PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# PostgreSQL connection used by src/core/database.js
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/binh_loi_db

# Use a long random value. Production refuses to start without it.
SESSION_SECRET=replace_with_a_long_random_secret

# Dedicated signing key for rotating venue check-in QR codes; required in production.
CHECKIN_QR_SECRET=replace_with_a_separate_long_random_secret

# Optional OAuth / media providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CARTO Basemaps key for the public Leaflet map. Keep the real value in .env only.
CARTO_BASEMAP_API_KEY=your_carto_basemaps_key

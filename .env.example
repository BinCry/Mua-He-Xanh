PORT=3000
NODE_ENV=production
BASE_URL=https://your-production-domain.example

# Endpoint nội bộ của AI agent; chỉ backend web gọi, không đưa sang trình duyệt.
AI_SERVICE_CHAT_URL=http://127.0.0.1:8100/api/v1/chat
# Dùng cùng secret với agent/.env; chỉ cấu hình trong môi trường server hoặc secret store.
AI_SERVICE_AUTH_TOKEN=

# PostgreSQL only. Never commit an actual password or connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Keep TLS verification enabled. Set to false only for an explicitly approved
# self-signed certificate deployment.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Generate a long, random value; production refuses to start without it.
SESSION_SECRET=replace_with_a_long_random_secret
CORS_ORIGIN=https://your-production-domain.example

# CARTO Basemaps key for the public Leaflet map. Keep the real value in .env only.
CARTO_BASEMAP_API_KEY=your_carto_basemaps_key

# Optional external providers. Leave absent when not configured.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

<style>
:root {
    --brand-maroon: #922724;
    --brand-maroon-dark: #6e1b19;
    --brand-green: #15803d;
    --brand-bg: #faf8f5;
    --brand-card: #ffffff;
    --brand-border: #eee7dd;
    --brand-text: #1e293b;
    --brand-muted: #64748b;
}

body {
    background-color: var(--brand-bg);
}

.onboarding-page-container {
    padding: 30px 12px 140px;
    background-color: var(--brand-bg);
    min-height: 90vh;
}

.onboarding-card-wrapper {
    background: #ffffff;
    border-radius: 24px;
    border: 1px solid #eee7dd;
    padding: 35px 28px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.04);
    max-width: 900px;
    margin: 0 auto;
}

@media (max-width: 768px) {
    .onboarding-card-wrapper {
        padding: 20px 14px !important;
        border-radius: 18px !important;
    }
}

.section-badge-num {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: linear-gradient(135deg, #922724 0%, #7f1d1d 100%);
    color: #ffffff;
    font-weight: 900;
    font-size: 1.15rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(146, 39, 36, 0.25);
}

.section-header-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: #1e293b;
    line-height: 1.3;
}

.section-header-sub {
    font-size: 0.82rem;
    color: #64748b;
    margin-top: 2px;
}

.section-divider-line {
    height: 1px;
    background: #eee7dd;
    margin: 18px 0 24px;
}

/* VIBE CARDS */
.vibe-card-item {
    background: #ffffff;
    border: 2px solid #e2e8f0;
    border-radius: 18px;
    padding: 20px 12px;
    text-align: center;
    cursor: pointer;
    position: relative;
    transition: all 0.25s ease;
    user-select: none;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.vibe-card-item:hover {
    border-color: #cbd5e1;
    background: #f8fafc;
    transform: translateY(-3px);
}

.vibe-card-item.selected {
    border-color: #922724 !important;
    background: #fff5f5 !important;
    box-shadow: 0 8px 20px rgba(146, 39, 36, 0.15) !important;
}

.check-badge {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #922724;
    color: #ffffff;
    font-size: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: scale(0.5);
    transition: all 0.2s ease;
}

.vibe-card-item.selected .check-badge {
    opacity: 1;
    transform: scale(1);
}

.vibe-icon {
    font-size: 2.2rem;
    margin-bottom: 8px;
    line-height: 1;
}

.vibe-title {
    font-size: 0.92rem;
    font-weight: 900;
    color: #1e293b;
    margin-bottom: 4px;
    letter-spacing: 0.5px;
}

.vibe-card-item.selected .vibe-title {
    color: #922724;
}

.vibe-sub {
    font-size: 0.75rem;
    color: #64748b;
    line-height: 1.3;
}

.sub-label-title {
    font-size: 0.82rem;
    font-weight: 800;
    color: #1e293b;
    margin-bottom: 10px;
    letter-spacing: 0.5px;
    display: flex;
    align-items: center;
    gap: 6px;
}

.option-pill-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
}

.option-pill-btn {
    border-radius: 50px;
    padding: 9px 6px;
    font-size: 0.78rem;
    font-weight: 700;
    background: #faf8f5;
    color: #334155;
    border: 1.5px solid #e2e8f0;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    user-select: none;
    white-space: nowrap;
    text-align: center;
    width: 100%;
}

@media (max-width: 768px) {
    .option-pill-btn {
        padding: 8px 2px !important;
        font-size: 0.72rem !important;
    }
    .btn-submit-journey {
        width: 100% !important;
        padding: 14px 20px !important;
        font-size: 0.95rem !important;
    }
}

.option-pill-btn:hover {
    background: #f1f5f9;
    border-color: #cbd5e1;
}

.option-pill-btn.active {
    background: linear-gradient(135deg, #922724 0%, #7f1d1d 100%) !important;
    color: #ffffff !important;
    border-color: #922724 !important;
    box-shadow: 0 4px 14px rgba(146, 39, 36, 0.3) !important;
}

.date-picker-input {
    border-radius: 50px;
    padding: 10px 20px;
    font-size: 0.88rem;
    font-weight: 700;
    border: 1.5px solid #e2e8f0;
    background: #ffffff;
    color: #922724;
    width: 100%;
}

.btn-submit-journey {
    background: linear-gradient(135deg, #7f1d1d 0%, #922724 50%, #6e1b19 100%);
    color: #ffffff;
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.5px;
    padding: 16px 45px;
    border-radius: 50px;
    border: none;
    box-shadow: 0 10px 28px rgba(146, 39, 36, 0.4);
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
}

.btn-submit-journey:hover, 
.btn-submit-journey:active, 
.btn-submit-journey:focus {
    background: #ffb6c1 !important;
    border-color: #ffb6c1 !important;
    color: white !important;
    box-shadow: 0 4px 12px rgba(255, 182, 193, 0.4) !important;
}

.btn-submit-journey:hover {
    transform: translateY(-2px);
}

.btn-submit-journey:active {
    transform: scale(0.96);
}
</style>

<div class="onboarding-page-container">
    
    <!-- HEADER -->
    <div class="text-center mb-4">
        <h1 class="display-6 fw-black font-heading text-dark mb-2" style="letter-spacing: -0.5px;">
            Thiết Kế Hành Trình Của Bạn
        </h1>
        <p class="text-muted small mx-auto mb-0" style="max-width: 580px;">
            Chọn mong muốn & ngày khởi hành để nhận đề xuất tour phù hợp nhất.
        </p>
    </div>

    <!-- MAIN FORM CARD -->
    <div class="onboarding-card-wrapper">
        <form id="onboardingForm" action="/onboarding" method="POST" onsubmit="handleOnboardingSubmit(event)">

            <!-- SECTION 1: BẠN ĐANG TÌM KIẾM CẢM GIÁC GÌ? -->
            <div class="mb-5">
                <div class="d-flex align-items-center gap-3">
                    <span class="section-badge-num">1</span>
                    <div>
                        <div class="section-header-title">Bạn đang tìm kiếm cảm giác gì?</div>
                        <div class="section-header-sub">Có thể chọn một hoặc nhiều trải nghiệm bạn yêu thích</div>
                    </div>
                </div>

                <div class="section-divider-line"></div>

                <div class="row g-3">
                    <!-- Card 1: Sống Chậm (Selected by default) -->
                    <div class="col-6 col-md-3">
                        <div class="vibe-card-item vibe-card-song-cham selected" onclick="toggleVibeCard(this, 'chill')">
                            <div class="check-badge"><i class="bi bi-check-lg"></i></div>
                            <div class="vibe-icon">🌿</div>
                            <div class="vibe-title">SỐNG CHẬM</div>
                            <div class="vibe-sub">Miệt vườn & hoa mai</div>
                        </div>
                    </div>

                    <!-- Card 2: Tâm Linh -->
                    <div class="col-6 col-md-3">
                        <div class="vibe-card-item vibe-card-tam-linh" onclick="toggleVibeCard(this, 'peace')">
                            <div class="check-badge"><i class="bi bi-check-lg"></i></div>
                            <div class="vibe-icon">🛕</div>
                            <div class="vibe-title">TÂM LINH</div>
                            <div class="vibe-sub">Chùa cổ Bát Bửu</div>
                        </div>
                    </div>

                    <!-- Card 3: Văn Hóa -->
                    <div class="col-6 col-md-3">
                        <div class="vibe-card-item vibe-card-van-hoa" onclick="toggleVibeCard(this, 'culture')">
                            <div class="check-badge"><i class="bi bi-check-lg"></i></div>
                            <div class="vibe-icon">🎨</div>
                            <div class="vibe-title">VĂN HÓA</div>
                            <div class="vibe-sub">Làng nghề truyền thống</div>
                        </div>
                    </div>

                    <!-- Card 4: Gắn Kết -->
                    <div class="col-6 col-md-3">
                        <div class="vibe-card-item vibe-card-gan-ket" onclick="toggleVibeCard(this, 'family')">
                            <div class="check-badge"><i class="bi bi-check-lg"></i></div>
                            <div class="vibe-icon">👨‍👩‍👧‍👦</div>
                            <div class="vibe-title">GẮN KẾT</div>
                            <div class="vibe-sub">Nông trại cá Koi</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECTION 2: THÔNG TIN CHUYẾN ĐỊ CA NÂN -->
            <div>
                <div class="d-flex align-items-center gap-3">
                    <span class="section-badge-num">2</span>
                    <div>
                        <div class="section-header-title">Thông tin chuyến đi của bạn</div>
                        <div class="section-header-sub">Chọn các tiêu chí phù hợp với kế hoạch cá nhân</div>
                    </div>
                </div>

                <div class="section-divider-line"></div>

                <div class="row g-4">

                    <!-- 1. SỐ LƯỢNG NGƯỜI -->
                    <div class="col-md-6">
                        <div class="sub-label-title"><i class="bi bi-people-fill"></i> SỐ LƯỢNG NGƯỜI</div>
                        <div class="option-pill-grid">
                            <div class="option-pill-btn" onclick="selectSingleOption('pax', '1', this)">👤 1 Người</div>
                            <div class="option-pill-btn active" onclick="selectSingleOption('pax', '2', this)">♥ Cặp đôi</div>
                            <div class="option-pill-btn" onclick="selectSingleOption('pax', '3-5', this)">👥 Nhóm 3-5</div>
                            <div class="option-pill-btn" onclick="selectSingleOption('pax', '5+', this)">🚌 Đoàn 5+</div>
                        </div>
                    </div>

                    <!-- 2. NGÂN SÁCH DỰ KIẾN / NGƯỜI -->
                    <div class="col-md-6">
                        <div class="sub-label-title"><i class="bi bi-wallet2"></i> NGÂN SÁCH DỰ KIẾN / NGƯỜI</div>
                        <div class="option-pill-grid">
                            <div class="option-pill-btn" onclick="selectSingleOption('budget', 'low', this)">🪙 &lt; 500k</div>
                            <div class="option-pill-btn active" onclick="selectSingleOption('budget', 'mid', this)">💵 500k-2Tr</div>
                            <div class="option-pill-btn" onclick="selectSingleOption('budget', 'high', this)">💎 &gt; 2 Tr</div>
                        </div>
                    </div>

                    <!-- 3. THỜI LƯỢNG HÀNH TRÌNH -->
                    <div class="col-md-6">
                        <div class="sub-label-title"><i class="bi bi-hourglass-split"></i> THỜI LƯỢNG HÀNH TRÌNH</div>
                        <div class="option-pill-grid">
                            <div class="option-pill-btn" onclick="selectSingleOption('duration', 'half_day', this)">⏱️ Nửa ngày</div>
                            <div class="option-pill-btn active" onclick="selectSingleOption('duration', 'full_day', this)">☀️ Trọn 1 ngày</div>
                            <div class="option-pill-btn" onclick="selectSingleOption('duration', '2d1n', this)">🌙 2N1Đ</div>
                        </div>
                    </div>

                    <!-- 4. NGÀY KHỞI HÀNH MONG MUỐN -->
                    <div class="col-md-6">
                        <div class="sub-label-title"><i class="bi bi-calendar-event"></i> NGÀY KHỞI HÀNH MONG MUỐN</div>
                        <div class="mb-2">
                            <input type="date" id="journeyDateInput" class="date-picker-input" value="2026-08-05">
                        </div>
                        <div class="option-pill-grid">
                            <div class="option-pill-btn active" onclick="setQuickDate('today', this)">⚡ Hôm nay</div>
                            <div class="option-pill-btn" onclick="setQuickDate('weekend', this)">📅 Cuối tuần</div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- SUBMIT BUTTON -->
            <div class="text-center mt-5 pb-4">
                <button type="submit" class="btn-submit-journey" id="btnSubmitForm">
                    PHÂN TÍCH LỘ TRÌNH TỐI ƯU <i class="bi bi-arrow-right"></i>
                </button>
            </div>

        </form>
    </div>

</div>

<script>
let selectedMoods = ['chill'];
let selectedPax = '2';
let selectedBudget = 'mid';
let selectedDuration = 'full_day';

document.addEventListener('DOMContentLoaded', () => {
    const dateInput = document.getElementById('journeyDateInput');
    if (dateInput) {
        const today = new Date().toISOString().split('T')[0];
        dateInput.value = today;
        dateInput.min = today;
    }
});

function toggleVibeCard(element, moodKey) {
    if (selectedMoods.includes(moodKey)) {
        if (selectedMoods.length > 1) {
            selectedMoods = selectedMoods.filter(m => m !== moodKey);
            element.classList.remove('selected');
        }
    } else {
        selectedMoods.push(moodKey);
        element.classList.add('selected');
    }
}

function selectSingleOption(group, val, element) {
    const parent = element.closest('.col-md-6');
    parent.querySelectorAll('.option-pill-btn').forEach(btn => btn.classList.remove('active'));
    element.classList.add('active');

    if (group === 'pax') selectedPax = val;
    if (group === 'budget') selectedBudget = val;
    if (group === 'duration') selectedDuration = val;
}

function setQuickDate(type, element) {
    const parent = element.parentElement;
    parent.querySelectorAll('.option-pill-btn').forEach(btn => btn.classList.remove('active'));
    element.classList.add('active');

    const dateInput = document.getElementById('journeyDateInput');
    const today = new Date();
    if (type === 'today') {
        dateInput.value = today.toISOString().split('T')[0];
    } else if (type === 'weekend') {
        const day = today.getDay();
        const diff = today.getDate() + (6 - day);
        const nextSat = new Date(today.setDate(diff));
        dateInput.value = nextSat.toISOString().split('T')[0];
    }
}

function handleOnboardingSubmit(e) {
    e.preventDefault();
    const btn = document.getElementById('btnSubmitForm');
    if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> ĐANG PHÂN TÍCH LỘ TRÌNH...';
    }

    const payload = {
        mood: selectedMoods,
        pax: selectedPax,
        budget: selectedBudget,
        duration: selectedDuration,
        date: document.getElementById('journeyDateInput') ? document.getElementById('journeyDateInput').value : ''
    };

    axios.post('/onboarding', payload, {
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }
    })
    .then(res => {
        if (res.data && res.data.redirect) {
            window.location.href = res.data.redirect;
            return;
        }
        window.location.href = '/journey/suggestions';
    })
    .catch(err => {
        console.error("Onboarding submit error:", err);
        window.location.href = '/journey/suggestions';
    });
}
</script>
    }
    .vibe-card-wow {
        height: 140px;
        border-radius: 16px;
    }
    .vibe-card-wow .vibe-content-box {
        padding: 10px;
    }
    .vibe-card-wow .vibe-emoji-icon {
        font-size: 1.5rem;
        margin-bottom: 2px;
    }
    .vibe-card-wow .vibe-main-title {
        font-size: 0.82rem;
    }
    .vibe-card-wow .vibe-sub-desc {
        font-size: 0.65rem;
        line-height: 1.2;
    }
    .vibe-check-circle {
        top: 8px; right: 8px;
        width: 26px; height: 26px;
        font-size: 0.9rem;
    }
    .option-pill-btn {
        min-width: 90px;
        padding: 8px 10px;
        font-size: 0.75rem;
    }
    .date-picker-custom {
        padding: 8px 12px;
        font-size: 0.8rem;
    }
    .btn-cta-wow {
        padding: 14px 24px;
        font-size: 0.82rem;
    }
}
</style>


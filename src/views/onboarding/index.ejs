<script>
let selectedVibes = ['chill'];

document.addEventListener('DOMContentLoaded', () => {
    gsap.from('.reveal-up', { opacity: 0, y: 30, duration: 0.8, ease: 'power2.out' });
    gsap.from('.main-onboarding-card', { opacity: 0, y: 40, duration: 1, delay: 0.2, ease: 'power3.out' });
    
    // Set default departure date to today
    const today = new Date().toISOString().split('T')[0];
    const dateInput = document.getElementById('departure_date');
    if (dateInput) {
        dateInput.value = today;
        dateInput.min = today;
    }
});

function selectVibe(vibe, el) {
    if (selectedVibes.includes(vibe)) {
        if (selectedVibes.length > 1) {
            selectedVibes = selectedVibes.filter(v => v !== vibe);
            el.classList.remove('active');
        }
    } else {
        selectedVibes.push(vibe);
        el.classList.add('active');
    }
    document.getElementById('moods-input').value = selectedVibes.join(',');
}

function selectPill(field, val, el) {
    const parent = el.closest('.pill-options-grid');
    parent.querySelectorAll('.option-pill-btn').forEach(btn => btn.classList.remove('active'));
    el.classList.add('active');
    const select = document.getElementById(`${field}-select`);
    if (select) select.value = val;
}

function setQuickDate(type, el) {
    const parent = el.closest('.pill-options-grid');
    parent.querySelectorAll('.option-pill-btn').forEach(btn => btn.classList.remove('active'));
    el.classList.add('active');

    const dateInput = document.getElementById('departure_date');
    const now = new Date();
    if (type === 'today') {
        dateInput.value = now.toISOString().split('T')[0];
    } else if (type === 'weekend') {
        const day = now.getDay();
        const diff = now.getDate() + (6 - day);
        const nextSat = new Date(now.setDate(diff));
        dateInput.value = nextSat.toISOString().split('T')[0];
    }
}

window.addEventListener('pageshow', () => {
    const btn = document.getElementById('submit-btn');
    if (btn) {
        btn.disabled = false;
        btn.innerHTML = 'PHÂN TÍCH LỘ TRÌNH TỐI ƯU <i class="bi bi-arrow-right-short fs-4 align-middle ms-1"></i>';
    }
});

document.getElementById('smartJourneyForm').addEventListener('submit', function(e) {
    e.preventDefault();
    const moods = document.getElementById('moods-input').value;
    if (!moods) {
        alert('Vui lòng chọn ít nhất một trải nghiệm/cảm giác!');
        return;
    }

    const btn = document.getElementById('submit-btn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>ĐANG TẠO TOUR TỐI ƯU...';

    const formData = new FormData(this);
    const data = Object.fromEntries(formData.entries());

    axios.post('/api/session', data)
        .then(() => {
            window.location.href = '/journey/suggestions';
        })
        .catch(err => {
            console.error(err);
            btn.disabled = false;
            btn.innerHTML = 'PHÂN TÍCH LỘ TRÌNH TỐI ƯU <i class="bi bi-arrow-right-short fs-4 align-middle ms-1"></i>';
        });
});
</script>
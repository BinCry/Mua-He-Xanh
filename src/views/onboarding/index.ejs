<style>
:root {
    --brand-maroon: #922724;
    --brand-maroon-dark: #6e1b19;
    --brand-green: #15803d;
    --brand-bg: #faf8f5;
    --brand-card: #ffffff;
    --brand-border: #eee7dd;
    --brand-text: #1e293b;
    --brand-muted: #64748b;
}

body {
    background-color: var(--brand-bg);
}

.onboarding-page-container {
    padding: 50px 15px 80px;
    background-color: var(--brand-bg);
    min-height: 90vh;
}

.onboarding-card-wrapper {
    max-width: 960px;
    margin: 0 auto;
    background: #ffffff;
    border-radius: 32px;
    padding: 45px 50px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.05);
    border: 1px solid rgba(0, 0, 0, 0.03);
}

@media (max-width: 768px) {
    .onboarding-card-wrapper {
        padding: 25px 20px;
        border-radius: 24px;
    }
}

.section-badge-num {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--brand-green);
    color: #ffffff;
    font-weight: 900;
    font-size: 0.95rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.section-header-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: #1e293b;
    margin-bottom: 2px;
}

.section-header-sub {
    font-size: 0.82rem;
    color: #64748b;
    margin-bottom: 0;
}

.section-divider-line {
    height: 1px;
    background: #e2e8f0;
    margin: 18px 0 24px;
}

/* VIBE CARDS (GIAO DIỆN HÌNH 1) */
.vibe-card-item {
    position: relative;
    border-radius: 20px;
    padding: 24px 20px;
    min-height: 165px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    color: #ffffff;
    user-select: none;
    border: 3px solid transparent;
}

.vibe-card-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.18);
}

.vibe-card-item.selected {
    border-color: var(--brand-maroon) !important;
    box-shadow: 0 10px 25px rgba(146, 39, 36, 0.35) !important;
}

.vibe-card-item .check-badge {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #ffffff;
    color: var(--brand-maroon);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
    font-weight: 900;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
    opacity: 0;
    transform: scale(0.5);
    transition: all 0.25s ease;
}

.vibe-card-item.selected .check-badge {
    opacity: 1;
    transform: scale(1);
}

/* Card Gradients */
.vibe-card-song-cham {
    background: linear-gradient(145deg, #1e4d34 0%, #15803d 50%, #0d5c2a 100%);
}
.vibe-card-tam-linh {
    background: linear-gradient(145deg, #4a1917 0%, #7f1d1d 50%, #581c1a 100%);
}
.vibe-card-van-hoa {
    background: linear-gradient(145deg, #5c2c1b 0%, #9a3412 50%, #6e2712 100%);
}
.vibe-card-gan-ket {
    background: linear-gradient(145deg, #172b4d 0%, #1e3a8a 50%, #0f2354 100%);
}

.vibe-icon {
    font-size: 1.8rem;
    margin-bottom: 12px;
}
.vibe-title {
    font-size: 1.05rem;
    font-weight: 900;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    line-height: 1.2;
    margin-bottom: 3px;
}
.vibe-sub {
    font-size: 0.76rem;
    opacity: 0.85;
    margin-bottom: 0;
}

/* SUB SECTIONS (SỐ LƯỢNG, NGÂN SÁCH, THỜI LƯỢNG, NGÀY) */
.sub-label-title {
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #922724;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 6px;
}

.option-pill-btn {
    border-radius: 50px;
    padding: 10px 18px;
    font-size: 0.86rem;
    font-weight: 700;
    background: #faf8f5;
    color: #334155;
    border: 1.5px solid #e2e8f0;
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    user-select: none;
}

.option-pill-btn:hover {
    background: #f1f5f9;
    border-color: #cbd5e1;
}

.option-pill-btn.active {
    background: linear-gradient(135deg, #922724 0%, #7f1d1d 100%) !important;
    color: #ffffff !important;
    border-color: #922724 !important;
    box-shadow: 0 4px 14px rgba(146, 39, 36, 0.3) !important;
}

.date-picker-input {
    border-radius: 50px;
    padding: 10px 20px;
    font-size: 0.88rem;
    font-weight: 700;
    border: 1.5px solid #e2e8f0;
    background: #ffffff;
    color: #922724;
    width: 100%;
}

.btn-submit-journey {
    background: linear-gradient(135deg, #7f1d1d 0%, #922724 50%, #6e1b19 100%);
    color: #ffffff;
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.5px;
    padding: 16px 45px;
    border-radius: 50px;
    border: none;
    box-shadow: 0 10px 28px rgba(146, 39, 36, 0.4);
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 10px;
}

.btn-submit-journey:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 34px rgba(146, 39, 36, 0.5);
    color: #ffffff;
}
</style>

<div class="onboarding-page-container">
    
    <!-- HEADER -->
    <div class="text-center mb-4">
        <h1 class="display-5 fw-black font-heading text-dark mb-2" style="letter-spacing: -0.5px;">
            Thiết Kế Hành Trình Của Bạn
        </h1>
        <p class="text-muted small mx-auto mb-0" style="max-width: 580px;">
            Chọn mong muốn & ngày khởi hành để nhận đề xuất tour phù hợp nhất.
        </p>
    </div>

    <!-- MAIN FORM CARD -->
    <div class="onboarding-card-wrapper">
        <form id="onboardingForm" onsubmit="handleOnboardingSubmit(event)">

            <!-- SECTION 1: BẠN ĐANG TÌM KIẾM CẢM GIÁC GÌ? -->
            <div class="mb-5">
                <div class="d-flex align-items-center gap-3">
                    <span class="section-badge-num">1</span>
                    <div>
                        <div class="section-header-title">Bạn đang tìm kiếm cảm giác gì?</div>
                        <div class="section-header-sub">Có thể chọn một hoặc nhiều trải nghiệm bạn yêu thích</div>
                    </div>
                </div>

                <div class="section-divider-line"></div>

                <div class="row g-3">
                    <!-- Card 1: Sống Chậm (Selected by default) -->
                    <div class="col-6 col-md-3">
                        <div class="vibe-card-item vibe-card-song-cham selected" onclick="toggleVibeCard(this, 'chill')">
                            <div class="check-badge"><i class="bi bi-check-lg"></i></div>
                            <div class="vibe-icon">🌿</div>
                            <div class="vibe-title">SỐNG CHẬM</div>
                            <div class="vibe-sub">Miệt vườn & hoa mai</div>
                        </div>
                    </div>

                    <!-- Card 2: Tâm Linh -->
                    <div class="col-6 col-md-3">
                        <div class="vibe-card-item vibe-card-tam-linh" onclick="toggleVibeCard(this, 'peace')">
                            <div class="check-badge"><i class="bi bi-check-lg"></i></div>
                            <div class="vibe-icon">🛕</div>
                            <div class="vibe-title">TÂM LINH</div>
                            <div class="vibe-sub">Chùa cổ Bát Bửu</div>
                        </div>
                    </div>

                    <!-- Card 3: Văn Hóa -->
                    <div class="col-6 col-md-3">
                        <div class="vibe-card-item vibe-card-van-hoa" onclick="toggleVibeCard(this, 'culture')">
                            <div class="check-badge"><i class="bi bi-check-lg"></i></div>
                            <div class="vibe-icon">🎨</div>
                            <div class="vibe-title">VĂN HÓA</div>
                            <div class="vibe-sub">Làng nghề truyền thống</div>
                        </div>
                    </div>

                    <!-- Card 4: Gắn Kết -->
                    <div class="col-6 col-md-3">
                        <div class="vibe-card-item vibe-card-gan-ket" onclick="toggleVibeCard(this, 'family')">
                            <div class="check-badge"><i class="bi bi-check-lg"></i></div>
                            <div class="vibe-icon">👨‍👩‍👧‍👦</div>
                            <div class="vibe-title">GẮN KẾT</div>
                            <div class="vibe-sub">Nông trại cá Koi</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECTION 2: THÔNG TIN CHUYẾN ĐỊ CA NÂN -->
            <div>
                <div class="d-flex align-items-center gap-3">
                    <span class="section-badge-num">2</span>
                    <div>
                        <div class="section-header-title">Thông tin chuyến đi của bạn</div>
                        <div class="section-header-sub">Chọn các tiêu chí phù hợp với kế hoạch cá nhân</div>
                    </div>
                </div>

                <div class="section-divider-line"></div>

                <div class="row g-4">

                    <!-- 1. SỐ LƯỢNG NGƯỜI -->
                    <div class="col-md-6">
                        <div class="sub-label-title"><i class="bi bi-people-fill"></i> SỐ LƯỢNG NGƯỜI</div>
                        <div class="d-flex gap-2 flex-wrap mb-2">
                            <div class="option-pill-btn" onclick="selectSingleOption('pax', '1', this)">👤 1 Người</div>
                            <div class="option-pill-btn active" onclick="selectSingleOption('pax', '2', this)">♥ Cặp đôi (2)</div>
                            <div class="option-pill-btn" onclick="selectSingleOption('pax', '3-5', this)">👥 Nhóm (3-5)</div>
                        </div>
                        <div class="w-100">
                            <div class="option-pill-btn w-100 justify-content-center" onclick="selectSingleOption('pax', '5+', this)">🚌 Đoàn (5+)</div>
                        </div>
                    </div>

                    <!-- 2. NGÂN SÁCH DỰ KIẾN / NGƯỜI -->
                    <div class="col-md-6">
                        <div class="sub-label-title"><i class="bi bi-wallet2"></i> NGÂN SÁCH DỰ KIẾN / NGƯỜI</div>
                        <div class="d-flex gap-2 flex-wrap">
                            <div class="option-pill-btn" onclick="selectSingleOption('budget', 'low', this)">🪙 &lt; 500k</div>
                            <div class="option-pill-btn active" onclick="selectSingleOption('budget', 'mid', this)">💵 500k - 2 Tr</div>
                            <div class="option-pill-btn" onclick="selectSingleOption('budget', 'high', this)">💎 &gt; 2 Tr</div>
                        </div>
                    </div>

                    <!-- 3. THỜI LƯỢNG HÀNH TRÌNH -->
                    <div class="col-md-6">
                        <div class="sub-label-title"><i class="bi bi-hourglass-split"></i> THỜI LƯỢNG HÀNH TRÌNH</div>
                        <div class="d-flex gap-2 flex-wrap">
                            <div class="option-pill-btn" onclick="selectSingleOption('duration', 'half_day', this)">⏱️ Nửa ngày</div>
                            <div class="option-pill-btn active" onclick="selectSingleOption('duration', 'full_day', this)">☀️ Trọn 1 ngày</div>
                            <div class="option-pill-btn" onclick="selectSingleOption('duration', '2d1n', this)">🌙 2 Ngày 1 đêm</div>
                        </div>
                    </div>

                    <!-- 4. NGÀY KHỞI HÀNH MONG MUỐN -->
                    <div class="col-md-6">
                        <div class="sub-label-title"><i class="bi bi-calendar-event"></i> NGÀY KHỞI HÀNH MONG MUỐN</div>
                        <div class="mb-2">
                            <input type="date" id="journeyDateInput" class="date-picker-input" value="2026-08-05">
                        </div>
                        <div class="d-flex gap-2 flex-wrap">
                            <div class="option-pill-btn active" onclick="setQuickDate('today', this)">⚡ Hôm nay</div>
                            <div class="option-pill-btn" onclick="setQuickDate('weekend', this)">📅 Cuối tuần</div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- SUBMIT BUTTON -->
            <div class="text-center mt-5">
                <button type="submit" class="btn-submit-journey" id="btnSubmitForm">
                    PHÂN TÍCH LỘ TRÌNH TỐI ƯU <i class="bi bi-arrow-right"></i>
                </button>
            </div>

        </form>
    </div>

</div>

<script>
let selectedMoods = ['chill'];
let selectedPax = '2';
let selectedBudget = 'mid';
let selectedDuration = 'full_day';

document.addEventListener('DOMContentLoaded', () => {
    const dateInput = document.getElementById('journeyDateInput');
    if (dateInput) {
        const today = new Date().toISOString().split('T')[0];
        dateInput.value = today;
        dateInput.min = today;
    }
});

function toggleVibeCard(element, moodKey) {
    if (selectedMoods.includes(moodKey)) {
        if (selectedMoods.length > 1) {
            selectedMoods = selectedMoods.filter(m => m !== moodKey);
            element.classList.remove('selected');
        }
    } else {
        selectedMoods.push(moodKey);
        element.classList.add('selected');
    }
}

function selectSingleOption(group, val, element) {
    const parent = element.closest('.col-md-6');
    parent.querySelectorAll('.option-pill-btn').forEach(btn => btn.classList.remove('active'));
    element.classList.add('active');

    if (group === 'pax') selectedPax = val;
    if (group === 'budget') selectedBudget = val;
    if (group === 'duration') selectedDuration = val;
}

function setQuickDate(type, element) {
    const parent = element.parentElement;
    parent.querySelectorAll('.option-pill-btn').forEach(btn => btn.classList.remove('active'));
    element.classList.add('active');

    const dateInput = document.getElementById('journeyDateInput');
    const today = new Date();
    if (type === 'today') {
        dateInput.value = today.toISOString().split('T')[0];
    } else if (type === 'weekend') {
        const day = today.getDay();
        const diff = today.getDate() + (6 - day);
        const nextSat = new Date(today.setDate(diff));
        dateInput.value = nextSat.toISOString().split('T')[0];
    }
}

function handleOnboardingSubmit(e) {
    e.preventDefault();
    const btn = document.getElementById('btnSubmitForm');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> ĐANG PHÂN TÍCH...';

    const payload = {
        mood: selectedMoods,
        pax: selectedPax,
        budget: selectedBudget,
        duration: selectedDuration,
        date: document.getElementById('journeyDateInput').value
    };

    axios.post('/onboarding', payload)
        .then(res => {
            if (typeof res.data === 'string' && res.data.includes('login')) {
                window.location.href = '/auth/login?error=auth_required';
                return;
            }
            if (res.data && res.data.redirect) {
                window.location.href = res.data.redirect;
                return;
            }
            window.location.href = '/journey/suggestions';
        })
        .catch(err => {
            window.location.href = '/journey/suggestions';
        });
}
</script>
<!-- Manager: Shop Management -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1" style="font-family: 'Inter', sans-serif;">Quản lý Shop - <%= dest.name %></h4>
        <p class="mb-0" style="color: var(--admin-muted); font-size: 0.85rem;">Quản lý danh sách, thêm, sửa, xóa các sản phẩm thuộc địa điểm <%= dest.name %>.</p>
    </div>
    <button class="btn btn-primary rounded-pill px-4 fw-bold" data-bs-toggle="modal" data-bs-target="#wsModal" onclick="openWsForm()">
        <i class="bi bi-plus-lg me-1"></i> Thêm sản phẩm
    </button>
</div>

<!-- Workshops Table -->
<div class="admin-table">
    <table class="table table-borderless mb-0">
        <thead>
            <tr>
                <th>Tên sản phẩm</th>
                <th>Loại</th>
                <th>Giá</th>
                <th>Thời gian / Quy cách</th>
                <th>Sức chứa / Kho</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            <% workshops.forEach(ws => { %>
            <tr>
                <td>
                    <div class="d-flex align-items-center gap-2">
                        <img src="<%= fixImg(ws.image, '/uploads/posters/poster-1.webp') %>" class="rounded-3" style="width: 44px; height: 44px; object-fit: cover;">
                        <div>
                            <div class="fw-bold small"><%= ws.title %></div>
                            <div style="font-size: 0.72rem; color: var(--admin-muted);"><%= dest.name %></div>
                        </div>
                    </div>
                </td>
                <td>
                    <% 
                    const typeLabels = {
                        nhang: 'Làm Nhang', mai: 'Chăm Mai', thien: 'Thiền Healing',
                        banh: 'Bánh Dân Gian', ecology: 'Nông Sản', culture: 'Văn Hóa & Lưu Niệm', other: 'Sản Phẩm Shop'
                    };
                    %>
                    <span class="role-badge role-user"><%= typeLabels[ws.type] || ws.type %></span>
                </td>
                <td>
                    <% if (ws.price == 0) { %>
                        <span class="text-success small fw-bold">Miễn phí</span>
                    <% } else { %>
                        <span class="small"><%= new Intl.NumberFormat('vi-VN').format(ws.price) %>đ</span>
                    <% } %>
                </td>
                <td class="small"><%= ws.duration || '2 giờ' %></td>
                <td class="small"><%= ws.max_participants || 20 %></td>
                <td>
                    <% if (ws.is_active) { %>
                        <span class="badge bg-success bg-opacity-25 text-success rounded-pill px-3">Active</span>
                    <% } else { %>
                        <span class="badge bg-secondary bg-opacity-25 text-secondary rounded-pill px-3">Ẩn</span>
                    <% } %>
                </td>
                <td>
                    <button class="btn btn-sm btn-outline-info rounded-pill px-3 me-1" onclick="viewBookings('<%= ws.id %>', '<%= ws.title.replace(/'/g, "\\'") %>')">
                        <i class="bi bi-people me-1"></i>Đăng ký (<%= ws.booking_count || 0 %>)
                    </button>
                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3 me-1" onclick="editWs(this)" data-workshop="<%= encodeURIComponent(JSON.stringify(ws)) %>">
                        <i class="bi bi-pencil"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="deleteWs('<%= ws.id %>')">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            </tr>
            <% }) %>
            <% if (workshops.length === 0) { %>
            <tr><td colspan="7" class="text-center py-5 text-muted">Chưa có sản phẩm nào trong shop.</td></tr>
            <% } %>
        </tbody>
    </table>
</div>

<!-- Workshop Modal -->
<div class="modal fade" id="wsModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 rounded-4" style="background: var(--admin-surface);">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="wsModalTitle">Thêm sản phẩm Shop</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="wsForm">
                    <input type="hidden" id="ws_id" name="id">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small fw-bold">Tên sản phẩm</label>
                            <input type="text" class="form-control admin-input" id="ws_title" name="title" placeholder="VD: Nhang thảo mộc Bình Lợi, Trải nghiệm hoa mai..." required>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Mô tả sản phẩm</label>
                            <textarea class="form-control admin-input" id="ws_description" name="description" rows="3" placeholder="Mô tả chi tiết sản phẩm / trải nghiệm..."></textarea>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Loại sản phẩm</label>
                             <select class="form-select admin-input" id="ws_type" name="type">
                                <option value="nhang">Làm Nhang</option>
                                <option value="mai">Chăm Mai</option>
                                <option value="thien">Thiền Healing</option>
                                <option value="banh">Bánh Dân Gian</option>
                                <option value="ecology">Nông Sản / Sinh Thái</option>
                                <option value="culture">Văn Hóa & Lưu Niệm</option>
                                <option value="other">Sản Phẩm Shop Khác</option>
                             </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Giá (VNĐ)</label>
                            <input type="number" class="form-control admin-input" id="ws_price" name="price" value="0">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Thời gian / Quy cách</label>
                            <input type="text" class="form-control admin-input" id="ws_duration" name="duration" value="2 giờ">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Sức chứa / Số lượng bán tối đa</label>
                            <input type="number" class="form-control admin-input" id="ws_max" name="max_participants" value="20">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Thuộc địa điểm</label>
                            <input type="text" class="form-control admin-input bg-light" value="<%= dest.name %>" readonly disabled>
                            <input type="hidden" id="ws_dest" name="destination_id" value="<%= dest.id %>">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Ngày giờ bắt đầu</label>
                            <input type="datetime-local" class="form-control admin-input" id="ws_start_date" name="start_date">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Ngày giờ kết thúc</label>
                            <input type="datetime-local" class="form-control admin-input" id="ws_end_date" name="end_date">
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Ảnh sản phẩm</label>
                            <div class="d-flex align-items-center gap-3 mb-2">
                                <img id="ws_preview" src="/uploads/posters/poster-1.webp" class="rounded-3" style="width: 100px; height: 60px; object-fit: cover; border: 1px solid var(--admin-border);">
                                <button type="button" id="ws_upload_btn" class="btn btn-sm btn-outline-dark rounded-pill" onclick="document.getElementById('ws_file').click()">
                                    <i class="bi bi-upload me-1"></i>Chọn ảnh
                                </button>
                                <input type="file" id="ws_file" class="d-none" accept="image/*" onchange="uploadWsFile(this)">
                            </div>
                            <input type="hidden" id="ws_image" name="image" value="/uploads/posters/poster-1.webp">
                        </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" id="ws_is_active" name="is_active" checked>
                                <label class="form-check-label small" for="ws_is_active">Hoạt động</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0">
                <button class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Hủy</button>
                <button class="btn btn-primary rounded-pill px-4 fw-bold" onclick="saveWs()">Lưu</button>
            </div>
        </div>
    </div>
</div>

<script>
let editingWs = false;

async function uploadWsFile(input) {
    if (!input.files || !input.files[0]) return;
    
    const formData = new FormData();
    formData.append('image', input.files[0]);
    
    const btn = document.getElementById('ws_upload_btn') || input.previousElementSibling;
    const oldHtml = btn ? btn.innerHTML : '';
    if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang tải ảnh...';
    }
    
    try {
        const res = await axios.post('/api/upload', formData);
        
        if (res.data.success) {
            document.getElementById('ws_image').value = res.data.url;
            document.getElementById('ws_preview').src = res.data.url;
            if (btn) btn.innerHTML = '<i class="bi bi-check-circle-fill text-success me-1"></i>Đã chọn ảnh!';
        } else {
            alert(res.data.message || 'Lỗi tải ảnh');
        }
    } catch (err) {
        alert('Lỗi tải ảnh: ' + (err.response?.data?.message || err.message));
        if (btn) btn.innerHTML = oldHtml;
    } finally {
        if (btn) {
            btn.disabled = false;
            setTimeout(() => { btn.innerHTML = oldHtml; }, 2000);
        }
    }
}

function openWsForm() {
    editingWs = false;
    document.getElementById('wsModalTitle').textContent = 'Thêm sản phẩm Shop';
    document.getElementById('wsForm').reset();
    document.getElementById('ws_id').value = '';
    document.getElementById('ws_preview').src = '/uploads/posters/poster-1.webp';
    document.getElementById('ws_image').value = '/uploads/posters/poster-1.webp';
    document.getElementById('ws_start_date').value = '';
    document.getElementById('ws_end_date').value = '';
    document.getElementById('ws_is_active').checked = true;
}

function editWs(target) {
    let ws = target;
    if (target instanceof HTMLElement) {
        ws = JSON.parse(decodeURIComponent(target.getAttribute('data-workshop')));
    }
    editingWs = true;
    document.getElementById('wsModalTitle').textContent = 'Sửa sản phẩm Shop';
    document.getElementById('ws_id').value = ws.id;
    document.getElementById('ws_title').value = ws.title || '';
    document.getElementById('ws_description').value = ws.description || '';
    document.getElementById('ws_type').value = ws.type || 'nhang';
    document.getElementById('ws_price').value = ws.price || 0;
    document.getElementById('ws_duration').value = ws.duration || '2 giờ';
    document.getElementById('ws_max').value = ws.max_participants || 20;
    document.getElementById('ws_image').value = ws.image || '/uploads/posters/poster-1.webp';
    document.getElementById('ws_preview').src = ws.image || '/uploads/posters/poster-1.webp';
    document.getElementById('ws_dest').value = ws.destination_id || '';
    if (ws.start_date) {
        document.getElementById('ws_start_date').value = new Date(new Date(ws.start_date).getTime() - new Date().getTimezoneOffset() * 60000).toISOString().slice(0, 16);
    } else {
        document.getElementById('ws_start_date').value = '';
    }
    if (ws.end_date) {
        document.getElementById('ws_end_date').value = new Date(new Date(ws.end_date).getTime() - new Date().getTimezoneOffset() * 60000).toISOString().slice(0, 16);
    } else {
        document.getElementById('ws_end_date').value = '';
    }
    document.getElementById('ws_is_active').checked = ws.is_active;
    new bootstrap.Modal(document.getElementById('wsModal')).show();
}

async function saveWs() {
    const data = {
        id: document.getElementById('ws_id').value,
        title: document.getElementById('ws_title').value,
        description: document.getElementById('ws_description').value,
        type: document.getElementById('ws_type').value,
        price: parseInt(document.getElementById('ws_price').value) || 0,
        duration: document.getElementById('ws_duration').value,
        max_participants: parseInt(document.getElementById('ws_max').value) || 20,
        image: document.getElementById('ws_image').value,
        destination_id: document.getElementById('ws_dest').value,
        start_date: document.getElementById('ws_start_date').value || null,
        end_date: document.getElementById('ws_end_date').value || null,
        is_active: document.getElementById('ws_is_active').checked
    };
    
    const url = editingWs ? '/api/manager/update-workshop' : '/api/manager/create-workshop';
    try {
        const res = await axios.post(url, data);
        if (res.data.success) { alert(res.data.message); location.reload(); }
        else alert(res.data.message);
    } catch (e) { alert('Lỗi: ' + (e.response?.data?.message || e.message)); }
}

function deleteWs(id) {
    showAdminConfirm('Bạn có chắc chắn muốn xóa sản phẩm này?', async () => {
        try {
            const res = await axios.post('/api/manager/delete-workshop', { id });
            if (res.data.success) location.reload();
            else showAdminToast(res.data.message, 'error');
        } catch (e) { showAdminToast('Lỗi: ' + (e.response?.data?.message || e.message), 'error'); }
    });
}

async function viewBookings(wsId, title) {
    document.getElementById('bookingsModalTitle').textContent = 'Danh sách đăng ký: ' + title;
    document.getElementById('bookingsLoading').style.display = 'block';
    document.getElementById('bookingsContent').style.display = 'none';
    const modal = new bootstrap.Modal(document.getElementById('bookingsModal'));
    modal.show();

    try {
        const res = await axios.get('/api/manager/workshop-bookings?workshop_id=' + wsId);
        document.getElementById('bookingsLoading').style.display = 'none';
        document.getElementById('bookingsContent').style.display = 'block';
        
        const tbody = document.getElementById('bookingsTableBody');
        tbody.innerHTML = '';
        
        if (!res.data.bookings || res.data.bookings.length === 0) {
            tbody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-muted">Chưa có lượt đăng ký nào.</td></tr>';
            return;
        }

        res.data.bookings.forEach(b => {
            const tr = document.createElement('tr');
            let statusBadge = '<span class="badge bg-success bg-opacity-25 text-success rounded-pill px-3">Đã xác nhận</span>';
            if (b.status === 'cancelled') statusBadge = '<span class="badge bg-danger bg-opacity-25 text-danger rounded-pill px-3">Đã hủy</span>';
            else if (b.status === 'completed') statusBadge = '<span class="badge bg-info bg-opacity-25 text-info rounded-pill px-3">Hoàn thành</span>';

            tr.innerHTML = `
                <td>
                    <div class="d-flex align-items-center gap-2">
                        <img src="${b.avatar || '/images/avatar-default.png'}" class="rounded-circle" style="width: 32px; height: 32px; object-fit: cover;">
                        <span class="fw-bold small">${b.full_name || 'Khách vãng lai'}</span>
                    </div>
                </td>
                <td class="small">
                    <div>${b.phone || 'N/A'}</div>
                    <div style="font-size: 0.75rem; color: var(--admin-muted);">${b.email || ''}</div>
                </td>
                <td class="small">
                    <div>${new Date(b.booking_date).toLocaleDateString('vi-VN')}</div>
                    <div style="font-size: 0.75rem; color: var(--admin-muted);">${b.booking_time || '08:00'} (${b.num_people} người)</div>
                </td>
                <td><code class="small fw-bold text-primary">${b.qr_ticket || 'N/A'}</code></td>
                <td>${statusBadge}</td>
                <td>
                    ${b.status === 'confirmed' ? `
                        <button class="btn btn-sm btn-success rounded-pill px-2 py-0 me-1" onclick="updateBookingStatus('${b.id}', 'completed', '${wsId}', '${title.replace(/'/g, "\\'")}')" title="Xác nhận hoàn thành">
                            <i class="bi bi-check-lg"></i> Tham gia
                        </button>
                        <button class="btn btn-sm btn-outline-danger rounded-pill px-2 py-0" onclick="updateBookingStatus('${b.id}', 'cancelled', '${wsId}', '${title.replace(/'/g, "\\'")}')" title="Hủy vé">
                            <i class="bi bi-x-lg"></i> Hủy
                        </button>
                    ` : '<span class="text-muted small">-</span>'}
                </td>
            `;
            tbody.appendChild(tr);
        });
    } catch(e) {
        alert('Lỗi tải danh sách: ' + (e.response?.data?.message || e.message));
    }
}

async function updateBookingStatus(bookingId, status, wsId, title) {
    try {
        const res = await axios.post('/api/manager/update-booking-status', { booking_id: bookingId, status });
        if (res.data.success) {
            viewBookings(wsId, title);
        }
    } catch(e) { alert('Lỗi: ' + (e.response?.data?.message || e.message)); }
}
</script>

<!-- Bookings List Modal -->
<div class="modal fade" id="bookingsModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 rounded-4" style="background: var(--admin-surface);">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="bookingsModalTitle">Danh sách đơn đặt mua sản phẩm</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="bookingsLoading" class="text-center py-4">
                    <span class="spinner-border text-primary"></span>
                </div>
                <div id="bookingsContent" class="table-responsive" style="display:none;">
                    <table class="table table-borderless align-middle mb-0 admin-table">
                        <thead>
                            <tr class="small">
                                <th>Khách hàng</th>
                                <th>Liên hệ</th>
                                <th>Thời gian</th>
                                <th>Mã vé</th>
                                <th>Trạng thái</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="bookingsTableBody">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

                    <h4 class="fw-bold mb-0 text-dark" style="font-size: 1.45rem; font-weight: 800; letter-spacing: -0.5px;">Đoạn chat</h4>
                    <div class="d-flex gap-2">
                        <button class="btn btn-light rounded-circle p-0 d-flex align-items-center justify-content-center border-0 shadow-none text-muted" style="width: 36px; height: 36px; background: #f0f2f5;" title="Tùy chọn">
                            <i class="bi bi-three-dots fs-5"></i>
                        </button>
                        <button class="btn btn-light rounded-circle p-0 d-flex align-items-center justify-content-center border-0 shadow-none text-muted" style="width: 36px; height: 36px; background: #f0f2f5;" title="Làm mới danh sách" onclick="location.reload()">
                            <i class="bi bi-arrow-clockwise fs-5"></i>
                        </button>
                    </div>
                </div>

                <!-- Messenger Search Bar -->
                <div class="px-3 pb-2">
                    <div class="position-relative">
                        <i class="bi bi-search position-absolute text-muted" style="left: 14px; top: 50%; transform: translateY(-50%); font-size: 0.9rem;"></i>

<script>
    let activeSessionId = null;
    let autoRefreshInterval = null;
    let cachedVisitor = null;
    let currentFilterTab = 'all';

    // Voice Recorder state
    let mediaRecorder = null;
    let audioChunks = [];
    let recordInterval = null;
    let recordSeconds = 0;

    function escapeHtmlManager(str) {
        if (!str) return '';
        const div = document.createElement('div');
        div.innerText = str;
        return div.innerHTML;
    }

    function toggleSendIcon(input) {
        const icon = document.getElementById('send-icon-graphic');
        if (!icon) return;
        if (input.value.trim().length > 0) {
            icon.className = 'bi bi-send-fill fs-5';
        } else {
            icon.className = 'bi bi-hand-thumbs-up-fill fs-4';
        }
    }

    function toggleEmojiPanel(force) {
        const p = document.getElementById('emoji-sticker-popover');
        if (!p) return;
        toggleGifPanel(false);
        p.style.display = (force !== undefined) ? (force ? 'block' : 'none') : (p.style.display === 'none' ? 'block' : 'none');
    }

    function toggleGifPanel(force) {
        const p = document.getElementById('gif-picker-popover');
        if (!p) return;
        toggleEmojiPanel(false);
        p.style.display = (force !== undefined) ? (force ? 'block' : 'none') : (p.style.display === 'none' ? 'block' : 'none');
    }

    function switchPickerTab(tab) {
        document.querySelectorAll('.picker-tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.picker-tab-pane').forEach(p => p.style.display = 'none');
        
        const activeBtn = document.getElementById(`ptab-${tab}`);
        if (activeBtn) activeBtn.classList.add('active');
        
        const activePane = document.getElementById(`ppane-${tab}`);
        if (activePane) activePane.style.display = 'block';
    }

    function insertEmoji(emoji) {
        const input = document.getElementById('manager-chat-input');
        input.value += emoji;
        input.focus();
        toggleSendIcon(input);
        toggleEmojiPanel(false);
    }

    function sendQuickGif(gifUrl) {
        toggleGifPanel(false);
        const text = `[GIF: ${gifUrl}]`;
        sendCustomMessage(text);
    }

    function triggerImageUpload() {
        document.getElementById('chat-image-input').click();
    }

    async function handleImageUpload(e) {
        const file = e.target.files[0];
        if (!file || !activeSessionId) return;

        const formData = new FormData();
        formData.append('image', file);

        try {
            showAdminToast('Đang tải ảnh lên...', 'info');
            const res = await axios.post('/api/admin/upload', formData, {
                headers: { 'Content-Type': 'multipart/form-data' }
            });
            if (res.data.success && (res.data.url || res.data.path)) {
                const imgUrl = res.data.url || res.data.path;
                sendCustomMessage(`[HÌNH ẢNH: ${imgUrl}]`);
                showAdminToast('Đã gửi ảnh thành công!', 'success');
            } else {
                showAdminToast(res.data.message || 'Lỗi tải ảnh', 'error');
            }
        } catch (err) {
            showAdminToast('Lỗi tải ảnh: ' + (err.response?.data?.message || err.message), 'error');
        } finally {
            e.target.value = '';
        }
    }

    // Voice Recording implementation with Web Audio API
    async function startVoiceRecording() {
        if (!activeSessionId) {
            showAdminToast('Vui lòng chọn cuộc hội thoại trước!', 'warning');
            return;
        }

        try {
            const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
            audioChunks = [];
            mediaRecorder = new MediaRecorder(stream);
            
            mediaRecorder.ondataavailable = (e) => {
                if (e.data.size > 0) audioChunks.push(e.data);
            };

            mediaRecorder.start();
            recordSeconds = 0;
            document.getElementById('recording-timer').innerText = '00:00';
            document.getElementById('standard-chat-bar').style.display = 'none';
            document.getElementById('voice-recording-bar').style.display = 'flex';

            recordInterval = setInterval(() => {
                recordSeconds++;
                const mins = String(Math.floor(recordSeconds / 60)).padStart(2, '0');
                const secs = String(recordSeconds % 60).padStart(2, '0');
                document.getElementById('recording-timer').innerText = `${mins}:${secs}`;
            }, 1000);
        } catch (err) {
            console.warn("Microphone not available, using simulated voice note:", err);
            sendCustomMessage('🎤 [Ghi âm thoại: 0:12]');
            showAdminToast('Đã gửi tin nhắn ghi chú thoại!', 'success');
        }
    }

    function cancelVoiceRecording() {
        if (recordInterval) clearInterval(recordInterval);
        if (mediaRecorder && mediaRecorder.state !== 'inactive') {
            mediaRecorder.stop();
            mediaRecorder.stream.getTracks().forEach(track => track.stop());
        }
        document.getElementById('voice-recording-bar').style.display = 'none';
        document.getElementById('standard-chat-bar').style.display = 'flex';
    }

    async function stopAndSendVoiceRecording() {
        if (!mediaRecorder || mediaRecorder.state === 'inactive') return;
        if (recordInterval) clearInterval(recordInterval);

        const durationStr = document.getElementById('recording-timer').innerText;

        mediaRecorder.onstop = async () => {
            mediaRecorder.stream.getTracks().forEach(track => track.stop());
            const audioBlob = new Blob(audioChunks, { type: 'audio/webm' });
            
            const formData = new FormData();
            formData.append('image', audioBlob, `voice-${Date.now()}.webm`);

            try {
                showAdminToast('Đang gửi ghi âm thoại...', 'info');
                const res = await axios.post('/api/admin/upload', formData, {
                    headers: { 'Content-Type': 'multipart/form-data' }
                });
                if (res.data.success && (res.data.url || res.data.path)) {
                    const audioUrl = res.data.url || res.data.path;
                    sendCustomMessage(`[AUDIO: ${audioUrl}|${durationStr}]`);
                } else {
                    sendCustomMessage(`🎤 [Ghi âm thoại: ${durationStr}]`);
                }
            } catch(e) {
                sendCustomMessage(`🎤 [Ghi âm thoại: ${durationStr}]`);
            }

            document.getElementById('voice-recording-bar').style.display = 'none';
            document.getElementById('standard-chat-bar').style.display = 'flex';
        };

        mediaRecorder.stop();
    }

    function openImageLightbox(url) {
        document.getElementById('lightbox-img').src = url;
        document.getElementById('lightbox-download-btn').href = url;
        const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('imageLightboxModal'));
        modal.show();
    }

    function togglePlayVoice(btn, audioUrl) {
        let audio = btn._audioInstance;
        if (!audio) {
            audio = new Audio(audioUrl);
            btn._audioInstance = audio;
            audio.onended = () => {
                btn.innerHTML = '<i class="bi bi-play-fill fs-5"></i>';
            };
        }

        if (audio.paused) {
            audio.play().then(() => {
                btn.innerHTML = '<i class="bi bi-pause-fill fs-5"></i>';
            }).catch(e => {
                showAdminToast('Đang phát tin nhắn thoại mẫu 🎵', 'info');
            });
        } else {
            audio.pause();
            btn.innerHTML = '<i class="bi bi-play-fill fs-5"></i>';
        }
    }

    function openVisitorInfoModal() {
        if (!cachedVisitor && !activeSessionId) return;
        const v = cachedVisitor || {};
        const vName = v.full_name || document.getElementById('active-chat-name').innerText;
        document.getElementById('modal-visitor-name').innerText = vName;
        document.getElementById('modal-visitor-id').innerText = 'Mã: ' + (v.uuid || v.id || activeSessionId);
        document.getElementById('modal-visitor-checkin').innerHTML = (v.is_checked_in > 0)
            ? '<span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>Đã Check-in</span>'
            : '<span class="text-muted">Chưa check-in</span>';
        document.getElementById('modal-visitor-points').innerText = (v.total_points || 0) + ' ✨';
        document.getElementById('modal-visitor-phone').innerText = v.phone || 'Chưa cung cấp';
        document.getElementById('modal-visitor-email').innerText = v.email || 'Chưa cung cấp';
        
        const avatarEl = document.getElementById('modal-visitor-avatar');
        if (v.avatar) {
            avatarEl.innerHTML = `<img src="${v.avatar}" class="w-100 h-100 rounded-circle object-fit-cover" onerror="this.src='/images/logo.png'">`;
        } else {
            avatarEl.innerText = vName.split(' ').pop().slice(0,2).toUpperCase();
        }

        const modalEl = document.getElementById('visitorInfoModal');
        const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
        modal.show();
    }

    function switchFilterTab(tab) {
        currentFilterTab = tab;
        document.querySelectorAll('.filter-tab-btn').forEach(b => {
            b.classList.remove('active');
            b.style.background = 'transparent';
            b.style.color = '#65676b';
        });
        const activeBtn = document.getElementById(`tab-${tab}`);
        if (activeBtn) {
            activeBtn.classList.add('active');
            activeBtn.style.background = '#e7f3ff';
            activeBtn.style.color = '#0064e0';
        }
        filterConversations();
    }

    function filterConversations() {
        const query = document.getElementById('chat-search').value.toLowerCase();
        const items = document.querySelectorAll('.convo-item-card');
        items.forEach(item => {
            const text = item.innerText.toLowerCase();
            const matchesQuery = text.includes(query);
            let matchesTab = true;

            if (currentFilterTab === 'unread') {
                const isSentByYou = text.includes('bạn:');
                matchesTab = !isSentByYou;
            } else if (currentFilterTab === 'replied') {
                const isSentByYou = text.includes('bạn:');
                matchesTab = isSentByYou;
            }

            item.style.display = (matchesQuery && matchesTab) ? 'flex' : 'none';
        });
    }

    function loadConversation(sessionId) {
        if (!sessionId) return;
        activeSessionId = sessionId;

        document.querySelectorAll('.convo-item-card').forEach(el => el.classList.remove('active'));
        const activeCard = document.getElementById(`convo-${sessionId}`);
        if (activeCard) activeCard.classList.add('active');

        axios.get('/api/manager/chat-history?sessionId=' + encodeURIComponent(sessionId) + '&dest_id=<%= dest.id %>')
            .then(res => {
                if (res.data.success) {
                    cachedVisitor = res.data.visitor;
                    renderChatMessages(res.data.messages, res.data.visitor);
                }
            })
            .catch(err => {
                console.error("Lỗi lấy lịch sử chat:", err);
            });
    }

    function formatMessengerDividerTime(isoDateStr) {
        if (!isoDateStr) return '';
        const d = new Date(isoDateStr);
        if (isNaN(d.getTime())) return '';
        const now = new Date();
        const isToday = d.toDateString() === now.toDateString();
        const yesterday = new Date(now);
        yesterday.setDate(now.getDate() - 1);
        const isYesterday = d.toDateString() === yesterday.toDateString();

        const timeStr = d.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
        const days = ['CN', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7'];
        const dayName = days[d.getDay()];
        const day = d.getDate();
        const month = d.getMonth() + 1;
        const year = d.getFullYear();

        if (isToday) {
            return `Hôm nay ${timeStr}`;
        } else if (isYesterday) {
            return `Hôm qua ${timeStr}`;
        } else if (year === now.getFullYear()) {
            return `${dayName}, ${day} Thg ${month}, ${timeStr}`;
        } else {
            return `${dayName}, ${day}/${month}/${year}, ${timeStr}`;
        }
    }

    function formatBubbleContent(text) {
        if (!text) return '';
        
        // 1. Handle images: [HÌNH ẢNH: url] or [IMAGE: url] or plain /uploads/... or http... (jpg|png|webp|jpeg)
        const imgTagMatch = text.match(/\[(HÌNH ẢNH|IMAGE):\s*([^\]]+)\]/i);
        if (imgTagMatch) {
            const url = imgTagMatch[2].trim();
            return `
                <div class="my-1 position-relative overflow-hidden rounded-3 shadow-xs">
                    <img src="${url}" class="img-fluid rounded-3 cursor-pointer" style="max-height: 220px; max-width: 100%; object-fit: cover; display: block;" onclick="openImageLightbox('${url}')" loading="lazy" onerror="this.outerHTML='<span class=\\'small text-white\\'>📷 Không thể tải ảnh</span>'">
                </div>
            `;
        }

        // Direct standalone image URL
        const directImgMatch = text.match(/^(\/[^\s]+\.(jpg|jpeg|png|webp|gif)|https?:\/\/[^\s]+\.(jpg|jpeg|png|webp|gif))$/i);
        if (directImgMatch) {
            const url = directImgMatch[1].trim();
            return `
                <div class="my-1 position-relative overflow-hidden rounded-3 shadow-xs">
                    <img src="${url}" class="img-fluid rounded-3 cursor-pointer" style="max-height: 220px; max-width: 100%; object-fit: cover; display: block;" onclick="openImageLightbox('${url}')" loading="lazy">
                </div>
            `;
        }

        // 2. Handle GIFs [GIF: url]
        const gifMatch = text.match(/\[GIF:\s*([^\]]+)\]/i);
        if (gifMatch) {
            const url = gifMatch[1].trim();
            return `
                <div class="my-1 position-relative overflow-hidden rounded-3 shadow-xs">
                    <img src="${url}" class="rounded-3 shadow-xs" style="max-height: 180px; max-width: 240px; object-fit: contain; display: block;" loading="lazy">
                </div>
            `;
        }

        // 3. Handle Voice / Audio Notes: [AUDIO: url|duration] or 🎤 [Ghi âm thoại: duration]
        const audioMatch = text.match(/\[(AUDIO|VOICE):\s*([^\|\]]+)(?:\|([^\]]+))?\]/i);
        if (audioMatch) {
            const audioUrl = audioMatch[2].trim();
            const duration = audioMatch[3] || '0:15';
            return `
                <div class="d-flex align-items-center gap-2 p-2 px-3 rounded-pill my-1" style="background: rgba(255,255,255,0.22); min-width: 190px;">
                    <button type="button" class="btn btn-sm btn-light rounded-circle p-0 d-flex align-items-center justify-content-center shadow-2xs flex-shrink-0" style="width: 32px; height: 32px; color: #0084ff;" onclick="togglePlayVoice(this, '${audioUrl}')">
                        <i class="bi bi-play-fill fs-5"></i>
                    </button>
                    <div class="flex-grow-1" style="height: 4px; background: rgba(255,255,255,0.4); border-radius: 2px;"></div>
                    <span class="x-small fw-bold opacity-90 text-nowrap" style="font-size: 0.72rem;">${duration}</span>
                </div>
            `;
        }

        if (text.includes('🎤 [Ghi âm thoại')) {
            return `
                <div class="d-flex align-items-center gap-2 p-2 px-3 rounded-pill my-1" style="background: rgba(255,255,255,0.22); min-width: 190px;">
                    <button type="button" class="btn btn-sm btn-light rounded-circle p-0 d-flex align-items-center justify-content-center shadow-2xs flex-shrink-0" style="width: 32px; height: 32px; color: #0084ff;" onclick="togglePlayVoice(this, '/sounds/chat-notification.mp3')">
                        <i class="bi bi-play-fill fs-5"></i>
                    </button>
                    <div class="flex-grow-1" style="height: 4px; background: rgba(255,255,255,0.4); border-radius: 2px;"></div>
                    <span class="x-small fw-bold opacity-90 text-nowrap" style="font-size: 0.72rem;">0:15</span>
                </div>
            `;
        }

        return escapeHtmlManager(text);
    }

    function renderChatMessages(messages, visitor) {
        const stream = document.getElementById('chat-messages-stream');
        const headerName = document.getElementById('active-chat-name');
        const headerStatus = document.getElementById('active-chat-status');
        const avatarBox = document.getElementById('active-chat-avatar');
        
        document.getElementById('chat-controls-area').style.display = 'block';
        const actionsEl = document.getElementById('active-chat-actions');
        if (actionsEl) actionsEl.style.display = 'flex';

        const rawId = (visitor && (visitor.uuid || visitor.id)) ? String(visitor.uuid || visitor.id) : (activeSessionId || '');
        const shortId = rawId ? rawId.slice(0, 4).toUpperCase() : 'ANON';
        const vName = (visitor && visitor.full_name) 
            ? visitor.full_name 
            : ('Du khách #' + shortId);

        headerName.innerText = vName;
        headerStatus.innerHTML = `
            <span class="d-inline-block rounded-circle bg-success" style="width: 7px; height: 7px;"></span>
            <span class="text-success fw-semibold">Đang hoạt động</span> • ${visitor && visitor.is_checked_in > 0 ? '<span class="text-primary fw-semibold"><i class="bi bi-check2-circle"></i> Đã Check-in</span>' : '<span class="text-muted">Chưa Check-in</span>'}
        `;
        
        const avatarInitial = (visitor && visitor.full_name) 
            ? visitor.full_name.split(' ').pop().slice(0,2).toUpperCase() 
            : ('#' + shortId.slice(0,2));
        
        let charCode = 0;
        for (let i = 0; i < rawId.length; i++) charCode += rawId.charCodeAt(i);
        const bgColors = ['#1e5a3e', '#0284c7', '#059669', '#d97706', '#7c3aed', '#db2777'];
        const avatarBg = bgColors[charCode % bgColors.length];

        let visitorAvatarHtml = '';
        if (visitor && visitor.avatar) {
            avatarBox.innerHTML = `<img src="${visitor.avatar}" class="w-100 h-100 rounded-circle object-fit-cover" onerror="this.src='/images/logo.png'">`;
            visitorAvatarHtml = `<img src="${visitor.avatar}" class="rounded-circle flex-shrink-0 shadow-2xs" style="width: 28px; height: 28px; object-fit: cover;" onerror="this.outerHTML='<div class=\\'rounded-circle d-flex align-items-center justify-content-center text-white flex-shrink-0 shadow-2xs\\' style=\\'width:28px;height:28px;font-size:0.7rem;background:${avatarBg};\\'>${avatarInitial}</div>'">`;
        } else {
            avatarBox.innerText = avatarInitial;
            avatarBox.style.background = avatarBg;
            visitorAvatarHtml = `<div class="rounded-circle d-flex align-items-center justify-content-center text-white flex-shrink-0 shadow-2xs" style="width: 28px; height: 28px; font-size: 0.7rem; background: ${avatarBg};">${avatarInitial}</div>`;
        }

        let html = '';
        let lastMsgTime = null;

        if (messages && messages.length > 0) {
            messages.forEach((msg, idx) => {
                const isAI = msg.is_ai === 1 || msg.is_ai === true;
                const isReply = !isAI && !msg.sender_uuid && msg.sender_id;
                const currentMsgTime = msg.created_at ? new Date(msg.created_at).getTime() : 0;
                const isLastMsg = (idx === messages.length - 1);
                const exactTime = msg.created_at ? new Date(msg.created_at).toLocaleTimeString('vi-VN', {hour: '2-digit', minute:'2-digit'}) : '';

                if (!lastMsgTime || (currentMsgTime - lastMsgTime > 20 * 60 * 1000)) {
                    html += `
                        <div class="text-center my-3">
                            <span class="text-muted fw-medium" style="font-size: 0.75rem; color: #65676b !important;">
                                ${formatMessengerDividerTime(msg.created_at)}
                            </span>
                        </div>
                    `;
                }
                lastMsgTime = currentMsgTime;

                const isLikeEmoji = (msg.message === '👍');
                const isMedia = (msg.message.includes('[HÌNH ẢNH:') || msg.message.includes('[GIF:') || msg.message.includes('[AUDIO:'));
                const isRecalled = msg.is_recalled || msg.message === '[ĐÃ THU HỒI]';

                if (isRecalled) {
                    if (isReply) {
                        html += `
                            <div class="d-flex flex-column align-items-end" style="margin-bottom: 3px;">
                                <div class="px-3 py-2 text-muted fst-italic shadow-2xs" style="border-radius: 18px; border: 1px dashed rgba(0,0,0,0.18); background: rgba(0,0,0,0.03); font-size: 0.85rem;" title="${exactTime}">
                                    <i class="bi bi-arrow-counterclockwise me-1 text-danger"></i>Tin nhắn đã bị thu hồi
                                </div>
                                <div class="x-small text-muted text-end mt-0.5 me-1" style="font-size: 0.68rem; color: #65676b;">${exactTime}</div>
                            </div>
                        `;
                    } else {
                        html += `
                            <div class="d-flex flex-column align-items-start" style="margin-bottom: 3px;">
                                <div class="d-flex gap-2 align-items-end" style="max-width: 75%;">
                                    ${visitorAvatarHtml}
                                    <div class="px-3 py-2 text-muted fst-italic shadow-2xs" style="border-radius: 18px; border: 1px dashed rgba(0,0,0,0.18); background: rgba(0,0,0,0.03); font-size: 0.85rem;" title="${exactTime}">
                                        <i class="bi bi-arrow-counterclockwise me-1 text-danger"></i>Tin nhắn đã bị thu hồi
                                    </div>
                                </div>
                                <div class="x-small text-muted text-start mt-0.5 ms-5" style="font-size: 0.68rem; color: #65676b;">${exactTime}</div>
                            </div>
                        `;
                    }
                } else if (isReply) {
                    html += `
                        <div class="d-flex flex-column align-items-end" style="margin-bottom: 3px;">
                            <div class="group-hover-parent d-flex align-items-center gap-1.5 justify-content-end" style="max-width: 82%;">
                                <button type="button" class="btn btn-sm btn-light rounded-circle p-0 d-flex align-items-center justify-content-center shadow-none text-muted group-hover-visible flex-shrink-0" style="width: 26px; height: 26px;" onclick="openRecallAction('${msg.id}', true)" title="Tùy chọn tin nhắn">
                                    <i class="bi bi-three-dots"></i>
                                </button>
                                <div class="text-white text-start shadow-2xs" style="font-size: ${isLikeEmoji ? '2.2rem' : '0.93rem'}; line-height: 1.38; padding: ${isLikeEmoji || isMedia ? '2px 4px' : '9px 14px'}; background: ${isLikeEmoji || isMedia ? 'transparent' : '#0084ff'} !important; border-radius: 18px !important; word-break: break-word; overflow-wrap: anywhere;" title="${exactTime}">
                                    ${formatBubbleContent(msg.message)}
                                </div>
                            </div>
                            ${isLastMsg ? `<div class="x-small text-muted text-end mt-1 me-1" style="font-size: 0.7rem; color: #65676b;">Đã gửi lúc ${exactTime} <i class="bi bi-check2"></i></div>` : ''}
                        </div>
                    `;
                } else if (isAI) {
                    html += `
                        <div class="d-flex flex-column align-items-start" style="margin-bottom: 3px;">
                            <div class="d-flex gap-2 align-items-end" style="max-width: 75%;">
                                <div class="rounded-circle d-flex align-items-center justify-content-center text-success flex-shrink-0 shadow-2xs bg-success bg-opacity-10 border border-success border-opacity-20" style="width: 28px; height: 28px; font-size: 0.9rem;">
                                    <i class="bi bi-robot"></i>
                                </div>
                                <div class="text-start shadow-2xs" style="font-size: 0.93rem; line-height: 1.38; padding: 9px 14px; border-radius: 18px !important; background: rgba(16,185,129,0.08); border: 1px solid rgba(16,185,129,0.2); color: #065f46; word-break: break-word; overflow-wrap: anywhere;" title="${exactTime}">
                                    <div class="x-small fw-bold text-success mb-0.5" style="font-size: 0.65rem;">🤖 TRỢ LÝ AI</div>
                                    ${formatBubbleContent(msg.message)}
                                </div>
                            </div>
                        </div>
                    `;
                } else {
                    html += `
                        <div class="d-flex flex-column align-items-start" style="margin-bottom: 3px;">
                            <div class="d-flex gap-2 align-items-end" style="max-width: 82%;">
                                ${visitorAvatarHtml}
                                <div class="group-hover-parent d-flex align-items-center gap-1.5 justify-content-start flex-grow-1">
                                    <div class="text-dark text-start shadow-2xs" style="font-size: ${isLikeEmoji ? '2.2rem' : '0.93rem'}; line-height: 1.38; padding: ${isLikeEmoji || isMedia ? '2px 4px' : '9px 14px'}; border-radius: 18px !important; word-break: break-word; overflow-wrap: anywhere; background: ${isLikeEmoji || isMedia ? 'transparent' : '#f0f2f5'} !important;" title="${exactTime}">
                                        ${formatBubbleContent(msg.message)}
                                    </div>
                                    <button type="button" class="btn btn-sm btn-light rounded-circle p-0 d-flex align-items-center justify-content-center shadow-none text-muted group-hover-visible flex-shrink-0" style="width: 26px; height: 26px;" onclick="openRecallAction('${msg.id}', false)" title="Tùy chọn tin nhắn">
                                        <i class="bi bi-three-dots"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="x-small text-muted text-start mt-0.5 ms-5" style="font-size: 0.68rem; color: #65676b;">${exactTime}</div>
                        </div>
                    `;
                }
            });
        } else {
            html = `<div class="h-100 d-flex flex-column justify-content-center align-items-center text-center opacity-40 my-auto"><p class="small text-muted">Bắt đầu cuộc trò chuyện với du khách tại đây</p></div>`;
        }

        stream.innerHTML = html;
        stream.scrollTop = stream.scrollHeight;
    }

    let activeRecallMessageId = null;

    function openRecallAction(msgId, isMine) {
        activeRecallMessageId = msgId;
        const optAll = document.getElementById('recall-option-all');
        if (optAll) {
            optAll.style.display = isMine ? 'flex' : 'none';
        }
        const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('recallActionModal'));
        modal.show();
    }

    async function executeRecall(type) {
        if (!activeRecallMessageId) return;
        const msgId = activeRecallMessageId;
        const modalEl = document.getElementById('recallActionModal');
        const modal = bootstrap.Modal.getInstance(modalEl);
        if (modal) modal.hide();

        try {
            const res = await axios.post('/api/chat/recall-message', { messageId: msgId, type });
            if (res.data.success) {
                if (activeSessionId) {
                    loadConversation(activeSessionId);
                }
            } else {
                alert(res.data.message || 'Không thể thực hiện thao tác');
            }
        } catch(e) {
            alert('Lỗi: ' + (e.response?.data?.message || e.message));
        }
    }

    function deleteActiveConversation() {
        if (!activeSessionId) return;
        showAdminConfirm('Bạn có chắc chắn muốn xóa toàn bộ lịch sử cuộc hội thoại này? Thao tác này không thể hoàn tác.', 'Xóa cuộc hội thoại', async () => {
            try {
                const res = await axios.post('/api/delete-conversation', { 
                    session_id: activeSessionId,
                    destination_id: '<%= dest.id %>'
                });
                if (res.data.success) {
                    const item = document.getElementById(`convo-${activeSessionId}`);
                    if (item) item.remove();
                    document.getElementById('chat-messages-stream').innerHTML = `
                        <div class="h-100 d-flex flex-column justify-content-center align-items-center text-center opacity-40 my-auto">
                            <i class="bi bi-check-circle display-4 mb-3 text-success"></i>
                            <h6 class="fw-bold text-dark">Đã xóa cuộc hội thoại</h6>
                            <p class="small text-muted px-4" style="max-width: 320px; font-size: 0.75rem;">Chọn cuộc hội thoại khác từ danh sách bên trái.</p>
                        </div>
                    `;
                    document.getElementById('active-chat-name').innerText = 'Vui lòng chọn hội thoại';
                    const actionsEl = document.getElementById('active-chat-actions');
                    if (actionsEl) actionsEl.style.display = 'none';
                    document.getElementById('chat-controls-area').style.display = 'none';
                    activeSessionId = null;
                    showAdminToast('Đã xóa cuộc hội thoại thành công!', 'success');
                } else {
                    showAdminToast(res.data.message || 'Không thể xóa hội thoại', 'error');
                }
            } catch(err) {
                showAdminToast('Lỗi xóa hội thoại: ' + (err.response?.data?.message || err.message), 'error');
            }
        });
    }

    function sendCustomMessage(text) {
        if (!text || !activeSessionId) return;
        const stream = document.getElementById('chat-messages-stream');
        const exactTime = new Date().toLocaleTimeString('vi-VN', {hour: '2-digit', minute:'2-digit'});
        const isLike = (text === '👍');
        const isMedia = (text.includes('[HÌNH ẢNH:') || text.includes('[GIF:') || text.includes('[AUDIO:'));

        const optHtml = `
            <div class="d-flex flex-column align-items-end" style="margin-bottom: 3px;">
                <div class="text-white text-start shadow-2xs" style="max-width: 72%; font-size: ${isLike ? '2.2rem' : '0.93rem'}; line-height: 1.38; padding: ${isLike || isMedia ? '2px 4px' : '9px 14px'}; background: ${isLike || isMedia ? 'transparent' : '#0084ff'} !important; border-radius: 18px !important; word-break: break-word; overflow-wrap: anywhere;">
                    ${formatBubbleContent(text)}
                </div>
                <div class="x-small text-muted text-end mt-1 me-1" style="font-size: 0.7rem; color: #65676b;">Đã gửi lúc ${exactTime} <i class="bi bi-check2"></i></div>
            </div>
        `;
        stream.insertAdjacentHTML('beforeend', optHtml);
        stream.scrollTop = stream.scrollHeight;

        axios.post('/api/reply-message', {
            sessionId: activeSessionId,
            replyText: text,
            destinationId: '<%= dest.id %>'
        }).then(res => {
            if (res.data.success) loadConversation(activeSessionId);
        }).catch(err => console.error(err));
    }

    function sendLiveReply() {
        const input = document.getElementById('manager-chat-input');
        let text = input.value.trim();
        if (!text) text = '👍';

        input.value = '';
        toggleSendIcon(input);
        sendCustomMessage(text);
        input.focus();
    }

    function insertCannedResponse(type) {
        const input = document.getElementById('manager-chat-input');
        const responses = {
            welcome: 'Chào mừng bạn đến với <%= dest.name %>! Chúng tôi rất vui được đón tiếp và hỗ trợ bạn trong suốt chuyến trải nghiệm.',
            hours: 'Điểm đến <%= dest.name %> mở cửa phục vụ từ <%= dest.open_hours || "7:30 - 17:30 hàng ngày" %>. Giá vé/chi phí tham khảo: <%= dest.cost || "Miễn phí vé vào cổng" %>.',
            checkin: 'Bạn có thể quét mã QR Check-in được đặt tại cổng hoặc quầy lễ tân để ghi dấu hành trình và tích điểm thưởng đổi quà nhé!',
            thanks: 'Cảm ơn bạn đã liên hệ với <%= dest.name %>. Chúc bạn có những phút giây thư giãn và an yên!'
        };
        input.value = responses[type] || '';
        toggleSendIcon(input);
        input.focus();
    }

    function startAutoRefresh() {
        stopAutoRefresh();
        autoRefreshInterval = setInterval(() => {
            if (activeSessionId) {
                axios.get('/api/manager/chat-history?sessionId=' + encodeURIComponent(activeSessionId) + '&dest_id=<%= dest.id %>')
                    .then(res => {
                        if (res.data.success) {
                            const stream = document.getElementById('chat-messages-stream');
                            const currentBubbles = stream.querySelectorAll('.shadow-2xs').length;
                            if (res.data.messages.length !== currentBubbles) {
                                renderChatMessages(res.data.messages, res.data.visitor);
                            }
                        }
                    }).catch(err => console.log(err));
            }
        }, 4000);
    }

    function stopAutoRefresh() {
        if (autoRefreshInterval) {
            clearInterval(autoRefreshInterval);
            autoRefreshInterval = null;
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        startAutoRefresh();

        <% if (conversations && conversations.length > 0) { %>
            const firstSession = '<%= conversations[0].session_id %>';
            loadConversation(firstSession);
        <% } %>
    });
</script>

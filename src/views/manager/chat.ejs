                    </div>
                </div>

                <!-- Messenger Filter Tabs -->
                <div class="px-3 pb-2 d-flex gap-1.5 align-items-center border-bottom" style="border-color: #f0f2f5 !important;">
                    <button class="btn btn-sm rounded-pill px-3 fw-semibold border-0 filter-tab-btn active" id="tab-all" onclick="switchFilterTab('all')" style="background: #e7f3ff; color: #0064e0; font-size: 0.85rem;">Tất cả</button>
                    <button class="btn btn-sm rounded-pill px-3 fw-semibold border-0 filter-tab-btn text-muted" id="tab-unread" onclick="switchFilterTab('unread')" style="background: transparent; font-size: 0.85rem;">Cần phản hồi</button>
                    <button class="btn btn-sm rounded-pill px-3 fw-semibold border-0 filter-tab-btn text-muted" id="tab-replied" onclick="switchFilterTab('replied')" style="background: transparent; font-size: 0.85rem;">Đã trả lời</button>
                </div>
                
<% 
function formatMessengerSidebarDate(dateStr) {
    if (!dateStr) return '';
    const d = new Date(dateStr);
    if (isNaN(d.getTime())) return '';
    const now = new Date();
    const diffMs = now - d;
    const diffSec = Math.floor(diffMs / 1000);
    const diffMin = Math.floor(diffSec / 60);
    const diffHour = Math.floor(diffMin / 60);
    const diffDay = Math.floor(diffHour / 24);

    if (diffMin < 1) return 'Vừa xong';
    if (diffMin < 60) return `${diffMin} phút`;
    if (diffHour < 24) return `${diffHour} giờ`;
    if (diffDay === 1) return 'Hôm qua';
    if (diffDay < 7) return `${diffDay} ngày`;
    
    const day = String(d.getDate()).padStart(2, '0');
    const month = String(d.getMonth() + 1).padStart(2, '0');
    if (d.getFullYear() === now.getFullYear()) {
        return `${day}/${month}`;
    }
    return `${day}/${month}/${d.getFullYear()}`;
}
%>
                <!-- Conversations List -->
                <div class="flex-grow-1 overflow-y-auto custom-scrollbar p-2" id="convo-list" style="background: #ffffff;">
                    <% if (conversations && conversations.length > 0) { %>
                        <% conversations.forEach((convo, index) => { 
                            const rawId = (convo.session_uuid || convo.session_id || '').toString();
                            const shortId = rawId ? rawId.slice(0,4).toUpperCase() : 'ANON';
                            const displayName = convo.user_name || ('Du khách #' + shortId);
                            const avatarInitial = convo.user_name ? convo.user_name.split(' ').pop().slice(0,2).toUpperCase() : ('#' + shortId.slice(0,2));
                            let charCode = 0;
                            for (let i = 0; i < rawId.length; i++) charCode += rawId.charCodeAt(i);
                            const bgColors = ['#1e5a3e', '#0284c7', '#059669', '#d97706', '#7c3aed', '#db2777'];
                            const avatarBg = bgColors[charCode % bgColors.length];
                        %>
                            <div class="convo-item-card px-2.5 py-2 d-flex gap-3 align-items-center position-relative cursor-pointer transition-all" 
                                 id="convo-<%= convo.session_id %>"
                                 data-session-id="<%= convo.session_id %>"
                                 data-user-name="<%= displayName %>"
                                 onclick="loadConversation('<%= convo.session_id %>')"
                                 style="border-radius: 10px; margin-bottom: 2px;">
                                
                                <!-- Avatar -->
                                <div class="position-relative flex-shrink-0">
                                    <div class="convo-avatar rounded-circle d-flex align-items-center justify-content-center fw-bold text-white shadow-2xs"
                                         style="width: 50px; height: 50px; background: <%= avatarBg %>; object-fit: cover; font-size: 0.95rem;">
                                        <% if (convo.user_avatar) { %>
                                            <img src="<%= convo.user_avatar %>" class="w-100 h-100 rounded-circle object-fit-cover" onerror="this.outerHTML='<%= avatarInitial %>'">
                                        <% } else { %>
                                            <%= avatarInitial %>
                                        <% } %>
                                    </div>
                                    <span class="position-absolute bottom-0 end-0 bg-success border border-white border-2 rounded-circle" style="width: 14px; height: 14px;"></span>
                                </div>
                                
                                <!-- Body -->
                                <div class="flex-grow-1 overflow-hidden" style="min-width: 0;">
                                    <h6 class="fw-semibold mb-0.5 text-truncate text-dark" style="font-size: 0.92rem;">
                                        <%= displayName %>
                                    </h6>
                                    <p class="text-muted text-truncate mb-0" style="line-height: 1.35; font-size: 0.8rem;">
                                        <span class="convo-last-msg"><%= (convo.last_message || 'Bắt đầu cuộc trò chuyện').replace(/\[(HÌNH ẢNH|IMAGE|AUDIO|GIF|VOICE):[^\]]+\]/gi, '📷 [Đã gửi tệp đa phương tiện]') %></span> · <span class="convo-time"><%= formatMessengerSidebarDate(convo.last_message_time) %></span>
                                    </p>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="text-center py-5 opacity-40">
                            <i class="bi bi-chat-square-quote display-6 mb-3 d-block text-muted"></i>
                            <small class="fw-bold text-muted">Chưa có du khách nào nhắn tin đến địa điểm</small>
                        </div>
                    <% } %>
                </div>
            </div>


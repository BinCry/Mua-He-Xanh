<!-- Premium Manager Chat Panel - Pixel-Perfect Facebook Messenger UI -->
<div class="container-fluid p-0 animate__animated animate__fadeIn position-relative">
    <!-- Header banner -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <div class="admin-page-title">
                <span class="admin-page-title-mark" aria-hidden="true" style="color: #1e5a3e;"><i class="bi bi-messenger"></i></span>
                <h4 class="fw-bold mb-0 font-display" style="color: var(--admin-text); font-family: 'Inter', sans-serif;">Hộp thư Hỗ trợ: <%= dest.name %></h4>
            </div>
            <p class="mb-0 text-muted small" style="font-size: 0.85rem;">
                Tương tác, tư vấn và hỗ trợ du khách ghé thăm <%= dest.name %> theo giao diện Messenger thời gian thực.
            </p>
        </div>
        <div>
            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-20 rounded-pill px-3 py-2 fw-semibold">
                <i class="bi bi-geo-alt-fill me-1"></i><%= dest.name %>
            </span>
        </div>
    </div>

    <!-- MAIN CHAT WORKSPACE -->
    <div class="chat-container-card shadow-sm border" style="height: calc(100vh - 170px); min-height: 580px; border-radius: 16px; overflow: hidden; background: #ffffff; border-color: #e4e6eb !important;">
        <div class="row g-0 h-100">
            
            <!-- Chat Sidebar (Active Conversations list) -->
            <div class="col-md-5 col-xl-4 border-end d-flex flex-column h-100" style="background: #ffffff; border-color: #e4e6eb !important;">
                

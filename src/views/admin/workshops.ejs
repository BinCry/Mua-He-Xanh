<!-- Admin: Shop & Product Management -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1" style="font-family: 'Inter', sans-serif;">Quản lý Shop & Sản phẩm</h4>
        <p class="mb-0" style="color: var(--admin-muted); font-size: 0.85rem;">Quản lý danh sách sản phẩm, đặc sản, quà lưu niệm & OCOP tại shop.</p>
    </div>
    <div>
        <button class="btn btn-primary rounded-pill px-4 py-2.5 fw-bold d-inline-flex align-items-center gap-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#wsModal" onclick="openWsForm()">
            <i class="bi bi-plus-circle-fill"></i> Thêm sản phẩm mới
        </button>
    </div>
</div>

<!-- Products Table -->
<div class="admin-table">
    <table class="table table-borderless mb-0">
        <thead>
            <tr>
                <th>Tên sản phẩm</th>
                <th>Giá bán</th>
                <th>Quy cách / Đơn vị</th>
                <th>Tồn kho</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            <% workshops.forEach(ws => { %>
            <tr>
                <td>
                    <div class="d-flex align-items-center gap-3">
                        <img src="<%= fixImg(ws.image, '/images/hero-2.png') %>" class="rounded-3" style="width: 48px; height: 48px; object-fit: cover; border: 1px solid rgba(0,0,0,0.08);">
                        <div>
                            <div class="fw-bold text-dark" style="font-size: 0.9rem;"><%= ws.title %></div>
                            <div class="text-muted text-truncate" style="font-size: 0.76rem; max-width: 250px;"><%= ws.description || '-' %></div>
                        </div>
                    </div>
                </td>
                <td>
                    <div class="fw-bold text-success" style="font-size: 0.9rem;">
                        <%= ws.price === 0 ? 'Miễn phí' : new Intl.NumberFormat('vi-VN').format(ws.price) + 'đ' %>
                    </div>
                </td>
                <td>
                    <div class="small text-secondary"><%= ws.duration || 'Chiếc / Hộp' %></div>
                </td>
                <td>
                    <div class="small fw-semibold text-dark"><%= ws.max_participants || 100 %> sản phẩm</div>
                </td>
                <td>
                    <span class="badge bg-<%= ws.is_active ? 'success' : 'secondary' %> rounded-pill px-2.5 py-1">
                        <%= ws.is_active ? 'Đang bán' : 'Ẩn' %>
                    </span>
                </td>
                <td>
                    <button class="btn btn-sm btn-outline-primary rounded-circle p-2 me-1" onclick="editWs(this)" data-workshop="<%= encodeURIComponent(JSON.stringify(ws)) %>" title="Chỉnh sửa">
                        <i class="bi bi-pencil-fill"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-danger rounded-circle p-2" onclick="deleteWs('<%= ws.id %>')" title="Xóa sản phẩm">
                        <i class="bi bi-trash-fill"></i>
                    </button>
                </td>
            </tr>
            <% }) %>
            <% if (workshops.length === 0) { %>
            <tr>
                <td colspan="7" class="text-center py-5">
                    <i class="bi bi-bag-plus display-4 text-muted d-block mb-3"></i>
                    <p class="text-muted fw-semibold mb-3">Chưa có sản phẩm nào trong shop.</p>
                    <button class="btn btn-primary rounded-pill px-4 fw-bold" data-bs-toggle="modal" data-bs-target="#wsModal" onclick="openWsForm()">
                        <i class="bi bi-plus-circle me-1"></i> Thêm sản phẩm đầu tiên
                    </button>
                </td>
            </tr>
            <% } %>
        </tbody>
    </table>
</div>

<!-- Product Add / Edit Modal -->
<div class="modal fade" id="wsModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg" style="background: #ffffff;">
            <div class="modal-header border-bottom px-4 py-3">
                <h5 class="modal-title fw-bold text-dark" id="wsModalTitle">Thêm sản phẩm mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="wsForm">
                    <input type="hidden" id="ws_id" name="id">
                    <div class="row g-3">
                        
                        <!-- Product Title -->
                        <div class="col-12">
                            <label class="form-label small fw-bold text-dark">Tên sản phẩm <span class="text-danger">*</span></label>
                            <input type="text" class="form-control rounded-3 py-2" id="ws_title" name="title" placeholder="VD: Tổ Yến Chưng Đông Trùng Hạ Thảo (Hộp 6+2 hũ 70ml)..." required>
                        </div>

                        <!-- Short Description -->
                        <div class="col-12">
                            <label class="form-label small fw-bold text-dark">Mô tả sản phẩm (Hiển thị trên thẻ sản phẩm) <span class="text-danger">*</span></label>
                            <textarea class="form-control rounded-3" id="ws_description" name="description" rows="3" placeholder="VD: 12g tổ yến tươi/hũ — OCOP 4 Sao TP.HCM..."></textarea>
                        </div>

                        <!-- Hidden Type Default -->
                        <input type="hidden" id="ws_type" name="type" value="other">

                        <!-- Selling Price -->
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark">Giá bán (VNĐ) <span class="text-danger">*</span></label>
                            <input type="number" class="form-control rounded-3 py-2" id="ws_price" name="price" value="0" placeholder="VD: 1029000">
                        </div>

                        <!-- Packaging Unit -->
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark">Quy cách / Đơn vị đóng gói</label>
                            <input type="text" class="form-control rounded-3 py-2" id="ws_duration" name="duration" placeholder="VD: Hộp 8 hũ x 70ml, Gói 50g, Hộp 100 nụ..." value="Hộp / Chiếc">
                        </div>

                        <!-- Stock Quantity -->
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark">Số lượng tồn kho</label>
                            <input type="number" class="form-control rounded-3 py-2" id="ws_max" name="max_participants" value="100" placeholder="VD: 100">
                        </div>

                        <!-- Product Image -->
                        <div class="col-12">
                            <label class="form-label small fw-bold text-dark">Ảnh sản phẩm</label>
                            <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-3 border">
                                <img id="ws_preview" src="/images/hero-2.png" class="rounded-3 shadow-sm" style="width: 100px; height: 75px; object-fit: cover; border: 1px solid #cbd5e1;">
                                <div>
                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1.5 fw-bold" onclick="document.getElementById('ws_file').click()">
                                        <i class="bi bi-upload me-1"></i>Chọn ảnh tải lên
                                    </button>
                                    <div class="text-muted x-small mt-1" style="font-size: 0.78rem;">Định dạng PNG, JPG, WEBP. Ảnh hình vuông hoặc 4:3 đẹp nhất.</div>
                                    <input type="file" id="ws_file" class="d-none" accept="image/*" onchange="uploadWsFile(this)">
                                </div>
                            </div>
                            <input type="hidden" id="ws_image" name="image" value="/images/hero-2.png">
                        </div>

                        <!-- Optional Destination -->
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark">Thuộc địa điểm (Tùy chọn)</label>
                            <select class="form-select rounded-3 py-2" id="ws_dest" name="destination_id">
                                <option value="">-- Không chọn --</option>
                                <% destinations.forEach(d => { %>
                                    <option value="<%= d.id %>"><%= d.name %></option>
                                <% }) %>
                            </select>
                        </div>

                        <!-- Status -->
                        <div class="col-md-6 d-flex align-items-center">
                            <div class="form-check form-switch mt-3">
                                <input class="form-check-input" type="checkbox" id="ws_is_active" name="is_active" checked style="width: 45px; height: 22px;">
                                <label class="form-check-label small fw-bold text-dark ms-2 mt-1" for="ws_is_active">Hiển thị bán tại Shop</label>
                            </div>
                        </div>

                    </div>
                </form>
            </div>
            <div class="modal-footer border-top px-4 py-3">
                <button class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                <button class="btn btn-primary rounded-pill px-5 fw-bold" onclick="saveWs()">
                    <i class="bi bi-check-circle-fill me-1"></i>Lưu sản phẩm
                </button>
            </div>
        </div>
    </div>
</div>

<script>
let editingWs = false;

async function uploadWsFile(input) {
    if (!input.files || !input.files[0]) return;
    
    const formData = new FormData();
    formData.append('image', input.files[0]);
    
    const btn = input.previousElementSibling.querySelector('button');
    const oldHtml = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang tải ảnh...';
    
    try {
        const res = await axios.post('/api/upload', formData, {
            headers: { 'Content-Type': 'multipart/form-data' }
        });
        
        if (res.data.success) {
            document.getElementById('ws_image').value = res.data.url;
            document.getElementById('ws_preview').src = res.data.url;
            btn.innerHTML = '<i class="bi bi-check-circle-fill text-success me-1"></i>Đã tải ảnh';
        }
    } catch (err) {
        alert('Lỗi tải ảnh: ' + (err.response?.data?.message || err.message));
        btn.innerHTML = oldHtml;
    } finally {
        btn.disabled = false;
        setTimeout(() => { btn.innerHTML = oldHtml; }, 2000);
    }
}

function openWsForm() {
    editingWs = false;
    document.getElementById('wsModalTitle').textContent = 'Thêm sản phẩm mới';
    document.getElementById('wsForm').reset();
    document.getElementById('ws_id').value = '';
    document.getElementById('ws_preview').src = '/images/hero-2.png';
    document.getElementById('ws_image').value = '/images/hero-2.png';
    document.getElementById('ws_is_active').checked = true;
}

function editWs(target) {
    let ws = target;
    if (target instanceof HTMLElement) {
        ws = JSON.parse(decodeURIComponent(target.getAttribute('data-workshop')));
    }
    editingWs = true;
    document.getElementById('wsModalTitle').textContent = 'Sửa thông tin sản phẩm';
    document.getElementById('ws_id').value = ws.id;
    document.getElementById('ws_title').value = ws.title || '';
    document.getElementById('ws_description').value = ws.description || '';
    document.getElementById('ws_type').value = ws.type || 'ecology';
    document.getElementById('ws_price').value = ws.price || 0;
    document.getElementById('ws_duration').value = ws.duration || 'Hộp / Chiếc';
    document.getElementById('ws_max').value = ws.max_participants || 100;
    document.getElementById('ws_image').value = ws.image || '/images/hero-2.png';
    document.getElementById('ws_preview').src = ws.image || '/images/hero-2.png';
    document.getElementById('ws_dest').value = ws.destination_id || '';
    document.getElementById('ws_is_active').checked = ws.is_active;
    new bootstrap.Modal(document.getElementById('wsModal')).show();
}

async function saveWs() {
    const titleVal = document.getElementById('ws_title').value.trim();
    if (!titleVal) {
        alert('Vui lòng nhập tên sản phẩm.');
        return;
    }

    const data = {
        id: document.getElementById('ws_id').value,
        title: titleVal,
        description: document.getElementById('ws_description').value,
        type: document.getElementById('ws_type').value,
        price: parseInt(document.getElementById('ws_price').value) || 0,
        duration: document.getElementById('ws_duration').value || 'Hộp / Chiếc',
        max_participants: parseInt(document.getElementById('ws_max').value) || 100,
        image: document.getElementById('ws_image').value,
        destination_id: document.getElementById('ws_dest').value || null,
        is_active: document.getElementById('ws_is_active').checked
    };
    
    const url = editingWs ? '/api/admin/update-shop' : '/api/admin/create-shop';
    try {
        const res = await axios.post(url, data);
        if (res.data.success) {
            alert(res.data.message || 'Đã lưu sản phẩm thành công!');
            location.reload();
        } else {
            alert(res.data.message || 'Không thể lưu sản phẩm.');
        }
    } catch (e) {
        alert('Lỗi lưu sản phẩm: ' + (e.response?.data?.message || e.message));
    }
}

async function deleteWs(id) {
    if (!confirm('Bạn có chắc chắn muốn xóa sản phẩm này khỏi Shop?')) return;
    try {
        const res = await axios.post('/api/admin/delete-shop', { id });
        if (res.data.success) {
            location.reload();
        } else {
            alert(res.data.message || 'Không thể xóa.');
        }
    } catch (e) {
        alert('Lỗi xóa sản phẩm: ' + (e.response?.data?.message || e.message));
    }
}
</script>

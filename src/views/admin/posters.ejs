<!-- Admin: Quản lý & Upload Poster Hero Trang chủ -->
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1" style="font-family: 'Inter', sans-serif;">Quản lý Poster Hero Trang Chủ</h4>
        <p class="mb-0 text-muted small"><i class="bi bi-info-circle me-1"></i>Kéo thả các thẻ Poster bên dưới để sắp xếp thứ tự hiển thị (Ví dụ: Thẻ đầu tiên sẽ là #1).</p>
    </div>
    <div>
        <button class="btn btn-primary rounded-pill px-4 py-2.5 fw-bold d-inline-flex align-items-center gap-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#posterModal" onclick="openPosterForm()">
            <i class="bi bi-cloud-arrow-up-fill"></i> Upload Poster Mới
        </button>
    </div>
</div>

<!-- Posters Grid with Drag & Drop -->
<div class="row g-4 mb-4" id="postersGrid">
    <% posters.forEach((p, idx) => { %>
    <div class="col-md-6 col-lg-4 poster-card-item" data-id="<%= p.id %>" style="cursor: grab;">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100 bg-white poster-card-inner">
            <div class="position-relative" style="height: 220px;">
                <img src="<%= fixImg(p.image_url) %>" class="w-100 h-100 object-fit-cover" pointer-events="none" draggable="false">
                <div class="position-absolute top-0 start-0 m-3">
                    <span class="badge bg-dark bg-opacity-75 text-white rounded-pill px-3 py-1.5 fw-bold poster-badge">
                        <i class="bi bi-arrows-move me-1 text-warning"></i>#<%= idx + 1 %>
                    </span>
                </div>
                <div class="position-absolute top-0 end-0 m-3">
                    <span class="badge <%= p.is_active ? 'bg-success' : 'bg-secondary' %> rounded-pill px-3 py-1.5 fw-bold">
                        <%= p.is_active ? 'Đang hiển thị' : 'Đang ẩn' %>
                    </span>
                </div>
            </div>
            <div class="card-body p-3.5 d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="fw-bold text-dark mb-1 text-truncate" style="max-width: 200px;"><%= p.title || ('Poster Slide ' + (idx + 1)) %></h6>
                    <small class="text-muted"><%= new Date(p.created_at || Date.now()).toLocaleDateString('vi-VN') %></small>
                </div>
                <form action="/admin/posters/delete" method="POST" onsubmit="return confirm('Bạn có chắc muốn xóa Poster này?');">
                    <input type="hidden" name="id" value="<%= p.id %>">
                    <button type="submit" class="btn btn-outline-danger shadow-sm" title="Xóa Poster" style="width: 38px; height: 38px; min-width: 38px; min-height: 38px; border-radius: 50% !important; display: inline-flex; align-items: center; justify-content: center; padding: 0; flex-shrink: 0; border-width: 1.5px;">
                        <i class="bi bi-trash3-fill fs-6" style="line-height: 1;"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>
    <% }) %>
</div>

<% if (posters.length === 0) { %>
<div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white mb-4">
    <i class="bi bi-images display-3 text-muted opacity-35 mb-3"></i>
    <h5 class="fw-bold text-dark">Chưa có Poster Hero nào do Admin Upload</h5>
    <p class="text-muted small mb-0">Hệ thống đang tự động dùng 5 Poster mặc định. Bạn có thể Upload Poster riêng để thay thế.</p>
</div>
<% } %>

<!-- Upload Modal -->
<div class="modal fade" id="posterModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
            <div class="modal-header bg-primary text-white p-4">
                <h5 class="modal-title fw-bold mb-0"><i class="bi bi-cloud-upload-fill me-2"></i>Upload Poster Hero Mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="posterForm" onsubmit="savePoster(event)">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Tiêu đề Poster / Ghi chú</label>
                        <input type="text" id="p_title" name="title" class="form-control rounded-3" placeholder="Ví dụ: Banner Sắc Mai Vàng 2026">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Hình ảnh Poster</label>
                        <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-3 border">
                            <img id="p_preview" src="/images/placeholder.jpg" class="rounded-3 shadow-sm" style="width: 120px; height: 75px; object-fit: cover; border: 1px solid #cbd5e1;">
                            <div>
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1.5 fw-bold" onclick="document.getElementById('p_file').click()">
                                    <i class="bi bi-upload me-1"></i>Chọn ảnh tải lên
                                </button>
                                <div class="text-muted x-small mt-1" style="font-size: 0.78rem;">Tỷ lệ 16:9 hoặc Banner Poster đẹp nhất.</div>
                                <input type="file" id="p_file" class="d-none" accept="image/*" onchange="uploadPosterFile(this)">
                            </div>
                        </div>
                        <input type="hidden" id="p_image_url" name="image_url" value="/images/placeholder.jpg">
                    </div>
                </div>
                <div class="modal-footer bg-light p-3 border-0">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" id="savePosterBtn" class="btn btn-primary rounded-pill px-4 fw-bold">UPLOAD VÀ LƯU</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const grid = document.getElementById('postersGrid');
    if (grid && typeof Sortable !== 'undefined') {
        new Sortable(grid, {
            animation: 200,
            ghostClass: 'opacity-50',
            onEnd: async function() {
                updatePosterBadges();
                await savePosterOrder();
            }
        });
    }
});

function updatePosterBadges() {
    const items = document.querySelectorAll('.poster-card-item');
    items.forEach((item, idx) => {
        const badge = item.querySelector('.poster-badge');
        if (badge) {
            badge.innerHTML = `<i class="bi bi-arrows-move me-1 text-warning"></i>#${idx + 1}`;
        }
    });
}

async function savePosterOrder() {
    const items = document.querySelectorAll('.poster-card-item');
    const orderedIds = Array.from(items).map(item => item.getAttribute('data-id'));
    
    try {
        const res = await axios.post('/api/admin/reorder-posters', { orderedIds });
        if (res.data.success) {
            showAdminToast('Đã lưu vị trí sắp xếp Poster mới!', 'success');
        }
    } catch (err) {
        showAdminToast('Lỗi lưu vị trí: ' + (err.response?.data?.message || err.message), 'error');
    }
}

function openPosterForm() {
    document.getElementById('posterForm').reset();
    document.getElementById('p_image_url').value = '/images/placeholder.jpg';
    document.getElementById('p_preview').src = '/images/placeholder.jpg';
}

async function uploadPosterFile(input) {
    if (!input.files || !input.files[0]) return;
    const formData = new FormData();
    formData.append('image', input.files[0]);
    
    const btn = input.previousElementSibling;
    const oldHtml = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang nén & tải...';
    
    try {
        const res = await axios.post('/api/upload', formData, {
            headers: { 'Content-Type': 'multipart/form-data' }
        });
        
        if (res.data.success) {
            document.getElementById('p_image_url').value = res.data.url;
            document.getElementById('p_preview').src = res.data.url;
            btn.innerHTML = '<i class="bi bi-check-circle-fill text-success me-1"></i>Đã chọn ảnh';
        }
    } catch (err) {
        showAdminToast('Lỗi tải ảnh: ' + (err.response?.data?.message || err.message), 'error');
        btn.innerHTML = oldHtml;
    } finally {
        btn.disabled = false;
        setTimeout(() => { btn.innerHTML = oldHtml; }, 2000);
    }
}

async function savePoster(e) {
    e.preventDefault();
    const btn = document.getElementById('savePosterBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang lưu...';
    
    try {
        const data = {
            title: document.getElementById('p_title').value,
            image_url: document.getElementById('p_image_url').value
        };
        const res = await axios.post('/admin/posters', data);
        if (res.data.success) {
            showAdminToast('Đã lưu Poster thành công!', 'success');
            setTimeout(() => { location.reload(); }, 800);
        } else {
            showAdminToast(res.data.message || 'Lưu thất bại.', 'error');
        }
    } catch (err) {
        showAdminToast('Lỗi lưu Poster: ' + (err.response?.data?.message || err.message), 'error');
    } finally {
        btn.disabled = false;
        btn.innerHTML = 'UPLOAD VÀ LƯU';
    }
}
</script>

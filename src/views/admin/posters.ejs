<!-- Admin: Quản lý & Upload Poster Hero Trang chủ -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1" style="font-family: 'Inter', sans-serif;">Quản lý Poster Hero Trang Chủ</h4>
        <p class="mb-0 text-muted small">Upload poster mới, thay đổi thứ tự hiển thị slider banner ở đầu trang chủ.</p>
    </div>
    <div>
        <button class="btn btn-primary rounded-pill px-4 py-2.5 fw-bold d-inline-flex align-items-center gap-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#posterModal" onclick="openPosterForm()">
            <i class="bi bi-cloud-arrow-up-fill"></i> Upload Poster Mới
        </button>
    </div>
</div>

<!-- Posters Grid -->
<div class="row g-4 mb-4">
    <% posters.forEach((p, idx) => { %>
    <div class="col-md-6 col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100 bg-white">
            <div class="position-relative" style="height: 220px;">
                <img src="<%= fixImg(p.image_url) %>" class="w-100 h-100 object-fit-cover">
                <div class="position-absolute top-0 start-0 m-3">
                    <span class="badge bg-dark bg-opacity-75 text-white rounded-pill px-3 py-1.5 fw-bold">#<%= idx + 1 %> (Thứ tự: <%= p.sort_order || 0 %>)</span>
                </div>
                <div class="position-absolute top-0 end-0 m-3">
                    <span class="badge <%= p.is_active ? 'bg-success' : 'bg-secondary' %> rounded-pill px-3 py-1.5 fw-bold">
                        <%= p.is_active ? 'Đang hiển thị' : 'Đang ẩn' %>
                    </span>
                </div>
            </div>
            <div class="card-body p-3.5 d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="fw-bold text-dark mb-1"><%= p.title || ('Poster Slide ' + (idx + 1)) %></h6>
                    <small class="text-muted"><%= new Date(p.created_at || Date.now()).toLocaleDateString('vi-VN') %></small>
                </div>
                <form action="/admin/posters/delete" method="POST" onsubmit="return confirm('Bạn có chắc muốn xóa Poster này?');">
                    <input type="hidden" name="id" value="<%= p.id %>">
                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-circle p-2" title="Xóa Poster">
                        <i class="bi bi-trash-fill"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>
    <% }) %>
</div>

<% if (posters.length === 0) { %>
<div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white mb-4">
    <i class="bi bi-images display-3 text-muted opacity-35 mb-3"></i>
    <h5 class="fw-bold text-dark">Chưa có Poster Hero nào do Admin Upload</h5>
    <p class="text-muted small mb-0">Hệ thống đang tự động dùng 5 Poster mặc định. Bạn có thể Upload Poster riêng để thay thế.</p>
</div>
<% } %>

<!-- Upload Modal -->
<div class="modal fade" id="posterModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
            <div class="modal-header bg-primary text-white p-4">
                <h5 class="modal-title fw-bold mb-0"><i class="bi bi-cloud-upload-fill me-2"></i>Upload Poster Hero Mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/admin/posters" method="POST" enctype="multipart/form-data">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Tiêu đề Poster / Ghi chú</label>
                        <input type="text" name="title" class="form-control rounded-3" placeholder="Ví dụ: Banner Sắc Mai Vàng 2026">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Chọn tệp hình ảnh Poster (JPG, PNG)</label>
                        <input type="file" name="image" accept="image/*" class="form-control rounded-3" required>
                        <small class="text-muted">Khuyên dùng hình ảnh chất lượng cao độ phân giải 1920x1080 hoặc tỷ lệ banner poster.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Thứ tự sắp xếp (Số nhỏ xếp trước)</label>
                        <input type="number" name="sort_order" class="form-control rounded-3" value="1">
                    </div>
                </div>
                <div class="modal-footer bg-light p-3 border-0">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">UPLOAD VÀ LƯU</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function openPosterForm() {
    // Reset form fields
}
</script>

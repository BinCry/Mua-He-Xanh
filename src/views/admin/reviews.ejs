<style>
/* Custom style to make tabs look like modern pills */
#communityTabs .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: var(--admin-primary);
    border-radius: 3px;
}
#communityTabs .nav-link {
    transition: all 0.2s ease-in-out;
}
#communityTabs .nav-link:hover {
    color: var(--admin-primary) !important;
}

.slot-builder-row {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 10px 14px;
    transition: all 0.2s ease;
}
.slot-builder-row:hover {
    border-color: #cbd5e1;
    background: #ffffff;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
}
.text-cyan { color: #00f0ff !important; }
</style>

<script>
// --- REVIEWS & SOUNDSCAPES FUNCTIONS ---
function openReviewModalFromBtn(btn) {
    try {
        const rawAttr = btn.getAttribute('data-review');
        const data = JSON.parse(decodeURIComponent(rawAttr));
        viewReviewModal(data.id, data.userName, data.avatar, data.content, data.location, data.images || (data.imgUrl ? [data.imgUrl] : []), data.rating, data.dateStr);
    } catch(e) {
        console.error("Error opening review modal:", e);
        alert("Lỗi hiển thị bài viết: " + e.message);
    }
}

function viewReviewModal(id, userName, avatar, content, location, images, rating, dateStr) {
    const modalEl = document.getElementById('viewReviewModal');
    if (!modalEl) return;

    if (modalEl.parentNode !== document.body) {
        document.body.appendChild(modalEl);
    }

    document.getElementById('modal_review_user').innerText = userName || 'Du khách';
    document.getElementById('modal_review_avatar').src = avatar || '/images/default-avatar.svg';
    document.getElementById('modal_review_meta').innerText = (location ? location + ' • ' : '') + (dateStr || '');
    document.getElementById('modal_review_content').innerText = content || '';
    
    let starsHtml = '';
    const r = parseInt(rating || 5);
    for(let i = 0; i < r; i++) starsHtml += '⭐';
    document.getElementById('modal_review_rating').innerHTML = `<span class="text-warning small">${starsHtml}</span>`;

    const imgWrap = document.getElementById('modal_review_img_wrap');
    const imgEl = document.getElementById('modal_review_img');
    const imgs = Array.isArray(images) ? images.filter(Boolean) : (images ? [images] : []);
    
    if (imgs.length === 1) {
        imgEl.src = imgs[0];
        imgWrap.className = 'text-center rounded-4 overflow-hidden shadow-2xs border bg-black mb-2';
        imgEl.classList.remove('d-none');
        imgWrap.classList.remove('d-none');
    } else if (imgs.length > 1) {
        let gridHtml = '<div class="row g-2 p-2 bg-light rounded-4 border">';
        imgs.forEach(img => {
            gridHtml += `
                <div class="col-6 col-md-4">
                    <div class="rounded-3 overflow-hidden shadow-2xs border bg-white cursor-pointer" style="aspect-ratio: 1/1;">
                        <img src="${img}" class="w-100 h-100" style="object-fit: cover;" onclick="window.open('${img}', '_blank')">
                    </div>
                </div>
            `;
        });
        gridHtml += '</div>';
        imgWrap.className = 'd-block mb-2';
        imgWrap.innerHTML = gridHtml;
        imgWrap.classList.remove('d-none');
    } else {
        imgWrap.classList.add('d-none');
    }

    const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
    modal.show();
}

function deleteReview(id) {
    showAdminConfirm('Bạn có chắc chắn muốn xóa bài đánh giá này?', async () => {
        try {
            const res = await axios.post('/api/admin/delete-review', { id });
            if (res.data.success) {
                const row = document.getElementById('review-row-' + id);
                if (row) {
                    row.style.transition = 'all 0.3s ease';
                    row.style.opacity = '0';
                    setTimeout(() => row.remove(), 300);
                }
                showAdminToast(res.data.message || 'Đã xóa bài đánh giá', 'success');
            } else {
                showAdminToast(res.data.message, 'error');
            }
        } catch (e) { showAdminToast('Lỗi xóa bài đánh giá', 'error'); }
    });
}

async function saveSoundscape(e) {
    e.preventDefault();
    const btn = document.getElementById('saveSoundBtn');
    const oldHtml = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang lưu...';

    const formData = new FormData();
    formData.append('name', document.getElementById('sound_name').value);
    formData.append('mood', document.getElementById('sound_mood').value);
    formData.append('duration_seconds', document.getElementById('sound_duration').value);
    formData.append('audio', document.getElementById('sound_file').files[0]);

    try {
        const res = await axios.post('/api/admin/create-soundscape', formData);

        if (res.data.success) {
            showAdminToast(res.data.message || 'Đã thêm âm thanh thành công', 'success');
            setTimeout(() => location.reload(), 600);
        } else {
            showAdminToast('Lỗi: ' + res.data.message, 'error');
            btn.disabled = false;
            btn.innerHTML = oldHtml;
        }
    } catch (err) {
        showAdminToast('Lỗi khi tải âm thanh: ' + (err.response?.data?.message || err.message), 'error');
        btn.disabled = false;
        btn.innerHTML = oldHtml;
    }
}

function deleteSoundscape(id) {
    showAdminConfirm('Bạn có chắc chắn muốn xóa âm thanh soundscape này?', async () => {
        try {
            const res = await axios.post('/api/admin/delete-soundscape', { id });
            if (res.data.success) {
                const row = document.getElementById('soundscape-row-' + id);
                if (row) {
                    row.style.transition = 'all 0.3s ease';
                    row.style.opacity = '0';
                    setTimeout(() => row.remove(), 300);
                }
                showAdminToast(res.data.message || 'Đã xóa âm thanh thành công', 'success');
            } else {
                showAdminToast('Lỗi: ' + res.data.message, 'error');
            }
        } catch (err) {
            showAdminToast('Lỗi xóa âm thanh', 'error');
        }
    });
}

// --- VIDEO TEMPLATES (BINH LOI STUDIO) BUILDER FUNCTIONS ---
let templateModalInstance = null;

function getTemplateModal() {
    if (!templateModalInstance) {
        const el = document.getElementById('videoTemplateModal');
        if (el) {
            if (el.parentNode !== document.body) document.body.appendChild(el);
            templateModalInstance = bootstrap.Modal.getOrCreateInstance(el);
        }
    }
    return templateModalInstance;
}

function previewCoverFile(input) {
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = e => {
            const preview = document.getElementById('tpl_cover_preview');
            if (preview) preview.src = e.target.result;
        };
        reader.readAsDataURL(input.files[0]);
    }
}

function previewAudioFile(input) {
    if (input.files && input.files[0]) {
        const url = URL.createObjectURL(input.files[0]);
        updateAudioPlayer(url);
    }
}

function updateAudioPlayer(url) {
    const player = document.getElementById('tpl_audio_player');
    if (player && url) {
        player.src = url;
    }
}

function selectSoundscapeForTemplate(sel) {
    if (!sel.value) return;
    document.getElementById('tpl_audio_url').value = sel.value;
    const opt = sel.options[sel.selectedIndex];
    if (opt && opt.getAttribute('data-title')) {
        document.getElementById('tpl_audio_title').value = opt.getAttribute('data-title');
    }
    updateAudioPlayer(sel.value);
}

function onTemplateDurationChange(val) {
    document.getElementById('targetDurationLabel').innerText = `${val}s`;
    autoRecalculateSlots();
}

const slotColors = ['#6366f1', '#10b981', '#f59e0b', '#ec4899', '#06b6d4', '#8b5cf6', '#14b8a6', '#f43f5e'];

function openAddTemplateModal() {
    document.getElementById('videoTemplateForm').reset();
    document.getElementById('tpl_id').value = '';
    document.getElementById('templateModalTitle').innerText = 'Thêm Mẫu Video Bình Lợi Studio';
    document.getElementById('tpl_duration').value = '15';
    document.getElementById('targetDurationLabel').innerText = '15s';
    document.getElementById('tpl_cover_preview').src = '/images/Poster 1.jpg';
    updateAudioPlayer('/audio/peaceful_stream.mp3');
    
    const container = document.getElementById('slotsBuilderContainer');
    container.innerHTML = '';
    
    const defaultSlots = [
        { slot_index: 1, title: 'Cảnh 1: Cổng chào & Đường làng mai', start_time: 0.0, end_time: 3.5, effect: 'kenburns', filter: 'warm', subtitle: 'Lạc vào miền xanh Bình Lợi...' },
        { slot_index: 2, title: 'Cảnh 2: Check-in Vườn Mai vàng', start_time: 3.5, end_time: 7.5, effect: 'pan', filter: 'warm', subtitle: 'Hương mai thoang thoảng bờ kênh thanh mát.' },
        { slot_index: 3, title: 'Cảnh 3: Chèo xuồng ba lá miệt vườn', start_time: 7.5, end_time: 11.0, effect: 'dissolve', filter: 'cool', subtitle: 'Chữa lành từ những điều mộc mạc nhất.' },
        { slot_index: 4, title: 'Cảnh 4: Ẩm thực & Khoảnh khắc kết', start_time: 11.0, end_time: 15.0, effect: 'flash', filter: 'vintage', subtitle: 'Nghe Bình Lợi theo cách của bạn ✨' }
    ];
    
    defaultSlots.forEach(s => addSlotRow(s));
    updateSlotDurationSum();

    goToTemplateStep(1);
    getTemplateModal().show();
}

function openEditTemplateModal(encodedData) {
    try {
        const tpl = JSON.parse(decodeURIComponent(encodedData));
        document.getElementById('videoTemplateForm').reset();
        document.getElementById('tpl_id').value = tpl.id || '';
        document.getElementById('templateModalTitle').innerText = 'Chỉnh Sửa Mẫu: ' + tpl.title;
        document.getElementById('tpl_title').value = tpl.title || '';
        document.getElementById('tpl_description').value = tpl.description || '';
        document.getElementById('tpl_duration').value = tpl.duration_seconds || 15;
        document.getElementById('targetDurationLabel').innerText = `${tpl.duration_seconds || 15}s`;
        document.getElementById('tpl_sort_order').value = tpl.sort_order || 1;
        document.getElementById('tpl_cover_url').value = tpl.cover_image || '';
        document.getElementById('tpl_cover_preview').src = tpl.cover_image || '/images/Poster 1.jpg';
        document.getElementById('tpl_audio_title').value = tpl.audio_title || 'Nhạc nền Bình Lợi';
        document.getElementById('tpl_audio_url').value = tpl.audio_url || '';
        updateAudioPlayer(tpl.audio_url || '');

        const container = document.getElementById('slotsBuilderContainer');
        container.innerHTML = '';
        
        const slots = Array.isArray(tpl.slots) ? tpl.slots : [];
        if (slots.length > 0) {
            slots.forEach(s => addSlotRow(s));
        } else {
            autoRecalculateSlots();
        }

        updateSlotDurationSum();
        goToTemplateStep(1);
        getTemplateModal().show();
    } catch(e) {
        console.error("Edit template error:", e);
        showAdminToast('Lỗi đọc dữ liệu mẫu video: ' + e.message, 'error');
    }
}

function goToTemplateStep(stepNum) {
    const tabEl = document.getElementById(`step${stepNum}-tab`);
    if (tabEl && window.bootstrap && window.bootstrap.Tab) {
        const tabInstance = window.bootstrap.Tab.getOrCreateInstance(tabEl);
        tabInstance.show();
    }
}

function addSlotRow(slotData = null) {
    const container = document.getElementById('slotsBuilderContainer');
    const rowIdx = container.querySelectorAll('.slot-builder-row').length + 1;
    const color = slotColors[(rowIdx - 1) % slotColors.length];
    
    const title = slotData?.title || slotData?.scene_name || `Cảnh ${rowIdx}: Phân đoạn mới`;
    const start = slotData?.start_time !== undefined ? parseFloat(slotData.start_time) : 0.0;
    const end = slotData?.end_time !== undefined ? parseFloat(slotData.end_time) : 3.5;
    const subtitle = slotData?.subtitle || `Trải nghiệm Bình Lợi #${rowIdx}`;
    const effect = slotData?.effect || 'kenburns';
    const filter = slotData?.filter || 'none';
    const duration = Math.max(0.5, (end - start) > 0 ? (end - start) : 3.5).toFixed(1);

    const row = document.createElement('div');
    row.className = 'slot-builder-row card border rounded-3 p-3 mb-2 shadow-sm bg-white';
    row.style.borderLeft = `5px solid ${color}`;
    row.innerHTML = `
        <div class="d-flex align-items-center justify-content-between mb-2 pb-2 border-bottom">
            <div class="d-flex align-items-center gap-2 flex-grow-1 min-w-0 me-2">
                <span class="badge rounded-pill px-2.5 py-1 fw-bold slot-badge-idx text-white" style="background: ${color}; font-size: 0.74rem;">Cảnh #${rowIdx}</span>
                <input type="text" class="form-control form-control-sm admin-input slot-title-input py-1 px-2.5 fw-bold flex-grow-1" value="${title}" placeholder="Tên phân cảnh (vd: Check-in vườn mai)..." style="font-size: 0.84rem;">
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-light text-dark border font-monospace slot-time-range-badge" style="font-size: 0.72rem;">${start}s → ${end}s (${duration}s)</span>
                <button type="button" class="btn btn-outline-danger btn-sm p-0 rounded-circle d-flex align-items-center justify-content-center" style="width: 26px; height: 26px;" onclick="removeSlotRow(this)" title="Xóa phân cảnh này">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>

        <div class="row g-2 align-items-center">
            <!-- Duration Stepper -->
            <div class="col-12 col-md-4">
                <div class="p-1.5 rounded-2 bg-light border d-flex align-items-center justify-content-between">
                    <span class="x-small fw-bold text-muted"><i class="bi bi-stopwatch text-danger me-1"></i>Thời lượng:</span>
                    <div class="d-flex align-items-center gap-1">
                        <button type="button" class="btn btn-sm btn-outline-secondary p-0 rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width:24px; height:24px;" onclick="adjustSlotDuration(this, -0.5)">-</button>
                        <input type="number" step="0.1" min="0.5" max="30" class="form-control form-control-sm admin-input slot-duration-input font-monospace text-center p-0 fw-bold text-primary" style="width: 50px; height: 26px;" value="${duration}" oninput="recalculateSequentialSlots()">
                        <span class="x-small fw-bold text-muted me-1">s</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary p-0 rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width:24px; height:24px;" onclick="adjustSlotDuration(this, 0.5)">+</button>
                    </div>
                </div>
                <!-- Hidden inputs for start_time & end_time for backward compatibility with saveVideoTemplate -->
                <input type="hidden" class="slot-start-input" value="${start}">
                <input type="hidden" class="slot-end-input" value="${end}">
            </div>

            <!-- Effect Dropdown -->
            <div class="col-6 col-md-4">
                <select class="form-select form-select-sm admin-input slot-effect-select py-1.5 x-small fw-semibold">
                    <option value="kenburns" ${effect === 'kenburns' ? 'selected' : ''}>🎬 Zoom In (Ken Burns)</option>
                    <option value="pan" ${effect === 'pan' ? 'selected' : ''}>↔ Pan Lướt Ngang</option>
                    <option value="dissolve" ${effect === 'dissolve' ? 'selected' : ''}>⧗ Hòa Tan (Dissolve)</option>
                    <option value="flash" ${effect === 'flash' ? 'selected' : ''}>⚡ Flash Sáng (TikTok)</option>
                </select>
            </div>

            <!-- Filter Dropdown -->
            <div class="col-6 col-md-4">
                <select class="form-select form-select-sm admin-input slot-filter-select py-1.5 x-small fw-semibold">
                    <option value="none" ${filter === 'none' ? 'selected' : ''}>🌿 Gốc (Natural)</option>
                    <option value="warm" ${filter === 'warm' ? 'selected' : ''}>☀️ Nắng Ấm</option>
                    <option value="cool" ${filter === 'cool' ? 'selected' : ''}>🎋 Rừng Trúc</option>
                    <option value="vintage" ${filter === 'vintage' ? 'selected' : ''}>🎞 Phim Cổ</option>
                    <option value="grayscale" ${filter === 'grayscale' ? 'selected' : ''}>🖤 Noir (Đen Trắng)</option>
                </select>
            </div>

            <!-- Subtitle Input -->
            <div class="col-12 mt-1">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light text-muted x-small py-0.5"><i class="bi bi-chat-left-quote me-1"></i>Lời dẫn:</span>
                    <input type="text" class="form-control form-control-sm admin-input slot-sub-input py-1 px-2.5 x-small" value="${subtitle}" placeholder="Gợi ý phụ đề hiển thị cho cảnh này...">
                </div>
            </div>
        </div>
    `;
    container.appendChild(row);
    recalculateSequentialSlots();
}

function adjustSlotDuration(btn, delta) {
    const row = btn.closest('.slot-builder-row');
    if (!row) return;
    const durInput = row.querySelector('.slot-duration-input');
    if (!durInput) return;
    let cur = parseFloat(durInput.value) || 3.5;
    cur = Math.max(0.5, Math.min(30.0, +(cur + delta).toFixed(1)));
    durInput.value = cur.toFixed(1);
    recalculateSequentialSlots();
}

function removeSlotRow(btn) {
    const row = btn.closest('.slot-builder-row');
    if (row) {
        row.remove();
        const rows = document.querySelectorAll('#slotsBuilderContainer .slot-builder-row');
        rows.forEach((r, idx) => {
            const color = slotColors[idx % slotColors.length];
            r.style.borderLeft = `5px solid ${color}`;
            const badge = r.querySelector('.slot-badge-idx');
            if (badge) {
                badge.innerText = `Cảnh #${idx + 1}`;
                badge.style.background = color;
            }
        });
        recalculateSequentialSlots();
    }
}

function recalculateSequentialSlots() {
    const rows = document.querySelectorAll('#slotsBuilderContainer .slot-builder-row');
    let currentStart = 0.0;

    rows.forEach((r, idx) => {
        const durInput = r.querySelector('.slot-duration-input');
        let dur = durInput ? parseFloat(durInput.value) || 3.5 : 3.5;
        dur = Math.max(0.5, dur);

        const startInput = r.querySelector('.slot-start-input');
        const endInput = r.querySelector('.slot-end-input');
        const timeBadge = r.querySelector('.slot-time-range-badge');

        const st = +currentStart.toFixed(1);
        const et = +(currentStart + dur).toFixed(1);

        if (startInput) startInput.value = st;
        if (endInput) endInput.value = et;
        if (timeBadge) timeBadge.innerText = `${st}s → ${et}s (${dur.toFixed(1)}s)`;

        currentStart = et;
    });

    updateSlotDurationSum();
}

function autoRecalculateSlots() {
    const dur = parseFloat(document.getElementById('tpl_duration').value || '15');
    const rows = document.querySelectorAll('#slotsBuilderContainer .slot-builder-row');
    const count = rows.length || (dur === 30 ? 5 : 4);

    if (rows.length === 0) {
        for (let i = 0; i < count; i++) addSlotRow();
    }

    const currentRows = document.querySelectorAll('#slotsBuilderContainer .slot-builder-row');
    const segDur = +(dur / currentRows.length).toFixed(1);

    currentRows.forEach((r, idx) => {
        const durInput = r.querySelector('.slot-duration-input');
        const thisDur = (idx === currentRows.length - 1) 
            ? +(dur - (idx * segDur)).toFixed(1) 
            : segDur;
        if (durInput) durInput.value = Math.max(0.5, thisDur).toFixed(1);
    });

    recalculateSequentialSlots();
}

function updateSlotDurationSum() {
    const rows = document.querySelectorAll('#slotsBuilderContainer .slot-builder-row');
    const targetDur = parseFloat(document.getElementById('tpl_duration').value || '15');
    let maxEnd = 0;

    const progressContainer = document.getElementById('visualSlotsProgressBar');
    let progressHtml = '';

    rows.forEach((r, idx) => {
        const st = parseFloat(r.querySelector('.slot-start-input')?.value || 0);
        const et = parseFloat(r.querySelector('.slot-end-input')?.value || 0);
        const title = r.querySelector('.slot-title-input')?.value || `Cảnh ${idx + 1}`;
        const diff = Math.max(0, et - st);
        if (et > maxEnd) maxEnd = et;

        const color = slotColors[idx % slotColors.length];
        const widthPct = targetDur > 0 ? Math.max(8, (diff / targetDur) * 100) : 25;

        progressHtml += `
            <div class="rounded-1 text-white fw-bold d-flex align-items-center justify-content-center text-truncate px-1"
                 style="width: ${widthPct}%; background: ${color}; font-size: 0.65rem; height: 100%; transition: all 0.2s;"
                 title="${title}: ${st}s - ${et}s (${diff.toFixed(1)}s)">
                #${idx + 1} (${diff.toFixed(1)}s)
            </div>
        `;
    });

    if (progressContainer) progressContainer.innerHTML = progressHtml;

    const label = document.getElementById('slotsDurationSumLabel');
    if (label) label.innerText = `${maxEnd.toFixed(1)}s`;

    const countLabel = document.getElementById('slotsCountLabel');
    if (countLabel) countLabel.innerText = `${rows.length} phân cảnh`;

    const tab2Count = document.getElementById('tab2SlotsCount');
    if (tab2Count) tab2Count.innerText = `${rows.length} cảnh`;

    const badge = document.getElementById('slotsSumBadge');
    if (badge) {
        const isMatch = Math.abs(maxEnd - targetDur) < 0.2;
        badge.className = isMatch ? 'badge bg-success font-monospace' : 'badge bg-warning text-dark font-monospace';
        badge.innerText = isMatch ? `✓ Khớp ${maxEnd.toFixed(1)}s / ${targetDur}s` : `⚠ Lệch: ${maxEnd.toFixed(1)}s / ${targetDur}s`;
    }
}

async function saveVideoTemplate(e) {
    e.preventDefault();
    const btn = document.getElementById('btnSaveTemplate');
    const oldHtml = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang lưu mẫu...';

    // Collect slots
    const slotRows = document.querySelectorAll('#slotsBuilderContainer .slot-builder-row');
    const slots = [];
    slotRows.forEach((r, idx) => {
        slots.push({
            slot_index: idx + 1,
            title: r.querySelector('.slot-title-input')?.value || `Cảnh ${idx + 1}`,
            start_time: parseFloat(r.querySelector('.slot-start-input')?.value || 0),
            end_time: parseFloat(r.querySelector('.slot-end-input')?.value || 0),
            effect: r.querySelector('.slot-effect-select')?.value || 'kenburns',
            filter: r.querySelector('.slot-filter-select')?.value || 'none',
            subtitle: r.querySelector('.slot-sub-input')?.value || ''
        });
    });

    const formData = new FormData();
    const id = document.getElementById('tpl_id').value;
    if (id) formData.append('id', id);

    formData.append('title', document.getElementById('tpl_title').value);
    formData.append('description', document.getElementById('tpl_description').value);
    formData.append('duration_seconds', document.getElementById('tpl_duration').value);
    formData.append('sort_order', document.getElementById('tpl_sort_order').value || '1');
    formData.append('audio_title', document.getElementById('tpl_audio_title').value || 'Nhạc nền Bình Lợi');
    formData.append('audio_url', document.getElementById('tpl_audio_url').value || '');
    formData.append('cover_image', document.getElementById('tpl_cover_url').value || '');
    formData.append('slots', JSON.stringify(slots));

    const coverFile = document.getElementById('tpl_cover_file').files[0];
    if (coverFile) formData.append('cover_image_file', coverFile);

    const audioFile = document.getElementById('tpl_audio_file').files[0];
    if (audioFile) formData.append('audio_file', audioFile);

    try {
        const url = id ? '/api/admin/update-video-template' : '/api/admin/create-video-template';
        const res = await axios.post(url, formData);

        if (res.data.success) {
            showAdminToast(res.data.message || 'Lưu mẫu video thành công!', 'success');
            setTimeout(() => location.reload(), 600);
        } else {
            showAdminToast('Lỗi: ' + res.data.message, 'error');
            btn.disabled = false;
            btn.innerHTML = oldHtml;
        }
    } catch(err) {
        showAdminToast('Lỗi lưu mẫu video: ' + (err.response?.data?.message || err.message), 'error');
        btn.disabled = false;
        btn.innerHTML = oldHtml;
    }
}

function deleteVideoTemplate(id) {
    showAdminConfirm('Bạn có chắc chắn muốn xóa mẫu video này?', async () => {
        try {
            const res = await axios.post('/api/admin/delete-video-template', { id });
            if (res.data.success) {
                const card = document.getElementById('template-card-' + id);
                if (card) {
                    card.style.transition = 'all 0.3s ease';
                    card.style.opacity = '0';
                    setTimeout(() => card.remove(), 300);
                }
                showAdminToast(res.data.message || 'Đã xóa mẫu video!', 'success');
            } else {
                showAdminToast(res.data.message, 'error');
            }
        } catch(e) {
            showAdminToast('Lỗi xóa mẫu video', 'error');
        }
    });
}

function toggleTemplateStatus(id) {
    axios.post('/api/admin/toggle-video-template', { id }).then(res => {
        if (res.data.success) {
            showAdminToast(res.data.message || 'Đã cập nhật trạng thái', 'success');
            setTimeout(() => location.reload(), 500);
        } else {
            showAdminToast(res.data.message, 'error');
        }
    }).catch(e => showAdminToast('Lỗi đổi trạng thái', 'error'));
}
</script>

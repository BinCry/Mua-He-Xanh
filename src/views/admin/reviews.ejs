<!-- Admin: Reviews & Soundscape Management -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1" style="font-family: 'Inter', sans-serif;">Quản lý Cộng đồng & Soundscape</h4>
        <p class="mb-0" style="color: var(--admin-muted); font-size: 0.85rem;">Duyệt đánh giá từ du khách và quản lý thư viện âm thanh chữa lành.</p>
    </div>
</div>

<!-- Tabs -->
<ul class="nav nav-tabs mb-4 border-bottom border-secondary border-opacity-25" id="communityTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active fw-bold text-dark border-0 bg-transparent position-relative pb-2 me-3" id="reviews-tab" data-bs-toggle="tab" data-bs-target="#reviews-pane" type="button" role="tab" style="outline: none;">
            <i class="bi bi-chat-left-text me-2"></i>Đánh giá từ Du khách
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold text-muted border-0 bg-transparent position-relative pb-2" id="soundscapes-tab" data-bs-toggle="tab" data-bs-target="#soundscapes-pane" type="button" role="tab" style="outline: none;">
            <i class="bi bi-music-note-beamed me-2"></i>Âm thanh Soundscape
        </button>
    </li>
</ul>

<div class="tab-content" id="communityTabsContent">
    <!-- Reviews Tab Pane -->
    <div class="tab-pane fade show active" id="reviews-pane" role="tabpanel" tabindex="0">
        <!-- Filter by Destination -->
        <div class="mb-4 d-flex gap-2 flex-wrap">
            <a href="/admin/reviews" class="btn btn-sm <%= !currentDestination ? 'btn-primary' : 'btn-outline-secondary' %> rounded-pill px-3">Tất cả</a>
            <% destinations.forEach(d => { %>
                <a href="/admin/reviews?destination=<%= d.id %>" class="btn btn-sm <%= currentDestination === d.id ? 'btn-primary' : 'btn-outline-secondary' %> rounded-pill px-3"><%= d.name %></a>
            <% }) %>
        </div>

        <!-- Reviews Table -->
        <div class="admin-table">
            <table class="table table-borderless mb-0">
                <thead>
                    <tr>
                        <th>Người dùng</th>
                        <th>Nội dung</th>
                        <th>Địa điểm</th>
                        <th>Đánh giá</th>
                        <th>Likes</th>
                        <th>Ngày đăng</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    <% reviews.forEach(r => { 
                        let imgs = [];
                        try {
                            if (r.images) {
                                imgs = typeof r.images === 'string' ? JSON.parse(r.images) : r.images;
                            }
                        } catch(e) {}
                    %>
                    <tr id="review-row-<%= r.id %>">
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <img src="<%= r.avatar || '/images/default-avatar.png' %>" class="rounded-circle" style="width: 32px; height: 32px; object-fit: cover;">
                                <span class="small fw-bold"><%= r.full_name %></span>
                            </div>
                        </td>
                        <td style="max-width: 300px;">
                            <p class="small mb-1 text-truncate" style="max-width: 280px;" title="<%= r.content %>"><%= r.content %></p>
                            <% if (imgs && imgs.length > 0) { 
                                const modalData = {
                                    id: r.id,
                                    userName: r.full_name || 'Du khách',
                                    avatar: r.avatar || '/images/default-avatar.png',
                                    content: r.content || '',
                                    location: r.destination_name || r.location_name || '',
                                    imgUrl: fixImg(imgs[0]),
                                    images: imgs.map(i => fixImg(i)),
                                    rating: r.rating || 5,
                                    dateStr: new Date(r.created_at).toLocaleDateString('vi-VN')
                                };
                                const encodedData = encodeURIComponent(JSON.stringify(modalData));
                            %>
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-0.5 x-small fw-bold border-0 bg-primary bg-opacity-10 text-primary btn-view-review-modal" 
                                        data-review="<%= encodedData %>"
                                        onclick="openReviewModalFromBtn(this)">
                                    <i class="bi bi-images me-1"></i>Xem bài viết & ảnh (<%= imgs.length %> ảnh)
                                </button>
                            <% } %>
                        </td>
                        <td class="small"><%= r.destination_name || r.location_name || '-' %></td>
                        <td>
                            <span class="text-warning small">
                                <% for(let s = 0; s < (r.rating || 5); s++) { %>⭐<% } %>
                            </span>
                        </td>
                        <td class="small"><%= r.likes_count || 0 %></td>
                        <td class="small" style="color: var(--admin-muted);"><%= new Date(r.created_at).toLocaleDateString('vi-VN') %></td>
                        <td>
                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="deleteReview('<%= r.id %>')">
                                <i class="bi bi-trash"></i> Xóa
                            </button>
                        </td>
                    </tr>
                    <% }) %>
                    <% if (reviews.length === 0) { %>
                    <tr><td colspan="7" class="text-center py-5 text-muted">Chưa có bài đánh giá nào.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Soundscapes Tab Pane -->
    <div class="tab-pane fade" id="soundscapes-pane" role="tabpanel" tabindex="0">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h5 class="fw-bold mb-0">Thư viện Âm thanh Soundscape</h5>
            <button class="btn btn-primary btn-sm rounded-pill px-3 fw-bold" data-bs-toggle="modal" data-bs-target="#soundscapeModal">
                <i class="bi bi-plus-lg me-1"></i>Thêm âm thanh mẫu
            </button>
        </div>

        <!-- Soundscapes Table -->
        <div class="admin-table">
            <table class="table table-borderless mb-0">
                <thead>
                    <tr>
                        <th>Tên âm thanh</th>
                        <th>Chủ đề (Mood)</th>
                        <th>Thời lượng</th>
                        <th>Nghe thử</th>
                        <th>Ngày tạo</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    <% soundscapes.forEach(s => { %>
                    <tr id="soundscape-row-<%= s.id %>">
                        <td class="fw-bold small"><%= s.name %></td>
                        <td>
                            <% if (s.mood === 'calm') { %>
                                <span class="badge bg-success bg-opacity-15 text-success rounded-pill px-3 py-1">Calm (Yên bình)</span>
                            <% } else if (s.mood === 'wild') { %>
                                <span class="badge bg-warning bg-opacity-15 text-warning rounded-pill px-3 py-1">Wild (Sống động)</span>
                            <% } else { %>
                                <span class="badge bg-dark bg-opacity-15 text-dark rounded-pill px-3 py-1">Night (Đêm tĩnh lặng)</span>
                            <% } %>
                        </td>
                        <td class="small"><%= s.duration_seconds || 0 %> giây</td>
                        <td>
                            <audio src="<%= s.audio_url %>" controls class="my-audio-player" style="max-height: 28px; width: 220px;"></audio>
                        </td>
                        <td class="small" style="color: var(--admin-muted);"><%= new Date(s.created_at).toLocaleDateString('vi-VN') %></td>
                        <td>
                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="deleteSoundscape('<%= s.id %>')">
                                <i class="bi bi-trash"></i> Xóa
                            </button>
                        </td>
                    </tr>
                    <% }) %>
                    <% if (soundscapes.length === 0) { %>
                    <tr><td colspan="6" class="text-center py-5 text-muted">Chưa có âm thanh soundscape nào.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add Soundscape Modal -->
<div class="modal fade" id="soundscapeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4" style="background: var(--admin-surface);">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Thêm Âm Thanh Soundscape</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="soundscapeForm" onsubmit="saveSoundscape(event)">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Tên âm thanh</label>
                        <input type="text" class="form-control admin-input" id="sound_name" name="name" required placeholder="Ví dụ: Tiếng Rừng Tràm Xào Xạc">
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Mood (Chủ đề cảm xúc)</label>
                        <select class="form-select admin-input" id="sound_mood" name="mood" required>
                            <option value="calm">Calm - Thư giãn, nhẹ nhàng</option>
                            <option value="wild">Wild - Sôi động, thiên nhiên hoang dã</option>
                            <option value="night">Night - Huyền bí, yên bình ban đêm</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Thời lượng (giây)</label>
                        <input type="number" class="form-control admin-input" id="sound_duration" name="duration_seconds" value="30" min="1" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Tệp âm thanh (MP3/WAV)</label>
                        <input type="file" class="form-control admin-input" id="sound_file" name="audio" accept="audio/*" required>
                        <div class="form-text small">Giới hạn tệp tối đa 25MB.</div>
                    </div>
                    <div class="modal-footer border-0 px-0 pb-0">
                        <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold" id="saveSoundBtn">Lưu lại</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
<!-- Review Detail Modal Popup -->
<div class="modal fade" id="viewReviewModal" tabindex="-1" aria-hidden="true" style="z-index: 1060 !important;">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden" style="background: var(--admin-surface, #ffffff);">
            <div class="modal-header border-bottom border-secondary border-opacity-10 p-3 px-4" style="background: linear-gradient(135deg, #922724 0%, #b83330 100%);">
                <h6 class="modal-title fw-bold text-white mb-0"><i class="bi bi-card-image me-2"></i>Chi Tiết Bài Đăng Cộng Đồng</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <img id="modal_review_avatar" src="/images/default-avatar.png" class="rounded-circle shadow-sm" style="width: 46px; height: 46px; object-fit: cover;">
                    <div>
                        <h6 class="fw-bold mb-0" id="modal_review_user" style="color: var(--admin-text);">---</h6>
                        <small class="text-muted" style="font-size: 0.78rem;" id="modal_review_meta">---</small>
                    </div>
                    <div class="ms-auto" id="modal_review_rating"></div>
                </div>
                
                <p class="p-3 bg-light rounded-3 border text-dark mb-3" id="modal_review_content" style="font-size: 0.95rem; line-height: 1.6; white-space: pre-wrap;"></p>

                <div id="modal_review_img_wrap" class="text-center rounded-4 overflow-hidden shadow-2xs border bg-black d-none">
                    <img id="modal_review_img" src="" class="w-100" style="max-height: 480px; object-fit: contain;">
                </div>
            </div>
            <div class="modal-footer border-top border-secondary border-opacity-10 p-3">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<style>
/* Custom style to make tabs look like modern pills */
#communityTabs .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: var(--admin-primary);
    border-radius: 3px;
}
#communityTabs .nav-link {
    transition: all 0.2s ease-in-out;
}
#communityTabs .nav-link:hover {
    color: var(--admin-primary) !important;
}
</style>

<script>
function openReviewModalFromBtn(btn) {
    try {
        const rawAttr = btn.getAttribute('data-review');
        const data = JSON.parse(decodeURIComponent(rawAttr));
        viewReviewModal(data.id, data.userName, data.avatar, data.content, data.location, data.images || (data.imgUrl ? [data.imgUrl] : []), data.rating, data.dateStr);
    } catch(e) {
        console.error("Error opening review modal:", e);
        alert("Lỗi hiển thị bài viết: " + e.message);
    }
}

function viewReviewModal(id, userName, avatar, content, location, images, rating, dateStr) {
    const modalEl = document.getElementById('viewReviewModal');
    if (!modalEl) return;

    if (modalEl.parentNode !== document.body) {
        document.body.appendChild(modalEl);
    }

    document.getElementById('modal_review_user').innerText = userName || 'Du khách';
    document.getElementById('modal_review_avatar').src = avatar || '/images/default-avatar.png';
    document.getElementById('modal_review_meta').innerText = (location ? location + ' • ' : '') + (dateStr || '');
    document.getElementById('modal_review_content').innerText = content || '';
    
    let starsHtml = '';
    const r = parseInt(rating || 5);
    for(let i = 0; i < r; i++) starsHtml += '⭐';
    document.getElementById('modal_review_rating').innerHTML = `<span class="text-warning small">${starsHtml}</span>`;

    const imgWrap = document.getElementById('modal_review_img_wrap');
    const imgEl = document.getElementById('modal_review_img');
    const imgs = Array.isArray(images) ? images.filter(Boolean) : (images ? [images] : []);
    
    if (imgs.length === 1) {
        imgEl.src = imgs[0];
        imgWrap.className = 'text-center rounded-4 overflow-hidden shadow-2xs border bg-black mb-2';
        imgEl.classList.remove('d-none');
        imgWrap.classList.remove('d-none');
    } else if (imgs.length > 1) {
        let gridHtml = '<div class="row g-2 p-2 bg-light rounded-4 border">';
        imgs.forEach(img => {
            gridHtml += `
                <div class="col-6 col-md-4">
                    <div class="rounded-3 overflow-hidden shadow-2xs border bg-white cursor-pointer" style="aspect-ratio: 1/1;">
                        <img src="${img}" class="w-100 h-100" style="object-fit: cover;" onclick="window.open('${img}', '_blank')">
                    </div>
                </div>
            `;
        });
        gridHtml += '</div>';
        imgWrap.className = 'd-block mb-2';
        imgWrap.innerHTML = gridHtml;
        imgWrap.classList.remove('d-none');
    } else {
        imgWrap.classList.add('d-none');
    }

    const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
    modal.show();
}

document.addEventListener('DOMContentLoaded', () => {
    const modalEl = document.getElementById('viewReviewModal');
    if (modalEl && modalEl.parentNode !== document.body) {
        document.body.appendChild(modalEl);
    }
});
function deleteReview(id) {
    showAdminConfirm('Bạn có chắc chắn muốn xóa bài đánh giá này?', async () => {
        try {
            const res = await axios.post('/api/admin/delete-review', { id });
            if (res.data.success) {
                const row = document.getElementById('review-row-' + id);
                if (row) {
                    row.style.transition = 'all 0.3s ease';
                    row.style.opacity = '0';
                    setTimeout(() => row.remove(), 300);
                }
                showAdminToast(res.data.message || 'Đã xóa bài đánh giá', 'success');
            } else {
                showAdminToast(res.data.message, 'error');
            }
        } catch (e) { showAdminToast('Lỗi xóa bài đánh giá', 'error'); }
    });
}

async function saveSoundscape(e) {
    e.preventDefault();
    const btn = document.getElementById('saveSoundBtn');
    const oldHtml = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang lưu...';

    const formData = new FormData();
    formData.append('name', document.getElementById('sound_name').value);
    formData.append('mood', document.getElementById('sound_mood').value);
    formData.append('duration_seconds', document.getElementById('sound_duration').value);
    formData.append('audio', document.getElementById('sound_file').files[0]);

    try {
        const res = await axios.post('/api/admin/create-soundscape', formData);

        if (res.data.success) {
            showAdminToast(res.data.message || 'Đã thêm âm thanh thành công', 'success');
            setTimeout(() => location.reload(), 600);
        } else {
            showAdminToast('Lỗi: ' + res.data.message, 'error');
            btn.disabled = false;
            btn.innerHTML = oldHtml;
        }
    } catch (err) {
        showAdminToast('Lỗi khi tải âm thanh: ' + (err.response?.data?.message || err.message), 'error');
        btn.disabled = false;
        btn.innerHTML = oldHtml;
    }
}

function deleteSoundscape(id) {
    showAdminConfirm('Bạn có chắc chắn muốn xóa âm thanh soundscape này?', async () => {
        try {
            const res = await axios.post('/api/admin/delete-soundscape', { id });
            if (res.data.success) {
                const row = document.getElementById('soundscape-row-' + id);
                if (row) {
                    row.style.transition = 'all 0.3s ease';
                    row.style.opacity = '0';
                    setTimeout(() => row.remove(), 300);
                }
                showAdminToast(res.data.message || 'Đã xóa âm thanh thành công', 'success');
            } else {
                showAdminToast('Lỗi: ' + res.data.message, 'error');
            }
        } catch (err) {
            showAdminToast('Lỗi xóa âm thanh', 'error');
        }
    });
}
</script>


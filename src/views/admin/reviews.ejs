<!-- Admin: Reviews, Soundscape & Video Template Management -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1" style="font-family: 'Inter', sans-serif;">Quản lý Cộng đồng & Bình Lợi Studio</h4>
        <p class="mb-0" style="color: var(--admin-muted); font-size: 0.85rem;">Duyệt đánh giá, quản lý thư viện âm thanh và tạo mẫu video Bình Lợi Studio cho du khách.</p>
    </div>
</div>

<!-- Tabs -->
<ul class="nav nav-tabs mb-4 border-bottom border-secondary border-opacity-25" id="communityTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active fw-bold text-dark border-0 bg-transparent position-relative pb-2 me-3" id="reviews-tab" data-bs-toggle="tab" data-bs-target="#reviews-pane" type="button" role="tab" style="outline: none;">
            <i class="bi bi-chat-left-text me-2"></i>Đánh giá từ Du khách
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold text-muted border-0 bg-transparent position-relative pb-2 me-3" id="soundscapes-tab" data-bs-toggle="tab" data-bs-target="#soundscapes-pane" type="button" role="tab" style="outline: none;">
            <i class="bi bi-music-note-beamed me-2"></i>Âm thanh Soundscape
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold text-muted border-0 bg-transparent position-relative pb-2" id="templates-tab" data-bs-toggle="tab" data-bs-target="#templates-pane" type="button" role="tab" style="outline: none;">
            <i class="bi bi-camera-reels-fill me-2 text-danger"></i>Mẫu Video Bình Lợi Studio
        </button>
    </li>
</ul>

<div class="tab-content" id="communityTabsContent">
    <!-- 1. Reviews Tab Pane -->
    <div class="tab-pane fade show active" id="reviews-pane" role="tabpanel" tabindex="0">
        <!-- Filter by Destination -->
        <div class="mb-4 d-flex gap-2 flex-wrap">
            <a href="/admin/reviews" class="btn btn-sm <%= !currentDestination ? 'btn-primary' : 'btn-outline-secondary' %> rounded-pill px-3">Tất cả</a>
            <% destinations.forEach(d => { %>
                <a href="/admin/reviews?destination=<%= d.id %>" class="btn btn-sm <%= currentDestination === d.id ? 'btn-primary' : 'btn-outline-secondary' %> rounded-pill px-3"><%= d.name %></a>
            <% }) %>
        </div>

        <!-- Reviews Table -->
        <div class="admin-table">
            <table class="table table-borderless mb-0">
                <thead>
                    <tr>
                        <th>Người dùng</th>
                        <th>Nội dung</th>
                        <th>Địa điểm</th>
                        <th>Đánh giá</th>
                        <th>Likes</th>
                        <th>Ngày đăng</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    <% reviews.forEach(r => { 
                        let imgs = [];
                        try {
                            if (r.images) {
                                imgs = typeof r.images === 'string' ? JSON.parse(r.images) : r.images;
                            }
                        } catch(e) {}
                    %>
                    <tr id="review-row-<%= r.id %>">
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <img src="<%= r.avatar || '/images/default-avatar.svg' %>" class="rounded-circle" style="width: 32px; height: 32px; object-fit: cover;">
                                <span class="small fw-bold"><%= r.full_name %></span>
                            </div>
                        </td>
                        <td style="max-width: 300px;">
                            <p class="small mb-1 text-truncate" style="max-width: 280px;" title="<%= r.content %>"><%= r.content %></p>
                            <% if (imgs && imgs.length > 0) { 
                                const modalData = {
                                    id: r.id,
                                    userName: r.full_name || 'Du khách',
                                    avatar: r.avatar || '/images/default-avatar.svg',
                                    content: r.content || '',
                                    location: r.destination_name || r.location_name || '',
                                    imgUrl: fixImg(imgs[0]),
                                    images: imgs.map(i => fixImg(i)),
                                    rating: r.rating || 5,
                                    dateStr: new Date(r.created_at).toLocaleDateString('vi-VN')
                                };
                                const encodedData = encodeURIComponent(JSON.stringify(modalData));
                            %>
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-0.5 x-small fw-bold border-0 bg-primary bg-opacity-10 text-primary btn-view-review-modal" 
                                        data-review="<%= encodedData %>"
                                        onclick="openReviewModalFromBtn(this)">
                                    <i class="bi bi-images me-1"></i>Xem bài viết & ảnh (<%= imgs.length %> ảnh)
                                </button>
                            <% } %>
                        </td>
                        <td class="small"><%= r.destination_name || r.location_name || '-' %></td>
                        <td>
                            <span class="text-warning small">
                                <% for(let s = 0; s < (r.rating || 5); s++) { %>⭐<% } %>
                            </span>
                        </td>
                        <td class="small"><%= r.likes_count || 0 %></td>
                        <td class="small" style="color: var(--admin-muted);"><%= new Date(r.created_at).toLocaleDateString('vi-VN') %></td>
                        <td>
                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="deleteReview('<%= r.id %>')">
                                <i class="bi bi-trash"></i> Xóa
                            </button>
                        </td>
                    </tr>
                    <% }) %>
                    <% if (reviews.length === 0) { %>
                    <tr><td colspan="7" class="text-center py-5 text-muted">Chưa có bài đánh giá nào.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- 2. Soundscapes Tab Pane -->
    <div class="tab-pane fade" id="soundscapes-pane" role="tabpanel" tabindex="0">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h5 class="fw-bold mb-0">Thư viện Âm thanh Soundscape</h5>
            <button class="btn btn-primary btn-sm rounded-pill px-3 fw-bold" data-bs-toggle="modal" data-bs-target="#soundscapeModal">
                <i class="bi bi-plus-lg me-1"></i>Thêm âm thanh mẫu
            </button>
        </div>

        <!-- Soundscapes Table -->
        <div class="admin-table">
            <table class="table table-borderless mb-0">
                <thead>
                    <tr>
                        <th>Tên âm thanh</th>
                        <th>Chủ đề (Mood)</th>
                        <th>Thời lượng</th>
                        <th>Nghe thử</th>
                        <th>Ngày tạo</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    <% soundscapes.forEach(s => { %>
                    <tr id="soundscape-row-<%= s.id %>">
                        <td class="fw-bold small"><%= s.name %></td>
                        <td>
                            <% if (s.mood === 'calm') { %>
                                <span class="badge bg-success bg-opacity-15 text-success rounded-pill px-3 py-1">Calm (Yên bình)</span>
                            <% } else if (s.mood === 'wild') { %>
                                <span class="badge bg-warning bg-opacity-15 text-warning rounded-pill px-3 py-1">Wild (Sống động)</span>
                            <% } else { %>
                                <span class="badge bg-dark bg-opacity-15 text-dark rounded-pill px-3 py-1">Night (Đêm tĩnh lặng)</span>
                            <% } %>
                        </td>
                        <td class="small"><%= s.duration_seconds || 0 %> giây</td>
                        <td>
                            <audio src="<%= s.audio_url %>" controls class="my-audio-player" style="max-height: 28px; width: 220px;"></audio>
                        </td>
                        <td class="small" style="color: var(--admin-muted);"><%= new Date(s.created_at).toLocaleDateString('vi-VN') %></td>
                        <td>
                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="deleteSoundscape('<%= s.id %>')">
                                <i class="bi bi-trash"></i> Xóa
                            </button>
                        </td>
                    </tr>
                    <% }) %>
                    <% if (soundscapes.length === 0) { %>
                    <tr><td colspan="6" class="text-center py-5 text-muted">Chưa có âm thanh soundscape nào.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- 3. Video Templates Tab Pane (Bình Lợi Studio) -->
    <div class="tab-pane fade" id="templates-pane" role="tabpanel" tabindex="0">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <div>
                <h5 class="fw-bold mb-0">Mẫu Video Bình Lợi Studio</h5>
                <p class="text-muted small mb-0">Tạo mẫu video, quy định thời lượng và mốc thời gian (giây) từng ảnh để người dùng chỉ cần chọn ảnh là tạo video ngay.</p>
            </div>
            <div class="d-flex gap-2">
                <a href="/reviews/video-editor" target="_blank" class="btn btn-outline-dark btn-sm rounded-pill px-3 fw-semibold">
                    <i class="bi bi-play-circle me-1 text-danger"></i>Mở Bình Lợi Studio
                </a>
                <button class="btn btn-primary btn-sm rounded-pill px-3.5 fw-bold" onclick="openAddTemplateModal()">
                    <i class="bi bi-plus-lg me-1"></i>Thêm mẫu video mới
                </button>
            </div>
        </div>

        <!-- Video Templates Grid / Table -->
        <div class="row g-3">
            <% if (typeof videoTemplates !== 'undefined' && videoTemplates && videoTemplates.length > 0) { %>
                <% videoTemplates.forEach(tpl => { 
                    const slotsCount = Array.isArray(tpl.slots) ? tpl.slots.length : 0;
                %>
                <div class="col-12 col-md-6 col-xl-4" id="template-card-<%= tpl.id %>">
                    <div class="card h-100 border-0 rounded-4 shadow-sm overflow-hidden" style="background: var(--admin-surface); border: 1px solid var(--admin-border) !important;">
                        <div class="position-relative bg-dark" style="height: 180px; overflow: hidden;">
                            <img src="<%= fixImg(tpl.cover_image || '/images/Poster 1.jpg') %>" class="w-100 h-100 object-fit-cover opacity-85">
                            <span class="position-absolute top-0 start-0 m-2 badge bg-dark bg-opacity-75 text-white border border-light border-opacity-25 rounded-pill px-2.5 py-1" style="font-size: 0.72rem;">
                                <i class="bi bi-stopwatch text-warning me-1"></i><%= tpl.duration_seconds %>s · <%= slotsCount %> ảnh
                            </span>
                            <span class="position-absolute top-0 end-0 m-2 badge <%= tpl.is_active ? 'bg-success' : 'bg-secondary' %> rounded-pill px-2.5 py-1">
                                <%= tpl.is_active ? 'Đang hoạt động' : 'Tạm ẩn' %>
                            </span>
                            <div class="position-absolute bottom-0 start-0 end-0 p-2 text-white bg-gradient-dark" style="background: linear-gradient(0deg, rgba(0,0,0,0.85) 0%, transparent 100%);">
                                <div class="fw-bold small text-truncate"><%= tpl.title %></div>
                                <div class="x-small text-white-50 text-truncate"><i class="bi bi-music-note me-1 text-cyan"></i><%= tpl.audio_title || 'Nhạc nền Bình Lợi' %></div>
                            </div>
                        </div>
                        <div class="card-body p-3 d-flex flex-column">
                            <p class="small text-muted mb-3 flex-grow-1" style="font-size: 0.8rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                <%= tpl.description || 'Chưa có mô tả' %>
                            </p>

                            <!-- Mini Slot Timeline Preview -->
                            <div class="mb-3 p-2 bg-light rounded-3 border">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="x-small fw-bold text-muted">PHÂN ĐOẠN THỜI GIAN</span>
                                    <span class="badge bg-secondary text-white font-monospace" style="font-size: 0.65rem;">Tổng: <%= tpl.duration_seconds %>s</span>
                                </div>
                                <div class="d-flex gap-1" style="height: 18px;">
                                    <% if (Array.isArray(tpl.slots)) { %>
                                        <% tpl.slots.forEach((sl, idx) => { 
                                            const widthPct = Math.max(10, ((sl.end_time - sl.start_time) / tpl.duration_seconds) * 100);
                                        %>
                                            <div class="rounded-1 text-white x-small fw-bold d-flex align-items-center justify-content-center text-truncate px-1" 
                                                 style="width: <%= widthPct %>%; background: <%= ['#6366f1', '#10b981', '#f59e0b', '#ec4899', '#06b6d4'][idx % 5] %>; font-size: 0.58rem;" 
                                                 title="<%= sl.title %>: <%= sl.start_time %>s - <%= sl.end_time %>s">
                                                <%= sl.start_time %>s-<%= sl.end_time %>s
                                            </div>
                                        <% }) %>
                                    <% } %>
                                </div>
                            </div>

                            <div class="d-flex align-items-center justify-content-between pt-2 border-top gap-1">
                                <button class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-1 x-small fw-bold" onclick="toggleTemplateStatus('<%= tpl.id %>')">
                                    <i class="bi <%= tpl.is_active ? 'bi-eye-slash text-warning' : 'bi-eye text-success' %> me-1"></i><%= tpl.is_active ? 'Ẩn' : 'Hiện' %>
                                </button>
                                <button class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-1 x-small fw-bold" onclick="openEditTemplateModal('<%= encodeURIComponent(JSON.stringify(tpl)) %>')">
                                    <i class="bi bi-pencil me-1"></i>Chỉnh sửa
                                </button>
                                <button class="btn btn-sm btn-outline-danger rounded-pill px-2.5 py-1 x-small fw-bold" onclick="deleteVideoTemplate('<%= tpl.id %>')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <% }) %>
            <% } else { %>
                <div class="col-12 py-5 text-center text-muted">
                    <i class="bi bi-camera-reels display-4 d-block text-secondary opacity-50 mb-2"></i>
                    <p class="mb-2">Chưa có mẫu video nào. Hãy thêm mẫu đầu tiên để du khách trải nghiệm!</p>
                    <button class="btn btn-primary btn-sm rounded-pill px-3.5 fw-bold" onclick="openAddTemplateModal()">
                        <i class="bi bi-plus-lg me-1"></i>Tạo mẫu video ngay
                    </button>
                </div>
            <% } %>
        </div>
    </div>
</div>

<!-- Add Soundscape Modal -->
<div class="modal fade" id="soundscapeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4" style="background: var(--admin-surface);">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Thêm Âm Thanh Soundscape</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="soundscapeForm" onsubmit="saveSoundscape(event)">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Tên âm thanh</label>
                        <input type="text" class="form-control admin-input" id="sound_name" name="name" required placeholder="Ví dụ: Tiếng Rừng Tràm Xào Xạc">
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Mood (Chủ đề cảm xúc)</label>
                        <select class="form-select admin-input" id="sound_mood" name="mood" required>
                            <option value="calm">Calm - Thư giãn, nhẹ nhàng</option>
                            <option value="wild">Wild - Sôi động, thiên nhiên hoang dã</option>
                            <option value="night">Night - Huyền bí, yên bình ban đêm</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Thời lượng (giây)</label>
                        <input type="number" class="form-control admin-input" id="sound_duration" name="duration_seconds" value="30" min="1" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Tệp âm thanh (MP3/WAV)</label>
                        <input type="file" class="form-control admin-input" id="sound_file" name="audio" accept="audio/*" required>
                        <div class="form-text small">Giới hạn tệp tối đa 25MB.</div>
                    </div>
                    <div class="modal-footer border-0 px-0 pb-0">
                        <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold" id="saveSoundBtn">Lưu lại</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Video Template Modal (Bình Lợi Studio Builder - 2-Step Wizard) -->
<div class="modal fade" id="videoTemplateModal" tabindex="-1" aria-hidden="true" style="z-index: 1070;">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content border-0 rounded-4 shadow-2xl overflow-hidden" style="background: var(--admin-surface, #ffffff);">
            <div class="modal-header border-bottom border-secondary border-opacity-10 py-3 px-4" style="background: linear-gradient(135deg, #922724 0%, #7a1f1d 100%);">
                <div class="d-flex align-items-center gap-2.5">
                    <div class="bg-white bg-opacity-20 rounded-circle p-1.5 d-flex align-items-center justify-content-center text-white" style="width: 34px; height: 34px;">
                        <i class="bi bi-camera-reels fs-5"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-white fs-6 mb-0" id="templateModalTitle">Thiết Lập Mẫu Video Bình Lợi Studio</h5>
                        <div class="text-white-50 x-small" style="font-size: 0.72rem;">Quy trình 2 bước trực quan: Cấu hình thông tin ➔ Phân bổ thời gian & kịch bản phân cảnh</div>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            
            <form id="videoTemplateForm" onsubmit="saveVideoTemplate(event)">
                <input type="hidden" id="tpl_id" name="id" value="">
                
                <div class="modal-body p-4 custom-scrollbar" style="max-height: calc(85vh - 120px); overflow-y: auto;">
                    <!-- Step Indicator Tabs -->
                    <ul class="nav nav-pills nav-fill mb-4 bg-light p-1.5 rounded-pill border" id="adminTemplateWizardTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active rounded-pill fw-bold py-2 px-4 d-flex align-items-center justify-content-center gap-2" id="step1-tab" data-bs-toggle="pill" data-bs-target="#step1-pane" type="button" role="tab">
                                <span class="badge bg-primary rounded-circle p-0 d-flex align-items-center justify-content-center" style="width:20px; height:20px; font-size: 0.7rem;">1</span>
                                <span>Bước 1: Thông Tin & Nhạc Nền</span>
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link rounded-pill fw-bold py-2 px-4 d-flex align-items-center justify-content-center gap-2" id="step2-tab" data-bs-toggle="pill" data-bs-target="#step2-pane" type="button" role="tab">
                                <span class="badge bg-danger rounded-circle p-0 d-flex align-items-center justify-content-center" style="width:20px; height:20px; font-size: 0.7rem;">2</span>
                                <span>Bước 2: Phân Cảnh & Thời Lượng (<span id="tab2SlotsCount">4 cảnh</span>)</span>
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content" id="adminTemplateWizardContent">
                        <!-- TAB PANE 1: THÔNG TIN & NHẠC NỀN -->
                        <div class="tab-pane fade show active" id="step1-pane" role="tabpanel">
                            <div class="row g-4">
                                <!-- Col 1: Basic Information -->
                                <div class="col-12 col-md-6">
                                    <div class="card border rounded-3 p-3.5 h-100 bg-white shadow-none">
                                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-3 d-flex align-items-center gap-2">
                                            <i class="bi bi-card-heading text-primary"></i> 1. Thông Tin Cơ Bản
                                        </h6>
                                        
                                        <div class="mb-3">
                                            <label class="form-label small fw-bold mb-1">Tên mẫu video <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control admin-input" id="tpl_title" name="title" required placeholder="Ví dụ: Khám Phá Vườn Mai 15s (Hot Trend)">
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label small fw-bold mb-1">Mô tả ngắn</label>
                                            <textarea class="form-control admin-input" id="tpl_description" name="description" rows="3" placeholder="Gợi ý nội dung, nhịp điệu chuyển cảnh, không khí phù hợp..."></textarea>
                                        </div>

                                        <div class="row g-3">
                                            <div class="col-7">
                                                <label class="form-label small fw-bold mb-1">Tổng thời lượng <span class="text-danger">*</span></label>
                                                <select class="form-select admin-input fw-semibold" id="tpl_duration" name="duration_seconds" onchange="onTemplateDurationChange(this.value)">
                                                    <option value="15">15 Giây (TikTok / Story)</option>
                                                    <option value="20">20 Giây (Reels / Trải nghiệm)</option>
                                                    <option value="30">30 Giây (Vlog Toàn Cảnh)</option>
                                                    <option value="10">10 Giây (Teaser Ngắn)</option>
                                                </select>
                                            </div>
                                            <div class="col-5">
                                                <label class="form-label small fw-bold mb-1">Thứ tự hiển thị</label>
                                                <input type="number" class="form-control admin-input font-monospace" id="tpl_sort_order" name="sort_order" value="1" min="0">
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Col 2: Cover Image & Audio Selection -->
                                <div class="col-12 col-md-6">
                                    <!-- Cover Image Card -->
                                    <div class="card border rounded-3 p-3.5 mb-3 bg-white shadow-none">
                                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-3 d-flex align-items-center gap-2">
                                            <i class="bi bi-image text-success"></i> 2. Ảnh Bìa Đại Diện (Cover 9:16)
                                        </h6>
                                        <div class="d-flex gap-3 align-items-start">
                                            <div class="position-relative rounded-2 overflow-hidden border bg-dark flex-shrink-0 shadow-sm" style="width: 82px; height: 110px;">
                                                <img id="tpl_cover_preview" src="/images/Poster 1.jpg" class="w-100 h-100 object-fit-cover" onerror="this.src='/images/Poster 1.jpg'">
                                                <span class="position-absolute bottom-0 start-0 end-0 text-center x-small py-0.5 text-white bg-dark bg-opacity-75 font-monospace" style="font-size: 0.55rem;">Xem trước</span>
                                            </div>
                                            <div class="flex-grow-1 min-w-0">
                                                <label class="form-label x-small fw-bold text-muted mb-1">Tải ảnh bìa mới từ máy:</label>
                                                <input type="file" class="form-control form-control-sm admin-input mb-2" id="tpl_cover_file" name="cover_image" accept="image/*" onchange="previewCoverFile(this)">
                                                <label class="form-label x-small fw-bold text-muted mb-1">Hoặc dán link URL ảnh:</label>
                                                <input type="text" class="form-control form-control-sm admin-input font-monospace x-small" id="tpl_cover_url" name="cover_image_url" placeholder="/images/Poster 1.jpg" oninput="document.getElementById('tpl_cover_preview').src = this.value || '/images/Poster 1.jpg'">
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Music Selection Card -->
                                    <div class="card border rounded-3 p-3.5 bg-white shadow-none">
                                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-3 d-flex align-items-center gap-2">
                                            <i class="bi bi-music-note-beamed text-info"></i> 3. Nhạc Nền Mẫu (Background Audio)
                                        </h6>
                                        
                                        <div class="mb-2">
                                            <label class="form-label small fw-bold mb-1">Tên bài nhạc hiển thị</label>
                                            <input type="text" class="form-control form-control-sm admin-input" id="tpl_audio_title" name="audio_title" placeholder="Suối reo miệt vườn">
                                        </div>

                                        <div class="mb-2">
                                            <label class="form-label x-small fw-bold text-muted mb-1">Chọn từ kho Soundscape Bình Lợi:</label>
                                            <select class="form-select form-select-sm admin-input" id="tpl_soundscape_select" onchange="selectSoundscapeForTemplate(this)">
                                                <option value="">-- Chọn bài nhạc Bình Lợi --</option>
                                                <% if (typeof soundscapes !== 'undefined' && soundscapes) { %>
                                                    <% soundscapes.forEach(sc => { %>
                                                        <option value="<%= sc.audio_url %>" data-title="<%= sc.name %>"><%= sc.name %> (<%= sc.mood %>)</option>
                                                    <% }) %>
                                                <% } %>
                                            </select>
                                        </div>

                                        <div class="mb-2">
                                            <label class="form-label x-small fw-bold text-muted mb-1">Hoặc tải file nhạc riêng (MP3/WAV):</label>
                                            <input type="file" class="form-control form-control-sm admin-input mb-1" id="tpl_audio_file" name="audio_file" accept="audio/*" onchange="previewAudioFile(this)">
                                            <input type="text" class="form-control form-control-sm admin-input font-monospace x-small" id="tpl_audio_url" name="audio_url" placeholder="/audio/peaceful_stream.mp3" oninput="updateAudioPlayer(this.value)">
                                        </div>

                                        <div class="p-2 rounded-2 bg-light border d-flex align-items-center gap-2 mt-2">
                                            <audio id="tpl_audio_player" controls class="w-100" style="height: 32px;"></audio>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Big Button to Step 2 -->
                            <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                                <button type="button" class="btn btn-primary rounded-pill px-4 py-2 fw-bold d-flex align-items-center gap-2 shadow-sm" onclick="goToTemplateStep(2)" style="background: #922724; border-color: #922724;">
                                    <span>Tiếp Tục: Thiết Lập Phân Cảnh (Bước 2)</span>
                                    <i class="bi bi-arrow-right fs-6"></i>
                                </button>
                            </div>
                        </div>

                        <!-- TAB PANE 2: PHÂN CẢNH & THỜI LƯỢNG (TIMELINE BUILDER) -->
                        <div class="tab-pane fade" id="step2-pane" role="tabpanel">
                            <!-- Timeline Header Toolbar -->
                            <div class="card border rounded-3 p-3 mb-3 bg-light bg-opacity-60 shadow-none">
                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2.5">
                                    <div>
                                        <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                                            <i class="bi bi-layers-half text-danger"></i> Kịch Bản Phân Cảnh (Slots Timeline)
                                        </h6>
                                        <small class="text-muted" style="font-size: 0.74rem;">
                                            Chỉ cần điều chỉnh số giây từng cảnh, hệ thống sẽ tự động liên kết các mốc thời gian liên tục mà không cần tính nhẩm!
                                        </small>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1.5 fw-bold d-flex align-items-center gap-1.5" onclick="autoRecalculateSlots()">
                                            <i class="bi bi-magic"></i> ✨ Chia Đều Giây
                                        </button>
                                        <button type="button" class="btn btn-sm btn-success rounded-pill px-3 py-1.5 fw-bold d-flex align-items-center gap-1.5" onclick="addSlotRow()">
                                            <i class="bi bi-plus-circle-fill"></i> Thêm Cảnh Mới
                                        </button>
                                    </div>
                                </div>

                                <!-- Visual Colorful Timeline Bar -->
                                <div class="p-2 rounded-2 bg-white border">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="x-small fw-bold text-muted text-uppercase" style="letter-spacing: 0.5px;">Sơ đồ trực quan</span>
                                        <span id="slotsSumBadge" class="badge bg-success font-monospace" style="font-size: 0.72rem;">✓ Khớp 15.0s / 15s</span>
                                    </div>
                                    <div class="d-flex gap-1 rounded-2 overflow-hidden bg-secondary bg-opacity-20 p-1" id="visualSlotsProgressBar" style="min-height: 28px;">
                                        <!-- Dynamic colored progress segments -->
                                    </div>
                                </div>
                            </div>

                            <!-- Slots Builder Container -->
                            <div id="slotsBuilderContainer" class="d-flex flex-column gap-2.5 mb-3 custom-scrollbar" style="max-height: 460px; overflow-y: auto; padding-right: 4px;">
                                <!-- Dynamic slot cards inserted here -->
                            </div>

                            <!-- Summary & Navigation Footer for Step 2 -->
                            <div class="p-3 bg-light rounded-3 border d-flex align-items-center justify-content-between flex-wrap gap-2">
                                <button type="button" class="btn btn-outline-secondary rounded-pill px-3.5 py-1.5 fw-semibold d-flex align-items-center gap-1.5" onclick="goToTemplateStep(1)">
                                    <i class="bi bi-arrow-left"></i> Quay lại Bước 1
                                </button>
                                
                                <div class="d-flex align-items-center gap-3">
                                    <div class="small text-muted">
                                        Tổng thời gian: <b class="text-dark font-monospace" id="slotsDurationSumLabel">15.0s</b> / <b class="text-primary font-monospace" id="targetDurationLabel">15s</b>
                                    </div>
                                    <span class="badge bg-dark px-2.5 py-1 text-white font-monospace" id="slotsCountLabel">4 phân cảnh</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-top border-secondary border-opacity-10 py-2.5 px-4 bg-light d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm" id="btnSaveTemplate" style="background: #922724; border-color: #922724;">
                        <i class="bi bi-check2-circle me-1.5"></i>LƯU MẪU VIDEO BÌNH LỢI STUDIO
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Review Detail Modal Popup -->

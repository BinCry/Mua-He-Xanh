<script>
    // Client-side Image Compression Helper using HTML5 Canvas
    function compressImage(file, maxDimension = 1600, quality = 0.82) {
        return new Promise((resolve) => {
            if (!file || !file.type || !file.type.startsWith('image/') || file.size < 500 * 1024) {
                return resolve(file);
            }

            const reader = new FileReader();
            reader.onload = function(e) {
                const img = new Image();
                img.onload = function() {
                    let width = img.width;
                    let height = img.height;

                    if (width > maxDimension || height > maxDimension) {
                        if (width > height) {
                            height = Math.round((height * maxDimension) / width);
                            width = maxDimension;
                        } else {
                            width = Math.round((width * maxDimension) / height);
                            height = maxDimension;
                        }
                    }

                    const canvas = document.createElement('canvas');
                    canvas.width = width;
                    canvas.height = height;

                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0, width, height);

                    canvas.toBlob(
                        (blob) => {
                            if (blob && blob.size < file.size) {
                                const compressedFile = new File([blob], file.name.replace(/\.[^/.]+$/, "") + ".jpg", {
                                    type: 'image/jpeg',
                                    lastModified: Date.now()
                                });
                                resolve(compressedFile);
                            } else {
                                resolve(file);
                            }
                        },
                        'image/jpeg',
                        quality
                    );
                };
                img.onerror = () => resolve(file);
                img.src = e.target.result;
            };
            reader.onerror = () => resolve(file);
            reader.readAsDataURL(file);
        });
    }

    // Client-side 1:1 Square Auto-Cropper + Compressor
    function cropImageToSquare(file, maxDimension = 1200, quality = 0.85) {
        return new Promise((resolve) => {
            if (!file || !file.type || !file.type.startsWith('image/')) {
                return resolve(file);
            }

            const reader = new FileReader();
            reader.onload = function(e) {
                const img = new Image();
                img.onload = function() {
                    const minDim = Math.min(img.width, img.height);
                    const targetSize = Math.min(minDim, maxDimension);

                    const sx = Math.round((img.width - minDim) / 2);
                    const sy = Math.round((img.height - minDim) / 2);

                    const canvas = document.createElement('canvas');
                    canvas.width = targetSize;
                    canvas.height = targetSize;

                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, sx, sy, minDim, minDim, 0, 0, targetSize, targetSize);

                    canvas.toBlob(
                        (blob) => {
                            if (blob) {
                                const croppedFile = new File([blob], file.name.replace(/\.[^/.]+$/, "") + "-square.jpg", {
                                    type: 'image/jpeg',
                                    lastModified: Date.now()
                                });
                                resolve(croppedFile);
                            } else {
                                resolve(file);
                            }
                        },
                        'image/jpeg',
                        quality
                    );
                };
                img.onerror = () => resolve(file);
                img.src = e.target.result;
            };
            reader.onerror = () => resolve(file);
            reader.readAsDataURL(file);
        });
    }

    const activeParentId = {};
    let selectedFiles = [];

    function openFbCreatePostModal(openFilePicker, focusTab) {
        const modalEl = document.getElementById('fbCreatePostModal');
        if (!modalEl) {
            window.location.href = '/auth/login';
            return;
        }
        const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
        modal.show();

        if (openFilePicker) {
            setTimeout(() => triggerPhotoUpload(false), 300);
        }
        if (focusTab === 'emoji') {
            setTimeout(() => toggleFbPostEmoji(true), 300);
        }
    }

    function toggleDestinationSelector() {
        const c = document.getElementById('destSelectorContainer');
        if (c) c.classList.toggle('d-none');
    }

    function updateDestBadge(select) {
        const textEl = document.getElementById('destBadgeText');
        if (!textEl) return;
        if (select.value) {
            const opt = select.options[select.selectedIndex];
            textEl.innerText = opt ? opt.text.replace(/^[📍\s]+/, '') : 'Check-in';
        } else {
            textEl.innerText = 'Check-in';
        }
    }

    function toggleRatingSelector() {
        const c = document.getElementById('ratingSelectorContainer');
        if (c) c.classList.toggle('d-none');
    }

    function updateRatingBadge(select) {
        const textEl = document.getElementById('ratingBadgeText');
        if (!textEl) return;
        const val = parseInt(select.value || '5', 10);
        textEl.innerText = '⭐'.repeat(val) + ` ${val} sao`;
    }

    function toggleFbPostEmoji(force) {
        const p = document.getElementById('fbPostEmojiPopover');
        if (!p) return;
        p.style.display = (force !== undefined) ? (force ? 'block' : 'none') : (p.style.display === 'none' ? 'block' : 'none');
    }

    function insertFbPostEmoji(emoji) {
        const textarea = document.getElementById('fbPostContent');
        if (!textarea) return;
        textarea.value += emoji;
        textarea.focus();
        handleFbPostInput();
    }

    function handleFbPostInput() {
        const textarea = document.getElementById('fbPostContent');
        const submitBtn = document.getElementById('btnFbSubmitPost');
        if (!textarea || !submitBtn) return;
        
        const hasText = textarea.value.trim().length > 0;
        const hasImages = selectedFiles.length > 0;
        submitBtn.disabled = !(hasText || hasImages);
    }

    // Handle multiple file selections from input (ALLOWS DUPLICATES & UP TO 30 PHOTOS)
    function handleFilesSelected(input) {
        if (!input.files || input.files.length === 0) return;
        
        const newFiles = Array.from(input.files);
        for (const f of newFiles) {
            if (selectedFiles.length >= 30) {
                showAppAlert('Bạn có thể đăng tối đa 30 ảnh trong một bài viết.', 'Thông báo');
                break;
            }
            // Allow identical / duplicate images!
            selectedFiles.push(f);
        }
        input.value = '';
        renderFbImageCollage();
        handleFbPostInput();
    }

    // Render Facebook Collage Preview Grid (Matches Image 4)
    function renderFbImageCollage() {
        const container = document.getElementById('fbImageCollageContainer');
        const grid = document.getElementById('fbCollageGrid');
        if (!container || !grid) return;

        if (selectedFiles.length === 0) {
            container.classList.add('d-none');
            grid.innerHTML = '';
            return;
        }

        container.classList.remove('d-none');
        const urls = selectedFiles.map(f => URL.createObjectURL(f));
        let html = '';

        if (urls.length === 1) {
            html = `
                <div class="position-relative w-100 bg-dark text-center overflow-hidden" style="max-height: 380px;">
                    <img src="${urls[0]}" class="w-100 h-100" style="object-fit: contain; max-height: 380px;" alt="Preview">
                </div>
            `;
        } else if (urls.length === 2) {
            // Equal 50%-50% side-by-side split (Matches Image 4!)
            html = `
                <div class="row g-1 w-100 m-0" style="height: 280px;">
                    <div class="col-6 p-0 pe-0.5 h-100 overflow-hidden">
                        <img src="${urls[0]}" class="w-100 h-100" style="object-fit: cover;" alt="Preview 1">
                    </div>
                    <div class="col-6 p-0 ps-0.5 h-100 overflow-hidden">
                        <img src="${urls[1]}" class="w-100 h-100" style="object-fit: cover;" alt="Preview 2">
                    </div>
                </div>
            `;
        } else if (urls.length === 3) {
            html = `
                <div class="row g-1 w-100 m-0" style="height: 280px;">
                    <div class="col-7 p-0 pe-0.5 h-100 overflow-hidden">
                        <img src="${urls[0]}" class="w-100 h-100" style="object-fit: cover;" alt="Preview 1">
                    </div>
                    <div class="col-5 p-0 ps-0.5 d-flex flex-column h-100 gap-1">
                        <div class="h-50 w-100 overflow-hidden"><img src="${urls[1]}" class="w-100 h-100" style="object-fit: cover;" alt="Preview 2"></div>
                        <div class="h-50 w-100 overflow-hidden"><img src="${urls[2]}" class="w-100 h-100" style="object-fit: cover;" alt="Preview 3"></div>
                    </div>
                </div>
            `;
        } else if (urls.length === 4) {
            html = `
                <div class="row g-1 w-100 m-0" style="height: 280px;">
                    <div class="col-6 p-0 pe-0.5 pb-0.5 overflow-hidden" style="height: 139px;"><img src="${urls[0]}" class="w-100 h-100" style="object-fit: cover;" alt="Preview 1"></div>
                    <div class="col-6 p-0 ps-0.5 pb-0.5 overflow-hidden" style="height: 139px;"><img src="${urls[1]}" class="w-100 h-100" style="object-fit: cover;" alt="Preview 2"></div>
                    <div class="col-6 p-0 pe-0.5 pt-0.5 overflow-hidden" style="height: 139px;"><img src="${urls[2]}" class="w-100 h-100" style="object-fit: cover;" alt="Preview 3"></div>
                    <div class="col-6 p-0 ps-0.5 pt-0.5 overflow-hidden" style="height: 139px;"><img src="${urls[3]}" class="w-100 h-100" style="object-fit: cover;" alt="Preview 4"></div>
                </div>
            `;
        } else {
            // 5+ photos: 2x2 grid with +N on 4th photo
            html = `
                <div class="row g-1 w-100 m-0" style="height: 280px;">
                    <div class="col-6 p-0 pe-0.5 pb-0.5 overflow-hidden" style="height: 139px;"><img src="${urls[0]}" class="w-100 h-100" style="object-fit: cover;" alt="Preview 1"></div>
                    <div class="col-6 p-0 ps-0.5 pb-0.5 overflow-hidden" style="height: 139px;"><img src="${urls[1]}" class="w-100 h-100" style="object-fit: cover;" alt="Preview 2"></div>
                    <div class="col-6 p-0 pe-0.5 pt-0.5 overflow-hidden" style="height: 139px;"><img src="${urls[2]}" class="w-100 h-100" style="object-fit: cover;" alt="Preview 3"></div>
                    <div class="col-6 p-0 ps-0.5 pt-0.5 position-relative overflow-hidden" style="height: 139px;">
                        <img src="${urls[3]}" class="w-100 h-100" style="object-fit: cover;" alt="Preview 4">
                        <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center text-white fw-bold fs-4" style="background: rgba(0,0,0,0.55); backdrop-filter: blur(2px);">
                            +${urls.length - 3}
                        </div>
                    </div>
                </div>
            `;
        }
        grid.innerHTML = html;
    }

    function clearAllImages() {
        selectedFiles = [];
        renderFbImageCollage();
        handleFbPostInput();
    }

    // Geolocation Tag Matching on compose box load
    document.addEventListener('DOMContentLoaded', () => {
        if (navigator.geolocation) {
            const badge = document.getElementById('locationBadge');
            if (badge) badge.classList.remove('d-none');
            navigator.geolocation.getCurrentPosition(
                (pos) => {
                    const lat = pos.coords.latitude;
                    const lng = pos.coords.longitude;
                    const el = document.getElementById('locationText');
                    if (el) el.innerText = `Tự động gắn thẻ địa điểm (${lat.toFixed(4)}, ${lng.toFixed(4)})`;
                },
                (err) => {
                    const el = document.getElementById('locationText');
                    if (el) el.innerText = "Bình Lợi, TP.HCM";
                }
            );
        }
    });

    function copyToClipboardFallback(text) {
        if (navigator.clipboard && window.isSecureContext) {
            return navigator.clipboard.writeText(text);
        }
        return new Promise((resolve, reject) => {
            try {
                const textArea = document.createElement("textarea");
                textArea.value = text;
                textArea.style.position = "fixed";
                textArea.style.top = "-9999px";
                textArea.style.left = "-9999px";
                document.body.appendChild(textArea);
                textArea.focus();
                textArea.select();
                const successful = document.execCommand('copy');
                document.body.removeChild(textArea);
                if (successful) resolve();
                else reject(new Error('execCommand copy failed'));
            } catch (err) {
                reject(err);
            }
        });
    }

    let currentTikTokShareText = '';

    function shareTikTokFromBtn(btn) {
        const content = btn.getAttribute('data-content') || '';
        const destinationName = btn.getAttribute('data-location') || '';
        const url = window.location.origin + '/reviews';
        const text = `Check-in tại ${destinationName || 'Bình Lợi'} - Bình Lợi: "${content.substring(0, 90)}..." #BinhLoi #ChuaLanh #MietVuonGiuaPho\n${url}`;
        
        currentTikTokShareText = text;

        // Auto copy to clipboard
        copyToClipboardFallback(text).catch(err => console.warn('Clipboard copy error:', err));

        // If on mobile device with native share supported, try Web Share API
        const isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
        if (isMobile && navigator.share) {
            navigator.share({
                title: 'Chia sẻ Bình Lợi',
                text: text,
                url: url
            }).catch(() => {
                showTikTokModal(text);
            });
            return;
        }

        // On desktop or when native share is unavailable, show interactive modal
        showTikTokModal(text);
    }

    function showTikTokModal(text) {
        const previewEl = document.getElementById('tiktokSharePreviewText');
        if (previewEl) previewEl.value = text;
        const modalEl = document.getElementById('tiktokShareModal');
        if (modalEl) {
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        }
    }

    function copyTikTokTextAgain(btn) {
        if (!currentTikTokShareText) return;
        copyToClipboardFallback(currentTikTokShareText).then(() => {
            if (btn) {
                const orig = btn.innerHTML;
                btn.innerHTML = '<i class="bi bi-check2 me-1"></i>Đã chép!';
                btn.classList.remove('text-primary');
                btn.classList.add('text-success');
                setTimeout(() => {
                    btn.innerHTML = orig;
                    btn.classList.remove('text-success');
                    btn.classList.add('text-primary');
                }, 2000);
            }
        }).catch(() => {
            alert('Không thể tự động sao chép, bạn hãy bôi đen văn bản và nhấn Ctrl+C.');
        });
    }

    // Handle Likes via API
    async function likeReview(id, btn) {
        try {
            const res = await axios.post('/api/reviews/like', { review_id: id });
            if (res.data.success) {
                const icon = btn.querySelector('i');
                const count = btn.querySelector('span');
                if (icon) {
                    icon.classList.toggle('bi-heart');
                    icon.classList.toggle('bi-heart-fill');
                    btn.style.color = icon.classList.contains('bi-heart-fill') ? '#dc3545' : 'inherit';
                }
                if (count) count.textContent = res.data.likes;
            }
        } catch(e) { console.error(e); }
    }

    // Toggle Comments Section
    async function toggleComments(reviewId) {
        const box = document.getElementById(`comments-box-${reviewId}`);
        if (!box) return;
        
        if (box.classList.contains('d-none')) {
            box.classList.remove('d-none');
            await loadComments(reviewId);
        } else {
            box.classList.add('d-none');
        }
    }

    const currentUserId = '<%= currentUser ? currentUser.id : "" %>';
    const currentUserRole = '<%= currentUser ? currentUser.role : "" %>';

    async function loadComments(reviewId) {
        const list = document.getElementById(`comments-list-${reviewId}`);
        if (!list) return;
        try {
            const res = await axios.get(`/api/reviews/comments?review_id=${reviewId}`);
            if (res.data.success && res.data.data.length > 0) {
                const allComments = res.data.data;
                const topComments = allComments.filter(c => !c.parent_id);
                const replyMap = {};
                allComments.filter(c => c.parent_id).forEach(r => {
                    if (!replyMap[r.parent_id]) replyMap[r.parent_id] = [];
                    replyMap[r.parent_id].push(r);
                });

                list.innerHTML = topComments.map(c => {
                    const isMyComment = (currentUserId && String(c.user_id) === String(currentUserId));
                    const isMyPost = (currentUserId && String(c.post_user_id) === String(currentUserId));
                    const isAdminUser = (currentUserRole === 'admin' || currentUserRole === 'manager');
                    const canDeleteC = isMyComment || isMyPost || isAdminUser;

                    const deleteBtnC = canDeleteC ? `
                        <button class="btn btn-link btn-sm p-0 text-danger text-decoration-none ms-2" style="font-size: 0.72rem; font-weight: 600;" onclick="deleteComment('${c.id}', '${reviewId}')" title="Xóa bình luận">
                            <i class="bi bi-trash3-fill me-1"></i>Xóa
                        </button>
                    ` : '';

                    const replies = replyMap[c.id] || [];
                    const repliesHtml = replies.map(r => {
                        const isMyReply = (currentUserId && String(r.user_id) === String(currentUserId));
                        const isMyPostReply = (currentUserId && String(r.post_user_id) === String(currentUserId));
                        const canDeleteR = isMyReply || isMyPostReply || isAdminUser;
                        const deleteBtnR = canDeleteR ? `
                            <button class="btn btn-link btn-sm p-0 text-danger text-decoration-none ms-2" style="font-size: 0.72rem; font-weight: 600;" onclick="deleteComment('${r.id}', '${reviewId}')" title="Xóa bình luận">
                                <i class="bi bi-trash3-fill me-1"></i>Xóa
                            </button>
                        ` : '';

                        return `
                            <div class="d-flex gap-2 align-items-start bg-white p-2 rounded-3 shadow-2xs mt-1 ms-4 border-start border-3 border-danger">
                                <img src="${r.avatar || '/images/default-avatar.png'}" class="rounded-circle flex-shrink-0" style="width: 24px; height: 24px; object-fit: cover;">
                                <div class="min-w-0 flex-grow-1" style="font-size: 0.8rem;">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <span class="fw-bold text-dark" style="font-size: 0.78rem;">${r.full_name}</span>
                                        <div>${deleteBtnR}</div>
                                    </div>
                                    <span class="text-secondary">${r.content}</span>
                                </div>
                            </div>
                        `;
                    }).join('');

                    return `
                        <div class="d-flex flex-column gap-1">
                            <div class="d-flex gap-2 align-items-start bg-white p-2 rounded-3 shadow-2xs border-start border-3 border-primary">
                                <img src="${c.avatar || '/images/default-avatar.png'}" class="rounded-circle flex-shrink-0" style="width: 30px; height: 30px; object-fit: cover;">
                                <div class="min-w-0 flex-grow-1" style="font-size: 0.82rem;">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <span class="fw-bold text-dark" style="font-size: 0.82rem;">${c.full_name}</span>
                                        <div class="d-flex align-items-center gap-1">
                                            <button class="btn btn-link btn-sm p-0 text-danger text-decoration-none fw-bold" style="font-size: 0.72rem;" onclick="setReplyTarget('${reviewId}', '${c.id}', '${c.full_name}')">
                                                <i class="bi bi-reply-fill me-1"></i>Trả lời
                                            </button>
                                            ${deleteBtnC}
                                        </div>
                                    </div>
                                    <span class="text-secondary d-block mt-0.5">${c.content}</span>
                                </div>
                            </div>
                            ${repliesHtml}
                        </div>
                    `;
                }).join('');
            } else {
                list.innerHTML = `<div class="text-muted small text-center py-1">Chưa có bình luận nào. Hãy là người đầu tiên!</div>`;
            }
        } catch(e) {
            list.innerHTML = `<div class="text-danger small text-center">Không thể tải bình luận.</div>`;
        }
    }

    async function deleteComment(commentId, reviewId) {
        showAppConfirm('Bạn có chắc chắn muốn xóa bình luận này?', 'Xóa bình luận', async () => {
            try {
                const res = await axios.post('/api/reviews/delete-comment', { comment_id: commentId });
                if (res.data.success) {
                    const countEls = document.querySelectorAll(`.comment-count-${reviewId}`);
                    countEls.forEach(el => el.innerText = res.data.count);
                    await loadComments(reviewId);
                } else {
                    showAppAlert(res.data.message || 'Không thể xóa bình luận', 'Thông báo');
                }
            } catch(e) {
                showAppAlert('Lỗi xóa bình luận: ' + (e.response?.data?.message || e.message), 'Lỗi');
            }
        });
    }

    function setReplyTarget(reviewId, parentId, authorName) {
        activeParentId[reviewId] = parentId;
        const targetBadge = document.getElementById(`reply-target-${reviewId}`);
        const input = document.getElementById(`comment-input-${reviewId}`);
        if (targetBadge) {
            targetBadge.innerHTML = `<span>Đang trả lời <b>@${authorName}</b></span> <button type="button" class="btn-close ms-2" style="font-size:0.65rem;" onclick="cancelReply('${reviewId}')"></button>`;
            targetBadge.classList.remove('d-none');
            targetBadge.classList.add('d-flex');
        }
        if (input) {
            input.placeholder = `Trả lời @${authorName}...`;
            input.focus();
        }
    }

    function cancelReply(reviewId) {
        activeParentId[reviewId] = null;
        const targetBadge = document.getElementById(`reply-target-${reviewId}`);
        const input = document.getElementById(`comment-input-${reviewId}`);
        if (targetBadge) {
            targetBadge.classList.add('d-none');
            targetBadge.classList.remove('d-flex');
        }
        if (input) input.placeholder = "Viết bình luận của bạn...";
    }

    function checkCommentAuth(input) {
        if (!currentUserId) {
            if (input) input.blur();
            showAppConfirm('Bạn cần đăng nhập tài khoản để tham gia gửi bình luận. Chuyển sang trang đăng nhập ngay?', 'Đăng nhập', () => {
                window.location.href = '/auth/login';
            });
        }
    }

    async function submitComment(event, reviewId) {
        event.preventDefault();
        if (!currentUserId) {
            showAppConfirm('Bạn cần đăng nhập tài khoản để tham gia gửi bình luận. Chuyển sang trang đăng nhập ngay?', 'Đăng nhập', () => {
                window.location.href = '/auth/login';
            });
            return;
        }

        const input = document.getElementById(`comment-input-${reviewId}`);
        if (!input || !input.value.trim()) return;

        const commentText = input.value.trim();
        const parentId = activeParentId[reviewId] || null;
        input.value = '';
        cancelReply(reviewId);

        try {
            const res = await axios.post('/api/reviews/comment', {
                review_id: reviewId,
                comment: commentText,
                parent_id: parentId
            });

            if (res.data.success) {
                const badges = document.querySelectorAll(`.comment-count-${reviewId}`);
                badges.forEach(b => { b.textContent = res.data.count; });
                await loadComments(reviewId);
            } else {
                showAppAlert(res.data.message || 'Lỗi gửi bình luận.', 'Thông báo');
            }
        } catch(e) {
            console.error('Submit comment error:', e);
            if (e.response?.status === 401) {
                showAppConfirm('Phiên đăng nhập đã hết hạn. Chuyển sang trang đăng nhập?', 'Phiên làm việc hết hạn', () => {
                    window.location.href = '/auth/login';
                });
            } else {
                showAppAlert(e.response?.data?.message || 'Không thể gửi bình luận lúc này.', 'Lỗi');
            }
        }
    }

    function triggerPhotoUpload(isCamera) {
        const input = document.getElementById('reviewFileInput');
        if (!input) return;
        if (isCamera) {
            input.setAttribute('capture', 'environment');
            input.removeAttribute('multiple');
        } else {
            input.removeAttribute('capture');
            input.setAttribute('multiple', '');
        }
        input.click();
    }

    // Submit form action
    document.getElementById('reviewForm')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const form = e.target;
        const btn = form.querySelector('button[type="submit"]');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>ĐANG TỐI ƯU ẢNH...';
        
        try {
            const formData = new FormData();
            formData.append('content', form.content.value);
            formData.append('rating', form.rating.value);
            if (form.destination_id && form.destination_id.value) {
                formData.append('destination_id', form.destination_id.value);
            }
            
            // Compress and append all selected files
            if (selectedFiles && selectedFiles.length > 0) {
                for (let i = 0; i < selectedFiles.length; i++) {
                    let file = selectedFiles[i];
                    try {
                        file = await compressImage(file, 1600, 0.85);
                    } catch(cErr) {
                        console.warn("Compression error:", cErr);
                    }
                    formData.append('images', file);
                }
            }

            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>ĐANG ĐĂNG...';

            // Retrieve Location
            if (navigator.geolocation) {
                try {
                    const pos = await new Promise((resolve, reject) => {
                        navigator.geolocation.getCurrentPosition(resolve, reject, { timeout: 3000 });
                    });
                    formData.append('lat', pos.coords.latitude);
                    formData.append('lng', pos.coords.longitude);
                } catch(geoErr) {}
            }

            const res = await axios.post('/api/reviews', formData);
            if (res.data.success) location.reload();
            else showAppAlert(res.data.message || 'Lỗi đăng bài', 'Thông báo');
        } catch(e) {
            showAppAlert('Lỗi đăng bài: ' + (e.response?.data?.message || e.message), 'Lỗi');
        } finally {
            btn.disabled = false;
            btn.innerHTML = 'ĐĂNG BÀI';
        }
    });

    async function deleteUserReview(reviewId, btnEl) {
        showAppConfirm('Bạn có chắc chắn muốn xóa bài viết này? Ảnh trong bài sẽ tự động gỡ khỏi Góc nhìn nghệ thuật.', 'Xóa bài viết', async () => {
            try {
                const res = await axios.post('/api/reviews/delete', { review_id: reviewId });
                if (res.data.success) {
                    const card = btnEl.closest('.card');
                    if (card) card.remove();
                    else location.reload();
                } else {
                    showAppAlert(res.data.message || 'Không thể xóa bài viết', 'Thông báo');
                }
            } catch(e) {
                showAppAlert('Lỗi khi xóa: ' + (e.response?.data?.message || e.message), 'Lỗi');
            }
        });
    }
</script>

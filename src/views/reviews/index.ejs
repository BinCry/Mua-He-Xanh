<% const currentUser = locals.user || (typeof user !== 'undefined' ? user : null); %>
<!-- Premium Social Network Feed -->
<section class="py-4 py-md-5" style="background: #f4f6f5;">
    <div class="container py-3" style="max-width: 680px;">
        
        <!-- Header -->
        <div class="text-center mb-4 reveal-up">
            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 mb-2 text-uppercase fw-bold" style="letter-spacing: 1px; font-size: 0.72rem;">
                <i class="bi bi-chat-heart-fill me-1"></i> Cộng đồng chữa lành
            </span>
            <h2 class="fw-black text-dark mb-1 letter-spacing-sm">Bảng Tin Check-in</h2>
            <p class="text-muted small mx-auto mb-0" style="max-width: 90%; font-size: 0.82rem; line-height: 1.4;">Chia sẻ khoảnh khắc tuyệt vời tại Bình Lợi</p>
        </div>

        <!-- Compose Box -->
        <% if (user) { %>
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 reveal-up bg-white">
            <form id="reviewForm" enctype="multipart/form-data">
                <div class="d-flex gap-3 mb-3">
                    <img src="<%= user.avatar || '/images/default-avatar.png' %>" class="rounded-circle flex-shrink-0" style="width: 46px; height: 46px; object-fit: cover; border: 2px solid var(--primary-100);">
                    <div class="flex-grow-1">
                        <div class="fw-bold mb-1" style="font-size: 0.9rem; color: #333;"><%= user.full_name %></div>
                        <textarea class="form-control border-0 bg-transparent shadow-none p-0" rows="3" name="content" 
                            placeholder="Chia sẻ khoảnh khắc chữa lành của bạn tại Bình Lợi (Tùy chọn)..." style="resize: none; font-size: 0.95rem; color: #444;"></textarea>
                    </div>
                </div>

                <!-- Destination Select Dropdown -->
                <div class="mb-3">
                    <select name="destination_id" class="form-select border-0 bg-light rounded-3 py-2 px-3 shadow-none" style="font-size: 0.85rem; color: #334155; font-weight: 500;">
                        <option value="">📍 Chọn địa điểm check-in (Tùy chọn)...</option>
                        <% (typeof destinations !== 'undefined' && destinations ? destinations : []).forEach(d => { %>
                            <option value="<%= d.id %>"><%= d.name %></option>
                        <% }) %>
                    </select>
                </div>

                <!-- Multi-Image Preview Gallery Container -->
                <div id="imagePreviewContainer" class="mb-3 d-none">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="small fw-bold text-muted" id="previewCountBadge">
                            <i class="bi bi-images me-1 text-primary"></i>Đã chọn <span id="selectedCountNum" class="text-primary fw-bold">0</span> ảnh (tối đa 10)
                        </span>
                        <button type="button" class="btn btn-link btn-sm text-danger text-decoration-none p-0 fw-semibold" onclick="clearAllImages()" style="font-size: 0.78rem;">
                            <i class="bi bi-trash3 me-1"></i>Xóa tất cả
                        </button>
                    </div>
                    
                    <!-- Thumbnail Grid -->
                    <div class="d-flex flex-wrap gap-2 align-items-center p-2 rounded-4 bg-light border" id="previewThumbnailsList"></div>
                </div>

                <!-- Actions Bar: Camera, Photo, Create Video aligned in 1 row; Rating above Submit button on the right -->
                <div class="pt-3 border-top border-light">
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-end gap-3">
                        <!-- Left: 3 Action Buttons in a clean straight row -->
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <!-- Multi Hidden File Input -->
                            <input type="file" name="images" accept="image/*" multiple class="d-none" id="reviewFileInput" onchange="handleFilesSelected(this)">

                            <!-- Button 1: Camera -->
                            <button type="button" class="btn btn-sm btn-light border rounded-pill px-3 py-1.5 fw-bold d-inline-flex align-items-center cursor-pointer mb-0" onclick="triggerPhotoUpload(true)" title="Chụp ảnh trực tiếp từ máy ảnh">
                                <i class="bi bi-camera-fill text-danger fs-6 me-2"></i>
                                <span class="small text-dark">Máy ảnh</span>
                            </button>

                            <!-- Button 2: Photo Gallery -->
                            <button type="button" class="btn btn-sm btn-light border rounded-pill px-3 py-1.5 fw-bold d-inline-flex align-items-center cursor-pointer mb-0" onclick="triggerPhotoUpload(false)" title="Chọn nhiều ảnh từ thư viện thiết bị">
                                <i class="bi bi-images text-primary fs-6 me-2"></i>
                                <span class="small text-dark">Thư viện ảnh</span>
                            </button>

                            <!-- Button 3: Create Video -->
                            <a href="/reviews/video-editor" class="btn btn-sm btn-light border rounded-pill px-3 py-1.5 fw-bold d-inline-flex align-items-center text-decoration-none mb-0" title="Tạo video hành trình">
                                <i class="bi bi-camera-reels-fill text-success fs-6 me-2"></i>
                                <span class="small text-dark">Tạo video</span>
                            </a>
                        </div>

                        <!-- Right: Rating Selector (Top) + Submit Button (Bottom) -->
                        <div class="d-flex flex-column align-items-end gap-2 ms-auto ms-sm-0">
                            <!-- Rating Selector -->
                            <div class="d-flex align-items-center gap-1">
                                <select class="form-select form-select-sm rounded-pill border bg-light px-3 py-1 text-center shadow-none" name="rating" style="width: 165px !important; min-width: 160px !important; font-size: 0.82rem !important; font-weight: 700 !important; cursor: pointer; background-image: none !important; -webkit-appearance: none !important; -moz-appearance: none !important; appearance: none !important; padding-right: 12px !important; padding-left: 12px !important;">
                                    <option value="5" selected>⭐⭐⭐⭐⭐ 5 sao</option>
                                    <option value="4">⭐⭐⭐⭐ 4 sao</option>
                                    <option value="3">⭐⭐⭐ 3 sao</option>
                                    <option value="2">⭐⭐ 2 sao</option>
                                    <option value="1">⭐ 1 sao</option>
                                </select>
                            </div>

                            <!-- Submit Button: ĐĂNG BÀI (Single horizontal line, no text wrapping) -->
                            <button type="submit" class="btn btn-primary-bl rounded-pill px-4 py-2 fw-bold text-nowrap flex-shrink-0" style="font-size: 0.88rem; white-space: nowrap;">
                                ĐĂNG BÀI
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
        <% } else { %>
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 text-center bg-white">
            <p class="text-muted mb-3 small">Vui lòng đăng nhập tài khoản để đăng bài viết chia sẻ check-in hoặc tạo video.</p>
            <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                <a href="/auth/login" class="btn btn-primary-bl rounded-pill px-4 py-2">ĐĂNG NHẬP NGAY</a>
                <a href="/reviews/video-editor" class="btn btn-outline-primary-bl rounded-pill px-4 py-2"><i class="bi bi-camera-reels-fill me-1"></i>TẠO VIDEO HÀNH TRÌNH</a>
            </div>
        </div>
        <% } %>

        <!-- Feed List -->
        <div class="d-flex flex-column gap-4 mb-5 pb-5" id="communityFeed">
            <% reviews.forEach((r, i) => { %>
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white reveal-up">
                <!-- User Header -->
                <div class="d-flex align-items-start justify-content-between gap-2 p-3 p-sm-4 pb-2">
                    <div class="d-flex align-items-center gap-3 flex-grow-1 min-w-0">
                        <img src="<%= r.avatar || '/images/default-avatar.png' %>" class="rounded-circle flex-shrink-0" style="width: 44px; height: 44px; object-fit: cover; border: 2px solid var(--primary-100);">
                        <div class="min-w-0 flex-grow-1">
                            <span class="fw-bold d-block text-truncate" style="font-size: 0.92rem; color: #333;"><%= r.full_name %></span>
                            <span class="text-muted d-block text-truncate" style="font-size: 0.72rem;">
                                <% if (r.destination_name) { %>
                                    <span class="text-danger fw-bold"><i class="bi bi-geo-alt-fill me-1"></i><%= r.destination_name %></span> · 
                                <% } else if (r.location_name) { %>
                                    <span class="text-secondary"><i class="bi bi-pin-map-fill me-1"></i><%= r.location_name %></span> · 
                                <% } %>
                                <%= new Date(r.created_at).toLocaleDateString('vi-VN') %>
                            </span>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-shrink-0 pt-1">
                        <div class="text-warning" style="font-size: 0.75rem;">
                            <% for(let s = 0; s < (r.rating || 5); s++) { %><i class="bi bi-star-fill"></i><% } %>
                        </div>
                        <% if (currentUser && (String(currentUser.id) === String(r.user_id) || currentUser.role === 'admin' || currentUser.role === 'manager')) { %>
                        <button class="btn btn-sm btn-light text-danger rounded-circle p-1 ms-1 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" onclick="deleteUserReview('<%= r.id %>', this)" title="Xóa bài viết">
                            <i class="bi bi-trash3-fill"></i>
                        </button>
                        <% } %>
                    </div>
                </div>
                
                <!-- Content text -->
                <div class="px-3 px-sm-4 pb-2">
                    <p class="mb-0 notranslate" translate="no" style="font-size: 0.92rem; line-height: 1.7; color: #444;"><%= r.content %></p>
                </div>

                <!-- Feed Images (Modern Facebook / Instagram Collage) -->
                <% 
                    let imgs = [];
                    if (r.images) {
                        try { 
                            if (typeof r.images === 'string') {
                                imgs = r.images.trim().startsWith('[') ? JSON.parse(r.images) : [r.images];
                            } else if (Array.isArray(r.images)) {
                                imgs = r.images;
                            }
                        } catch(e) {
                            imgs = [r.images];
                        }
                        imgs = (imgs || []).filter(Boolean);
                    }
                    if (imgs.length > 0) { 
                        const galleryJson = JSON.stringify(imgs.map(img => fixImg(img)));
                %>
                <div class="px-3 px-sm-4 py-2">
                    <% if (imgs.length === 1) { %>
                        <!-- 1 Image: Full Hero Square Card -->
                        <div class="rounded-4 overflow-hidden shadow-2xs border bg-light text-center cursor-pointer position-relative" style="width: 100%; aspect-ratio: 1 / 1; max-height: 540px;" onclick='openImageLightbox("<%= fixImg(imgs[0]) %>", <%= galleryJson %>, 0)' title="Nhấn để xem ảnh phóng to đầy đủ">
                            <img src="<%= fixImg(imgs[0]) %>" class="w-100 h-100" style="object-fit: cover; object-position: center;" alt="Review image" loading="lazy" onerror="this.onerror=null; this.src='/images/no-image.svg';">
                        </div>
                    <% } else if (imgs.length === 2) { %>
                        <!-- 2 Images: 2 Columns Side by Side -->
                        <div class="row g-2">
                            <% imgs.forEach((img, idx) => { %>
                            <div class="col-6">
                                <div class="rounded-4 overflow-hidden shadow-2xs border bg-light text-center cursor-pointer position-relative" style="width: 100%; aspect-ratio: 1 / 1;" onclick='openImageLightbox("<%= fixImg(img) %>", <%= galleryJson %>, <%= idx %>)' title="Nhấn để xem ảnh phóng to đầy đủ">
                                    <img src="<%= fixImg(img) %>" class="w-100 h-100" style="object-fit: cover; object-position: center;" alt="Review image" loading="lazy" onerror="this.onerror=null; this.src='/images/no-image.svg';">
                                </div>
                            </div>
                            <% }) %>
                        </div>
                    <% } else if (imgs.length === 3) { %>
                        <!-- 3 Images: 1 Banner Top + 2 Square Bottom -->
                        <div class="row g-2">
                            <div class="col-12">
                                <div class="rounded-4 overflow-hidden shadow-2xs border bg-light text-center cursor-pointer position-relative" style="width: 100%; aspect-ratio: 16 / 9; max-height: 360px;" onclick='openImageLightbox("<%= fixImg(imgs[0]) %>", <%= galleryJson %>, 0)' title="Nhấn để xem ảnh phóng to đầy đủ">
                                    <img src="<%= fixImg(imgs[0]) %>" class="w-100 h-100" style="object-fit: cover; object-position: center;" alt="Review image" loading="lazy" onerror="this.onerror=null; this.src='/images/no-image.svg';">
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="rounded-4 overflow-hidden shadow-2xs border bg-light text-center cursor-pointer position-relative" style="width: 100%; aspect-ratio: 1 / 1;" onclick='openImageLightbox("<%= fixImg(imgs[1]) %>", <%= galleryJson %>, 1)' title="Nhấn để xem ảnh phóng to đầy đủ">
                                    <img src="<%= fixImg(imgs[1]) %>" class="w-100 h-100" style="object-fit: cover; object-position: center;" alt="Review image" loading="lazy" onerror="this.onerror=null; this.src='/images/no-image.svg';">
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="rounded-4 overflow-hidden shadow-2xs border bg-light text-center cursor-pointer position-relative" style="width: 100%; aspect-ratio: 1 / 1;" onclick='openImageLightbox("<%= fixImg(imgs[2]) %>", <%= galleryJson %>, 2)' title="Nhấn để xem ảnh phóng to đầy đủ">
                                    <img src="<%= fixImg(imgs[2]) %>" class="w-100 h-100" style="object-fit: cover; object-position: center;" alt="Review image" loading="lazy" onerror="this.onerror=null; this.src='/images/no-image.svg';">
                                </div>
                            </div>
                        </div>
                    <% } else { %>
                        <!-- 4+ Images: 2x2 Grid with +N Overlay on 4th image -->
                        <div class="row g-2">
                            <% imgs.slice(0, 4).forEach((img, idx) => { %>
                            <div class="col-6">
                                <div class="rounded-4 overflow-hidden shadow-2xs border bg-light text-center cursor-pointer position-relative" style="width: 100%; aspect-ratio: 1 / 1;" onclick='openImageLightbox("<%= fixImg(img) %>", <%= galleryJson %>, <%= idx %>)' title="Nhấn để xem ảnh phóng to đầy đủ">
                                    <img src="<%= fixImg(img) %>" class="w-100 h-100" style="object-fit: cover; object-position: center;" alt="Review image" loading="lazy" onerror="this.onerror=null; this.src='/images/no-image.svg';">
                                    <% if (idx === 3 && imgs.length > 4) { %>
                                    <div class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center text-white" style="background: rgba(0,0,0,0.65); backdrop-filter: blur(4px);">
                                        <i class="bi bi-images fs-3 mb-1"></i>
                                        <span class="fw-bold fs-4">+<%= imgs.length - 3 %></span>
                                        <span class="small fw-semibold opacity-75">Xem tất cả</span>
                                    </div>
                                    <% } %>
                                </div>
                            </div>
                            <% }) %>
                        </div>
                    <% } %>
                </div>
                <% } %>
                
                <!-- Footer Action Buttons -->
                <div class="d-flex align-items-center gap-3 px-3 px-sm-4 py-3" style="font-size: 0.85rem; border-top: 1px solid rgba(0,0,0,0.03);">
                    <button class="btn btn-sm p-0 border-0 bg-transparent d-flex align-items-center gap-1 text-muted" onclick="likeReview('<%= r.id %>', this)">
                        <i class="bi bi-heart fs-5"></i>
                        <span class="fw-bold"><%= r.likes_count || 0 %></span>
                    </button>
                    
                    <button class="btn btn-sm p-0 border-0 bg-transparent d-flex align-items-center gap-1 text-muted" onclick="toggleComments('<%= r.id %>')">
                        <i class="bi bi-chat fs-5"></i>
                        <span class="fw-bold comment-count-<%= r.id %>"><%= r.comments_count || 0 %></span>
                    </button>
                    
                    <div class="d-flex gap-2 ms-auto">
                        <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(baseUrl + '/reviews') %>" 
                           target="_blank" class="btn btn-sm p-0 border-0 bg-transparent d-flex align-items-center gap-1 text-muted">
                            <i class="bi bi-facebook fs-5 text-primary"></i>
                            <span class="fw-bold d-none d-sm-inline" style="font-size: 0.8rem;">Facebook</span>
                        </a>
                        <button class="btn btn-sm p-0 border-0 bg-transparent d-flex align-items-center gap-1 text-muted" 
                                data-content="<%= (r.content || '').replace(/"/g, '&quot;') %>"
                                data-location="<%= (r.destination_name || r.location_name || '').replace(/"/g, '&quot;') %>"
                                onclick="shareTikTokFromBtn(this)">
                            <i class="bi bi-tiktok fs-5 text-dark"></i>
                            <span class="fw-bold d-none d-sm-inline" style="font-size: 0.8rem;">TikTok</span>
                        </button>
                    </div>
                </div>

                <!-- Expandable Interactive Comment Box -->
                <div id="comments-box-<%= r.id %>" class="d-none bg-light p-3 border-top">
                    <div class="comments-list mb-3 d-flex flex-column gap-2" id="comments-list-<%= r.id %>">
                        <div class="text-center py-2 text-muted small">Đang tải bình luận...</div>
                    </div>
                    <div id="reply-target-<%= r.id %>" class="d-none alert alert-warning py-1 px-3 mb-2 small d-flex align-items-center justify-content-between rounded-pill"></div>
                    <form onsubmit="submitComment(event, '<%= r.id %>')" class="d-flex gap-2">
                        <input type="text" class="form-control form-control-sm rounded-pill border px-3" id="comment-input-<%= r.id %>" onfocus="checkCommentAuth(this)" placeholder="Viết bình luận của bạn..." required>
                        <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold text-white flex-shrink-0" style="background: var(--primary);">Gửi</button>
                    </form>
                </div>
            </div>
            <% }) %>
        </div>

        <% if (reviews.length === 0) { %>
        <div class="text-center py-5">
            <i class="bi bi-chat-heart display-1 text-muted opacity-25"></i>
            <p class="text-muted mt-3">Chưa có bài đăng check-in nào. Hãy là người đầu tiên!</p>
        </div>
        <% } %>
    </div>
</section>

<script>
    // Client-side Image Compression Helper using HTML5 Canvas
    function compressImage(file, maxDimension = 1600, quality = 0.82) {
        return new Promise((resolve) => {
            if (!file || !file.type || !file.type.startsWith('image/') || file.size < 500 * 1024) {
                return resolve(file);
            }

            const reader = new FileReader();
            reader.onload = function(e) {
                const img = new Image();
                img.onload = function() {
                    let width = img.width;
                    let height = img.height;

                    if (width > maxDimension || height > maxDimension) {
                        if (width > height) {
                            height = Math.round((height * maxDimension) / width);
                            width = maxDimension;
                        } else {
                            width = Math.round((width * maxDimension) / height);
                            height = maxDimension;
                        }
                    }

                    const canvas = document.createElement('canvas');
                    canvas.width = width;
                    canvas.height = height;

                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0, width, height);

                    canvas.toBlob(
                        (blob) => {
                            if (blob && blob.size < file.size) {
                                const compressedFile = new File([blob], file.name.replace(/\.[^/.]+$/, "") + ".jpg", {
                                    type: 'image/jpeg',
                                    lastModified: Date.now()
                                });
                                resolve(compressedFile);
                            } else {
                                resolve(file);
                            }
                        },
                        'image/jpeg',
                        quality
                    );
                };
                img.onerror = () => resolve(file);
                img.src = e.target.result;
            };
            reader.onerror = () => resolve(file);
            reader.readAsDataURL(file);
        });
    }

    // Client-side 1:1 Square Auto-Cropper + Compressor
    function cropImageToSquare(file, maxDimension = 1200, quality = 0.85) {
        return new Promise((resolve) => {
            if (!file || !file.type || !file.type.startsWith('image/')) {
                return resolve(file);
            }

            const reader = new FileReader();
            reader.onload = function(e) {
                const img = new Image();
                img.onload = function() {
                    const minDim = Math.min(img.width, img.height);
                    const targetSize = Math.min(minDim, maxDimension);

                    const sx = Math.round((img.width - minDim) / 2);
                    const sy = Math.round((img.height - minDim) / 2);

                    const canvas = document.createElement('canvas');
                    canvas.width = targetSize;
                    canvas.height = targetSize;

                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, sx, sy, minDim, minDim, 0, 0, targetSize, targetSize);

                    canvas.toBlob(
                        (blob) => {
                            if (blob) {
                                const croppedFile = new File([blob], file.name.replace(/\.[^/.]+$/, "") + "-square.jpg", {
                                    type: 'image/jpeg',
                                    lastModified: Date.now()
                                });
                                resolve(croppedFile);
                            } else {
                                resolve(file);
                            }
                        },
                        'image/jpeg',
                        quality
                    );
                };
                img.onerror = () => resolve(file);
                img.src = e.target.result;
            };
            reader.onerror = () => resolve(file);
            reader.readAsDataURL(file);
        });
    }

    const activeParentId = {};
    let selectedFiles = [];

    // Handle multiple file selections from input
    function handleFilesSelected(input) {
        if (!input.files || input.files.length === 0) return;
        
        const newFiles = Array.from(input.files);
        for (const f of newFiles) {
            if (selectedFiles.length >= 10) {
                if (typeof showAppAlert === 'function') {
                    showAppAlert('Bạn chỉ có thể đăng tối đa 10 ảnh trong một bài viết.', 'Thông báo');
                } else {
                    alert('Bạn chỉ có thể đăng tối đa 10 ảnh trong một bài viết.');
                }
                break;
            }
            const isDuplicate = selectedFiles.some(existing => 
                existing.name === f.name && existing.size === f.size && existing.lastModified === f.lastModified
            );
            if (!isDuplicate) {
                selectedFiles.push(f);
            }
        }
        input.value = '';
        renderImagePreviews();
    }

    // Render multi-image thumbnail preview gallery
    function renderImagePreviews() {
        const container = document.getElementById('imagePreviewContainer');
        const countNum = document.getElementById('selectedCountNum');
        const thumbnailsList = document.getElementById('previewThumbnailsList');
        
        if (!container || !thumbnailsList) return;
        
        if (selectedFiles.length === 0) {
            container.classList.add('d-none');
            return;
        }
        
        container.classList.remove('d-none');
        if (countNum) countNum.textContent = selectedFiles.length;
        
        let html = '';
        selectedFiles.forEach((file, index) => {
            const objectUrl = URL.createObjectURL(file);
            html += `
                <div class="position-relative d-inline-block rounded-3 overflow-hidden border shadow-2xs bg-white flex-shrink-0" style="width: 80px; height: 80px;">
                    <img src="${objectUrl}" class="w-100 h-100" style="object-fit: cover; object-position: center;" alt="Preview ${index + 1}">
                    <button type="button" class="btn btn-danger btn-sm rounded-circle position-absolute top-0 end-0 m-1 p-0 d-flex align-items-center justify-content-center shadow" style="width: 22px; height: 22px; z-index: 10; font-size: 0.75rem;" onclick="removeSelectedFile(${index})" title="Xóa ảnh này">
                        <i class="bi bi-x fs-6"></i>
                    </button>
                </div>
            `;
        });
        
        if (selectedFiles.length < 10) {
            html += `
                <button type="button" class="btn btn-outline-secondary border-dashed rounded-3 d-flex flex-column align-items-center justify-content-center flex-shrink-0" style="width: 80px; height: 80px; border-style: dashed !important; border-width: 2px !important; background: rgba(0,0,0,0.02);" onclick="triggerPhotoUpload(false)" title="Thêm ảnh khác">
                    <i class="bi bi-plus-lg fs-5"></i>
                    <span style="font-size: 0.65rem;" class="fw-bold mt-1">+ Thêm</span>
                </button>
            `;
        }
        thumbnailsList.innerHTML = html;
    }

    function removeSelectedFile(index) {
        if (index >= 0 && index < selectedFiles.length) {
            selectedFiles.splice(index, 1);
            renderImagePreviews();
        }
    }

    function clearAllImages() {
        selectedFiles = [];
        renderImagePreviews();
    }

    // Geolocation Tag Matching on compose box load
    document.addEventListener('DOMContentLoaded', () => {
        if (navigator.geolocation) {
            const badge = document.getElementById('locationBadge');
            if (badge) badge.classList.remove('d-none');
            navigator.geolocation.getCurrentPosition(
                (pos) => {
                    const lat = pos.coords.latitude;
                    const lng = pos.coords.longitude;
                    const el = document.getElementById('locationText');
                    if (el) el.innerText = `Tự động gắn thẻ địa điểm (${lat.toFixed(4)}, ${lng.toFixed(4)})`;
                },
                (err) => {
                    const el = document.getElementById('locationText');
                    if (el) el.innerText = "Bình Lợi, TP.HCM";
                }
            );
        }
    });

    function shareTikTokFromBtn(btn) {
        const content = btn.getAttribute('data-content') || '';
        const destinationName = btn.getAttribute('data-location') || '';
        shareTikTok(content, destinationName, window.location.origin + '/reviews');
    }

    // TikTok Share with fallback copy
    function shareTikTok(content, destinationName, url) {
        const text = `Check-in tại ${destinationName || 'Bình Lợi'} - Bình Lợi Healing: "${content.substring(0, 80)}..." #BinhLoiHealing #ChuaLanh #MietVuonGiuaPho`;
        
        if (navigator.share) {
            navigator.share({
                title: 'Chia sẻ Bình Lợi Healing',
                text: text,
                url: url
            }).catch(err => console.error("Web Share failed:", err));
        } else {
            if (navigator.clipboard) {
                navigator.clipboard.writeText(text + " " + url)
                    .then(() => {
                        alert('Đã sao chép nội dung chia sẻ (kèm hashtag)! Đang chuyển hướng bạn sang TikTok...');
                        window.open('https://www.tiktok.com/upload', '_blank');
                    })
                    .catch(() => {
                        window.open(`https://www.tiktok.com/share?url=${encodeURIComponent(url)}&text=${encodeURIComponent(text)}`, '_blank');
                    });
            } else {
                window.open(`https://www.tiktok.com/share?url=${encodeURIComponent(url)}&text=${encodeURIComponent(text)}`, '_blank');
            }
        }
    }

    // Handle Likes via API
    async function likeReview(id, btn) {
        try {
            const res = await axios.post('/api/reviews/like', { review_id: id });
            if (res.data.success) {
                const icon = btn.querySelector('i');
                const count = btn.querySelector('span');
                if (icon) {
                    icon.classList.toggle('bi-heart');
                    icon.classList.toggle('bi-heart-fill');
                    btn.style.color = icon.classList.contains('bi-heart-fill') ? '#dc3545' : 'inherit';
                }
                if (count) count.textContent = res.data.likes;
            }
        } catch(e) { console.error(e); }
    }

    // Toggle Comments Section
    async function toggleComments(reviewId) {
        const box = document.getElementById(`comments-box-${reviewId}`);
        if (!box) return;
        
        if (box.classList.contains('d-none')) {
            box.classList.remove('d-none');
            await loadComments(reviewId);
        } else {
            box.classList.add('d-none');
        }
    }

    const currentUserId = '<%= currentUser ? currentUser.id : "" %>';
    const currentUserRole = '<%= currentUser ? currentUser.role : "" %>';

    async function loadComments(reviewId) {
        const list = document.getElementById(`comments-list-${reviewId}`);
        if (!list) return;
        try {
            const res = await axios.get(`/api/reviews/comments?review_id=${reviewId}`);
            if (res.data.success && res.data.data.length > 0) {
                const allComments = res.data.data;
                const topComments = allComments.filter(c => !c.parent_id);
                const replyMap = {};
                allComments.filter(c => c.parent_id).forEach(r => {
                    if (!replyMap[r.parent_id]) replyMap[r.parent_id] = [];
                    replyMap[r.parent_id].push(r);
                });

                list.innerHTML = topComments.map(c => {
                    const isMyComment = (currentUserId && String(c.user_id) === String(currentUserId));
                    const isMyPost = (currentUserId && String(c.post_user_id) === String(currentUserId));
                    const isAdminUser = (currentUserRole === 'admin' || currentUserRole === 'manager');
                    const canDeleteC = isMyComment || isMyPost || isAdminUser;

                    const deleteBtnC = canDeleteC ? `
                        <button class="btn btn-link btn-sm p-0 text-danger text-decoration-none ms-2" style="font-size: 0.72rem; font-weight: 600;" onclick="deleteComment('${c.id}', '${reviewId}')" title="Xóa bình luận">
                            <i class="bi bi-trash3-fill me-1"></i>Xóa
                        </button>
                    ` : '';

                    const replies = replyMap[c.id] || [];
                    const repliesHtml = replies.map(r => {
                        const isMyReply = (currentUserId && String(r.user_id) === String(currentUserId));
                        const isMyPostReply = (currentUserId && String(r.post_user_id) === String(currentUserId));
                        const canDeleteR = isMyReply || isMyPostReply || isAdminUser;
                        const deleteBtnR = canDeleteR ? `
                            <button class="btn btn-link btn-sm p-0 text-danger text-decoration-none ms-2" style="font-size: 0.72rem; font-weight: 600;" onclick="deleteComment('${r.id}', '${reviewId}')" title="Xóa bình luận">
                                <i class="bi bi-trash3-fill me-1"></i>Xóa
                            </button>
                        ` : '';

                        return `
                            <div class="d-flex gap-2 align-items-start bg-white p-2 rounded-3 shadow-2xs mt-1 ms-4 border-start border-3 border-danger">
                                <img src="${r.avatar || '/images/default-avatar.png'}" class="rounded-circle flex-shrink-0" style="width: 24px; height: 24px; object-fit: cover;">
                                <div class="min-w-0 flex-grow-1" style="font-size: 0.8rem;">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <span class="fw-bold text-dark" style="font-size: 0.78rem;">${r.full_name}</span>
                                        <div>${deleteBtnR}</div>
                                    </div>
                                    <span class="text-secondary">${r.content}</span>
                                </div>
                            </div>
                        `;
                    }).join('');

                    return `
                        <div class="d-flex flex-column gap-1">
                            <div class="d-flex gap-2 align-items-start bg-white p-2 rounded-3 shadow-2xs border-start border-3 border-primary">
                                <img src="${c.avatar || '/images/default-avatar.png'}" class="rounded-circle flex-shrink-0" style="width: 30px; height: 30px; object-fit: cover;">
                                <div class="min-w-0 flex-grow-1" style="font-size: 0.82rem;">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <span class="fw-bold text-dark" style="font-size: 0.82rem;">${c.full_name}</span>
                                        <div class="d-flex align-items-center gap-1">
                                            <button class="btn btn-link btn-sm p-0 text-danger text-decoration-none fw-bold" style="font-size: 0.72rem;" onclick="setReplyTarget('${reviewId}', '${c.id}', '${c.full_name}')">
                                                <i class="bi bi-reply-fill me-1"></i>Trả lời
                                            </button>
                                            ${deleteBtnC}
                                        </div>
                                    </div>
                                    <span class="text-secondary d-block mt-0.5">${c.content}</span>
                                </div>
                            </div>
                            ${repliesHtml}
                        </div>
                    `;
                }).join('');
            } else {
                list.innerHTML = `<div class="text-muted small text-center py-1">Chưa có bình luận nào. Hãy là người đầu tiên!</div>`;
            }
        } catch(e) {
            list.innerHTML = `<div class="text-danger small text-center">Không thể tải bình luận.</div>`;
        }
    }

    async function deleteComment(commentId, reviewId) {
        showAppConfirm('Bạn có chắc chắn muốn xóa bình luận này?', 'Xóa bình luận', async () => {
            try {
                const res = await axios.post('/api/reviews/delete-comment', { comment_id: commentId });
                if (res.data.success) {
                    const countEls = document.querySelectorAll(`.comment-count-${reviewId}`);
                    countEls.forEach(el => el.innerText = res.data.count);
                    await loadComments(reviewId);
                } else {
                    showAppAlert(res.data.message || 'Không thể xóa bình luận', 'Thông báo');
                }
            } catch(e) {
                showAppAlert('Lỗi xóa bình luận: ' + (e.response?.data?.message || e.message), 'Lỗi');
            }
        });
    }

    function setReplyTarget(reviewId, parentId, authorName) {
        activeParentId[reviewId] = parentId;
        const targetBadge = document.getElementById(`reply-target-${reviewId}`);
        const input = document.getElementById(`comment-input-${reviewId}`);
        if (targetBadge) {
            targetBadge.innerHTML = `<span>Đang trả lời <b>@${authorName}</b></span> <button type="button" class="btn-close ms-2" style="font-size:0.65rem;" onclick="cancelReply('${reviewId}')"></button>`;
            targetBadge.classList.remove('d-none');
            targetBadge.classList.add('d-flex');
        }
        if (input) {
            input.placeholder = `Trả lời @${authorName}...`;
            input.focus();
        }
    }

    function cancelReply(reviewId) {
        activeParentId[reviewId] = null;
        const targetBadge = document.getElementById(`reply-target-${reviewId}`);
        const input = document.getElementById(`comment-input-${reviewId}`);
        if (targetBadge) {
            targetBadge.classList.add('d-none');
            targetBadge.classList.remove('d-flex');
        }
        if (input) input.placeholder = "Viết bình luận của bạn...";
    }

    function checkCommentAuth(input) {
        if (!currentUserId) {
            if (input) input.blur();
            showAppConfirm('Bạn cần đăng nhập tài khoản để tham gia gửi bình luận. Chuyển sang trang đăng nhập ngay?', 'Đăng nhập', () => {
                window.location.href = '/auth/login';
            });
        }
    }

    async function submitComment(event, reviewId) {
        event.preventDefault();
        if (!currentUserId) {
            showAppConfirm('Bạn cần đăng nhập tài khoản để tham gia gửi bình luận. Chuyển sang trang đăng nhập ngay?', 'Đăng nhập', () => {
                window.location.href = '/auth/login';
            });
            return;
        }

        const input = document.getElementById(`comment-input-${reviewId}`);
        if (!input || !input.value.trim()) return;

        const commentText = input.value.trim();
        const parentId = activeParentId[reviewId] || null;
        input.value = '';
        cancelReply(reviewId);

        try {
            const res = await axios.post('/api/reviews/comment', {
                review_id: reviewId,
                comment: commentText,
                parent_id: parentId
            });

            if (res.data.success) {
                const badges = document.querySelectorAll(`.comment-count-${reviewId}`);
                badges.forEach(b => { b.textContent = res.data.count; });
                await loadComments(reviewId);
            } else {
                showAppAlert(res.data.message || 'Lỗi gửi bình luận.', 'Thông báo');
            }
        } catch(e) {
            console.error('Submit comment error:', e);
            if (e.response?.status === 401) {
                showAppConfirm('Phiên đăng nhập đã hết hạn. Chuyển sang trang đăng nhập?', 'Phiên làm việc hết hạn', () => {
                    window.location.href = '/auth/login';
                });
            } else {
                showAppAlert(e.response?.data?.message || 'Không thể gửi bình luận lúc này.', 'Lỗi');
            }
        }
    }

    function triggerPhotoUpload(isCamera) {
        const input = document.getElementById('reviewFileInput');
        if (!input) return;
        if (isCamera) {
            input.setAttribute('capture', 'environment');
            input.removeAttribute('multiple');
        } else {
            input.removeAttribute('capture');
            input.setAttribute('multiple', '');
        }
        input.click();
    }

    // Submit form action
    document.getElementById('reviewForm')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const form = e.target;
        const btn = form.querySelector('button[type="submit"]');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>ĐANG TỐI ƯU ẢNH...';
        
        try {
            const formData = new FormData();
            formData.append('content', form.content.value);
            formData.append('rating', form.rating.value);
            if (form.destination_id && form.destination_id.value) {
                formData.append('destination_id', form.destination_id.value);
            }
            
            // Compress and append all selected files
            if (selectedFiles && selectedFiles.length > 0) {
                for (let i = 0; i < selectedFiles.length; i++) {
                    let file = selectedFiles[i];
                    try {
                        file = await compressImage(file, 1600, 0.85);
                    } catch(cErr) {
                        console.warn("Compression error:", cErr);
                    }
                    formData.append('images', file);
                }
            }

            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>ĐANG ĐĂNG...';

            // Retrieve Location
            if (navigator.geolocation) {
                try {
                    const pos = await new Promise((resolve, reject) => {
                        navigator.geolocation.getCurrentPosition(resolve, reject, { timeout: 3000 });
                    });
                    formData.append('lat', pos.coords.latitude);
                    formData.append('lng', pos.coords.longitude);
                } catch(geoErr) {}
            }

            const res = await axios.post('/api/reviews', formData);
            if (res.data.success) location.reload();
            else showAppAlert(res.data.message || 'Lỗi đăng bài', 'Thông báo');
        } catch(e) {
            showAppAlert('Lỗi đăng bài: ' + (e.response?.data?.message || e.message), 'Lỗi');
        } finally {
            btn.disabled = false;
            btn.innerHTML = 'ĐĂNG BÀI';
        }
    });

    async function deleteUserReview(reviewId, btnEl) {
        showAppConfirm('Bạn có chắc chắn muốn xóa bài viết này? Ảnh trong bài sẽ tự động gỡ khỏi Góc nhìn nghệ thuật.', 'Xóa bài viết', async () => {
            try {
                const res = await axios.post('/api/reviews/delete', { review_id: reviewId });
                if (res.data.success) {
                    const card = btnEl.closest('.card');
                    if (card) card.remove();
                    else location.reload();
                } else {
                    showAppAlert(res.data.message || 'Không thể xóa bài viết', 'Thông báo');
                }
            } catch(e) {
                showAppAlert('Lỗi khi xóa: ' + (e.response?.data?.message || e.message), 'Lỗi');
            }
        });
    }
</script>

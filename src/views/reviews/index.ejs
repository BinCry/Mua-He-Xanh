<% const currentUser = locals.user || (typeof user !== 'undefined' ? user : null); %>
<!-- Premium Social Network Feed -->
<section class="py-4 py-md-5" style="background: #f4f6f5;">
    <div class="container py-3" style="max-width: 680px;">
        
        <!-- Header -->
        <div class="text-center mb-4 reveal-up">
            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 mb-2 text-uppercase fw-bold" style="letter-spacing: 1px; font-size: 0.72rem;">
                <i class="bi bi-chat-heart-fill me-1"></i> Cộng đồng chữa lành
            </span>
            <h2 class="fw-black text-dark mb-1 letter-spacing-sm">Bảng Tin Check-in</h2>
            <p class="text-muted small mx-auto mb-0" style="max-width: 90%; font-size: 0.82rem; line-height: 1.4;">Chia sẻ khoảnh khắc tuyệt vời tại Bình Lợi</p>
        </div>

        <!-- Facebook Style Compose Bar -->
        <% if (user) { %>
        <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 reveal-up bg-white">
            <div class="d-flex align-items-center gap-3 pb-2.5 border-bottom" style="border-color: #e4e6eb !important;">
                <img src="<%= user.avatar || '/images/default-avatar.png' %>" class="rounded-circle flex-shrink-0 shadow-2xs" style="width: 44px; height: 44px; object-fit: cover; border: 2px solid #f0f2f5;">
                <div class="flex-grow-1 cursor-pointer rounded-pill ps-3.5 pe-4 py-2 text-muted small hover-bg-gray transition-all d-flex align-items-center" onclick="openFbCreatePostModal()" style="font-size: 0.95rem; background: #f0f2f5 !important; user-select: none; min-height: 42px; color: #65676b !important;">
                    <span class="ps-1"><%= user.full_name %> ơi, bạn đang nghĩ gì thế?</span>
                </div>
            </div>
            <div class="d-flex align-items-center justify-content-around pt-2 px-1">
                <a href="/reviews/video-editor" class="btn btn-sm btn-link text-decoration-none d-flex align-items-center gap-2 p-1.5 rounded-3 hover-bg-light flex-grow-1 justify-content-center">
                    <i class="bi bi-camera-reels-fill text-danger fs-5"></i>
                    <span class="fw-semibold small text-dark d-none d-sm-inline">Bình Lợi studio</span>
                </a>
                <button type="button" class="btn btn-sm btn-link text-decoration-none d-flex align-items-center gap-2 p-1.5 rounded-3 hover-bg-light flex-grow-1 justify-content-center" onclick="openFbCreatePostModal(true)">
                    <i class="bi bi-images text-success fs-5"></i>
                    <span class="fw-semibold small text-dark">Ảnh/video</span>
                </button>
                <button type="button" class="btn btn-sm btn-link text-decoration-none d-flex align-items-center gap-2 p-1.5 rounded-3 hover-bg-light flex-grow-1 justify-content-center" onclick="openFbCreatePostModal(false, 'emoji')">
                    <i class="bi bi-emoji-smile-fill text-warning fs-5"></i>
                    <span class="fw-semibold small text-dark d-none d-sm-inline">Cảm xúc</span>
                </button>
            </div>
        </div>

        <!-- Facebook "Tạo bài viết" Modal Popup -->
        <div class="modal fade" id="fbCreatePostModal" tabindex="-1" aria-labelledby="fbCreatePostModalLabel" aria-hidden="true" style="z-index: 1060;">
            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width: 520px;">
                <div class="modal-content border-0 rounded-4 shadow-2xl overflow-hidden bg-white">
                    <!-- Modal Header -->
                    <div class="modal-header border-bottom py-2.5 px-3 position-relative text-center d-block bg-white">
                        <h5 class="modal-title fw-bold text-dark fs-6 mb-0" id="fbCreatePostModalLabel">Tạo bài viết</h5>
                        <button type="button" class="btn-close position-absolute end-0 top-50 translate-middle-y me-3 bg-light rounded-circle p-2" data-bs-dismiss="modal" aria-label="Close" style="font-size: 0.7rem;"></button>
                    </div>

                    <!-- Modal Body Form -->
                    <div class="modal-body p-3.5 custom-scrollbar">
                        <form id="reviewForm" enctype="multipart/form-data">
                            <!-- User Profile Info Row -->
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <img src="<%= user.avatar || '/images/default-avatar.png' %>" class="rounded-circle flex-shrink-0 shadow-2xs" style="width: 44px; height: 44px; object-fit: cover; border: 2px solid #f0f2f5;">
                                <div>
                                    <div class="fw-bold text-dark" style="font-size: 0.95rem; line-height: 1.2;"><%= user.full_name %></div>
                                    <div class="d-flex flex-wrap gap-1 mt-1">
                                        <span class="badge bg-light text-dark border rounded-pill px-2 py-0.5 fw-semibold" style="font-size: 0.72rem;">
                                            <i class="bi bi-globe-americas me-1"></i>Công khai
                                        </span>
                                        <span class="badge bg-light text-danger border rounded-pill px-2 py-0.5 fw-semibold cursor-pointer" onclick="toggleDestinationSelector()" id="destBadgeSummary">
                                            <i class="bi bi-geo-alt-fill me-1"></i><span id="destBadgeText">Check-in</span>
                                        </span>
                                        <span class="badge bg-light text-warning border rounded-pill px-2 py-0.5 fw-semibold cursor-pointer" onclick="toggleRatingSelector()" id="ratingBadgeSummary">
                                            <span id="ratingBadgeText">⭐⭐⭐⭐⭐ 5 sao</span>
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <!-- Expandable Destination Selector -->
                            <div class="mb-3 d-none" id="destSelectorContainer">
                                <label class="x-small fw-bold text-muted mb-1 d-block"><i class="bi bi-pin-map-fill text-danger me-1"></i>ĐỊA ĐIỂM CHECK-IN BÌNH LỢI</label>
                                <select name="destination_id" id="fbPostDestinationSelect" class="form-select border rounded-3 py-2 px-3 shadow-none" style="font-size: 0.88rem; background: #f8fafc;" onchange="updateDestBadge(this)">
                                    <option value="">📍 Không gắn thẻ địa điểm cụ thể</option>
                                    <% (typeof destinations !== 'undefined' && destinations ? destinations : []).forEach(d => { %>
                                        <option value="<%= d.id %>"><%= d.name %></option>
                                    <% }) %>
                                </select>
                            </div>

                            <!-- Expandable Rating Selector -->
                            <div class="mb-3 d-none" id="ratingSelectorContainer">
                                <label class="x-small fw-bold text-muted mb-1 d-block"><i class="bi bi-star-fill text-warning me-1"></i>ĐÁNH GIÁ TRẢI NGHIỆM</label>
                                <select name="rating" id="fbPostRatingSelect" class="form-select border rounded-3 py-2 px-3 shadow-none" style="font-size: 0.88rem; background: #f8fafc;" onchange="updateRatingBadge(this)">
                                    <option value="5" selected>⭐⭐⭐⭐⭐ 5 sao - Tuyệt vời</option>
                                    <option value="4">⭐⭐⭐⭐ 4 sao - Rất tốt</option>
                                    <option value="3">⭐⭐⭐ 3 sao - Bình thường</option>
                                    <option value="2">⭐⭐ 2 sao - Tạm được</option>
                                    <option value="1">⭐ 1 sao - Chưa hài lòng</option>
                                </select>
                            </div>

                            <!-- Post Content Textarea -->
                            <div class="position-relative mb-3">
                                <textarea class="form-control border-0 bg-transparent shadow-none p-0" id="fbPostContent" rows="3" name="content" 
                                    placeholder="<%= user.full_name %> ơi, bạn đang nghĩ gì thế?" style="resize: none; font-size: 1.15rem; color: #050505; min-height: 80px;" oninput="handleFbPostInput()"></textarea>
                                
                                <!-- Floating Quick Emojis Drawer Inside Modal -->
                                <div id="fbPostEmojiPopover" class="position-absolute shadow-lg border rounded-4 bg-white p-2" style="display: none; bottom: 10px; right: 0; z-index: 1050; width: 280px;">
                                    <div class="d-flex justify-content-between align-items-center mb-1 pb-1 border-bottom">
                                        <span class="x-small fw-bold text-muted">CHỌN CẢM XÚC</span>
                                        <button type="button" class="btn-close" style="font-size: 0.6rem;" onclick="toggleFbPostEmoji(false)"></button>
                                    </div>
                                    <div class="d-flex flex-wrap gap-1 fs-4 justify-content-start" style="max-height: 140px; overflow-y: auto;">
                                        <span class="cursor-pointer p-1 rounded hover-bg-light" onclick="insertFbPostEmoji('😊')">😊</span>
                                        <span class="cursor-pointer p-1 rounded hover-bg-light" onclick="insertFbPostEmoji('🥰')">🥰</span>
                                        <span class="cursor-pointer p-1 rounded hover-bg-light" onclick="insertFbPostEmoji('😍')">😍</span>
                                        <span class="cursor-pointer p-1 rounded hover-bg-light" onclick="insertFbPostEmoji('😂')">😂</span>
                                        <span class="cursor-pointer p-1 rounded hover-bg-light" onclick="insertFbPostEmoji('😎')">😎</span>
                                        <span class="cursor-pointer p-1 rounded hover-bg-light" onclick="insertFbPostEmoji('🥳')">🥳</span>
                                        <span class="cursor-pointer p-1 rounded hover-bg-light" onclick="insertFbPostEmoji('🌸')">🌸</span>
                                        <span class="cursor-pointer p-1 rounded hover-bg-light" onclick="insertFbPostEmoji('🌿')">🌿</span>
                                        <span class="cursor-pointer p-1 rounded hover-bg-light" onclick="insertFbPostEmoji('🌾')">🌾</span>
                                        <span class="cursor-pointer p-1 rounded hover-bg-light" onclick="insertFbPostEmoji('🚣')">🚣</span>
                                        <span class="cursor-pointer p-1 rounded hover-bg-light" onclick="insertFbPostEmoji('🚴')">🚴</span>
                                        <span class="cursor-pointer p-1 rounded hover-bg-light" onclick="insertFbPostEmoji('🏕️')">🏕️</span>
                                        <span class="cursor-pointer p-1 rounded hover-bg-light" onclick="insertFbPostEmoji('💖')">💖</span>
                                        <span class="cursor-pointer p-1 rounded hover-bg-light" onclick="insertFbPostEmoji('✨')">✨</span>
                                        <span class="cursor-pointer p-1 rounded hover-bg-light" onclick="insertFbPostEmoji('👍')">👍</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Facebook Collage Photo Container Inside Modal (Matches Image 4) -->
                            <div id="fbImageCollageContainer" class="position-relative border rounded-4 overflow-hidden mb-3 bg-light d-none" style="border-color: #e4e6eb !important;">
                                <!-- Top Bar Actions: Edit All & Close -->
                                <div class="position-absolute top-0 start-0 end-0 p-2 d-flex justify-content-between align-items-center" style="z-index: 15; background: linear-gradient(180deg, rgba(0,0,0,0.4) 0%, transparent 100%);">
                                    <button type="button" class="btn btn-sm btn-white rounded-pill px-3 py-1 fw-bold shadow-sm d-flex align-items-center gap-1.5" onclick="triggerPhotoUpload(false)" style="font-size: 0.78rem; background: #fff;">
                                        <i class="bi bi-pencil-fill text-dark" style="font-size: 0.7rem;"></i>
                                        <span>Thêm ảnh / Chỉnh sửa</span>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-white rounded-circle p-0 d-flex align-items-center justify-content-center shadow-sm" style="width: 30px; height: 30px; background: #fff;" onclick="clearAllImages()" title="Gỡ tất cả ảnh">
                                        <i class="bi bi-x-lg fs-6 text-dark"></i>
                                    </button>
                                </div>

                                <!-- Dynamic Facebook Collage Preview Grid -->
                                <div id="fbCollageGrid" class="w-100" style="min-height: 240px;">
                                    <!-- Rendered dynamically via JavaScript -->
                                </div>
                            </div>

                            <!-- Hidden Multiple File Input -->
                            <input type="file" name="images" accept="image/*" multiple class="d-none" id="reviewFileInput" onchange="handleFilesSelected(this)">

                            <!-- "Thêm vào bài viết của bạn" Card Toolbar (Image 2 & 3) -->
                            <div class="border rounded-3 p-2 px-3 mb-3 d-flex align-items-center justify-content-between shadow-2xs bg-white" style="border-color: #ced0d4 !important;">
                                <span class="fw-bold text-dark small" style="font-size: 0.88rem;">Thêm vào bài viết của bạn</span>
                                <div class="d-flex align-items-center gap-1">
                                    <button type="button" class="btn btn-link p-1.5 rounded-circle text-success hover-bg-light text-decoration-none d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;" onclick="triggerPhotoUpload(false)" title="Ảnh/video">
                                        <i class="bi bi-images fs-5"></i>
                                    </button>
                                    <button type="button" class="btn btn-link p-1.5 rounded-circle text-primary hover-bg-light text-decoration-none d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;" onclick="toggleDestinationSelector()" title="Gắn thẻ điểm đến">
                                        <i class="bi bi-geo-alt-fill fs-5 text-danger"></i>
                                    </button>
                                    <button type="button" class="btn btn-link p-1.5 rounded-circle text-warning hover-bg-light text-decoration-none d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;" onclick="toggleFbPostEmoji()" title="Cảm xúc">
                                        <i class="bi bi-emoji-smile-fill fs-5"></i>
                                    </button>
                                    <button type="button" class="btn btn-link p-1.5 rounded-circle text-warning hover-bg-light text-decoration-none d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;" onclick="toggleRatingSelector()" title="Đánh giá 5 sao">
                                        <i class="bi bi-star-fill fs-5"></i>
                                    </button>
                                    <a href="/reviews/video-editor" class="btn btn-link p-1.5 rounded-circle text-danger hover-bg-light text-decoration-none d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;" title="Tạo video hành trình">
                                        <i class="bi bi-camera-reels-fill fs-5 text-success"></i>
                                    </a>
                                </div>
                            </div>

                            <!-- Big Blue Submit Button (Image 2 & 4) -->
                            <button type="submit" id="btnFbSubmitPost" class="btn btn-primary w-100 rounded-3 py-2 fw-bold" style="background: #1877f2 !important; border: none; font-size: 0.95rem;" disabled>
                                Đăng
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <% } else { %>
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 text-center bg-white reveal-up">
            <p class="text-muted mb-3 small">Vui lòng đăng nhập tài khoản để đăng bài viết chia sẻ check-in hoặc tạo video.</p>
            <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                <a href="/auth/login" class="btn btn-primary-bl rounded-pill px-4 py-2">ĐĂNG NHẬP NGAY</a>
                <a href="/reviews/video-editor" class="btn btn-outline-primary-bl rounded-pill px-4 py-2"><i class="bi bi-camera-reels-fill me-1"></i>TẠO VIDEO HÀNH TRÌNH</a>
            </div>
        </div>
        <% } %>

        <!-- Feed List -->
        <div class="d-flex flex-column gap-4 mb-5 pb-5" id="communityFeed">
            <% reviews.forEach((r, i) => { %>
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white reveal-up">
                <!-- User Header -->
                <div class="d-flex align-items-start justify-content-between gap-2 p-3 p-sm-4 pb-2">
                    <div class="d-flex align-items-center gap-3 flex-grow-1 min-w-0">
                        <img src="<%= r.avatar || '/images/default-avatar.png' %>" class="rounded-circle flex-shrink-0" style="width: 44px; height: 44px; object-fit: cover; border: 2px solid var(--primary-100);">
                        <div class="min-w-0 flex-grow-1">
                            <span class="fw-bold d-block text-truncate" style="font-size: 0.92rem; color: #333;"><%= r.full_name %></span>
                            <span class="text-muted d-block text-truncate" style="font-size: 0.72rem;">
                                <% if (r.destination_name) { %>
                                    <span class="text-danger fw-bold"><i class="bi bi-geo-alt-fill me-1"></i><%= r.destination_name %></span> · 
                                <% } else if (r.location_name) { %>
                                    <span class="text-secondary"><i class="bi bi-pin-map-fill me-1"></i><%= r.location_name %></span> · 
                                <% } %>
                                <%= new Date(r.created_at).toLocaleDateString('vi-VN') %>
                            </span>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-shrink-0 pt-1">
                        <div class="text-warning" style="font-size: 0.75rem;">
                            <% for(let s = 0; s < (r.rating || 5); s++) { %><i class="bi bi-star-fill"></i><% } %>
                        </div>
                        <% if (currentUser && (String(currentUser.id) === String(r.user_id) || currentUser.role === 'admin' || currentUser.role === 'manager')) { %>
                        <button class="btn btn-sm btn-light text-danger rounded-circle p-1 ms-1 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" onclick="deleteUserReview('<%= r.id %>', this)" title="Xóa bài viết">
                            <i class="bi bi-trash3-fill"></i>
                        </button>
                        <% } %>
                    </div>
                </div>
                
                <!-- Content text -->
                <div class="px-3 px-sm-4 pb-2">
                    <p class="mb-0 notranslate" translate="no" style="font-size: 0.92rem; line-height: 1.7; color: #444;"><%= r.content %></p>
                </div>

                <!-- Feed Images (Modern Facebook / Instagram Collage) -->
                <% 
                    let imgs = [];
                    if (r.images) {
                        try { 
                            if (typeof r.images === 'string') {
                                imgs = r.images.trim().startsWith('[') ? JSON.parse(r.images) : [r.images];
                            } else if (Array.isArray(r.images)) {
                                imgs = r.images;
                            }
                        } catch(e) {
                            imgs = [r.images];
                        }
                        imgs = (imgs || []).filter(Boolean);
                    }
                    if (imgs.length > 0) { 
                        const galleryJson = JSON.stringify(imgs.map(img => fixImg(img)));
                %>
                <div class="px-3 px-sm-4 py-2">
                    <% if (imgs.length === 1) { %>
                        <!-- 1 Image: Full Hero Square Card -->
                        <div class="rounded-4 overflow-hidden shadow-2xs border bg-light text-center cursor-pointer position-relative" style="width: 100%; aspect-ratio: 1 / 1; max-height: 540px;" onclick='openImageLightbox("<%= fixImg(imgs[0]) %>", <%= galleryJson %>, 0)' title="Nhấn để xem ảnh phóng to đầy đủ">
                            <img src="<%= fixImg(imgs[0]) %>" class="w-100 h-100" style="object-fit: cover; object-position: center;" alt="Review image" loading="lazy" onerror="this.onerror=null; this.src='/images/no-image.svg';">
                        </div>
                    <% } else if (imgs.length === 2) { %>
                        <!-- 2 Images: 2 Columns Side by Side -->
                        <div class="row g-2">
                            <% imgs.forEach((img, idx) => { %>
                            <div class="col-6">
                                <div class="rounded-4 overflow-hidden shadow-2xs border bg-light text-center cursor-pointer position-relative" style="width: 100%; aspect-ratio: 1 / 1;" onclick='openImageLightbox("<%= fixImg(img) %>", <%= galleryJson %>, <%= idx %>)' title="Nhấn để xem ảnh phóng to đầy đủ">
                                    <img src="<%= fixImg(img) %>" class="w-100 h-100" style="object-fit: cover; object-position: center;" alt="Review image" loading="lazy" onerror="this.onerror=null; this.src='/images/no-image.svg';">
                                </div>
                            </div>
                            <% }) %>
                        </div>
                    <% } else if (imgs.length === 3) { %>
                        <!-- 3 Images: 1 Banner Top + 2 Square Bottom -->
                        <div class="row g-2">
                            <div class="col-12">
                                <div class="rounded-4 overflow-hidden shadow-2xs border bg-light text-center cursor-pointer position-relative" style="width: 100%; aspect-ratio: 16 / 9; max-height: 360px;" onclick='openImageLightbox("<%= fixImg(imgs[0]) %>", <%= galleryJson %>, 0)' title="Nhấn để xem ảnh phóng to đầy đủ">
                                    <img src="<%= fixImg(imgs[0]) %>" class="w-100 h-100" style="object-fit: cover; object-position: center;" alt="Review image" loading="lazy" onerror="this.onerror=null; this.src='/images/no-image.svg';">
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="rounded-4 overflow-hidden shadow-2xs border bg-light text-center cursor-pointer position-relative" style="width: 100%; aspect-ratio: 1 / 1;" onclick='openImageLightbox("<%= fixImg(imgs[1]) %>", <%= galleryJson %>, 1)' title="Nhấn để xem ảnh phóng to đầy đủ">
                                    <img src="<%= fixImg(imgs[1]) %>" class="w-100 h-100" style="object-fit: cover; object-position: center;" alt="Review image" loading="lazy" onerror="this.onerror=null; this.src='/images/no-image.svg';">
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="rounded-4 overflow-hidden shadow-2xs border bg-light text-center cursor-pointer position-relative" style="width: 100%; aspect-ratio: 1 / 1;" onclick='openImageLightbox("<%= fixImg(imgs[2]) %>", <%= galleryJson %>, 2)' title="Nhấn để xem ảnh phóng to đầy đủ">
                                    <img src="<%= fixImg(imgs[2]) %>" class="w-100 h-100" style="object-fit: cover; object-position: center;" alt="Review image" loading="lazy" onerror="this.onerror=null; this.src='/images/no-image.svg';">
                                </div>
                            </div>
                        </div>
                    <% } else { %>
                        <!-- 4+ Images: 2x2 Grid with +N Overlay on 4th image -->
                        <div class="row g-2">
                            <% imgs.slice(0, 4).forEach((img, idx) => { %>
                            <div class="col-6">
                                <div class="rounded-4 overflow-hidden shadow-2xs border bg-light text-center cursor-pointer position-relative" style="width: 100%; aspect-ratio: 1 / 1;" onclick='openImageLightbox("<%= fixImg(img) %>", <%= galleryJson %>, <%= idx %>)' title="Nhấn để xem ảnh phóng to đầy đủ">
                                    <img src="<%= fixImg(img) %>" class="w-100 h-100" style="object-fit: cover; object-position: center;" alt="Review image" loading="lazy" onerror="this.onerror=null; this.src='/images/no-image.svg';">
                                    <% if (idx === 3 && imgs.length > 4) { %>
                                    <div class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center text-white" style="background: rgba(0,0,0,0.65); backdrop-filter: blur(4px);">
                                        <i class="bi bi-images fs-3 mb-1"></i>
                                        <span class="fw-bold fs-4">+<%= imgs.length - 3 %></span>
                                        <span class="small fw-semibold opacity-75">Xem tất cả</span>
                                    </div>
                                    <% } %>
                                </div>
                            </div>
                            <% }) %>
                        </div>
                    <% } %>
                </div>
                <% } %>
                
                <!-- Footer Action Buttons -->
                <div class="d-flex align-items-center gap-3 px-3 px-sm-4 py-3" style="font-size: 0.85rem; border-top: 1px solid rgba(0,0,0,0.03);">
                    <button class="btn btn-sm p-0 border-0 bg-transparent d-flex align-items-center gap-1 text-muted" onclick="likeReview('<%= r.id %>', this)">
                        <i class="bi bi-heart fs-5"></i>
                        <span class="fw-bold"><%= r.likes_count || 0 %></span>
                    </button>
                    
                    <button class="btn btn-sm p-0 border-0 bg-transparent d-flex align-items-center gap-1 text-muted" onclick="toggleComments('<%= r.id %>')">
                        <i class="bi bi-chat fs-5"></i>
                        <span class="fw-bold comment-count-<%= r.id %>"><%= r.comments_count || 0 %></span>
                    </button>
                    
                    <div class="d-flex gap-2 ms-auto">

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title><%= title || 'Bình Lợi Studio - Trình Tạo Video Chuẩn CapCut' %></title>
    <!-- Favicon -->
    <link rel="icon" href="/images/logo.svg" type="image/svg+xml">
    <!-- Bootstrap Icons & Fonts -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&family=Montserrat:wght@500;700;800;900&family=Playfair+Display:ital,wght@0,700;1,700&display=swap" rel="stylesheet">
    <!-- CapCut Studio Dedicated CSS -->
    <link rel="stylesheet" href="/css/capcut-studio.css?v=<%= assetV || Date.now() %>">
</head>
<body class="capcut-studio-root">

    <!-- ==================== 1. TOP CAPCUT HEADER ==================== -->
    <header class="capcut-header">
        <!-- Brand & Back -->
        <div class="capcut-brand">
            <a href="/reviews" class="capcut-icon-btn" title="Quay lại Bảng tin">
                <i class="bi bi-chevron-left fs-5"></i>
            </a>
            <div class="capcut-brand-badge">
                <i class="bi bi-scissors fs-5 text-dark"></i>
            </div>
            <div class="d-flex flex-column d-none d-sm-flex">
                <div class="capcut-brand-title">
                    <span>Bình Lợi Studio</span>
                    <span class="capcut-pro-tag">CAPCUT PRO</span>
                </div>
            </div>
        </div>

        <!-- Center Tools (Project Name, Aspect Ratio, Undo/Redo) -->
        <div class="d-flex align-items-center gap-2">
            <!-- Inline Project Name -->
            <div class="capcut-project-name-wrapper d-none d-md-flex">
                <i class="bi bi-cloud-check text-info font-size-xs" id="cloudSyncIcon" title="Tự động đồng bộ"></i>
                <input type="text" id="projectTitleInput" class="capcut-project-input" value="BinhLoi_Video_<%= Math.floor(Math.random()*900000 + 100000) %>" title="Nhấp để đổi tên dự án">
            </div>

            <!-- Aspect Ratio Selector -->
            <select id="aspectRatioSelect" class="capcut-ratio-select" title="Tỉ lệ khung hình">
                <option value="9:16" selected>📱 9:16 (TikTok / Reels)</option>
                <option value="16:9">🖥️ 16:9 (YouTube / Ngang)</option>
                <option value="1:1">📷 1:1 (Vuông Instagram)</option>
                <option value="4:3">🎞️ 4:3 (Cổ điển)</option>
            </select>

            <!-- Undo / Redo -->
            <div class="d-none d-sm-flex align-items-center gap-1">
                <button type="button" class="capcut-icon-btn" id="btnUndo" title="Hoàn tác (Ctrl+Z)">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </button>
                <button type="button" class="capcut-icon-btn" id="btnRedo" title="Làm lại (Ctrl+Y)">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>
        </div>

        <!-- Right Export Button & Resolution -->
        <div class="d-flex align-items-center gap-2">
            <span class="badge d-none d-lg-inline-block px-2 py-1 text-white-50 border border-secondary border-opacity-25" style="font-size: 0.7rem; background: #191b20;">
                1080P · 30 FPS
            </span>
            <button type="button" class="btn-capcut-export" id="btnOpenExportModal">
                <i class="bi bi-box-arrow-up-right fs-6"></i>
                <span>Xuất</span>
            </button>
        </div>
    </header>

    <!-- ==================== 2. MAIN 3-COLUMN DESKTOP BODY ==================== -->
    <div class="capcut-desktop-body">
        
        <!-- LEFT PANEL: Category Rail + Drawer -->
        <aside class="capcut-left-panel">
            <!-- Tier 1: Vertical Icon Rail -->
            <nav class="capcut-rail">
                <button type="button" class="capcut-rail-item active" data-tab="templates" title="Mẫu CapCut có sẵn">
                    <i class="bi bi-collection-play"></i>
                    <span>Mẫu</span>
                </button>
                <button type="button" class="capcut-rail-item" data-tab="media" title="Ảnh & Video của bạn">
                    <i class="bi bi-folder2-open"></i>
                    <span>Media</span>
                </button>
                <button type="button" class="capcut-rail-item" data-tab="audio" title="Nhạc nền & Âm thanh">
                    <i class="bi bi-music-note-beamed"></i>
                    <span>Nhạc</span>
                </button>
                <button type="button" class="capcut-rail-item" data-tab="text" title="Phụ đề & Lời dẫn">
                    <i class="bi bi-fonts"></i>
                    <span>Văn bản</span>
                </button>
                <button type="button" class="capcut-rail-item" data-tab="effects" title="Hiệu ứng chuyển cảnh">
                    <i class="bi bi-magic"></i>
                    <span>Hiệu ứng</span>
                </button>
                <button type="button" class="capcut-rail-item" data-tab="filters" title="Bộ lọc màu sắc (LUTs)">
                    <i class="bi bi-palette"></i>
                    <span>Bộ lọc</span>
                </button>
                <button type="button" class="capcut-rail-item" data-tab="canvas" title="Phông nền video">
                    <i class="bi bi-aspect-ratio"></i>
                    <span>Nền</span>
                </button>
            </nav>

            <!-- Tier 2: Drawer Content -->
            <div class="capcut-drawer capcut-custom-scroll">
                
                <!-- TAB 1: TEMPLATES (Mẫu CapCut Bình Lợi) -->
                <div class="capcut-drawer-pane active" id="pane-templates">
                    <div class="capcut-drawer-header">
                        <h6><i class="bi bi-collection-play text-cyan me-1"></i> Mẫu CapCut Bình Lợi</h6>
                        <span class="badge bg-dark border border-secondary text-white-50 font-size-xs" id="tplCountBadge">6 mẫu</span>
                    </div>
                    <div class="capcut-drawer-body">
                        <div class="d-flex gap-1 mb-3 overflow-x-auto pb-1" style="scrollbar-width: none;">
                            <button type="button" class="btn btn-sm btn-dark text-cyan rounded-pill px-2.5 py-0.5 border border-cyan" style="font-size: 0.7rem;">Tất cả</button>
                            <button type="button" class="btn btn-sm btn-dark text-white-50 rounded-pill px-2.5 py-0.5" style="font-size: 0.7rem;">Hot Trend</button>
                            <button type="button" class="btn btn-sm btn-dark text-white-50 rounded-pill px-2.5 py-0.5" style="font-size: 0.7rem;">Chữa lành</button>
                            <button type="button" class="btn btn-sm btn-dark text-white-50 rounded-pill px-2.5 py-0.5" style="font-size: 0.7rem;">Vlog</button>
                        </div>

                        <div id="templatesListContainer">
                            <!-- Populated dynamically via JS from videoTemplates data -->
                            <% if (videoTemplates && videoTemplates.length > 0) { %>
                                <% videoTemplates.forEach((tpl, idx) => { %>
                                    <div class="capcut-tpl-card <%= idx === 0 ? 'active' : '' %>" data-template-id="<%= tpl.id %>">
                                        <img src="<%= tpl.cover_image || '/images/Poster 1.jpg' %>" alt="<%= tpl.title %>" class="capcut-tpl-thumb">
                                        <div class="capcut-tpl-meta">
                                            <div class="capcut-tpl-title"><%= tpl.title %></div>
                                            <div class="capcut-tpl-info">
                                                <span><i class="bi bi-clock me-1"></i><%= tpl.duration_seconds || 15 %>s</span>
                                                <span class="text-cyan"><i class="bi bi-images me-1"></i><%= Array.isArray(tpl.slots) ? tpl.slots.length : 4 %> phân đoạn</span>
                                            </div>
                                        </div>
                                    </div>
                                <% }) %>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- TAB 2: MEDIA (Tải ảnh & Video của bạn) -->
                <div class="capcut-drawer-pane d-none" id="pane-media">
                    <div class="capcut-drawer-header">
                        <h6><i class="bi bi-images text-cyan me-1"></i> Tải ảnh từ thiết bị</h6>
                        <button type="button" class="btn btn-sm btn-outline-cyan rounded-pill px-2 py-0.5 font-size-xs" id="btnBatchReplace">
                            <i class="bi bi-shuffle me-1"></i>Thay hàng loạt
                        </button>
                    </div>
                    <div class="capcut-drawer-body">
                        <!-- Dropzone -->
                        <div class="p-4 rounded-3 text-center mb-3 cursor-pointer border border-secondary border-dashed" style="background: rgba(255,255,255,0.02); border-color: rgba(0, 240, 255, 0.3) !important;" onclick="document.getElementById('mediaInput').click()">
                            <i class="bi bi-cloud-arrow-up display-6 text-cyan d-block mb-1"></i>
                            <div class="fw-bold text-white small mb-0.5">Nhấp hoặc Kéo thả ảnh vào đây</div>
                            <div class="text-white-50 font-size-xs mb-2">Hỗ trợ JPG, PNG, WEBP (Tự động canh tỉ lệ)</div>
                            <button type="button" class="btn btn-sm btn-cyan text-dark fw-bold rounded-pill px-3 py-1 font-size-xs">
                                + Thêm ảnh mới
                            </button>
                            <input type="file" id="mediaInput" multiple accept="image/*" class="d-none">
                        </div>

                        <!-- Media slots preview list -->
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="font-size-xs text-white-50 fw-bold text-uppercase">Các phân cảnh trong video</span>
                            <span class="font-size-xs text-cyan" id="mediaSlotsCount">0 / 4 ảnh</span>
                        </div>
                        <div id="mediaSlotsList" class="d-flex flex-column gap-2">
                            <!-- Populated dynamically via JS -->
                        </div>
                    </div>
                </div>

                <!-- TAB 3: AUDIO (Âm thanh & Nhạc nền) -->
                <div class="capcut-drawer-pane d-none" id="pane-audio">
                    <div class="capcut-drawer-header">
                        <h6><i class="bi bi-music-note-list text-cyan me-1"></i> Kho nhạc Bình Lợi</h6>
                        <label for="customAudioUpload" class="btn btn-sm btn-outline-cyan rounded-pill px-2 py-0.5 font-size-xs cursor-pointer m-0">
                            + Tải MP3
                        </label>
                        <input type="file" id="customAudioUpload" accept="audio/*" class="d-none">
                    </div>
                    <div class="capcut-drawer-body">
                        <div class="d-flex flex-column gap-2" id="soundscapeList">
                            <% if (soundscapes && soundscapes.length > 0) { %>
                                <% soundscapes.forEach((s, idx) => { %>
                                    <div class="capcut-audio-item <%= idx === 0 ? 'active' : '' %>" data-audio-url="<%= s.audio_url %>" data-audio-title="<%= s.name %>">
                                        <div class="d-flex align-items-center gap-2 min-w-0">
                                            <button type="button" class="capcut-icon-btn btn-play-audio-preview text-cyan" title="Nghe thử">
                                                <i class="bi bi-play-fill fs-5"></i>
                                            </button>
                                            <div class="min-w-0">
                                                <div class="text-truncate small fw-bold text-white"><%= s.name %></div>
                                                <span class="badge bg-dark border border-secondary text-white-50" style="font-size: 0.6rem;"><%= s.mood || 'Chữa lành' %></span>
                                            </div>
                                        </div>
                                        <i class="bi bi-check-circle-fill text-cyan check-icon <%= idx === 0 ? '' : 'd-none' %>"></i>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <div class="capcut-audio-item active" data-audio-url="/audio/peaceful_stream.mp3" data-audio-title="Suối reo miệt vườn">
                                    <div class="d-flex align-items-center gap-2">
                                        <button type="button" class="capcut-icon-btn btn-play-audio-preview text-cyan">
                                            <i class="bi bi-play-fill fs-5"></i>
                                        </button>
                                        <div>
                                            <div class="small fw-bold text-white">Suối reo miệt vườn</div>
                                            <span class="badge bg-dark border border-secondary text-white-50" style="font-size: 0.6rem;">Chữa lành</span>
                                        </div>
                                    </div>
                                    <i class="bi bi-check-circle-fill text-cyan check-icon"></i>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- TAB 4: TEXT (Phụ đề & Lời dẫn) -->
                <div class="capcut-drawer-pane d-none" id="pane-text">
                    <div class="capcut-drawer-header">
                        <h6><i class="bi bi-chat-quote text-cyan me-1"></i> Lời dẫn & Phụ đề</h6>
                    </div>
                    <div class="capcut-drawer-body">
                        <div class="d-flex flex-column gap-3" id="subtitlesListContainer">
                            <!-- Populated dynamically via JS based on template slots -->
                        </div>
                    </div>
                </div>

                <!-- TAB 5: EFFECTS (Hiệu ứng chuyển cảnh) -->
                <div class="capcut-drawer-pane d-none" id="pane-effects">
                    <div class="capcut-drawer-header">
                        <h6><i class="bi bi-magic text-cyan me-1"></i> Hiệu ứng hình ảnh</h6>
                    </div>
                    <div class="capcut-drawer-body">
                        <div class="row g-2">
                            <div class="col-6">
                                <div class="p-3 rounded-3 text-center border border-secondary cursor-pointer capcut-effect-btn active" data-effect="kenburns">
                                    <i class="bi bi-zoom-in fs-4 text-cyan d-block mb-1"></i>
                                    <div class="small fw-bold">Ken Burns</div>
                                    <div class="font-size-xs text-white-50">Phóng to điện ảnh</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 rounded-3 text-center border border-secondary cursor-pointer capcut-effect-btn" data-effect="pan">
                                    <i class="bi bi-arrow-left-right fs-4 text-info d-block mb-1"></i>
                                    <div class="small fw-bold">Pan Lướt</div>
                                    <div class="font-size-xs text-white-50">Trôi ngang êm ái</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 rounded-3 text-center border border-secondary cursor-pointer capcut-effect-btn" data-effect="dissolve">
                                    <i class="bi bi-intersect fs-4 text-warning d-block mb-1"></i>
                                    <div class="small fw-bold">Hòa tan</div>
                                    <div class="font-size-xs text-white-50">Cross Dissolve</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 rounded-3 text-center border border-secondary cursor-pointer capcut-effect-btn" data-effect="flash">
                                    <i class="bi bi-lightning-charge fs-4 text-danger d-block mb-1"></i>
                                    <div class="small fw-bold">Flash Trắng</div>
                                    <div class="font-size-xs text-white-50">TikTok Giật Beat</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TAB 6: FILTERS (Bộ lọc màu sắc) -->
                <div class="capcut-drawer-pane d-none" id="pane-filters">
                    <div class="capcut-drawer-header">
                        <h6><i class="bi bi-palette text-cyan me-1"></i> Bộ lọc màu (LUTs)</h6>
                    </div>
                    <div class="capcut-drawer-body">
                        <div class="row g-2">
                            <div class="col-6">
                                <div class="p-2.5 rounded-3 text-center border border-secondary cursor-pointer capcut-filter-btn active" data-filter="none">
                                    <div class="rounded-2 mb-1.5" style="height: 38px; background: linear-gradient(135deg, #3a3d46 0%, #1f2127 100%);"></div>
                                    <div class="small fw-bold">Tự nhiên (Gốc)</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2.5 rounded-3 text-center border border-secondary cursor-pointer capcut-filter-btn" data-filter="warm">
                                    <div class="rounded-2 mb-1.5" style="height: 38px; background: linear-gradient(135deg, #ff9966 0%, #ff5e62 100%);"></div>
                                    <div class="small fw-bold">Nắng Ấm</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2.5 rounded-3 text-center border border-secondary cursor-pointer capcut-filter-btn" data-filter="cool">
                                    <div class="rounded-2 mb-1.5" style="height: 38px; background: linear-gradient(135deg, #00c6ff 0%, #0072ff 100%);"></div>
                                    <div class="small fw-bold">Rừng Trúc (Emerald)</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2.5 rounded-3 text-center border border-secondary cursor-pointer capcut-filter-btn" data-filter="vintage">
                                    <div class="rounded-2 mb-1.5" style="height: 38px; background: linear-gradient(135deg, #ba8b02 0%, #181818 100%);"></div>
                                    <div class="small fw-bold">Phim Cổ (Vintage)</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2.5 rounded-3 text-center border border-secondary cursor-pointer capcut-filter-btn" data-filter="grayscale">
                                    <div class="rounded-2 mb-1.5" style="height: 38px; background: linear-gradient(135deg, #2c3e50 0%, #000000 100%);"></div>
                                    <div class="small fw-bold">Đen Trắng (Noir)</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TAB 7: CANVAS / BACKGROUND -->
                <div class="capcut-drawer-pane d-none" id="pane-canvas">
                    <div class="capcut-drawer-header">
                        <h6><i class="bi bi-aspect-ratio text-cyan me-1"></i> Bảng vẽ & Nền</h6>
                    </div>
                    <div class="capcut-drawer-body">
                        <label class="capcut-control-label mb-2">Loại phông nền</label>
                        <div class="d-flex gap-2 mb-3">
                            <button type="button" class="btn btn-sm btn-dark border border-cyan text-cyan rounded-pill flex-grow-1" id="btnBgBlur">Làm mờ ảnh</button>
                            <button type="button" class="btn btn-sm btn-dark border border-secondary text-white-50 rounded-pill flex-grow-1" id="btnBgColor">Màu đen</button>
                        </div>
                    </div>
                </div>

            </div>
        </aside>

        <!-- CENTER PANEL: Canvas Preview Monitor (Direct Manipulation) -->
        <main class="capcut-center-panel">
            <!-- Viewport with Bounding Box Overlay -->
            <div class="capcut-viewport-container" id="canvasViewport">
                <!-- HTML5 Core Canvas -->
                <canvas id="studioCanvas" width="540" height="960"></canvas>

                <!-- Magnetic Smart Alignment Guidelines -->
                <div class="capcut-guide-line-x" id="guideLineX"></div>
                <div class="capcut-guide-line-y" id="guideLineY"></div>

                <!-- DIRECT CANVAS BOUNDING BOX (NO POPUPS!) -->
                <div class="capcut-bounding-box" id="studioBBox">
                    <!-- Corner Handles -->
                    <div class="capcut-bbox-handle nw" data-handle="nw"></div>
                    <div class="capcut-bbox-handle ne" data-handle="ne"></div>
                    <div class="capcut-bbox-handle se" data-handle="se"></div>
                    <div class="capcut-bbox-handle sw" data-handle="sw"></div>
                    <!-- Edge Handles -->
                    <div class="capcut-bbox-handle n" data-handle="n"></div>
                    <div class="capcut-bbox-handle s" data-handle="s"></div>
                    <div class="capcut-bbox-handle e" data-handle="e"></div>
                    <div class="capcut-bbox-handle w" data-handle="w"></div>
                    <!-- Rotator Pin -->
                    <div class="capcut-bbox-rotator-stem"></div>
                    <div class="capcut-bbox-rotator" id="bboxRotator" title="Xoay ảnh 360°">
                        <i class="bi bi-arrow-repeat"></i>
                    </div>
                </div>
            </div>

            <!-- Floating Control Bar Under Canvas -->
            <div class="capcut-monitor-dock">
                <button type="button" class="capcut-dock-btn" id="btnRewind" title="Tua về đầu">
                    <i class="bi bi-skip-start-fill"></i>
                </button>
                <button type="button" class="capcut-dock-btn" id="btnPrevFrame" title="Lùi 1 khung hình">
                    <i class="bi bi-caret-left-fill"></i>
                </button>
                <button type="button" class="capcut-dock-btn play" id="btnPlayPause" title="Phát / Tạm dừng (Space)">
                    <i class="bi bi-play-circle-fill"></i>
                </button>
                <button type="button" class="capcut-dock-btn" id="btnNextFrame" title="Tới 1 khung hình">
                    <i class="bi bi-caret-right-fill"></i>
                </button>
                <div class="capcut-dock-time" id="dockTimecode">00:00 / 00:15</div>
                <button type="button" class="capcut-dock-btn" id="btnToggleMute" title="Bật / Tắt âm thanh">
                    <i class="bi bi-volume-up-fill" id="dockMuteIcon"></i>
                </button>
                <button type="button" class="capcut-dock-btn" id="btnFitCanvas" title="Vừa vặn màn hình">
                    <i class="bi bi-arrows-angle-expand"></i>
                </button>
            </div>
        </main>

        <!-- RIGHT PANEL: Contextual Property Inspector -->
        <aside class="capcut-right-panel capcut-custom-scroll">
            <div class="capcut-inspector-header">
                <button type="button" class="capcut-inspector-tab-btn active" data-itab="basic">Cơ bản</button>
                <button type="button" class="capcut-inspector-tab-btn" data-itab="adjust">Màu sắc</button>
                <button type="button" class="capcut-inspector-tab-btn" data-itab="audio">Âm thanh</button>
            </div>
            
            <div class="capcut-inspector-body">
                <!-- Tab: Basic (Position, Scale, Rotate, Opacity) -->
                <div class="capcut-itab-pane active" id="itab-basic">
                    <div class="capcut-control-group">
                        <label class="capcut-control-label">
                            <span>Thu phóng (Tỉ lệ)</span>
                            <span class="text-cyan font-size-xs" id="valScale">100%</span>
                        </label>
                        <input type="range" class="capcut-range-slider" id="sliderScale" min="50" max="300" value="100">
                    </div>

                    <div class="capcut-control-group">
                        <label class="capcut-control-label">
                            <span>Góc xoay</span>
                            <span class="text-cyan font-size-xs" id="valRotate">0°</span>
                        </label>
                        <input type="range" class="capcut-range-slider" id="sliderRotate" min="-180" max="180" value="0">
                    </div>

                    <div class="capcut-control-group">
                        <label class="capcut-control-label">
                            <span>Vị trí ngang (X)</span>
                            <span class="text-cyan font-size-xs" id="valPosX">0 px</span>
                        </label>
                        <input type="range" class="capcut-range-slider" id="sliderPosX" min="-200" max="200" value="0">
                    </div>

                    <div class="capcut-control-group">
                        <label class="capcut-control-label">
                            <span>Vị trí dọc (Y)</span>
                            <span class="text-cyan font-size-xs" id="valPosY">0 px</span>
                        </label>
                        <input type="range" class="capcut-range-slider" id="sliderPosY" min="-200" max="200" value="0">
                    </div>

                    <div class="capcut-control-group">
                        <label class="capcut-control-label">
                            <span>Độ mờ (Opacity)</span>
                            <span class="text-cyan font-size-xs" id="valOpacity">100%</span>
                        </label>
                        <input type="range" class="capcut-range-slider" id="sliderOpacity" min="10" max="100" value="100">
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="button" class="btn btn-sm btn-dark border border-secondary text-white-50 rounded-pill" id="btnResetTransform">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>Đặt lại góc nhìn ảnh
                        </button>
                    </div>
                </div>

                <!-- Tab: Adjust (Brightness, Contrast, Saturation) -->
                <div class="capcut-itab-pane d-none" id="itab-adjust">
                    <div class="capcut-control-group">
                        <label class="capcut-control-label">
                            <span>Độ sáng (Brightness)</span>
                            <span class="text-cyan font-size-xs" id="valBrightness">100%</span>
                        </label>
                        <input type="range" class="capcut-range-slider" id="sliderBrightness" min="50" max="150" value="100">
                    </div>

                    <div class="capcut-control-group">
                        <label class="capcut-control-label">
                            <span>Độ tương phản (Contrast)</span>
                            <span class="text-cyan font-size-xs" id="valContrast">100%</span>
                        </label>
                        <input type="range" class="capcut-range-slider" id="sliderContrast" min="50" max="150" value="100">
                    </div>

                    <div class="capcut-control-group">
                        <label class="capcut-control-label">
                            <span>Độ bão hòa màu (Saturation)</span>
                            <span class="text-cyan font-size-xs" id="valSaturation">100%</span>
                        </label>
                        <input type="range" class="capcut-range-slider" id="sliderSaturation" min="0" max="200" value="100">
                    </div>
                </div>

                <!-- Tab: Audio (Volume, Fade) -->
                <div class="capcut-itab-pane d-none" id="itab-audio">
                    <div class="capcut-control-group">
                        <label class="capcut-control-label">
                            <span>Âm lượng nhạc</span>
                            <span class="text-cyan font-size-xs" id="valVolume">100%</span>
                        </label>
                        <input type="range" class="capcut-range-slider" id="sliderVolume" min="0" max="200" value="100">
                    </div>
                </div>
            </div>
        </aside>

    </div>

    <!-- ==================== 3. BOTTOM MULTI-TRACK TIMELINE ==================== -->
    <footer class="capcut-timeline-panel">
        <!-- Toolbar above tracks -->
        <div class="capcut-timeline-toolbar">
            <div class="d-flex align-items-center gap-1">
                <button type="button" class="capcut-tool-btn" id="toolSplit" title="Tách phân cảnh (Ctrl+B)">
                    <i class="bi bi-scissors"></i>
                    <span>Tách</span>
                </button>
                <button type="button" class="capcut-tool-btn" id="toolDelete" title="Xóa phân cảnh (Del)">
                    <i class="bi bi-trash3"></i>
                    <span>Xóa</span>
                </button>
                <button type="button" class="capcut-tool-btn" id="toolDuplicate" title="Nhân đôi">
                    <i class="bi bi-copy"></i>
                    <span>Nhân bản</span>
                </button>
                <button type="button" class="capcut-tool-btn" id="toolBatch" title="Thay thế tất cả ảnh">
                    <i class="bi bi-shuffle"></i>
                    <span>Thay loạt ảnh</span>
                </button>
            </div>

            <!-- Timecode & Duration Info -->
            <div class="d-flex align-items-center gap-3">
                <span class="font-size-xs text-white-50"><i class="bi bi-film text-cyan me-1"></i><span id="tlClipCount">4</span> clip</span>
                <span class="font-size-xs text-white-50"><i class="bi bi-clock text-cyan me-1"></i><span id="tlDurationLabel">15.0s</span></span>
            </div>
        </div>

        <!-- Scrollable Tracks Container -->
        <div class="capcut-timeline-tracks-scroll capcut-custom-scroll" id="timelineScrollArea">
            
            <!-- Red Playhead Needle (Desktop) -->
            <div class="capcut-playhead" id="timelinePlayhead" style="left: 16px;">
                <div class="capcut-playhead-knob"></div>
            </div>

            <!-- Mobile Center Needle Indicator (< 992px) -->
            <div class="capcut-mobile-playhead-center d-none" id="mobileCenterNeedle"></div>

            <!-- Time Ruler Bar -->
            <div class="capcut-ruler" id="timelineRuler">
                <!-- Ticks rendered via JS -->
            </div>

            <!-- Track 1: Video / Photo Clips Filmstrip -->
            <div class="capcut-track-video" id="videoTrackContainer">
                <!-- Dynamic clip blocks -->
            </div>

            <!-- Track 2: Subtitles Track -->
            <div class="capcut-track-subtitles" id="subtitlesTrackContainer">
                <!-- Dynamic subtitle blocks -->
            </div>

            <!-- Track 3: Audio Track -->
            <div class="capcut-track-audio" id="audioTrackContainer">
                <div class="capcut-audio-bar">
                    <i class="bi bi-music-note"></i>
                    <span id="tlAudioName">Suối reo miệt vườn - Nhạc bản quyền Bình Lợi</span>
                </div>
            </div>

        </div>
    </footer>

    <!-- ==================== 4. MOBILE BOTTOM STICKY DOCK (< 992px) ==================== -->
    <div class="capcut-mobile-bottom-bar d-none">
        <button type="button" class="capcut-m-btn active" data-mtab="templates">
            <i class="bi bi-collection-play"></i>
            <span>Mẫu</span>
        </button>
        <button type="button" class="capcut-m-btn" data-mtab="media">
            <i class="bi bi-folder2-open"></i>
            <span>Ảnh</span>
        </button>
        <button type="button" class="capcut-m-btn" data-mtab="audio">
            <i class="bi bi-music-note-beamed"></i>
            <span>Nhạc</span>
        </button>
        <button type="button" class="capcut-m-btn" data-mtab="text">
            <i class="bi bi-fonts"></i>
            <span>Chữ</span>
        </button>
        <button type="button" class="capcut-m-btn" data-mtab="effects">
            <i class="bi bi-magic"></i>
            <span>Hiệu ứng</span>
        </button>
        <button type="button" class="capcut-m-btn" data-mtab="filters">
            <i class="bi bi-palette"></i>
            <span>Bộ lọc</span>
        </button>
    </div>

    <!-- Mobile Slide-Up Drawer Sheet -->
    <div class="capcut-mobile-sheet" id="mobileDrawerSheet">
        <div class="d-flex justify-content-between align-items-center p-3 border-bottom border-secondary border-opacity-25">
            <h6 class="m-0 text-white font-size-sm fw-bold" id="mobileSheetTitle">Mẫu CapCut</h6>
            <button type="button" class="btn-close btn-close-white" id="btnCloseMobileSheet"></button>
        </div>
        <div class="p-3 overflow-y-auto" id="mobileSheetContent" style="max-height: 40vh;">
            <!-- Rendered dynamically -->
        </div>
    </div>

    <!-- ==================== 5. EXPORT VIDEO MODAL POPUP ==================== -->
    <div class="modal fade" id="capcutExportModal" tabindex="-1" aria-hidden="true" style="z-index: 1050; display: none;">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
            <div class="modal-content border-0 rounded-4 overflow-hidden text-white" style="background: #18191d; border: 1px solid #2e313a !important;">
                <div class="modal-header border-bottom border-secondary border-opacity-25 py-3 px-4">
                    <div class="d-flex align-items-center gap-2">
                        <div class="capcut-brand-badge" style="width: 26px; height: 26px;">
                            <i class="bi bi-scissors fs-6 text-dark"></i>
                        </div>
                        <h5 class="modal-title fw-bold fs-6 mb-0">Xuất video CapCut Pro</h5>
                    </div>
                    <button type="button" class="capcut-icon-btn" id="btnCloseExportModal" style="margin-right: -8px;">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="font-size-xs fw-bold text-white-50 text-uppercase mb-1.5 d-block">Định dạng & Chất lượng</label>
                        <div class="d-flex gap-2">
                            <span class="badge text-dark fw-bold px-2.5 py-1.5" style="background: var(--capcut-cyan);">1080P Full HD</span>
                            <span class="badge bg-dark border border-secondary text-white-50 px-2.5 py-1.5">30 FPS</span>
                            <span class="badge bg-dark border border-secondary text-white-50 px-2.5 py-1.5" id="exportRatioBadge">9:16</span>
                        </div>
                    </div>

                    <!-- Progress Bar (hidden during prep) -->
                    <div id="exportProgressWrapper" class="mb-3 d-none">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="font-size-xs fw-bold text-cyan" id="exportStatusLabel">Đang kết xuất khung hình...</span>
                            <span class="font-size-xs fw-bold text-white" id="exportPercentLabel">0%</span>
                        </div>
                        <div class="progress rounded-pill bg-dark border border-secondary border-opacity-30" style="height: 8px;">
                            <div id="exportProgressBar" class="progress-bar progress-bar-striped progress-bar-animated" style="width: 0%; background: var(--capcut-cyan);"></div>
                        </div>
                    </div>

                    <!-- Action Button -->
                    <div class="d-grid gap-2 mt-4">
                        <button type="button" class="btn-capcut-export py-2.5 justify-content-center" id="btnStartExport">
                            <i class="bi bi-download fs-5"></i>
                            <span>BẮT ĐẦU XUẤT VIDEO</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Hidden audio element for fallback soundscapes -->
    <audio id="bgAudioPlayer" preload="auto"></audio>

    <!-- Embedded Initial Data -->
    <script>
        window.__CAPCUT_TEMPLATES__ = <%- JSON.stringify(videoTemplates || []) %>;
        window.__CAPCUT_SOUNDSCAPES__ = <%- JSON.stringify(soundscapes || []) %>;
    </script>

    <!-- Core Video Editor Client Engine -->
    <script src="/js/video-editor.js?v=<%= assetV || Date.now() %>"></script>
</body>
</html>

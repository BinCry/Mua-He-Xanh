<!-- Bình Lợi Studio – Trình Tạo Video Ngắn -->
<div class="bl-studio-workspace" id="blStudioWorkspace">
    <!-- 1. HEADER / THANH ĐIỀU HƯỚNG TRÊN CÙNG -->
    <header class="bl-studio-header d-flex align-items-center justify-content-between px-4 border-bottom bg-white shadow-2xs">
        <!-- Bên trái: Logo & Branding -->
        <div class="d-flex align-items-center gap-3">
            <a href="/reviews" class="btn btn-sm bl-btn-back rounded-circle d-flex align-items-center justify-content-center me-1" title="Quay lại Bảng tin">
                <i class="bi bi-arrow-left fs-6"></i>
            </a>
            <div class="d-flex align-items-center gap-3">
                <img src="<%= fixImg(settings.brand_logo, '/images/logo.png') %>" alt="Bình Lợi Studio" class="rounded-circle shadow-2xs flex-shrink-0" style="width: 38px; height: 38px; object-fit: cover; border: 1.5px solid #FEE2E2;" onerror="this.src='/images/logo.png'">
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-bold text-dark fs-6" style="letter-spacing: -0.2px;">Bình Lợi Studio</span>
                        <span class="badge bl-badge-pro fw-bold ms-1">PRO</span>
                    </div>
                    <div class="text-muted x-small mt-0.5" style="font-size: 0.74rem;">Trình Tạo Video Ngắn Bình Lợi</div>
                </div>
            </div>
        </div>

        <!-- Khu vực giữa: Tên project & Trạng thái lưu -->
        <div class="d-none d-md-flex align-items-center gap-2.5 px-3.5 py-1.5 rounded-pill bl-project-name-wrapper border shadow-2xs">
            <i class="bi bi-pencil-square text-muted font-size-sm"></i>
            <input type="text" class="bl-project-title-input font-size-sm fw-semibold" id="projectTitleInput" value="Video Bình Lợi – Chữa Lành" placeholder="Nhập tên dự án...">
            <span class="bl-status-saved d-flex align-items-center gap-2 text-success font-size-xs fw-semibold ms-2" id="saveStatusIndicator">
                <i class="bi bi-check-circle-fill"></i>
                <span>Đã lưu</span>
            </span>
        </div>

        <!-- Bên phải: Các công cụ thao tác nhanh (Undo, Redo, Play, Xuất video) -->
        <div class="d-flex align-items-center gap-2.5">
            <button type="button" class="btn btn-sm bl-btn-icon" id="btnUndo" title="Hoàn tác (Ctrl+Z)" disabled>
                <i class="bi bi-arrow-counterclockwise fs-5"></i>
            </button>
            <button type="button" class="btn btn-sm bl-btn-icon" id="btnRedo" title="Làm lại (Ctrl+Y)" disabled>
                <i class="bi bi-arrow-clockwise fs-5"></i>
            </button>
            <div class="vr my-1 bl-vr mx-1"></div>
            <button type="button" class="btn btn-sm bl-btn-secondary d-none d-sm-flex align-items-center gap-2 px-3 py-1.5 rounded-pill" id="btnHeaderPlay">
                <i class="bi bi-play-fill fs-5"></i>
                <span>Xem trước</span>
            </button>
            <button type="button" class="btn btn-sm bl-btn-secondary d-none d-lg-flex align-items-center gap-2 px-3 py-1.5 rounded-pill" id="btnSaveProject">
                <i class="bi bi-floppy fs-6"></i>
                <span>Lưu</span>
            </button>
            <!-- Nút Export nổi bật màu đỏ -->
            <button type="button" class="btn btn-sm bl-btn-export fw-bold d-flex align-items-center gap-2 shadow-sm px-4 py-1.5 rounded-pill ms-1" id="btnOpenExportModal">
                <i class="bi bi-box-arrow-up-right fs-6"></i>
                <span>Xuất video</span>
            </button>
        </div>
    </header>

    <!-- 2. THÂN STUDIO (3 CỘT: SIDEBAR + DRAWER, CANVAS MONITOR, PROPERTIES PANEL) -->
    <div class="bl-studio-body d-flex">
        <!-- CỘT 1: SIDEBAR CÔNG CỤ TRÁI + DRAWER NỘI DUNG (RỘNG 440px) -->
        <aside class="bl-left-panel d-flex border-end bg-white">
            <!-- Sidebar Cố Định Biểu Tượng (Rộng 74px, tối ưu khoảng cách không bị khuất nút) -->
            <nav class="bl-nav-rail d-flex flex-column align-items-center py-2 border-end bg-white">
                <button type="button" class="bl-rail-btn active" data-tab="templates" onclick="switchStudioTab('templates')" title="Mẫu Video">
                    <i class="bi bi-stars fs-5 text-danger"></i>
                    <span>Mẫu Video</span>
                </button>
                <button type="button" class="bl-rail-btn" data-tab="media" onclick="switchStudioTab('media')" title="Hình ảnh & Video">
                    <i class="bi bi-collection-play fs-5"></i>
                    <span>Ảnh/Video</span>
                </button>
                <button type="button" class="bl-rail-btn" data-tab="audio" onclick="switchStudioTab('audio')" title="Âm thanh & Nhạc nền">
                    <i class="bi bi-music-note-beamed fs-5"></i>
                    <span>Âm thanh</span>
                </button>
                <button type="button" class="bl-rail-btn" data-tab="text" onclick="switchStudioTab('text')" title="Văn bản & Phụ đề">
                    <i class="bi bi-fonts fs-5"></i>
                    <span>Văn bản</span>
                </button>
                <button type="button" class="bl-rail-btn" data-tab="effects" onclick="switchStudioTab('effects')" title="Hiệu ứng">
                    <i class="bi bi-magic fs-5"></i>
                    <span>Hiệu ứng</span>
                </button>
                <button type="button" class="bl-rail-btn" data-tab="filters" onclick="switchStudioTab('filters')" title="Bộ lọc màu">
                    <i class="bi bi-palette fs-5"></i>
                    <span>Bộ lọc</span>
                </button>
                <button type="button" class="bl-rail-btn" data-tab="transitions" onclick="switchStudioTab('transitions')" title="Chuyển cảnh">
                    <i class="bi bi-distribute-horizontal fs-5"></i>
                    <span>Chuyển cảnh</span>
                </button>
                <button type="button" class="bl-rail-btn" data-tab="canvas" onclick="switchStudioTab('canvas')" title="Tỷ lệ khung hình">
                    <i class="bi bi-aspect-ratio fs-5"></i>
                    <span>Tỷ lệ</span>
                </button>
                <button type="button" class="bl-rail-btn" data-tab="speed" onclick="switchStudioTab('speed')" title="Tốc độ phát">
                    <i class="bi bi-speedometer2 fs-5"></i>
                    <span>Tốc độ</span>
                </button>
            </nav>

            <!-- Drawer Panel Bên Cạnh Sidebar (Chiều rộng 360px) -->
            <div class="bl-drawer-panel p-3.5 custom-scrollbar bg-white">
                <!-- 0. TAB: MẪU VIDEO -->
                <div class="bl-tab-pane active" id="spane-templates">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h6 class="fw-bold text-dark mb-0 fs-6"><i class="bi bi-stars text-danger me-2"></i>Mẫu Video Bình Lợi</h6>
                            <span class="text-muted x-small">Chọn mẫu 1-chạm & chỉ cần thêm ảnh</span>
                        </div>
                        <span class="badge bg-danger text-white px-2.5 py-1 rounded-pill font-size-xs fw-bold">Xu hướng</span>
                    </div>

                    <!-- Category Filter Chips -->
                    <div class="d-flex gap-1.5 mb-3 overflow-x-auto pb-1 no-scrollbar" id="templateFilterChips">
                        <button type="button" class="btn btn-sm bl-chip-btn active" onclick="filterTemplates('all')">Tất cả</button>
                        <button type="button" class="btn btn-sm bl-chip-btn" onclick="filterTemplates('healing')">Chữa lành</button>
                        <button type="button" class="btn btn-sm bl-chip-btn" onclick="filterTemplates('vlog')">Vlog Sen</button>
                        <button type="button" class="btn btn-sm bl-chip-btn" onclick="filterTemplates('chill')">Hoàng Hôn</button>
                        <button type="button" class="btn btn-sm bl-chip-btn" onclick="filterTemplates('langmai')">Làng Mai</button>
                        <button type="button" class="btn btn-sm bl-chip-btn" onclick="filterTemplates('food')">Ẩm Thực</button>
                    </div>

                    <!-- Templates Cards List -->
                    <div class="d-flex flex-column gap-3" id="templateCardsContainer">
                        <!-- Populated dynamically via JS -->
                    </div>
                </div>

                <!-- 1. TAB: MEDIA (Tải ảnh, Thư viện ảnh Bình Lợi) -->
                <div class="bl-tab-pane" id="spane-media">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="bl-panel-heading">
                            <h6 class="fw-bold text-dark mb-0 fs-6"><i class="bi bi-images text-danger me-2"></i>Thư viện Media</h6>
                            <span class="text-muted x-small">Thêm ảnh để bắt đầu video của bạn</span>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1 fw-semibold font-size-xs d-flex align-items-center gap-1.5" onclick="document.getElementById('media-files').click()">
                            <i class="bi bi-plus-lg"></i> Tải ảnh lên
                        </button>
                        <input type="file" id="media-files" multiple accept="image/*,video/*" class="d-none">
                    </div>

                    <!-- Category Pills: Bình Lợi Library, My Media -->
                    <div class="d-flex gap-1 mb-3 p-1 rounded-3 bg-light border">
                        <button type="button" class="btn btn-sm bl-subtab-btn active flex-grow-1" data-mediasub="binhloi" onclick="switchMediaSubTab('binhloi')">Bình Lợi Mẫu</button>
                        <button type="button" class="btn btn-sm bl-subtab-btn flex-grow-1" data-mediasub="my" onclick="switchMediaSubTab('my')">Ảnh Của Bạn</button>
                    </div>

                    <!-- Sub 1: Thư viện Bình Lợi Library có sẵn -->
                    <div id="mediaSubBinhLoi">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span class="x-small text-muted fw-bold text-uppercase">Ảnh phong cảnh Bình Lợi</span>
                            <button type="button" class="btn btn-link p-0 x-small text-danger text-decoration-none fw-semibold" id="btnLoadAllPresetPhotos">
                                <i class="bi bi-lightning-fill"></i> Dùng tất cả ảnh
                            </button>
                        </div>
                        <div class="row g-3" id="presetPhotosGrid">
                            <!-- Populated dynamically via JS -->
                        </div>
                    </div>

                    <!-- Sub 2: My Media (Tải lên từ máy) -->
                    <div id="mediaSubMy" class="d-none">
                        <!-- Dropzone -->
                        <div id="dropzone" class="bl-dropzone p-4 rounded-4 text-center cursor-pointer mb-3" onclick="document.getElementById('media-files').click()">
                            <i class="bi bi-cloud-arrow-up text-danger display-5 d-block mb-2"></i>
                            <div class="fw-bold text-dark small mb-1">Tải ảnh hoặc video lên</div>
                            <div class="text-muted x-small mb-3">Kéo thả tệp JPG, PNG, MP4 từ máy tính</div>
                            <span class="btn btn-sm btn-danger rounded-pill px-3.5 py-1.5 font-size-xs fw-semibold">
                                <i class="bi bi-upload me-1.5"></i>Chọn tệp từ máy
                            </span>
                        </div>

                        <!-- Danh sách tệp đã tải lên -->
                        <div id="myUploadedMediaWrapper" class="d-none">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="x-small text-muted fw-bold text-uppercase">Tệp của bạn</span>
                                <button type="button" class="btn btn-link p-0 x-small text-danger text-decoration-none" onclick="clearAllLoadedImages()">Xóa tất cả</button>
                            </div>
                            <div class="row g-2.5" id="myUploadedMediaGrid"></div>
                        </div>
                    </div>
                </div>

                <!-- 2. TAB: TEXT (Thêm chữ & Presets kịch bản) -->
                <div class="bl-tab-pane" id="spane-text">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h6 class="fw-bold text-dark mb-0 fs-6"><i class="bi bi-fonts text-danger me-2"></i>Văn bản & Phụ đề</h6>
                            <span class="text-muted x-small">Phụ đề hiển thị theo thời gian trên video</span>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1 font-size-xs fw-semibold" id="btnAddNewText">
                            <i class="bi bi-plus-lg"></i> Thêm chữ
                        </button>
                    </div>

                    <!-- Gợi ý kịch bản chữ theo từng khoảnh khắc -->
                    <div class="mb-3.5">
                        <label class="x-small fw-bold text-muted text-uppercase mb-2 d-block">1. Mở đầu (Hook 0s - 4s)</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-chat-quote"></i></span>
                            <input type="text" class="form-control border-start-0 ps-0" id="text-hook" placeholder="Ví dụ: Rời xa khói bụi thành phố, về Bình Lợi thôi...">
                        </div>
                    </div>

                    <div class="mb-3.5">
                        <label class="x-small fw-bold text-muted text-uppercase mb-2 d-block">2. Trải nghiệm (Immersion 4s - 8s)</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-tree"></i></span>
                            <input type="text" class="form-control border-start-0 ps-0" id="text-immersion" placeholder="Ví dụ: Không gian thanh bình bên bóng dừa mát...">
                        </div>
                    </div>

                    <div class="mb-3.5">
                        <label class="x-small fw-bold text-muted text-uppercase mb-2 d-block">3. Điểm nhấn (Highlight 8s - 12s)</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-heart"></i></span>
                            <input type="text" class="form-control border-start-0 ps-0" id="text-highlight" placeholder="Ví dụ: Chữa lành từ những điều mộc mạc nhất...">
                        </div>
                    </div>

                    <div class="mb-3.5">
                        <label class="x-small fw-bold text-muted text-uppercase mb-2 d-block">4. Kết thúc (Outro 12s - 15s)</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-geo-alt"></i></span>
                            <input type="text" class="form-control border-start-0 ps-0" id="text-outro" placeholder="Ví dụ: Hẹn gặp bạn tại Bình Lợi vào cuối tuần!">
                        </div>
                    </div>

                    <!-- Các kiểu chữ mẫu (Typography Presets) -->
                    <div class="mt-4">
                        <label class="x-small fw-bold text-muted text-uppercase d-block" style="margin-bottom: .75rem;">Kiểu chữ đẹp có sẵn</label>
                        <div class="row g-2">
                            <div class="col-6">
                                <button type="button" class="btn btn-sm btn-outline-secondary w-100 py-2 rounded-3 text-start d-flex align-items-center justify-content-between" onclick="applyTextStylePreset('modern')">
                                    <span class="fw-bold small">Hiện đại</span>
                                    <span class="badge bg-dark text-white">Inter</span>
                                </button>
                            </div>
                            <div class="col-6">
                                <button type="button" class="btn btn-sm btn-outline-secondary w-100 py-2 rounded-3 text-start d-flex align-items-center justify-content-between" onclick="applyTextStylePreset('cinematic')">
                                    <span class="fw-bold small">Điện ảnh</span>
                                    <span class="badge bg-warning text-dark">Gold</span>
                                </button>
                            </div>
                            <div class="col-6">
                                <button type="button" class="btn btn-sm btn-outline-secondary w-100 py-2 rounded-3 text-start d-flex align-items-center justify-content-between" onclick="applyTextStylePreset('handwrite')">
                                    <span class="fw-bold small">Thơ mộng</span>
                                    <span class="badge bg-info text-dark">Script</span>
                                </button>
                            </div>
                            <div class="col-6">
                                <button type="button" class="btn btn-sm btn-outline-secondary w-100 py-2 rounded-3 text-start d-flex align-items-center justify-content-between" onclick="applyTextStylePreset('subtitle')">
                                    <span class="fw-bold small">Phụ đề chuẩn</span>
                                    <span class="badge bg-secondary text-white">Box</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. TAB: AUDIO (Nhạc nền, Soundscapes) -->
                <div class="bl-tab-pane" id="spane-audio">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="bl-panel-heading">
                            <h6 class="fw-bold text-dark mb-0 fs-6"><i class="bi bi-music-note-beamed text-danger me-2"></i>Âm thanh & Nhạc nền</h6>
                            <span class="text-muted x-small">Nhạc chữa lành độc quyền Bình Lợi</span>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1 font-size-xs fw-semibold" onclick="document.getElementById('userAudioFile').click()">
                            <i class="bi bi-upload"></i> Tải nhạc
                        </button>
                        <input type="file" id="userAudioFile" accept="audio/*" class="d-none" onchange="handleUserAudioUpload(this)">
                    </div>

                    <!-- File nhạc do người dùng tải lên nếu có -->
                    <div id="userAudioBadgeWrapper" class="d-none mb-3">
                        <div class="p-3 rounded-3 border bg-light d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2.5 min-w-0">
                                <i class="bi bi-file-earmark-music-fill text-danger fs-5"></i>
                                <div class="min-w-0">
                                    <div class="fw-bold text-dark text-truncate small" id="userAudioTitle">Tên bài nhạc</div>
                                    <span class="badge bg-danger-subtle text-danger font-size-xs">Nhạc của bạn</span>
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-sm btn-light border p-1" id="btnPreviewUserAudio" title="Nghe thử"><i class="bi bi-play-circle fs-5"></i></button>
                                <button type="button" class="btn btn-sm btn-danger rounded-pill px-2.5 py-1 font-size-xs fw-semibold" id="btnSelectUserAudio">Chọn</button>
                            </div>
                        </div>
                    </div>

                    <!-- Danh sách Soundscape có sẵn -->
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <label class="x-small fw-bold text-muted text-uppercase mb-0">Thư viện nhạc Bình Lợi</label>
                        <span class="text-muted x-small">Bản quyền mở</span>
                    </div>
                    <div class="d-flex flex-column gap-2" id="soundscapeList">
                        <% if (soundscapes && soundscapes.length > 0) { %>
                            <% soundscapes.forEach((sound, index) => { %>
                                <div class="bl-audio-card p-3 rounded-3 border bg-white d-flex align-items-center justify-content-between cursor-pointer shadow-2xs" data-audio-url="<%= sound.audio_url %>" data-audio-name="<%= sound.name %>">
                                    <div class="d-flex align-items-center gap-3 min-w-0 flex-grow-1 me-2">
                                        <div class="bl-audio-icon rounded-circle d-flex align-items-center justify-content-center flex-shrink-0">
                                            <i class="bi bi-soundwave fs-5 text-danger"></i>
                                        </div>
                                        <div class="min-w-0 flex-grow-1">
                                            <div class="fw-bold text-dark text-truncate small" style="font-size: 0.83rem;"><%= sound.name %></div>
                                            <span class="badge bg-light border text-muted mt-1" style="font-size: 0.65rem;"><%= sound.mood || 'Thư giãn' %></span>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                        <button type="button" class="btn btn-sm bl-btn-preview-audio p-1 text-muted hover-danger" onclick="previewAudioTrack(event, '<%= sound.audio_url %>')" title="Nghe thử">
                                            <i class="bi bi-play-circle fs-5"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary bl-btn-add-audio rounded-pill px-2.5 py-1 font-size-xs fw-semibold" onclick="selectAudioTrack(event, '<%= sound.audio_url %>', '<%= sound.name %>')">
                                            + Thêm
                                        </button>
                                    </div>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <div class="text-center py-4 text-muted x-small">Không có dữ liệu âm thanh</div>
                        <% } %>
                    </div>
                </div>

                <!-- 4. TAB: EFFECTS (Hiệu ứng động) -->
                <div class="bl-tab-pane" id="spane-effects">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="bl-panel-heading">
                            <h6 class="fw-bold text-dark mb-0 fs-6"><i class="bi bi-magic text-danger me-2"></i>Hiệu ứng Video</h6>
                            <span class="text-muted x-small">Chuyển động hình ảnh chuyên nghiệp</span>
                        </div>
                    </div>
                    <div class="d-flex flex-column gap-3">
                        <div class="bl-effect-card p-3 rounded-3 border bg-white cursor-pointer active shadow-2xs" data-effect="kenburns" onclick="selectStudioEffect('kenburns')">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="fw-bold text-dark small"><i class="bi bi-zoom-in text-danger me-1.5"></i>Ken Burns (Zoom nhẹ)</span>
                                <span class="badge bg-danger-subtle text-danger font-size-xs">Khuyên dùng</span>
                            </div>
                            <div class="text-muted x-small">Phóng to thu nhỏ tự nhiên tạo cảm giác điện ảnh sâu lắng</div>
                        </div>
                        <div class="bl-effect-card p-3 rounded-3 border bg-white cursor-pointer shadow-2xs" data-effect="shimmer" onclick="selectStudioEffect('shimmer')">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="fw-bold text-dark small"><i class="bi bi-sun text-warning me-1.5"></i>Lóe sáng (Shimmer)</span>
                            </div>
                            <div class="text-muted x-small">Tia sáng mềm xuyên qua lớp ảnh làm rực rỡ không gian</div>
                        </div>
                        <div class="bl-effect-card p-3 rounded-3 border bg-white cursor-pointer shadow-2xs" data-effect="bokeh" onclick="selectStudioEffect('bokeh')">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="fw-bold text-dark small"><i class="bi bi-droplet-half text-info me-1.5"></i>Đốm sáng Bokeh</span>
                            </div>
                            <div class="text-muted x-small">Hiệu ứng đom đóm lung linh phù hợp hoàng hôn bên sông</div>
                        </div>
                        <div class="bl-effect-card p-3 rounded-3 border bg-white cursor-pointer shadow-2xs" data-effect="heartbeat" onclick="selectStudioEffect('heartbeat')">

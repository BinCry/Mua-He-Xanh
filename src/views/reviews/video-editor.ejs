                                <span class="fw-bold x-small text-dark">Tự nhiên</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="bl-filter-card p-2 rounded-3 border bg-white cursor-pointer shadow-2xs text-center" data-filter="warm" onclick="selectStudioFilter('warm')">
                                <div class="bl-filter-swatch mb-1.5" style="background: linear-gradient(135deg, #F59E0B, #D97706);"></div>
                                <span class="fw-bold x-small text-dark">Nắng vàng</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="bl-filter-card p-2 rounded-3 border bg-white cursor-pointer shadow-2xs text-center" data-filter="vintage" onclick="selectStudioFilter('vintage')">
                                <div class="bl-filter-swatch mb-1.5" style="background: linear-gradient(135deg, #B45309, #78350F);"></div>
                                <span class="fw-bold x-small text-dark">Vintage</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="bl-filter-card p-2 rounded-3 border bg-white cursor-pointer shadow-2xs text-center" data-filter="cool" onclick="selectStudioFilter('cool')">
                                <div class="bl-filter-swatch mb-1.5" style="background: linear-gradient(135deg, #06B6D4, #0284C7);"></div>
                                <span class="fw-bold x-small text-dark">Thanh mát</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="bl-filter-card p-2 rounded-3 border bg-white cursor-pointer shadow-2xs text-center" data-filter="vibrant" onclick="selectStudioFilter('vibrant')">
                                <div class="bl-filter-swatch mb-1.5" style="background: linear-gradient(135deg, #EC4899, #EF4444);"></div>
                                <span class="fw-bold x-small text-dark">Rực rỡ</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="bl-filter-card p-2 rounded-3 border bg-white cursor-pointer shadow-2xs text-center" data-filter="bw" onclick="selectStudioFilter('bw')">
                                <div class="bl-filter-swatch mb-1.5" style="background: linear-gradient(135deg, #4B5563, #1F2937);"></div>
                                <span class="fw-bold x-small text-dark">Trắng đen</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 6. TAB: TRANSITIONS (Chuyển cảnh) -->
                <div class="bl-tab-pane" id="spane-transitions">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="bl-panel-heading">
                            <h6 class="fw-bold text-dark mb-0 fs-6"><i class="bi bi-distribute-horizontal text-danger me-2"></i>Chuyển cảnh</h6>
                            <span class="text-muted x-small">Hiệu ứng chuyển tiếp giữa các khung hình</span>
                        </div>
                    </div>
                    <div class="d-flex flex-column gap-3">
                        <div class="bl-transition-card p-3 rounded-3 border bg-white cursor-pointer active shadow-2xs d-flex align-items-center justify-content-between" data-trans="crossdissolve" onclick="selectStudioTransition('crossdissolve')">
                            <div>
                                <div class="fw-bold text-dark small">Hòa tan mềm (Cross Dissolve)</div>
                                <span class="text-muted x-small">Chuyển cảnh mịn màng chuẩn điện ảnh</span>
                            </div>
                            <i class="bi bi-check-circle-fill text-danger fs-5 check-icon"></i>
                        </div>
                        <div class="bl-transition-card p-3 rounded-3 border bg-white cursor-pointer shadow-2xs d-flex align-items-center justify-content-between" data-trans="fadeblack" onclick="selectStudioTransition('fadeblack')">
                            <div>
                                <div class="fw-bold text-dark small">Mờ dần sang đen (Fade Black)</div>
                                <span class="text-muted x-small">Tạo khoảng lặng tinh tế cho clip</span>
                            </div>
                            <i class="bi bi-check-circle-fill text-danger fs-5 check-icon d-none"></i>
                        </div>
                        <div class="bl-transition-card p-3 rounded-3 border bg-white cursor-pointer shadow-2xs d-flex align-items-center justify-content-between" data-trans="slidedown" onclick="selectStudioTransition('slidedown')">
                            <div>
                                <div class="fw-bold text-dark small">Lướt trượt xuống (Slide Down)</div>
                                <span class="text-muted x-small">Năng động kiểu TikTok / Reels</span>
                            </div>
                            <i class="bi bi-check-circle-fill text-danger fs-5 check-icon d-none"></i>
                        </div>
                        <div class="bl-transition-card p-3 rounded-3 border bg-white cursor-pointer shadow-2xs d-flex align-items-center justify-content-between" data-trans="zoomin" onclick="selectStudioTransition('zoomin')">
                            <div>
                                <div class="fw-bold text-dark small">Phóng to lướt tới (Zoom In)</div>
                                <span class="text-muted x-small">Hiệu ứng bút phá tập trung vào chi tiết</span>
                            </div>
                            <i class="bi bi-check-circle-fill text-danger fs-5 check-icon d-none"></i>
                        </div>
                    </div>

                    <!-- Thời lượng chuyển cảnh -->
                    <div class="mt-4 p-3 rounded-3 bg-light border">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="x-small fw-bold text-muted text-uppercase">Thời lượng chuyển cảnh</span>
                            <span class="fw-bold x-small text-danger" id="transDurationVal">0.5s</span>
                        </div>
                        <input type="range" class="form-range" min="0.2" max="1.5" step="0.1" value="0.5" id="transDurationSlider">
                    </div>
                </div>

                <!-- 7. TAB: CANVAS (Tỷ lệ khung hình) -->
                <div class="bl-tab-pane" id="spane-canvas">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="bl-panel-heading">
                            <h6 class="fw-bold text-dark mb-0 fs-6"><i class="bi bi-aspect-ratio text-danger me-2"></i>Tỷ lệ khung hình</h6>
                            <span class="text-muted x-small">Định dạng xuất video cho các nền tảng</span>
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-6">
                            <div class="bl-ratio-card p-3 rounded-3 border bg-white cursor-pointer active shadow-2xs text-center" data-ratio="9:16" onclick="selectStudioRatio('9:16')">
                                <div class="d-flex justify-content-center mb-2">
                                    <div style="width: 22px; height: 38px; border: 2px solid var(--bl-primary); border-radius: 4px;"></div>
                                </div>
                                <span class="fw-bold text-dark small d-block">9:16 Dọc</span>
                                <span class="text-muted x-small">TikTok, Reels, Shorts</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="bl-ratio-card p-3 rounded-3 border bg-white cursor-pointer shadow-2xs text-center" data-ratio="16:9" onclick="selectStudioRatio('16:9')">
                                <div class="d-flex justify-content-center mb-2">
                                    <div style="width: 38px; height: 22px; border: 2px solid #CBD5E1; border-radius: 4px;"></div>
                                </div>
                                <span class="fw-bold text-dark small d-block">16:9 Ngang</span>
                                <span class="text-muted x-small">YouTube, Tivi</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="bl-ratio-card p-3 rounded-3 border bg-white cursor-pointer shadow-2xs text-center" data-ratio="1:1" onclick="selectStudioRatio('1:1')">
                                <div class="d-flex justify-content-center mb-2">
                                    <div style="width: 28px; height: 28px; border: 2px solid #CBD5E1; border-radius: 4px;"></div>
                                </div>
                                <span class="fw-bold text-dark small d-block">1:1 Vuông</span>
                                <span class="text-muted x-small">Instagram, Facebook Post</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="bl-ratio-card p-3 rounded-3 border bg-white cursor-pointer shadow-2xs text-center" data-ratio="4:5" onclick="selectStudioRatio('4:5')">
                                <div class="d-flex justify-content-center mb-2">
                                    <div style="width: 26px; height: 32px; border: 2px solid #CBD5E1; border-radius: 4px;"></div>
                                </div>
                                <span class="fw-bold text-dark small d-block">4:5 Dọc ngắn</span>
                                <span class="text-muted x-small">Facebook Feed</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 8. TAB: SPEED (Tốc độ phát) -->
                <div class="bl-tab-pane" id="spane-speed">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="bl-panel-heading">
                            <h6 class="fw-bold text-dark mb-0 fs-6"><i class="bi bi-speedometer2 text-danger me-2"></i>Tốc độ video</h6>
                            <span class="text-muted x-small">Điều chỉnh thời gian & nhịp điệu phát</span>
                        </div>
                        <span class="badge bg-light border text-danger fw-bold font-size-xs" id="currentSpeedBadge">1.0x Chuẩn</span>
                    </div>

                    <!-- Nút gạt chọn nhanh 4 mốc tốc độ -->
                    <div class="d-flex gap-2 mb-3">
                        <button type="button" class="btn btn-sm btn-outline-secondary bl-speed-btn flex-grow-1 py-2 fw-semibold" data-speed="0.5" onclick="setStudioPlaybackSpeed(0.5)">0.5x</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary bl-speed-btn flex-grow-1 py-2 fw-semibold active" data-speed="1.0" onclick="setStudioPlaybackSpeed(1.0)">1.0x</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary bl-speed-btn flex-grow-1 py-2 fw-semibold" data-speed="1.5" onclick="setStudioPlaybackSpeed(1.5)">1.5x</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary bl-speed-btn flex-grow-1 py-2 fw-semibold" data-speed="2.0" onclick="setStudioPlaybackSpeed(2.0)">2.0x</button>
                    </div>

                    <!-- Thanh trượt tinh chỉnh chi tiết tốc độ -->
                    <div class="p-3 rounded-3 bg-light border mb-4" style="margin-bottom: 1.25rem !important;">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="x-small fw-bold text-muted text-uppercase">Tinh chỉnh tốc độ tự do</span>
                            <span class="fw-bold x-small text-danger" id="sliderSpeedVal">1.0x</span>
                        </div>
                        <input type="range" class="form-range" min="0.25" max="3.0" step="0.05" value="1.0" id="studioSpeedSlider" oninput="setStudioPlaybackSpeed(this.value)">
                        <div class="d-flex justify-content-between x-small text-muted mt-1">
                            <span>0.25x (Rất chậm)</span>
                            <span>1.0x (Chuẩn)</span>
                            <span>3.0x (Cực nhanh)</span>
                        </div>
                    </div>

                    <!-- Gợi ý nhịp điệu cho video Bình Lợi -->
                    <div class="p-3 rounded-3 border bg-white shadow-2xs">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-lightbulb-fill text-warning fs-6"></i>
                            <span class="fw-bold text-dark x-small text-uppercase">Gợi ý phong cách</span>
                        </div>
                        <ul class="list-unstyled mb-0 text-muted x-small d-flex flex-column gap-2">
                            <li class="d-flex align-items-start gap-2">
                                <span class="badge bg-secondary text-white font-size-xs flex-shrink-0 mt-0.5">0.5x</span>
                                <span>Thơ mộng, lắng đọng, phù hợp hoàng hôn và hoa mai trổ bông</span>
                            </li>
                            <li class="d-flex align-items-start gap-2">
                                <span class="badge bg-danger text-white font-size-xs flex-shrink-0 mt-0.5">1.0x</span>
                                <span>Chuẩn điện ảnh, nhịp vừa phải cho vlog khám phá miệt vườn</span>
                            </li>
                            <li class="d-flex align-items-start gap-2">
                                <span class="badge bg-warning text-dark font-size-xs flex-shrink-0 mt-0.5">1.5x</span>
                                <span>Nhanh & sôi động, tối ưu thu hút người xem trên TikTok / Reels</span>
                            </li>
                            <li class="d-flex align-items-start gap-2">
                                <span class="badge bg-dark text-white font-size-xs flex-shrink-0 mt-0.5">2.0x</span>
                                <span>Tua nhanh hành trình du lịch Bình Lợi theo dạng recap</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </aside>

        <!-- CỘT 2: KHUNG PREVIEW CHÍNH (CANVAS 9:16 + CONTROLS) -->
        <section class="bl-center-panel flex-grow-1 d-flex flex-column align-items-center justify-content-center p-3">
            <div class="bl-canvas-wrapper position-relative d-flex flex-column align-items-center justify-content-center w-100 h-100" id="canvasWrapper">
                <!-- Monitor Frame 9:16 (Co giãn theo chiều cao viewport) -->
                <div class="bl-monitor-frame position-relative shadow-2xl overflow-hidden" id="monitorFrame">
                    <!-- Canvas Vẽ Video Chính (1080x1920) -->
                    <canvas id="videoCanvas" width="540" height="960" class="w-100 h-100 d-block"></canvas>

                    <!-- Interactive Drag Overlay cho Text trên canvas -->
                    <div class="bl-text-drag-box" id="textDragBox" style="display: none;">
                        <span class="bl-text-drag-handle">✥</span>
                    </div>

                    <!-- Nút Play trên màn hình khi video đang tạm dừng (Ẩn khi chưa có clip) -->
                    <button type="button" class="btn bl-canvas-big-play position-absolute top-50 start-50 translate-middle rounded-circle shadow-lg text-white" id="playOverlayBtn" onclick="togglePlayVideo()">
                        <i class="bi bi-play-fill fs-1"></i>
                    </button>
                </div>

                <!-- Thanh điều khiển Play/Pause/Timecode dưới màn hình canvas -->
                <div class="bl-monitor-controls mt-2.5 d-flex align-items-center justify-content-between px-3.5 py-2 rounded-pill bg-white border shadow-sm">
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-sm bl-ctrl-btn" onclick="rewindStartVideo()" title="Về đầu">
                            <i class="bi bi-skip-start-fill fs-5"></i>
                        </button>
                        <button type="button" class="btn btn-sm bl-ctrl-btn bl-ctrl-play" id="monitorPlayToggle" onclick="togglePlayVideo()" title="Phát / Dừng">
                            <i class="bi bi-play-circle-fill fs-3 text-danger"></i>
                        </button>
                        <button type="button" class="btn btn-sm bl-ctrl-btn" onclick="forwardEndVideo()" title="Đến cuối">
                            <i class="bi bi-skip-end-fill fs-5"></i>
                        </button>
                    </div>

                    <!-- Timecode đồng hồ -->
                    <div class="bl-timecode-badge px-3 py-1 rounded-pill bg-light font-monospace fw-bold small text-dark mx-2" id="player-time">
                        00:00 / 00:15
                    </div>

                    <!-- Âm lượng / Mute -->
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-sm bl-ctrl-btn" onclick="toggleMute()" title="Bật/Tắt tiếng">
                            <i class="bi bi-volume-up-fill fs-5" id="volIcon"></i>
                        </button>
                        <input type="range" class="form-range d-none d-sm-inline-block" style="width: 70px;" min="0" max="1" step="0.05" value="0.8" id="masterVolumeSlider" oninput="changeMasterVolume(this.value)">
                    </div>
                </div>
            </div>
        </section>

        <!-- CỘT 3: PROPERTIES PANEL (BÊN PHẢI, CHỈNH THUỘC TÍNH CHỮ / CLIP / DỰ ÁN) -->
        <aside class="bl-properties-panel border-start bg-white p-3.5 custom-scrollbar">
            <!-- Header Properties -->
            <div class="d-flex align-items-center justify-content-between mb-3.5 pb-2 border-bottom">
                <h6 class="fw-bold text-dark mb-0 fs-6 d-flex align-items-center gap-2" id="propPanelTitle" style="column-gap: .625rem !important;"><i class="bi bi-sliders text-danger"></i><span>Thuộc tính</span></h6>
                <span class="badge bg-light border text-muted x-small" id="propPanelBadge">Tổng quan</span>
            </div>

            <!-- 1. Tổng quan Dự án (Khi không chọn gì cụ thể) -->
            <div id="propPanelDefault">
                <div class="p-3 rounded-3 bg-light border mb-3">
                    <div class="d-flex justify-content-between mb-1.5">
                        <span class="text-muted x-small">Tỷ lệ khung hình:</span>
                        <span class="fw-bold text-dark x-small" id="overviewRatioLabel">9:16 Dọc</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1.5">
                        <span class="text-muted x-small">Tổng thời lượng:</span>
                        <span class="fw-bold text-danger x-small" id="overviewDurationLabel">15 Giây</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1.5">
                        <span class="text-muted x-small">Số phân cảnh:</span>
                        <span class="fw-bold text-dark x-small" id="overviewClipsCount">0 Clips</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted x-small">Độ phân giải xuất:</span>
                        <span class="fw-bold text-dark x-small">1080 × 1920 (FHD)</span>
                    </div>
                </div>

                <div class="p-3 rounded-3 border bg-white mb-3">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="bi bi-lightbulb-fill text-warning fs-6"></i>
                        <span class="fw-bold text-dark small">Gợi ý nhanh:</span>
                    </div>
                    <p class="text-muted x-small mb-0">
                        Bạn có thể chọn <strong>Mẫu Video</strong> ở cột bên trái để tự động nạp nhạc và phụ đề chuẩn, sau đó chỉ cần thêm ảnh là hoàn tất!
                    </p>
                </div>
            </div>

            <!-- 2. Properties của Văn bản (Khi đang chọn Text) -->
            <div id="propPanelText" class="d-none">
                <div class="mb-3">
                    <label class="x-small fw-bold text-muted text-uppercase mb-1.5 d-block">Nội dung chữ</label>
                    <textarea class="form-control form-control-sm" rows="3" id="propTextInput" placeholder="Nhập chữ..."></textarea>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="x-small fw-bold text-muted text-uppercase mb-1.5 d-block">Font chữ</label>
                        <select class="form-select form-select-sm" id="propFontFamily">
                            <option value="Inter, sans-serif">Inter (Chuẩn)</option>
                            <option value="Montserrat, sans-serif">Montserrat (Trẻ)</option>
                            <option value="'Dancing Script', cursive">Dancing Script</option>
                            <option value="Arial, sans-serif">Arial</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="x-small fw-bold text-muted text-uppercase mb-1.5 d-block">Cỡ chữ</label>
                        <input type="number" class="form-control form-control-sm" id="propFontSize" value="32" min="16" max="72">
                    </div>
                </div>

                <div class="d-flex align-items-center justify-content-between mb-3 p-2.5 rounded-3 bg-light border">
                    <span class="x-small fw-bold text-muted text-uppercase">Màu chữ</span>
                    <input type="color" class="form-control form-control-color p-0 border-0 rounded-circle" id="propTextColor" value="#FFFFFF" style="width: 28px; height: 28px;">
                </div>

                <!-- Định dạng In đậm, Nghiêng, Căn lề -->
                <div class="d-flex gap-1.5 mb-3">
                    <button type="button" class="btn btn-sm btn-outline-secondary flex-grow-1" id="btnPropBold"><i class="bi bi-type-bold"></i></button>
                    <button type="button" class="btn btn-sm btn-outline-secondary flex-grow-1" id="btnPropItalic"><i class="bi bi-type-italic"></i></button>
                    <button type="button" class="btn btn-sm btn-outline-secondary flex-grow-1" id="btnPropUnderline"><i class="bi bi-type-underline"></i></button>
                    <button type="button" class="btn btn-sm btn-outline-secondary flex-grow-1 active" id="btnAlignCenter"><i class="bi bi-text-center"></i></button>
                </div>

                <!-- Animation Chữ -->
                <div class="mb-3">
                    <label class="x-small fw-bold text-muted text-uppercase mb-1.5 d-block">Hiệu ứng xuất hiện</label>
                    <select class="form-select form-select-sm" id="propTextAnimation">
                        <option value="none">Không hiệu ứng</option>
                        <option value="fade">Mờ dần (Fade In/Out)</option>
                        <option value="typewriter">Gõ chữ (Typewriter)</option>
                        <option value="pop">Phóng to bật ra (Pop)</option>
                    </select>
                </div>
            </div>

            <!-- 3. Properties của Phân cảnh (Clip đang chọn trên Timeline) -->
            <div id="propPanelClip" class="d-none">
                <div class="p-2.5 rounded-3 bg-light border mb-3 d-flex align-items-center justify-content-between">
                    <span class="fw-bold text-dark x-small text-truncate" id="propClipName">Clip Ảnh</span>
                    <button type="button" class="btn btn-link text-danger p-0 x-small text-decoration-none" id="btnDeleteSelectedClip"><i class="bi bi-trash"></i> Xóa clip</button>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1.5">
                        <span class="x-small fw-bold text-muted text-uppercase">Thời lượng clip</span>
                        <span class="fw-bold x-small text-danger" id="clipDurationLabel">3.5s</span>
                    </div>
                    <input type="range" class="form-range" min="1.0" max="8.0" step="0.5" value="3.5" id="clipDurationSlider">
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1.5">
                        <span class="x-small fw-bold text-muted text-uppercase">Thu phóng (Scale)</span>
                        <span class="fw-bold x-small text-dark" id="clipScaleLabel">100%</span>
                    </div>
                    <input type="range" class="form-range" min="100" max="200" step="5" value="100" id="clipScaleSlider">
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1.5">
                        <span class="x-small fw-bold text-muted text-uppercase">Độ sáng (Brightness)</span>
                        <span class="fw-bold x-small text-dark" id="clipBrightnessLabel">100%</span>
                    </div>
                    <input type="range" class="form-range" min="50" max="150" step="5" value="100" id="clipBrightnessSlider">
                </div>
            </div>
        </aside>
    </div>

    <!-- 3. MULTI-TRACK TIMELINE (DƯỚI CÙNG, CAO 230px, THOÁNG ĐÃNG, CÓ LABEL VIDEO, CHỮ & NHẠC) -->
    <footer class="bl-timeline-panel border-top bg-white d-flex flex-column shadow-2xs">
        <!-- Timeline Toolbar (Play, Split, Delete, Zoom, Clip count) -->
        <div class="bl-timeline-toolbar d-flex align-items-center justify-content-between px-3 py-2 border-bottom bg-light">
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-sm btn-light border p-1 rounded-2 shadow-2xs" onclick="togglePlayVideo()" title="Phát / Dừng (Space)">
                    <i class="bi bi-play-fill fs-6" id="btnTimelinePlayIcon"></i>
                </button>
                <div class="vr my-1 bl-vr mx-1"></div>
                <button type="button" class="btn btn-sm btn-light border px-2.5 py-1 rounded-2 font-size-xs fw-semibold shadow-2xs d-flex align-items-center gap-1.5" id="btnTimelineSplit" title="Cắt / Chia clip tại vị trí kim">
                    <i class="bi bi-scissors"></i> <span>Cắt clip</span>
                </button>
                <button type="button" class="btn btn-sm btn-light border px-2.5 py-1 rounded-2 font-size-xs fw-semibold text-danger shadow-2xs d-flex align-items-center gap-1.5" id="btnTimelineDelete" title="Xóa clip đang chọn">
                    <i class="bi bi-trash"></i> <span>Xóa</span>
                </button>
            </div>

            <!-- Timecode & Zoom Controls -->
            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-white border text-secondary px-2.5 py-1 font-size-xs font-monospace shadow-2xs" id="timelineDurationBadge">
                    00:00 / 00:15
                </span>
                <span class="badge bg-danger-subtle text-danger px-2.5 py-1 font-size-xs fw-semibold shadow-2xs" id="timelineClipsBadge">
                    0 clips
                </span>
                <div class="vr my-1 bl-vr"></div>
                <div class="d-flex align-items-center gap-1">
                    <button type="button" class="btn btn-sm bl-btn-icon p-1" id="btnTimelineZoomOut" title="Thu nhỏ Timeline"><i class="bi bi-zoom-out"></i></button>
                    <button type="button" class="btn btn-sm bl-btn-icon p-1" id="btnTimelineZoomIn" title="Phóng to Timeline"><i class="bi bi-zoom-in"></i></button>
                </div>
            </div>
        </div>

        <!-- Timeline Tracks Wrapper (Chứa Time Ruler và 3 Tracks riêng biệt) -->
        <div class="bl-timeline-scroll custom-scrollbar flex-grow-1 position-relative p-2" id="timelineContainer">
            <!-- Thước đo thời gian (Time ruler markings) -->
            <div class="bl-time-ruler d-flex justify-content-between px-2 mb-2 font-monospace text-muted x-small position-relative" id="timeRuler">
                <span>00:00</span>
                <span>00:03</span>
                <span>00:06</span>
                <span>00:09</span>
                <span>00:12</span>
                <span>00:15</span>
            </div>

            <!-- Kim chỉ giờ (Timeline Playhead Scrubber) -->
            <div class="bl-timeline-playhead position-absolute" id="timelinePlayhead" style="left: 120px;">
                <div class="bl-playhead-pointer"></div>
                <div class="bl-playhead-line"></div>
            </div>

            <!-- TRACK 1: VIDEO & HÌNH ẢNH -->
            <div class="bl-track-row d-flex align-items-center mb-2 position-relative" id="trackRowVideo">
                <div class="bl-track-label d-flex align-items-center gap-2 text-dark fw-bold px-2.5 py-1 rounded-2 shadow-2xs">
                    <span class="badge bg-primary text-white p-1 rounded-circle"><i class="bi bi-camera-video-fill font-size-xs"></i></span>
                    <span style="font-size: 0.78rem;">Video</span>
                </div>
                <div class="bl-track-slot flex-grow-1 d-flex align-items-center rounded-2 border bg-light position-relative custom-scrollbar" id="videoTrackSlots">
                    <!-- Populated dynamically with clip thumbnails or empty state -->
                </div>
            </div>

            <!-- TRACK 2: CHỮ & PHỤ ĐỀ (TEXT) -->
            <div class="bl-track-row d-flex align-items-center mb-2 position-relative" id="trackRowText">
                <div class="bl-track-label d-flex align-items-center gap-2 text-dark fw-bold px-2.5 py-1 rounded-2 shadow-2xs">
                    <span class="badge text-white p-1 rounded-circle" style="background: #8B5CF6;"><i class="bi bi-fonts font-size-xs"></i></span>
                    <span style="font-size: 0.78rem;">Chữ</span>
                </div>
                <div class="bl-track-slot flex-grow-1 d-flex align-items-center rounded-2 border bg-light position-relative" id="textTrackSlots">
                    <!-- Populated dynamically with text badges or empty state -->
                </div>
            </div>

            <!-- TRACK 3: ÂM THANH (AUDIO) -->
            <div class="bl-track-row d-flex align-items-center position-relative" id="trackRowAudio">
                <div class="bl-track-label d-flex align-items-center gap-2 text-dark fw-bold px-2.5 py-1 rounded-2 shadow-2xs">
                    <span class="badge bg-success text-white p-1 rounded-circle"><i class="bi bi-music-note font-size-xs"></i></span>
                    <span style="font-size: 0.78rem;">Nhạc</span>
                </div>
                <div class="bl-track-slot flex-grow-1 d-flex align-items-center rounded-2 border bg-light position-relative" id="audioTrackSlot">
                    <!-- Populated dynamically with audio badge or empty state -->
                </div>
            </div>
        </div>
    </footer>
</div>

<!-- MODAL 1: ÁP DỤNG MẪU THÀNH CÔNG & CHỌN NHANH ẢNH -->
<div class="modal fade" id="blTemplateAppliedModal" tabindex="-1" aria-hidden="true" style="z-index: 1085;">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 480px;">
        <div class="modal-content border-0 rounded-4 shadow-2xl overflow-hidden bg-white">
            <div class="modal-header border-bottom py-3.5 px-4 bg-light">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-danger text-white shadow-2xs" style="width: 38px; height: 38px;">
                        <i class="bi bi-stars fs-5"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold fs-6 mb-0 text-dark">Đã Áp Dụng Mẫu Video!</h5>
                        <span class="text-muted x-small" id="tplAppliedSubtitle">Mẫu video Bình Lợi đã sẵn sàng</span>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="p-3 rounded-3 bg-light border mb-3.5 text-center">
                    <div class="fw-bold text-dark fs-6 mb-1" id="tplAppliedTitle">Tên Mẫu</div>
                    <div class="text-muted small mb-2" id="tplAppliedDesc">Mô tả mẫu...</div>
                    <div class="d-flex justify-content-center gap-2 flex-wrap" id="tplAppliedBadges">
                        <!-- Badges -->
                    </div>
                </div>

                <div class="text-muted small text-center mb-3">
                    ✨ Bây giờ bạn chỉ cần thêm ảnh vào để xuất video hoàn chỉnh:
                </div>

                <div class="d-flex flex-column gap-3">
                    <button type="button" class="btn btn-danger py-2.5 rounded-pill fw-bold d-flex align-items-center justify-content-center gap-2 shadow-sm" id="btnUseTemplateSamplePhotos">
                        <i class="bi bi-lightning-charge-fill"></i>
                        <span>Dùng luôn ảnh mẫu có sẵn (Xem ngay video)</span>
                    </button>
                    <button type="button" class="btn btn-outline-dark py-2.5 rounded-pill fw-semibold d-flex align-items-center justify-content-center gap-2" id="btnUploadOwnPhotosForTemplate">
                        <i class="bi bi-upload"></i>
                        <span>Tải ảnh của bạn lên từ máy tính</span>
                    </button>
                    <button type="button" class="btn btn-link text-muted x-small text-decoration-none py-1" data-bs-dismiss="modal">
                        Tự chọn từng tấm ảnh từ thư viện sau
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL 2: XUẤT VIDEO (EXPORT VIDEO MODAL) -->
<div class="modal fade" id="blExportModal" tabindex="-1" aria-hidden="true" style="z-index: 1085;">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 460px;">
        <div class="modal-content border-0 rounded-4 shadow-2xl overflow-hidden bg-white">
            <div class="modal-header border-bottom py-3.5 px-4 bg-light">
                <div class="d-flex align-items-center gap-3">
                    <img src="<%= fixImg(settings.brand_logo, '/images/logo.png') %>" alt="Bình Lợi Studio" class="rounded-circle shadow-2xs flex-shrink-0" style="width: 34px; height: 34px; object-fit: cover; border: 1.5px solid #FEE2E2;" onerror="this.src='/images/logo.png'">
                    <div>
                        <h5 class="modal-title fw-bold fs-6 mb-0 text-dark">Xuất video Bình Lợi Studio</h5>
                        <span class="text-muted x-small">Tạo video độ nét cao trực tiếp trên trình duyệt</span>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Resolution & Format Settings -->
                <div class="mb-4" style="margin-bottom: 1.25rem !important;">
                    <label class="x-small fw-bold text-muted text-uppercase mb-2 d-block">Độ phân giải & Thông số</label>
                    <div class="d-flex gap-2">
                        <span class="badge bg-danger text-white px-3 py-2 fw-bold">1080P Full HD</span>
                        <span class="badge bg-light border text-dark px-3 py-2 fw-semibold">30 FPS</span>
                        <span class="badge bg-light border text-dark px-3 py-2 fw-semibold">MP4 (H.264)</span>
                    </div>
                </div>

                <div class="mb-4" style="margin-bottom: 1.25rem !important;">
                    <label class="x-small fw-bold text-muted text-uppercase mb-2 d-block">Tên tệp video xuất ra</label>
                    <input type="text" class="form-control form-control-sm" id="exportFileName" value="binh_loi_studio_video.mp4">
                    <span class="text-muted x-small mt-1 d-block">Tệp sẽ tự động được tải về thư mục Downloads của máy</span>
                </div>

                <!-- Export Progress Bar -->
                <div id="exportStatusPanel" class="d-none mb-3.5 p-3 rounded-3 bg-light border">
                    <div class="d-flex justify-content-between x-small fw-bold mb-1.5">
                        <span id="exportStatusText" class="text-dark">Đang render khung hình...</span>
                        <span id="exportPercentText" class="text-danger">0%</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-danger progress-bar-striped progress-bar-animated" id="exportProgressBar" style="width: 0%;"></div>
                    </div>
                </div>

                <!-- Complete Status -->
                <div id="exportSuccessPanel" class="d-none p-3 rounded-3 bg-success-subtle border border-success mb-3 text-center">
                    <i class="bi bi-check-circle-fill text-success fs-3 mb-1 d-block"></i>
                    <div class="fw-bold text-success small">Xuất video thành công!</div>
                    <span class="text-muted x-small">Tệp MP4 đã được tải xuống máy tính của bạn.</span>
                    <div class="mt-2.5">
                        <button type="button" class="btn btn-sm btn-success rounded-pill px-3 py-1 font-size-xs fw-semibold" id="btnDownloadAgain">
                            <i class="bi bi-download me-1"></i>Tải lại tệp
                        </button>
                    </div>
                </div>

                <!-- Action Button -->
                <div class="d-grid mt-4" id="exportTriggerWrapper">
                    <button type="button" class="btn btn-danger py-2.5 rounded-pill fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2" id="startExportProcessBtn">
                        <i class="bi bi-camera-reels-fill"></i>
                        <span>Bắt đầu xuất video MP4</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- CSS ĐỘC QUYỀN DÀNH RIÊNG CHO BÌNH LỢI STUDIO (SPACIOUS LIGHT THEME) -->
<style>
/* Reset Layout Chung của website để Studio trọn vẹn 100vh không bị đè */
.navbar, footer, .fab-qr, a.fab-qr, .mobile-bottom-qr-container, .mobile-qr-fab, #pwaInstallBanner, header.sticky-top, .main-footer, .pwa-install-banner, .pwa-ios-instructions {
    display: none !important;
}

body, html {
    margin: 0 !important;
    padding: 0 !important;
    overflow: hidden !important;
    width: 100vw !important;
    height: 100vh !important;
    background: #FFFFFF !important;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif !important;
}

/* QUAN TRỌNG: Gỡ bỏ triệt để padding-top 107px của thẻ main từ layout chung */
main {
    margin: 0 !important;
    padding: 0 !important;
    height: 100vh !important;
    width: 100vw !important;
    overflow: hidden !important;
    position: static !important;
}

:root {
    --bl-primary: #DC2626;
    --bl-primary-hover: #B91C1C;
    --bl-primary-subtle: #FEF2F2;
    --bl-bg-main: #FFFFFF;
    --bl-bg-subtle: #F8F9FA;
    --bl-border: #E5E7EB;
    --bl-border-subtle: #F1F5F9;
    --bl-text-main: #111827;
    --bl-text-muted: #6B7280;
}

/* Bootstrap has no fractional spacing utilities. The Studio markup uses these
   intentionally, so define them locally instead of letting browsers drop them. */
.bl-studio-workspace .gap-1\.5 { gap: .375rem !important; }
.bl-studio-workspace .gap-2\.5 { gap: .75rem !important; }
.bl-studio-workspace .g-2\.5 { --bs-gutter-x: .75rem; --bs-gutter-y: .75rem; }
.bl-studio-workspace .mb-1\.5 { margin-bottom: .375rem !important; }
.bl-studio-workspace .mb-2\.5 { margin-bottom: .75rem !important; }
.bl-studio-workspace .mb-3\.5 { margin-bottom: 1.25rem !important; }
.bl-studio-workspace .mt-0\.5 { margin-top: .125rem !important; }
.bl-studio-workspace .mt-2\.5 { margin-top: .75rem !important; }
.bl-studio-workspace .p-2\.5 { padding: .75rem !important; }
.bl-studio-workspace .p-3\.5 { padding: 1.25rem !important; }
.bl-studio-workspace .px-2\.5 { padding-left: .75rem !important; padding-right: .75rem !important; }
.bl-studio-workspace .px-3\.5 { padding-left: 1.25rem !important; padding-right: 1.25rem !important; }
.bl-studio-workspace .py-1\.5 { padding-top: .375rem !important; padding-bottom: .375rem !important; }
.bl-studio-workspace .py-2\.5 { padding-top: .75rem !important; padding-bottom: .75rem !important; }
.bl-studio-workspace .py-3\.5 { padding-top: 1.25rem !important; padding-bottom: 1.25rem !important; }
.bl-studio-workspace .me-1\.5 { margin-right: .375rem !important; }

/* 1. Header */
.bl-studio-workspace {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    height: 100vh !important;
    width: 100vw !important;
    background: #FFFFFF !important;
    overflow: hidden !important;
    z-index: 1040 !important;
}

.bl-studio-header {
    height: 60px;
    flex-shrink: 0;
    z-index: 100;
}
.bl-badge-pro {
    background: #FEF2F2;
    color: var(--bl-primary);
    border: 1px solid rgba(220, 38, 38, 0.2);
    font-size: 0.65rem;
}
.bl-btn-back {
    width: 34px;
    height: 34px;
    background: var(--bl-bg-subtle);
    border: 1px solid var(--bl-border);
    color: var(--bl-text-muted);
    transition: all 0.15s ease;
}
.bl-btn-back:hover {
    background: var(--bl-primary-subtle);
    color: var(--bl-primary);
}
.bl-project-name-wrapper {
    background: var(--bl-bg-subtle);
    border-color: var(--bl-border) !important;
    gap: 8px;
    padding: 6px 14px;
}
.bl-project-title-input {
    border: none;
    background: transparent;
    outline: none;
    color: var(--bl-text-main);
    width: 240px;
}
.bl-project-title-input:focus {
    border-bottom: 1px solid var(--bl-primary);
}
.bl-btn-icon {
    color: var(--bl-text-muted);
    border: none;
    background: transparent;
    padding: 7px;
    border-radius: 8px;
    transition: all 0.15s ease;
}
.bl-btn-icon:hover:not(:disabled) {
    background: var(--bl-bg-subtle);
    color: var(--bl-text-main);
}
.bl-btn-icon:disabled {
    opacity: 0.35;
    cursor: not-allowed;
}
.bl-btn-secondary {
    background: var(--bl-bg-subtle);
    border: 1px solid var(--bl-border);
    color: var(--bl-text-main);
    font-weight: 600;
    transition: all 0.15s ease;
}
.bl-btn-secondary:hover {
    background: #E5E7EB;
}
.bl-btn-export {
    background: var(--bl-primary) !important;
    color: #FFFFFF !important;
    border: none;
    transition: all 0.2s ease;
}
.bl-btn-export:hover {
    background: var(--bl-primary-hover) !important;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(220, 38, 38, 0.35);
}
.bl-vr {
    background: var(--bl-border);
    opacity: 1;
    width: 1px;
}

/* 2. Main Studio Body (Flex 1, never causes overflow) */
.bl-studio-body {
    flex: 1 1 0;
    min-height: 0;
    display: flex;
    overflow: hidden;
}

/* Left Sidebar & Drawer (Width: 460px, tối ưu không gian rộng thoáng) */
.bl-left-panel {
    width: 460px;
    background: #FFFFFF;
    flex-shrink: 0;
}
.bl-nav-rail {
    width: 74px;
    background: #FFFFFF;
    flex-shrink: 0;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 6px 2px !important;
}
.bl-rail-btn {
    width: 66px;
    min-height: 58px;
    height: auto;
    flex: 0 0 auto;
    background: transparent;
    border: none;
    color: var(--bl-text-muted);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    padding: 2px;
    margin-bottom: 2px;
    font-size: 0.65rem;
    font-weight: 600;
    line-height: 1.2;
    transition: all 0.15s ease;
}
.bl-rail-btn i {
    font-size: 1.05rem !important;
}
.bl-rail-btn span {
    display: block;
    max-width: 100%;
    line-height: 1.2;
    text-align: center;
    white-space: normal;
}
.bl-rail-btn:hover {
    background: var(--bl-bg-subtle);
    color: var(--bl-text-main);
}
.bl-rail-btn.active {
    background: var(--bl-primary-subtle);
    color: var(--bl-primary);
}

.bl-drawer-panel {
    width: 386px;
    background: #FFFFFF;
    overflow-y: auto;
    padding: 16px !important;
}
.bl-tab-pane { display: none; }
.bl-tab-pane.active { display: block; animation: fadeIn 0.15s ease; }
.bl-panel-heading h6 { margin-bottom: .35rem !important; line-height: 1.3; }
.bl-panel-heading .x-small { display: block; line-height: 1.45; }

.bl-chip-btn {
    background: var(--bl-bg-subtle);
    border: 1px solid var(--bl-border);
    color: var(--bl-text-muted);
    font-weight: 600;
    font-size: 0.74rem;
    border-radius: 20px;
    padding: 4px 12px;
    white-space: nowrap;
    transition: all 0.15s ease;
}
.bl-chip-btn:hover {
    background: #E5E7EB;
    color: var(--bl-text-main);
}
.bl-chip-btn.active {
    background: var(--bl-primary);
    color: #FFFFFF;
    border-color: var(--bl-primary);
}

.bl-template-card {
    border: 1px solid var(--bl-border);
    border-radius: 14px;
    overflow: hidden;
    background: #FFFFFF;
    transition: all 0.2s ease;
}
.bl-template-card:hover {
    border-color: var(--bl-primary);
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    transform: translateY(-2px);
}
.bl-template-cover {
    height: 140px;
    position: relative;
    overflow: hidden;
}

.bl-subtab-btn {
    background: transparent;
    border: none;
    color: var(--bl-text-muted);
    font-weight: 600;
    font-size: 0.75rem;
    border-radius: 6px;
    padding: 5px 8px;
    transition: all 0.15s ease;
}
.bl-subtab-btn.active {
    background: #FFFFFF;
    color: var(--bl-primary);
    box-shadow: 0 1px 4px rgba(0,0,0,0.08);
}

.bl-dropzone {
    background: var(--bl-bg-subtle);
    border: 2px dashed rgba(220, 38, 38, 0.35);
    transition: all 0.2s ease;
}
.bl-dropzone:hover {
    border-color: var(--bl-primary);
    background: var(--bl-primary-subtle);
}

.bl-audio-card, .bl-effect-card, .bl-filter-card, .bl-transition-card, .bl-ratio-card {
    border: 1px solid var(--bl-border) !important;
    transition: all 0.15s ease;
}
.bl-audio-card:hover, .bl-effect-card:hover, .bl-filter-card:hover, .bl-transition-card:hover, .bl-ratio-card:hover {
    border-color: var(--bl-primary) !important;
    background: var(--bl-primary-subtle) !important;
}
.bl-audio-card.active, .bl-effect-card.active, .bl-filter-card.active, .bl-transition-card.active {
    border-color: var(--bl-primary) !important;
    background: #FFF5F5 !important;
}
.bl-ratio-card.active {
    border-color: var(--bl-primary) !important;
    background: #FFF5F5 !important;
    box-shadow: 0 0 0 1.5px var(--bl-primary);
}
.bl-ratio-card.active div[style*="border: 2px solid"] {
    border-color: var(--bl-primary) !important;
}
.bl-audio-icon {
    width: 36px;
    height: 36px;
    background: #FEE2E2;
    flex-shrink: 0;
}
.bl-btn-add-audio {
    white-space: nowrap !important;
    font-size: 0.72rem !important;
    padding: 3px 10px !important;
    transition: all 0.15s ease;
}
.bl-btn-add-audio:hover {
    background: var(--bl-primary) !important;
    color: #FFFFFF !important;
    border-color: var(--bl-primary) !important;
}
.bl-speed-btn.active {
    background: var(--bl-primary) !important;
    color: #FFFFFF !important;
    border-color: var(--bl-primary) !important;
}
.bl-filter-swatch {
    height: 44px;
    border-radius: 8px;
}

/* Center Panel & Monitor */
.bl-center-panel {
    background: #F3F4F6;
    overflow: hidden;
}
.bl-canvas-wrapper {
    max-height: calc(100% - 62px);
}
.bl-monitor-frame {
    height: 100%;
    aspect-ratio: 9 / 16;
    background: #000000;
    border-radius: 20px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15);
    border: 2px solid #E5E7EB;
}
.bl-canvas-big-play {
    display: none;
    width: 68px;
    height: 68px;
    background: rgba(220, 38, 38, 0.9) !important;
    border: none;
    border-radius: 50%;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
    z-index: 50;
}
.bl-canvas-big-play.is-visible {
    display: flex !important;
}
.bl-canvas-big-play:hover {
    transform: translate(-50%, -50%) scale(1.1) !important;
    background: #DC2626 !important;
}

.bl-text-drag-box {
    position: absolute;
    border: 2px dashed #DC2626;
    background: rgba(220, 38, 38, 0.1);
    cursor: move;
    z-index: 40;
    border-radius: 8px;
}
.bl-text-drag-handle {
    position: absolute;
    top: -12px;
    right: -12px;
    width: 24px;
    height: 24px;
    background: #DC2626;
    color: #FFFFFF;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
}

.bl-monitor-controls {
    height: 42px;
    width: min(100%, 480px);
    min-width: 0;
    gap: 12px;
    margin-top: 8px;
    margin-inline: auto;
    padding-inline: 14px !important;
    flex-shrink: 0;
}
.bl-monitor-controls > div { flex: 0 0 auto; }
.bl-monitor-controls .bl-timecode-badge { white-space: nowrap; }
.bl-ctrl-btn {
    color: var(--bl-text-main);
    padding: 4px;
    transition: color 0.15s ease;
}
.bl-ctrl-btn:hover {
    color: var(--bl-primary);
}

/* Right Properties Panel (Width: 290px) */
.bl-properties-panel {
    width: 290px;
    flex-shrink: 0;
    overflow-y: auto;
    padding: 16px !important;
}

/* Bottom Timeline Panel */
.bl-timeline-panel {
    height: 230px;
    flex-shrink: 0;
    padding: 0 16px;
    background: #FFFFFF;
    border-top: 1px solid var(--bl-border);
    z-index: 90;
}
.bl-timeline-scroll {
    min-height: 0;
    overflow-x: auto;
    overflow-y: auto;
    padding: 4px 10px 6px !important;
}
.bl-track-row {
    height: 38px;
    margin-bottom: 6px !important;
}
.bl-track-label {
    width: 110px;
    height: 34px;
    flex-shrink: 0;
    background: var(--bl-bg-subtle);
    border: 1px solid var(--bl-border);
    margin-right: 10px;
    padding: 0 8px;
}
.bl-track-slot {
    height: 34px;
    padding: 2px 8px;
    background: #F8F9FA !important;
    border-color: #E5E7EB !important;
    overflow-x: auto;
    overflow-y: hidden;
}

.bl-timeline-clip-item {
    height: 28px;
    min-width: 75px;
    max-width: 140px;
    border-radius: 6px;
    overflow: hidden;
    position: relative;
    border: 1.5px solid #CBD5E1;
    cursor: pointer;
    flex-shrink: 0;
    margin-right: 8px;
    transition: all 0.15s ease;
}
.bl-timeline-clip-item.active {
    border-color: var(--bl-primary) !important;
    box-shadow: 0 0 0 2px rgba(220, 38, 38, 0.3);
}

.bl-track-badge {
    border-radius: 6px;
    font-size: 0.74rem;
    height: 28px;
}
.bl-empty-track-hint {
    gap: 0.5rem;
    min-width: 0;
    padding-inline: 0.75rem !important;
}

    /* Do not rely solely on the utility class: this status is also replaced at runtime. */
    .bl-status-saved {
        column-gap: 0.5rem;
        white-space: nowrap;
    }

    .bl-status-saved > i {
        flex: 0 0 auto;
    }

    .bl-status-saved > i + span {
        margin-inline-start: 0.125rem;
    }
.bl-empty-track-hint > i { flex: 0 0 auto; }
.bl-empty-track-hint > span { min-width: 0; }
.bl-badge-text {
    background: #EDE9FE;
    color: #6D28D9;
    border: 1px solid #DDD6FE;
}
.bl-badge-audio {
    background: #DCFCE7;
    color: #15803D;
    border: 1px solid #BBF7D0;
}

/* Playhead */
.bl-timeline-playhead {
    top: 20px;
    bottom: 0;
    width: 2px;
    background: #DC2626;
    pointer-events: none;
    z-index: 60;
    transition: left 0.04s linear;
}
.bl-playhead-pointer {
    position: absolute;
    top: -10px;
    left: -6px;
    width: 14px;
    height: 12px;
    background: #DC2626;
    clip-path: polygon(0% 0%, 100% 0%, 50% 100%);
}

/* Mobile Studio: preserve every tool without squeezing the desktop workspace. */
@media (max-width: 1199.98px) {
    html,
    body {
        width: 100% !important;
        height: auto !important;
        min-height: 100dvh !important;
        overflow-x: hidden !important;
        overflow-y: auto !important;
    }

    main {
        width: 100% !important;
        height: auto !important;
        min-height: 100dvh !important;
        overflow: visible !important;
    }

    .bl-studio-workspace {
        position: relative !important;
        inset: auto !important;
        width: 100% !important;
        height: auto !important;
        min-height: 100dvh !important;
        overflow: visible !important;
    }

    .bl-studio-header {
        position: sticky;
        top: 0;
        height: 60px;
        min-height: 60px;
        padding: 8px 10px !important;
        gap: 6px;
        z-index: 1100;
    }

    .bl-studio-header > div:first-child {
        flex: 1 1 auto;
        min-width: 0;
        gap: 4px !important;
    }

    .bl-studio-header > div:first-child > div {
        min-width: 0;
        gap: 6px !important;
    }

    .bl-studio-header > div:first-child img {
        width: 32px !important;
        height: 32px !important;
    }

    .bl-studio-header span.fw-bold {
        display: block;
        max-width: 92px;
        overflow: hidden;
        font-size: 0.9rem !important;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .bl-studio-header .bl-badge-pro,
    .bl-studio-header .text-muted.x-small,
    .bl-studio-header .bl-vr,
    .bl-project-name-wrapper {
        display: none !important;
    }

    .bl-studio-header > div:last-child {
        flex: 0 0 auto;
        gap: 4px !important;
    }

    .bl-studio-header > div:last-child button {
        display: grid !important;
        width: 36px;
        height: 36px;
        min-width: 36px;
        margin: 0 !important;
        padding: 0 !important;
        place-items: center;
    }

    .bl-studio-header > div:last-child button > span {
        display: none !important;
    }

    .bl-studio-body {
        display: flex !important;
        flex: none !important;
        min-height: 0;
        overflow: visible !important;
        flex-direction: column !important;
    }

    .bl-left-panel,
    .bl-center-panel,
    .bl-properties-panel {
        width: 100% !important;
        min-width: 0;
        border-right: 0 !important;
        border-left: 0 !important;
    }

    .bl-left-panel {
        display: flex !important;
        flex-direction: column !important;
        border-bottom: 1px solid var(--bl-border);
    }

    .bl-nav-rail {
        width: 100% !important;
        min-height: 68px;
        flex: 0 0 68px;
        flex-direction: row !important;
        align-items: center !important;
        gap: 6px;
        overflow-x: auto !important;
        overflow-y: hidden !important;
        padding: 5px 8px !important;
        border-right: 0 !important;
        border-bottom: 1px solid var(--bl-border);
        -webkit-overflow-scrolling: touch;
    }

    .bl-rail-btn {
        width: 70px;
        min-width: 70px;
        min-height: 56px;
        height: 56px;
        margin: 0;
    }

    .bl-drawer-panel,
    .bl-properties-panel {
        width: 100% !important;
        overflow: visible !important;
        padding: 12px !important;
    }

    .bl-center-panel {
        flex: none !important;
        min-height: 0;
        overflow: visible !important;
        padding: 16px !important;
    }

    .bl-canvas-wrapper {
        height: auto !important;
        max-height: none;
    }

    .bl-monitor-frame {
        width: min(68vw, 260px);
        height: auto !important;
        max-width: 100%;
        flex: 0 0 auto;
    }

    .bl-monitor-controls {
        width: min(calc(100% - 24px), 360px);
        gap: 4px;
        padding: 6px 12px !important;
    }

    .bl-monitor-controls .btn {
        padding: 3px !important;
    }

    .bl-monitor-controls .bl-timecode-badge {
        margin: 0 4px !important;
        padding: 4px 8px !important;
        font-size: 0.72rem;
    }

    .bl-properties-panel {
        border-top: 1px solid var(--bl-border);
    }

    .bl-timeline-panel {
        width: 100%;
        height: 230px;
        min-height: 230px;
        padding: 0 8px;
    }

    .bl-timeline-toolbar {
        justify-content: flex-start !important;
        gap: 8px;
        overflow-x: auto;
        overflow-y: hidden;
        white-space: nowrap;
        -webkit-overflow-scrolling: touch;
    }

    .bl-timeline-toolbar > div,
    .bl-timeline-toolbar button,
    .bl-timeline-toolbar .badge {
        flex: 0 0 auto;
        white-space: nowrap;
    }

    .bl-timeline-scroll {
        overflow-x: auto;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
    }

    .bl-time-ruler,
    .bl-track-row {
        min-width: 560px;
    }
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
}

.shadow-2xs { box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05); }
.custom-scrollbar::-webkit-scrollbar { width: 5px; height: 5px; }
.custom-scrollbar::-webkit-scrollbar-thumb { background: #CBD5E1; border-radius: 4px; }
.no-scrollbar::-webkit-scrollbar { display: none; }
</style>


                        class="bi bi-envelope-heart-fill text-danger"></i> Hộp thư hỗ trợ</a>
                <% } %>
        </div>

        <!-- User Section at Bottom -->
        <div class="mt-auto border-top p-3 bg-light bg-opacity-50">
            <% if (user) { %>
                <div class="d-flex align-items-center gap-2 mb-3 pb-3 border-bottom">
                    <img src="<%= user.avatar || '/images/default-avatar.png' %>" class="rounded-circle shadow-sm"
                        style="width: 38px; height: 38px; object-fit: cover; border: 2px solid var(--primary-100);">
                    <div class="overflow-hidden">
                        <div class="fw-bold text-dark text-truncate" style="font-size: 0.85rem;">
                            <%= user.full_name %>
                        </div>
                        <div class="x-small text-muted text-truncate">
                            <%= user.phone || user.email %>
                        </div>
                    </div>
                </div>
                <% if (user.role==='user' ) { %>
                    <a class="mobile-menu-link" href="/profile"><i class="bi bi-person-circle text-primary"></i> Hồ sơ
                        du khách</a>
                    <a class="mobile-menu-link" href="/profile/rewards"><i class="bi bi-gift-fill text-warning"></i>
                        Điểm thưởng</a>
                    <% } %>
                        <% if (user.role==='admin' ) { %>
                            <a class="mobile-menu-link text-primary fw-bold" href="/admin"><i
                                    class="bi bi-shield-check"></i> Admin Panel</a>
                            <% } %>

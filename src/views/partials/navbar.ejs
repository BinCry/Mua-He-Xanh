        var viKeys = Object.keys(VI_EN).sort(function (a, b) { return b.length - a.length; });

        function translatePage(lang) {
            var mb = document.getElementById('langToggleBtn');
            var db = document.getElementById('langToggleBtnDesktop');
            if (mb) mb.textContent = lang === 'en' ? 'VI' : 'EN';
            if (db) db.textContent = lang === 'en' ? 'VI' : 'EN';

            var walker = document.createTreeWalker(
                document.body, NodeFilter.SHOW_TEXT, null, false
            );
            var textNode;
            while (textNode = walker.nextNode()) {
                var el = textNode.parentElement;
                if (!el) continue;
                var tag = el.tagName;
                if (tag === 'SCRIPT' || tag === 'STYLE' || tag === 'TEXTAREA') continue;

                var val = textNode.nodeValue;
                if (!val || !val.trim()) continue;

                if (!_originals.has(textNode)) {
                    _originals.set(textNode, val);
                }

                if (lang === 'en') {
                    var src = _originals.get(textNode);
                    var result = src;
                    for (var i = 0; i < viKeys.length; i++) {
                        if (result.indexOf(viKeys[i]) !== -1) {
                            result = result.split(viKeys[i]).join(VI_EN[viKeys[i]]);
                        }
                    }
                    textNode.nodeValue = result;
                } else {
                    textNode.nodeValue = _originals.get(textNode);
                }
            }

            // Translate placeholders
            document.querySelectorAll('input[placeholder], textarea[placeholder]').forEach(function (input) {
                var ph = input.getAttribute('placeholder');
                if (!ph) return;
                if (!input.dataset.origPh) input.dataset.origPh = ph;
                if (lang === 'en') {
                    var r = input.dataset.origPh;
                    for (var i = 0; i < viKeys.length; i++) {
                        if (r.indexOf(viKeys[i]) !== -1) {
                            r = r.split(viKeys[i]).join(VI_EN[viKeys[i]]);
                        }
                    }
                    input.setAttribute('placeholder', r);
                } else {
                    input.setAttribute('placeholder', input.dataset.origPh);
                }
            });

            // Translate title attributes on buttons
            document.querySelectorAll('[title]').forEach(function (el) {
                var t = el.getAttribute('title');
                if (!t) return;
                if (!el.dataset.origTitle) el.dataset.origTitle = t;
                if (lang === 'en') {
                    var r = el.dataset.origTitle;
                    for (var i = 0; i < viKeys.length; i++) {
                        if (r.indexOf(viKeys[i]) !== -1) {
                            r = r.split(viKeys[i]).join(VI_EN[viKeys[i]]);
                        }
                    }
                    el.setAttribute('title', r);
                } else {
                    el.setAttribute('title', el.dataset.origTitle);
                }
            });
        }

        window.toggleLanguage = function () {
            var current = localStorage.getItem('app_lang') || 'vi';
            var next = current === 'vi' ? 'en' : 'vi';
            localStorage.setItem('app_lang', next);
            translatePage(next);
        };

        function init() {
            var lang = localStorage.getItem('app_lang') || 'vi';
            translatePage(lang);
        }

        document.addEventListener('DOMContentLoaded', init);
        window.addEventListener('pageshow', function (e) {
            if (e.persisted) init();
        });
    })();
</script>
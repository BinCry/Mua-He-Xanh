                                    <a class="mobile-menu-link text-primary fw-bold" href="/manager"><i
                                            class="bi bi-shield-check"></i> Quản lý Panel</a>
                                    <% } %>
                                        <a class="mobile-menu-link text-danger mt-1" href="/auth/logout"><i
                                                class="bi bi-box-arrow-right"></i> Đăng xuất</a>
                                        <% } else { %>
                                            <a href="/auth/login"
                                                class="btn btn-premium rounded-pill w-100 py-2 fw-bold shadow-sm"
                                                style="font-size: 0.82rem;">
                                                <i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập / Đăng ký
                                            </a>
                                            <% } %>
        </div>
    </div>
</div>

<style>
    /* Hamburger */
    .nav-hamburger {
        width: 22px;
        height: 16px;
        position: relative;
        cursor: pointer;
    }

    .nav-hamburger span {
        display: block;
        height: 2px;
        background: var(--primary);
        border-radius: 2px;
        transition: all 0.3s ease;
        position: absolute;
        left: 0;
        width: 100%;
    }

    .nav-hamburger span:nth-child(1) {
        top: 0;
    }

    .nav-hamburger span:nth-child(2) {
        top: 7px;
        width: 70%;
    }

    .nav-hamburger span:nth-child(3) {
        top: 14px;
        width: 85%;
    }

    /* Mobile: Center the brand */
    @media (max-width: 991.98px) {
        .navbar>.container {
            display: flex;
            justify-content: center;
            position: relative;
        }

        .navbar-toggler {
            position: absolute !important;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
        }

        .navbar-brand {
            margin: 0 auto !important;
        }
    }

    /* Mobile Offcanvas Menu Sidebar */
    #mobileMenu {
        background: #ffffff !important;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15) !important;
    }

    .mobile-menu-link {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 14px;
        font-size: 0.84rem;
        font-weight: 600;
        color: #334155;
        text-decoration: none;
        border-radius: 12px;
        transition: all 0.2s ease;
        margin-bottom: 3px;
    }

    .mobile-menu-link:hover,
    .mobile-menu-link:active {
        background: var(--primary-50, #fdf5f5);
        color: var(--primary, #922724);
    }

    .mobile-menu-link i {
        width: 22px;
        text-align: center;
        font-size: 1.05rem;
    }

    /* Dropdown polish */
    .dropdown-item {
        font-size: 0.85rem;
        transition: all 0.15s ease;
    }

    .dropdown-item:hover {
        background: var(--primary-50);
        color: var(--primary);
    }

    .dropdown-item:active {
        background: var(--primary-100);
    }
</style>



<!-- MOBILE OFFCANVAS MENU (Modern App Sidebar Style) -->
<div class="offcanvas offcanvas-start border-0 shadow-lg" tabindex="-1" id="mobileMenu"
    style="width: 285px; z-index: 1060; border-radius: 0 24px 24px 0;">
    <div class="offcanvas-header p-4"
        style="background: linear-gradient(135deg, var(--primary-50) 0%, #ffffff 100%); border-bottom: 1px solid var(--border-light);">
        <div class="d-flex align-items-center gap-2">
            <img src="<%= fixImg(settings.brand_logo, '/images/logo.png') %>" alt="Logo" style="height: 34px;"
                onerror="this.src='/images/logo.png'">
            <div class="d-flex flex-column justify-content-center">
                <span class="fw-black d-block lh-1"
                    style="font-family: 'Inter', sans-serif; color: var(--primary); font-size: 1.05rem; font-weight: 900;">
                    <%= settings.brand_name || 'BÌNH LỢI' %>
                </span>
                <span class="d-block text-truncate"
                    style="font-family: 'Dancing Script', cursive; font-size: 0.95rem; color: var(--primary-green); font-weight: 700; margin-top: 1px;">
                    <%= settings.brand_subtext || 'Chạm vào bình yên' %>
                </span>
            </div>
        </div>
        <button type="button" class="btn-close shadow-none p-2" data-bs-dismiss="offcanvas" aria-label="Đóng"></button>
    </div>

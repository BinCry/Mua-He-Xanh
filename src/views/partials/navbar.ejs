            <a class="mobile-menu-link" href="/map"><i class="bi bi-map-fill text-primary"></i> Bản đồ</a>
            <a class="mobile-menu-link" href="/festivals"><i class="bi bi-calendar-event-fill text-success"></i> Lễ

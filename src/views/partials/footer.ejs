<footer class="footer-main py-5" style="background: #922724; color: rgba(255,255,255,0.92); font-size: 0.88rem; border-top: 1px solid rgba(255,255,255,0.1);">
    <div class="container">
        <div class="row g-5">
            <!-- Brand Column -->
            <div class="col-lg-3">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <div class="bg-white rounded-circle p-1 d-flex align-items-center justify-content-center shadow-sm flex-shrink-0" style="width: 44px; height: 44px;">
                        <img src="<%= fixImg(settings.brand_logo, '/images/logo.png') %>" alt="Logo" style="max-height: 32px; max-width: 32px; object-fit: contain;" onerror="this.src='/images/logo.png'">
                    </div>
                    <div class="d-flex flex-column justify-content-center" style="overflow: visible;">
                        <span class="d-block fw-black" style="font-family: &quot;Segoe UI&quot;, Arial, sans-serif; font-synthesis: none; font-size: 1.25rem; font-weight: 900; letter-spacing: 0.5px; color: #ffffff; line-height: 1.25; padding-top: 2px;"><%= settings.brand_name || 'BÌNH LỢI' %></span>
                        <span class="d-block footer-brand-subtext" style="font-size: 1.1rem; color: rgba(255,255,255,0.9); font-weight: 700; margin-top: 1px; line-height: 1.25; padding-bottom: 2px;"><%= settings.brand_subtext || 'Chạm sắc bản nguyên' %></span>
                    </div>
                </div>
                <p class="mb-4" style="line-height: 1.8; color: rgba(255,255,255,0.92);">
                    Hành trình khám phá Bình Lợi bắt đầu từ đây
                </p>
                <div class="footer-social-list" aria-label="Kết nối mạng xã hội">
                    <a href="<%= settings.social_facebook || '#' %>" target="_blank" rel="noopener noreferrer" class="footer-social-btn footer-social-btn--facebook" title="Facebook" aria-label="Facebook"><i class="bi bi-facebook" aria-hidden="true"></i></a>
                    <a href="<%= settings.social_instagram || '#' %>" target="_blank" rel="noopener noreferrer" class="footer-social-btn footer-social-btn--instagram" title="Instagram" aria-label="Instagram"><i class="bi bi-instagram" aria-hidden="true"></i></a>
                    <a href="<%= settings.social_tiktok || '#' %>" target="_blank" rel="noopener noreferrer" class="footer-social-btn footer-social-btn--tiktok" title="TikTok" aria-label="TikTok"><i class="bi bi-tiktok" aria-hidden="true"></i></a>
                    <a href="<%= settings.social_threads || '#' %>" target="_blank" rel="noopener noreferrer" class="footer-social-btn footer-social-btn--threads" title="Threads" aria-label="Threads"><i class="bi bi-threads" aria-hidden="true"></i></a>
                </div>
            </div>

            <!-- Features Links -->
            <div class="col-6 col-md-3 col-lg-2">
                <h6 class="fw-bold mb-3 text-uppercase tracking-widest text-white" style="font-size: 0.8rem; color: #ffffff !important;">TÍNH NĂNG</h6>
                <ul class="list-unstyled d-flex flex-column gap-2">
                    <li><a href="/" class="footer-link-premium">Trang chủ</a></li>
                    <li><a href="/explore" class="footer-link-premium">Khám phá</a></li>
                    <li><a href="/shops" class="footer-link-premium">Shop</a></li>
                    <li><a href="/reviews" class="footer-link-premium">Cộng đồng</a></li>
                    <li><a href="/journey" class="footer-link-premium">Hành trình</a></li>
                    <li><a href="/map" class="footer-link-premium">Bản đồ</a></li>
                </ul>
            </div>

            <!-- Support -->
            <div class="col-6 col-md-3 col-lg-2">
                <h6 class="fw-bold mb-3 text-uppercase tracking-widest text-white" style="font-size: 0.8rem; color: #ffffff !important;">HỖ TRỢ</h6>
                <ul class="list-unstyled d-flex flex-column gap-2">
                    <li><a href="/huong-dan" class="footer-link-premium">Hướng dẫn</a></li>
                    <li><a href="/cau-hoi-thuong-gap" class="footer-link-premium">Câu hỏi thường gặp</a></li>
                    <li><a href="/lien-he" class="footer-link-premium">Liên hệ</a></li>
                    <li><a href="/dieu-khoan-dich-vu" class="footer-link-premium">Điều khoản dịch vụ</a></li>
                    <li><a href="/chinh-sach-bao-mat" class="footer-link-premium">Chính sách bảo mật</a></li>
                </ul>
            </div>

            <!-- Contact -->
            <div class="col-md-6 col-lg-3">
                <h6 class="fw-bold mb-3 text-uppercase tracking-widest text-white" style="font-size: 0.8rem; color: #ffffff !important;">Liên hệ với chúng tôi</h6>
                <ul class="list-unstyled d-flex flex-column gap-3" style="color: rgba(255,255,255,0.92);">
                    <li class="d-flex gap-2">
                        <i class="bi bi-geo-alt text-white" style="margin-top: 2px;"></i>
                        <span>Xã Bình Lợi, TP. Hồ Chí Minh</span>
                    </li>
                    <li class="d-flex gap-2">
                        <i class="bi bi-telephone text-white"></i>
                        <span><%= settings.contact_phone || '(028) 3765 0xxx' %></span>
                    </li>
                    <li class="d-flex gap-2">
                        <i class="bi bi-envelope text-white"></i>
                        <span><%= settings.contact_email || 'contact@binhloi-healing.vn' %></span>
                    </li>
                </ul>
            </div>

            <!-- Updates -->
            <div class="col-md-6 col-lg-2">
                <h6 class="fw-bold mb-3 text-uppercase tracking-widest text-white" style="font-size: 0.8rem; color: #ffffff !important;">CẬP NHẬT TIN TỨC</h6>
                <p class="mb-3 footer-newsletter-copy" style="color: rgba(255,255,255,0.92); line-height: 1.6; font-size: 0.8rem;">
                    Khám phá những trải nghiệm hấp&nbsp;dẫn. Theo dõi Facebook hoặc liên hệ với Bình Lợi để cập nhật tin mới.
                </p>
                <% const updateChannel = String(settings.social_facebook || '').trim(); %>
                <% if (updateChannel && updateChannel !== '#') { %>
                    <a href="<%= updateChannel %>" target="_blank" rel="noopener noreferrer" class="btn btn-outline-light rounded-pill px-3 py-2 fw-semibold">Theo dõi Facebook</a>
                <% } else { %>
                    <a href="/lien-he" class="btn btn-outline-light rounded-pill px-3 py-2 fw-semibold">Liên hệ Bình Lợi</a>
                <% } %>
            </div>
        </div>

        <hr class="my-4" style="border-color: rgba(255,255,255,0.15);">

        <!-- Bottom Copyright -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3" style="color: rgba(255,255,255,0.92); font-size: 0.8rem;">
            <span>© <%= new Date().getFullYear() %> Bình Lợi. Mọi quyền được bảo lưu.</span>
            <span>Đồng hành chiến lược bởi <span class="fw-bold" style="color: #ffffff;">LOMAR 2026</span></span>
        </div>
    </div>
</footer>

<style>
    .footer-social-list { display: flex; align-items: center; gap: 10px; }
    .footer-social-btn {
        width: 44px; height: 44px;
        border-radius: 50%;
        display: inline-flex; align-items: center; justify-content: center;
        position: relative;
        overflow: hidden;
        isolation: isolate;
        background: rgba(73, 17, 17, 0.32);
        border: 1px solid rgba(255, 255, 255, 0.3);
        color: #ffffff;
        transition: transform 180ms ease, background-color 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
        font-size: 1.18rem;
        text-decoration: none;
    }
    .footer-social-btn::before {
        content: '';
        position: absolute;
        inset: 6px;
        z-index: -1;
        border-radius: inherit;
        opacity: 0.92;
        transition: transform 180ms ease, opacity 180ms ease;
    }
    .footer-social-btn--facebook::before { background: #1877f2; }
    .footer-social-btn--instagram::before { background: linear-gradient(135deg, #ffdc80 0%, #fcaf45 24%, #f77737 46%, #d62976 68%, #962fbf 100%); }
    .footer-social-btn--tiktok::before { background: #151515; box-shadow: 2px 0 0 #ff5b84, -2px 0 0 #4fe2d5; }
    .footer-social-btn--threads::before { background: #252525; }
    .footer-social-btn:hover,
    .footer-social-btn:focus-visible {
        color: #ffffff !important;
        transform: translateY(-2px);
        border-color: rgba(255, 255, 255, 0.72);
        box-shadow: 0 8px 18px rgba(56, 12, 12, 0.28);
    }
    .footer-social-btn:hover::before,
    .footer-social-btn:focus-visible::before { transform: scale(1.14); opacity: 1; }
    .footer-social-btn:active { transform: translateY(0) scale(0.96); }
    .footer-social-btn:focus-visible { outline: 3px solid #ffffff; outline-offset: 3px; }
    @media (prefers-reduced-motion: reduce) {
        .footer-social-btn, .footer-social-btn::before { transition: none; }
    }
    .footer-link-premium {
        color: rgba(255, 255, 255, 0.92);
        text-decoration: none;
        transition: all 0.2s ease;
    }
    .footer-link-premium:hover {
        color: #ffffff !important;
        padding-left: 4px;
    }
    .tracking-widest { letter-spacing: 1.5px !important; }
    .footer-newsletter-copy {
        max-width: 28rem;
        text-wrap: pretty;
    }
    @media (max-width: 575.98px) {
        .footer-newsletter-copy {
            max-width: 100%;
            font-size: 0.82rem !important;
            line-height: 1.55 !important;
        }
    }
</style>

<section class="auth-section min-vh-100 d-flex align-items-center position-relative overflow-hidden py-5">
    <!-- Cinematic Background -->
    <div class="position-absolute top-0 start-0 w-100 h-100" style="background: url('<%= fixImg(settings.login_bg, '/images/hero-1.png') %>') center/cover; z-index: 0; filter: brightness(0.35);"></div>

    <div class="container position-relative z-index-10">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-7 col-sm-10">
                
                <div class="text-center mb-4 reveal-up">
                    <img src="<%= fixImg(settings.brand_logo, '/images/logo.png') %>" alt="Logo" height="65" class="mb-3" onerror="this.src='/images/logo.png'">
                    <h2 class="text-white fw-black tracking-widest text-uppercase mb-1"><%= settings.brand_name || 'BÌNH LỢI' %></h2>
                    <p class="text-white-50 small mb-0"><%= settings.brand_subtext || 'Chạm vào bình yên' %></p>
                </div>

                <div class="auth-card border-0 shadow-premium rounded-5 overflow-hidden reveal-up" style="transition-delay: 0.1s">
                    <div class="p-4 p-md-5 text-center">
                        
                        <h4 class="text-white fw-bold mb-2">Đăng Nhập Nhanh</h4>
                        <p class="text-white-50 small mb-4">Vui lòng chọn phương thức đăng nhập để tiếp tục trải nghiệm tuyệt vời cùng Bình Lợi Healing</p>

                        <% if (typeof error !== 'undefined' && error) { %>
                            <div class="alert alert-danger bg-danger bg-opacity-25 text-white border-0 rounded-4 small text-center mb-4 animate__animated animate__shakeX">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i> <%= error %>
                            </div>
                        <% } %>

                        <!-- Social Logins (Primary) -->
                        <div class="d-flex flex-column gap-3 mb-3">
                            <a href="/auth/google" class="btn btn-light w-100 rounded-pill shadow-sm social-login-btn py-3">
                                <img class="social-login-icon me-2" src="https://upload.wikimedia.org/wikipedia/commons/c/c1/Google_%22G%22_logo.svg" alt="Google" style="width: 22px; height: 22px;">
                                <span class="fw-bold text-dark fs-6">Đăng nhập với Google</span>
                            </a>
                            <a href="/auth/facebook" class="btn btn-primary w-100 rounded-pill shadow-sm border-0 social-login-btn py-3" style="background-color: #1877F2;">
                                <i class="bi bi-facebook social-login-icon me-2 fs-5"></i>
                                <span class="fw-bold fs-6">Đăng nhập với Facebook</span>
                            </a>
                        </div>

                        <div class="mt-4 pt-2 border-top border-white border-opacity-10">
                            <p class="x-small text-white-50 mb-0">
                                Bằng cách đăng nhập, bạn đồng ý với <a href="#" class="text-white text-decoration-underline">Điều khoản dịch vụ</a> và <a href="#" class="text-white text-decoration-underline">Chính sách bảo mật</a> của chúng tôi.
                            </p>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        gsap.from('.reveal-up', { opacity: 0, y: 30, stagger: 0.1, duration: 0.8, ease: 'power2.out' });

        if (window.location.search.includes('error=')) {
            const cleanUrl = window.location.protocol + "//" + window.location.host + window.location.pathname;
            window.history.replaceState({ path: cleanUrl }, '', cleanUrl);
        }
    });
</script>

<style>
    .auth-card { 
        background: rgba(0, 0, 0, 0.55); 
        backdrop-filter: blur(25px); 
        -webkit-backdrop-filter: blur(25px); 
        border: 1px solid rgba(255, 255, 255, 0.15); 
    }
    .tracking-widest { letter-spacing: 2px; }
    .z-index-10 { z-index: 10; }
    .social-login-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .social-login-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25) !important;
    }
</style>

<section class="auth-section min-vh-100 d-flex align-items-center position-relative overflow-hidden py-5">
    <!-- Cinematic Background -->
    <div class="position-absolute top-0 start-0 w-100 h-100" style="background: url('<%= fixImg(settings.login_bg, '/images/hero-1.png') %>') center/cover; z-index: 0; filter: brightness(0.35);"></div>

    <div class="container position-relative z-index-10">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-7 col-sm-10">
                
                <div class="text-center mb-4">
                    <a href="/" class="text-decoration-none">
                        <img src="<%= fixImg(settings.brand_logo, '/images/logo.svg') %>" alt="Logo" height="65" class="mb-3" onerror="this.src='/images/logo.svg'">
                        <h2 class="fw-black tracking-widest text-uppercase mb-1" style="color: #922724 !important; font-weight: 900; text-shadow: 0 1px 3px rgba(255,255,255,0.9);"><%= settings.brand_name || 'BÌNH LỢI' %></h2>
                        <p class="small mb-0 fw-bold" style="font-family: 'Dancing Script', cursive; font-size: 1.15rem; color: #15803d !important; text-shadow: 0 1px 3px rgba(255,255,255,0.9);"><%= settings.brand_subtext || 'Chạm vào bình yên' %></p>
                    </a>
                </div>

                <div class="auth-card border-0 shadow-premium rounded-5 overflow-hidden">
                    <div class="p-4 p-md-5">
                        
                        <div class="text-center mb-4">
                            <h4 class="text-white fw-bold mb-2">Tiếp Tục Với Du Lịch Bình Lợi</h4>
                            <p class="text-white-50 small mb-0">Đăng nhập tài khoản để lưu lại hành trình & trải nghiệm trọn vẹn</p>
                        </div>

                        <div id="ajaxErrorBox" class="alert alert-danger bg-danger bg-opacity-25 text-white border-0 rounded-4 small text-center mb-4 <%= (typeof error !== 'undefined' && error) ? '' : 'd-none' %> animate__animated animate__shakeX">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> <span id="ajaxErrorMsg"><%= (typeof error !== 'undefined' && error) ? error : '' %></span>
                        </div>

                        <!-- 1. Social Logins (Google & Facebook) -->
                        <div class="d-flex flex-column gap-3 mb-4">
                            <a href="/auth/google" class="btn btn-light w-100 rounded-pill shadow-sm social-login-btn py-3">
                                <img class="social-login-icon me-2" src="https://upload.wikimedia.org/wikipedia/commons/c/c1/Google_%22G%22_logo.svg" alt="Google" style="width: 22px; height: 22px;">
                                <span class="fw-bold text-dark fs-6">Tiếp tục với Google</span>
                            </a>
                            <a href="/auth/facebook" class="btn btn-primary w-100 rounded-pill shadow-sm border-0 social-login-btn py-3" style="background-color: #1877F2;">
                                <i class="bi bi-facebook social-login-icon me-2 fs-5"></i>
                                <span class="fw-bold fs-6">Tiếp tục với Facebook</span>
                            </a>
                        </div>

                        <!-- Divider -->
                        <div class="d-flex align-items-center my-4">
                            <hr class="flex-grow-1 border-white border-opacity-25 my-0">
                            <span class="px-3 text-white-50 small">Hoặc bằng Email</span>
                            <hr class="flex-grow-1 border-white border-opacity-25 my-0">
                        </div>

                        <!-- 2. Email & Password Login Form (Works for both Users & Admin) -->
                        <form action="/auth/login" method="POST" id="unifiedLoginForm">
                            <div class="mb-3">
                                <label class="form-label text-white-50 small fw-bold">Email</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white bg-opacity-10 border-white border-opacity-25 text-white">
                                        <i class="bi bi-envelope-fill"></i>
                                    </span>
                                    <input type="text" name="email" class="form-control auth-input bg-white bg-opacity-10 border-white border-opacity-25 text-white" placeholder="nhapemail@gmail.com" required autocomplete="username">
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label text-white-50 small fw-bold">Mật khẩu</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white bg-opacity-10 border-white border-opacity-25 text-white">
                                        <i class="bi bi-key-fill"></i>
                                    </span>
                                    <input type="password" name="password" id="passwordInput" class="form-control auth-input bg-white bg-opacity-10 border-white border-opacity-25 text-white" placeholder="••••••••" autocomplete="current-password">
                                    <button class="btn btn-outline-light border-white border-opacity-25" type="button" onclick="togglePasswordVisibility()">
                                        <i class="bi bi-eye-fill" id="togglePasswordIcon"></i>
                                    </button>
                                </div>
                            </div>

                            <button type="submit" id="submitBtn" class="btn btn-primary-bl w-100 rounded-pill py-3 fw-bold shadow-lg text-uppercase tracking-wider">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Đăng Nhập
                            </button>
                        </form>

                        <div class="mt-4 pt-3 border-top border-white border-opacity-10 text-center">
                            <p class="x-small text-white-50 mb-0">
                                Bằng cách đăng nhập, bạn đồng ý với <a href="#" class="text-white text-decoration-underline">Điều khoản dịch vụ</a> và <a href="#" class="text-white text-decoration-underline">Chính sách bảo mật</a> của chúng tôi.
                            </p>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script>
    function togglePasswordVisibility() {
        const input = document.getElementById('passwordInput');
        const icon = document.getElementById('togglePasswordIcon');
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('bi-eye-fill');
            icon.classList.add('bi-eye-slash-fill');
        } else {
            input.type = 'password';
            icon.classList.remove('bi-eye-slash-fill');
            icon.classList.add('bi-eye-fill');
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        gsap.from('.reveal-up', { opacity: 0, y: 30, stagger: 0.1, duration: 0.8, ease: 'power2.out' });

        if (window.location.search.includes('error=')) {
            const cleanUrl = window.location.protocol + "//" + window.location.host + window.location.pathname;
            window.history.replaceState({ path: cleanUrl }, '', cleanUrl);
        }

        const loginForm = document.getElementById('unifiedLoginForm');
        if (loginForm) {
            loginForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const btn = document.getElementById('submitBtn');
                const origHtml = btn.innerHTML;
                const errBox = document.getElementById('ajaxErrorBox');
                const errText = document.getElementById('ajaxErrorMsg');

                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang kiểm tra...';
                if (errBox) errBox.classList.add('d-none');

                try {
                    const res = await fetch('/auth/login', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json'
                        },
                        body: JSON.stringify({
                            email: loginForm.email.value,
                            password: loginForm.password.value
                        })
                    });
                    const data = await res.json();
                    if (data.success) {
                        window.location.href = data.redirect || '/';
                    } else {
                        if (errText) errText.textContent = data.message || 'Mật khẩu hoặc tài khoản không chính xác.';
                        if (errBox) errBox.classList.remove('d-none');
                        btn.disabled = false;
                        btn.innerHTML = origHtml;
                    }
                } catch (err) {
                    if (errText) errText.textContent = 'Lỗi kết nối máy chủ. Vui lòng thử lại.';
                    if (errBox) errBox.classList.remove('d-none');
                    btn.disabled = false;
                    btn.innerHTML = origHtml;
                }
            });
        }
    });
</script>

<style>
    .auth-card { 
        background: rgba(15, 15, 15, 0.75); 
        backdrop-filter: blur(25px); 
        -webkit-backdrop-filter: blur(25px); 
        border: 1px solid rgba(255, 255, 255, 0.18); 
    }
    .tracking-widest { letter-spacing: 2px; }
    .tracking-wider { letter-spacing: 1px; }
    .z-index-10 { z-index: 10; }
    
    .auth-input {
        transition: all 0.3s ease;
        font-size: 0.95rem;
        padding: 12px 16px;
    }
    .auth-input:focus {
        background: rgba(255, 255, 255, 0.2) !important;
        border-color: rgba(255, 255, 255, 0.5) !important;
        box-shadow: 0 0 15px rgba(255, 255, 255, 0.2);
        color: #fff !important;
    }
    .auth-input::placeholder {
        color: rgba(255, 255, 255, 0.4);
    }

    .social-login-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .social-login-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25) !important;
    }
    .btn-primary-bl {
        background: linear-gradient(135deg, #922724 0%, #b8322e 100%);
        color: white;
        border: none;
        transition: all 0.3s ease;
    }
    .btn-primary-bl:hover {
        background: linear-gradient(135deg, #a62c29 0%, #d13935 100%);
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(146, 39, 36, 0.4) !important;
    }
</style>

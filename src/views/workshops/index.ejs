<section class="py-4 py-md-5 bg-light min-vh-100">
  <div class="container py-3">
    <header class="text-center mb-4 mb-md-5">
      <h1 class="display-6 fw-bold">Workshop theo từng ca</h1>
    </header>
    <form class="card border-0 shadow-sm rounded-4 p-2 mb-5 workshop-search" action="/workshops" method="get" role="search" data-live-catalog-search>
      <div class="input-group">
        <input type="search" class="form-control border-0 shadow-none" name="q" value="<%= searchQuery %>" maxlength="100" placeholder="Tìm Workshop hoặc địa điểm" aria-label="Tìm Workshop" autocomplete="off">
        <button class="btn workshop-search-button rounded-pill px-4" type="submit">Tìm kiếm</button>
      </div>
    </form>
    <% if (searchQuery) { %>
      <div class="d-flex justify-content-end mb-4"><a class="btn btn-outline-secondary rounded-pill px-4" href="/workshops">Xem tất cả</a></div>
    <% } %>
    <div data-catalog-results aria-live="polite">
    <div class="row g-4">
      <% sessions.forEach(session => { const remaining = Math.max(0, Number(session.capacity) - Number(session.reserved_seats)); %>
      <article class="col-12 col-md-6 col-xl-4">
        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
          <% if (session.image) { %><img class="card-img-top workshop-image" src="<%= fixImg(session.image, '/uploads/posters/poster-1.webp') %>" alt="" loading="lazy"><% } %>
          <div class="card-body d-flex flex-column p-4">
            <p class="small text-success fw-bold mb-2"><%= session.destination_name || 'Bình Lợi' %></p>
            <h2 class="h5 fw-bold"><a class="text-decoration-none text-dark" href="/workshops/<%= session.workshop_id %>"><%= session.title %></a></h2>
            <p class="text-secondary small flex-grow-1"><%= (session.description || '').slice(0, 170) %></p>
            <dl class="row small mb-3">
              <dt class="col-5 text-secondary">Bắt đầu</dt><dd class="col-7"><%= new Date(session.starts_at).toLocaleString('vi-VN') %></dd>
              <dt class="col-5 text-secondary">Còn lại</dt><dd class="col-7"><%= remaining %> / <%= session.capacity %> chỗ</dd>
              <dt class="col-5 text-secondary">Giá</dt><dd class="col-7 fw-bold"><%= new Intl.NumberFormat('vi-VN').format(session.price_vnd) %>đ</dd>
            </dl>
            <a class="btn btn-outline-success rounded-pill" href="/workshops/<%= session.workshop_id %>">Xem ca &amp; đăng ký</a>
          </div>
        </div>
      </article>
      <% }) %>
    </div>
    <% if (!sessions.length) { %>
      <div class="text-center bg-white rounded-4 p-5 shadow-sm">
        <h2 class="h5 mb-2">Chưa có ca Workshop phù hợp</h2>
        <% if (searchQuery) { %><p class="text-secondary mb-0">Thử đổi từ khóa hoặc xem toàn bộ các ca đang mở.</p><% } %>
      </div>
    <% } %>
    </div>
  </div>
</section>
<style>
  .workshop-image{height:190px;object-fit:cover}
  .workshop-search-button{background:#a22926;border-color:#a22926;color:#fff;min-height:46px;font-weight:700}
  .workshop-search-button:hover,.workshop-search-button:focus{background:#86211f;border-color:#86211f;color:#fff}
  @media(max-width:575.98px){.workshop-image{height:170px}.workshop-search{margin-bottom:2rem!important}.workshop-search-button{padding-inline:1rem!important}}
</style>
<script src="/js/live-catalog-search.js?v=<%= assetV %>" defer></script>

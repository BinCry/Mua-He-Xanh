<!-- Minimal staff profile for administrators and destination managers -->
<style>
    .staff-profile {
        max-width: 680px;
        margin: 0 auto;
        padding: 12px 0 28px;
    }
    .staff-profile__heading {
        margin-bottom: 20px;
    }
    .staff-profile__heading h4 {
        color: var(--admin-text);
        font-weight: 800;
        margin: 0 0 4px;
    }
    .staff-profile__heading p {
        color: var(--admin-muted);
        font-size: 0.88rem;
        margin: 0;
    }
    .staff-profile__card {
        background: var(--admin-surface);
        border: 1px solid var(--admin-border);
        border-radius: 20px;
        overflow: hidden;
    }
    .staff-profile__cover {
        height: 104px;
        background: linear-gradient(135deg, color-mix(in srgb, var(--admin-primary) 92%, #ffffff), var(--admin-primary));
    }
    .staff-profile__body {
        padding: 0 28px 28px;
    }
    .staff-profile__avatar {
        width: 104px;
        height: 104px;
        display: block;
        margin: -52px auto 14px;
        border: 4px solid var(--admin-surface);
        border-radius: 50%;
        background: #ffffff;
        object-fit: cover;
        box-shadow: 0 8px 20px rgba(0,0,0,0.14);
    }
    .staff-profile__name {
        color: var(--admin-text);
        font-size: 1.35rem;
        font-weight: 800;
        text-align: center;
        margin: 0 0 22px;
    }
    .staff-profile__contacts {
        display: grid;
        gap: 12px;
        margin: 0;
    }
    .staff-profile__contact {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
        padding: 14px 16px;
        background: var(--admin-bg);
        border-radius: 12px;
    }
    .staff-profile__contact-icon {
        width: 36px;
        height: 36px;
        flex: 0 0 auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--admin-primary);
        background: color-mix(in srgb, var(--admin-primary) 12%, transparent);
        border-radius: 10px;
    }
    .staff-profile__contact-label {
        display: block;
        color: var(--admin-muted);
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }
    .staff-profile__contact-value {
        display: block;
        overflow-wrap: anywhere;
        color: var(--admin-text);
        font-size: 0.92rem;
        font-weight: 600;
    }
    @media (max-width: 575px) {
        .staff-profile { padding-top: 2px; }
        .staff-profile__body { padding: 0 18px 18px; }
    }
</style>

<main class="staff-profile">
    <header class="staff-profile__heading">
        <h4><%= staffUser.role === 'admin' ? 'Hồ sơ Quản trị' : 'Hồ sơ Quản lý' %></h4>
        <p>Thông tin liên hệ của tài khoản.</p>
    </header>

    <section class="staff-profile__card" aria-label="Thông tin hồ sơ">
        <div class="staff-profile__cover" aria-hidden="true"></div>
        <div class="staff-profile__body">
            <img
                src="<%= fixImg(staffUser.avatar || (staffUser.role === 'admin' ? settings.brand_logo : ''), '/images/default-avatar.svg') %>"
                alt="Ảnh đại diện của <%= staffUser.full_name %>"
                class="staff-profile__avatar"
                onerror="this.onerror=null;this.src='/images/default-avatar.svg';">
            <h1 class="staff-profile__name"><%= staffUser.full_name %></h1>

            <dl class="staff-profile__contacts">
                <div class="staff-profile__contact">
                    <span class="staff-profile__contact-icon" aria-hidden="true"><i class="bi bi-telephone"></i></span>
                    <div>
                        <dt class="staff-profile__contact-label">Liên hệ</dt>
                        <dd class="staff-profile__contact-value mb-0"><%= staffUser.phone || 'Chưa cập nhật' %></dd>
                    </div>
                </div>
            </dl>
        </div>
    </section>
</main>

<!-- Shop product detail: direct contact only, never an online order. -->
<section class="py-4 py-md-5" style="background: #f8faf9;">
    <div class="container py-3">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <nav aria-label="breadcrumb" class="mb-4">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Trang chủ</a></li>
                        <li class="breadcrumb-item"><a href="/shops" class="text-decoration-none text-muted">Shop hàng hóa</a></li>
                        <li class="breadcrumb-item active" aria-current="page"><%= workshop.title %></li>
                    </ol>
                </nav>

                <article class="card border-0 shadow-premium rounded-4 overflow-hidden mb-5 bg-white reveal-up">
                    <div class="w-100 bg-dark p-2 text-center position-relative">
                        <img src="<%= fixImg(workshop.image, '/uploads/posters/poster-1.webp') %>" class="img-fluid rounded-3 shadow" style="max-height: 540px; width: 100%; object-fit: contain; background: #0f172a;" alt="<%= workshop.title %>">
                    </div>
                    <div class="p-4 p-md-5">
                        <header class="mb-4 pb-3 border-bottom">
                            <span class="badge bg-dark bg-opacity-75 text-white mb-2 px-3 py-1.5 rounded-pill fw-bold text-uppercase notranslate" translate="no" style="font-size: .75rem; background: rgba(15, 23, 42, .85) !important;">
                                <i class="bi bi-shop me-1"></i><%= workshop.destination_name || 'Bình Lợi' %>
                            </span>
                            <h1 class="display-6 fw-black text-dark mb-3 font-display notranslate" translate="no"><%= workshop.title %></h1>
                            <div class="d-flex flex-wrap align-items-center gap-3 text-muted" style="font-size: .95rem;">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-tag-fill text-warning fs-5"></i>
                                    <span class="fw-black <%= (!workshop.price || workshop.price <= 0) ? 'text-primary' : 'text-dark' %> fs-5">
                                        <%= (!workshop.price || workshop.price <= 0) ? 'Liên hệ' : new Intl.NumberFormat('vi-VN').format(workshop.price) + 'đ' %>
                                    </span>
                                </div>
                                <span aria-hidden="true">·</span>
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-box-seam text-primary fs-5"></i>
                                    <span class="fw-semibold"><%= workshop.duration || workshop.duration_minutes || 'Quy cách chuẩn' %></span>
                                </div>
                                <span aria-hidden="true">·</span>
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-geo-alt-fill text-danger fs-5"></i>
                                    <% if (workshop.destination_slug) { %>
                                        <a href="/explore/<%= workshop.destination_slug %>" class="text-decoration-none text-dark fw-bold hover-underline" title="Xem địa điểm cung cấp"><%= workshop.destination_name || 'Bình Lợi' %></a>
                                    <% } else { %>
                                        <span class="fw-semibold"><%= workshop.destination_name || 'Bình Lợi' %></span>
                                    <% } %>
                                </div>
                            </div>
                        </header>

                        <h2 class="h4 fw-bold mb-3 text-primary font-display">Thông tin sản phẩm</h2>
                        <div class="story-text-rich text-secondary mb-5" style="font-size: 1.1rem; line-height: 1.8; text-align: justify; white-space: pre-line;"><%= workshop.description || '' %></div>

                        <section class="p-4 rounded-4 bg-light border" aria-labelledby="shop-contact-title">
                            <h2 class="h5 fw-bold mb-3" id="shop-contact-title" style="color: var(--primary);"><i class="bi bi-chat-dots-fill me-2"></i>Liên hệ sản phẩm</h2>
                            <div class="row g-3 mb-3">
                                <div class="col-sm-6">
                                    <div class="small text-muted mb-1"><i class="bi bi-calendar-event me-1"></i>Thời gian phục vụ</div>
                                    <div class="fw-bold text-dark"><%= workshop.start_date ? new Date(workshop.start_date).toLocaleDateString('vi-VN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) : 'Hằng ngày' %></div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="small text-muted mb-1"><i class="bi bi-geo-alt me-1"></i>Điểm cung cấp</div>
                                    <div class="fw-bold text-dark"><%= workshop.destination_name || 'Bình Lợi' %></div>
                                </div>
                            </div>
                            <p class="small text-muted mb-4">Sản phẩm được trao đổi trực tiếp với điểm cung cấp để xác nhận giá, số lượng và cách nhận. Shop không nhận đơn trực tuyến.</p>
                            <a href="https://zalo.me/0395529890" target="_blank" rel="noopener" class="btn btn-primary w-100 rounded-pill py-3 fw-bold btn-premium" style="background: var(--primary);"><i class="bi bi-chat-dots-fill me-2"></i>LIÊN HỆ ZALO ĐỂ ĐƯỢC TƯ VẤN</a>
                        </section>
                    </div>
                </article>
            </div>
        </div>
    </div>
</section>

<!-- Shop & Products Listing - 100% Screenshot Match -->
<section class="py-4 py-md-5" style="background: #fafafa; min-height: 100vh;">
    <div class="container py-3">
        
        <!-- Elegant Header Section -->
        <div class="mb-5 text-center px-3" style="padding-top: 10px; padding-bottom: 10px;">
            <h1 class="shop-title display-6 fw-bold text-dark mb-0 font-display" style="font-family: 'Montserrat', 'Inter', sans-serif; letter-spacing: -0.5px;">
                Sản Phẩm Của Chúng Tôi
            </h1>
        </div>

        <!-- Filter & Search Capsules Bar (Single line search input + right button) -->
        <div class="card border-0 shadow-sm rounded-4 p-2.5 mb-5 bg-white reveal-up">
            <form action="/shops" method="GET" id="workshopSearchForm">
                <div class="input-group rounded-pill overflow-hidden bg-light border p-1.5 w-100">
                    <span class="input-group-text bg-transparent border-0 ps-3 pe-2 text-muted">
                        <i class="bi bi-search fs-5"></i>
                    </span>
                    <input type="text" name="q" class="form-control border-0 bg-transparent shadow-none px-2" 
                        placeholder="Tìm kiếm sản phẩm, yến sào, quà tặng..." 
                        value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>" style="font-size: 0.95rem; height: 44px;">
                    <button type="submit" class="btn btn-primary rounded-pill px-4 px-md-5 fw-bold text-white flex-shrink-0" style="background: var(--primary); font-size: 0.9rem; height: 44px;">
                        Tìm kiếm
                    </button>
                </div>

                <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
                    <div class="text-center mt-2 mb-0">
                        <a href="/shops" class="text-danger small fw-bold text-decoration-none"><i class="bi bi-x-circle me-1"></i>Xóa tìm kiếm</a>
                    </div>
                <% } %>
            </form>
        </div>

        <script>
        function setWorkshopType(val) {
            document.getElementById('filterTypeInput').value = val;
            document.getElementById('workshopSearchForm').submit();
        }
        </script>


        <!-- 4-Column Product Grid (Matching Screenshot 100%) -->
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 shop-grid-container">
            <% workshops.forEach((ws, i) => { %>
            <div class="col reveal-up">
                <div class="card h-100 border-0 shop-product-card rounded-4 overflow-hidden bg-white shadow-sm" style="transition: all 0.3s ease;">
                    
                    <!-- Product Image Container (1:1 Square ratio showing 100% full product image) -->
                    <div class="position-relative shop-img-holder" style="width: 100%; aspect-ratio: 1 / 1; overflow: hidden; background: #ffffff;">
                        <a href="/shops/<%= ws.id %>" class="d-block w-100 h-100">
                            <img src="<%= fixImg(ws.image, '/uploads/posters/poster-1.webp') %>" alt="<%= ws.title %>" class="w-100 h-100 shop-img" style="object-fit: cover; object-position: top center;">
                        </a>
                        
                        <!-- Top Left Badge (Bình Lợi Tag) -->
                        <div class="position-absolute top-0 start-0 m-3" style="z-index: 5;">
                            <span class="badge bg-dark bg-opacity-75 rounded-pill px-3 py-1.5 fw-bold shadow-sm" style="font-size: 0.72rem; letter-spacing: 0.5px; background: rgba(15, 23, 42, 0.85) !important; color: #ffffff !important;">
                                ✨ Bình Lợi
                            </span>
                        </div>
                    </div>

                    <!-- Card Body -->
                    <div class="card-body p-4 d-flex flex-column justify-content-between flex-grow-1">
                        <div>
                            <!-- Product Title -->
                            <h5 class="fw-bold mb-1 shop-title-text" style="font-family: 'Inter', sans-serif; font-size: 1.02rem; line-height: 1.45; color: #1e293b; min-height: 2.9rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                <a href="/shops/<%= ws.id %>" class="text-decoration-none text-dark hover-primary"><%= ws.title %></a>
                            </h5>
                            
                            <!-- Product Sub-description -->
                            <p class="text-secondary small mb-3 shop-desc-text" style="font-size: 0.85rem; color: #64748b !important; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                <%= (ws.description || '').replace(/\.+$/, '') %>
                            </p>
                        </div>

                        <!-- Price & Cart Button Row (Bottom Row) -->
                        <div class="d-flex align-items-center justify-content-between pt-3 mt-auto border-top border-light">
                            <!-- Price Block -->
                            <div class="shop-price-wrapper">
                                <% if (ws.price > 500000) { %>
                                    <div class="text-muted text-decoration-line-through x-small" style="font-size: 0.78rem; color: #94a3b8 !important;">
                                        <%= new Intl.NumberFormat('vi-VN').format(Math.round(ws.price * 1.18)) %>đ
                                    </div>
                                <% } %>
                                <div class="fw-black text-dark shop-price-val" style="font-size: 1.28rem; font-weight: 900; color: #0f172a !important;">
                                    <%= ws.price === 0 ? 'Miễn phí' : new Intl.NumberFormat('vi-VN').format(ws.price) + 'đ' %>
                                </div>
                            </div>

                            <!-- Cart Icon Button -->
                            <a href="/shops/<%= ws.id %>" class="shop-cart-btn d-flex align-items-center justify-content-center text-decoration-none" title="Xem chi tiết & Đặt mua">
                                <i class="bi bi-cart3 fs-5"></i>
                            </a>
                        </div>

                    </div>
                </div>
            </div>
            <% }) %>
        </div>

        <% if (workshops.length === 0) { %>
        <div class="text-center py-5 my-4 bg-white rounded-4 border shadow-sm">
            <i class="bi bi-shop display-1 text-muted"></i>
            <h5 class="fw-bold mt-3 text-dark">Chưa có sản phẩm nào trong danh mục này.</h5>
            <p class="text-muted small">Vui lòng chọn danh mục khác hoặc quay lại sau.</p>
            <a href="/shops" class="btn btn-primary rounded-pill px-4 mt-2">Xem tất cả sản phẩm</a>
        </div>
        <% } %>

    </div>
</section>

<style>
    /* Premium Product Card Styles matching screenshot 100% */
    .shop-product-card {
        border: 1px solid #f1f5f9 !important;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03) !important;
    }

    .shop-product-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 14px 30px rgba(0, 0, 0, 0.09) !important;
        border-color: rgba(0, 0, 0, 0.08) !important;
    }

    .shop-product-card:hover .shop-img {
        transform: scale(1.05);
    }

    .shop-img {
        transition: transform 0.4s ease;
    }

    .hover-primary:hover {
        color: var(--primary) !important;
    }

    /* Circular Cart Button matching screenshot */
    .shop-cart-btn {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: #edf4ef;
        color: #1e5a3e;
        transition: all 0.25s ease;
    }

    .shop-cart-btn:hover {
        background: #1e5a3e;
        color: #ffffff !important;
        transform: scale(1.08);
    }

    /* Floating buttons hover */
    .btn-zalo-oa:hover,
    .btn-tiktok-shop:hover {
        transform: scale(1.05);
    }

    /* Capsule Filter buttons */
    .btn-filter-capsule {
        background: #ffffff;
        border: 1px solid rgba(0, 0, 0, 0.08);
        color: var(--text-secondary);
        padding: 6px 16px;
        border-radius: 50px;
        font-weight: 600;
        font-size: 0.84rem;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s ease;
        cursor: pointer;
    }

    .btn-filter-capsule:hover {
        background: var(--primary-50);
        border-color: var(--primary-200);
        color: var(--primary);
    }

    .btn-filter-capsule.active {
        background: var(--primary);
        color: #ffffff;
        border-color: var(--primary);
    }
</style>

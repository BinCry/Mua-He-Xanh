            <div class="col-lg-6 reveal-up d-flex flex-column">
                <div>
                    <span class="badge rounded-pill px-3 py-2 mb-3 text-uppercase fw-bold x-small"
                        style="background: var(--primary-100); color: var(--primary); border: 1px solid var(--primary-200); letter-spacing: 1px;">

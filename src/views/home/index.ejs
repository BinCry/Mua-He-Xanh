<!-- EVENTS & SEASONAL -->
<section class="py-section position-relative"
    style="background-color: #f1f9f6; border-top: 1px solid rgba(0,0,0,0.03); border-bottom: 1px solid rgba(0,0,0,0.03); overflow: hidden;">
    <div class="container py-4 py-md-5 position-relative" style="z-index: 2;">
        <div class="row align-items-stretch g-4 g-md-5">
            <div class="col-lg-6 reveal-up d-flex flex-column gap-3">
                <% if (nextEvent) { %>
                    <!-- Badge Outside Event Card Header Margin -->
                    <div>
                        <span class="badge rounded-pill px-3 py-2 text-uppercase fw-bold x-small shadow-sm"
                            style="background: var(--primary-100); color: var(--primary); border: 1px solid var(--primary-200); letter-spacing: 1px;">
                            <i class="bi bi-star-fill me-1" style="color: #ffc847;"></i> Sự kiện nổi bật
                        </span>
                    </div>

                    <div class="card border-0 rounded-4 overflow-hidden position-relative shadow-sm hover-lift w-100 d-flex flex-column bg-white border">
                        <!-- Top Image Poster: 100% FULL UNCROPPED POSTER with blurred background fill -->
                        <div class="w-100 position-relative overflow-hidden" style="aspect-ratio: 16 / 9; width: 100%; background: #0f172a; flex-shrink: 0;">
                            <div class="position-absolute top-0 start-0 w-100 h-100" style="background: url('<%= fixImg(nextEvent.image, '/uploads/posters/poster-1.webp') %>') center/cover; filter: blur(16px) brightness(0.65); transform: scale(1.2);"></div>
                            <img src="<%= fixImg(nextEvent.image, '/uploads/posters/poster-1.webp') %>" class="position-relative w-100 h-100" style="object-fit: contain; object-position: center; z-index: 2;" loading="lazy" decoding="async" alt="<%= nextEvent.title %>">
                        </div>

                        <!-- Bottom 50% Information Body -->
                        <a href="/events/<%= nextEvent.id %>" class="card-body p-4 d-flex flex-column justify-content-between text-decoration-none text-start bg-white">
                            <div>
                                <h3 class="text-dark font-black mb-2 font-display text-start notranslate" translate="no" style="font-size: 1.35rem; line-height: 1.3;">
                                    <%= nextEvent.title %>
                                </h3>
                                <p class="text-muted mb-3 line-clamp-3" style="font-size: 0.88rem; line-height: 1.6;">
                                    <%= nextEvent.description %>
                                </p>
                            </div>

                            <div class="pt-3 border-top border-light">
                                <div class="d-flex flex-column gap-1.5 text-start" style="font-size: 0.85rem;">
                                    <div class="d-flex align-items-center gap-2 text-dark">
                                        <i class="bi bi-geo-alt-fill text-danger fs-6"></i>
                                        <span class="fw-bold"><%= nextEvent.location %></span>
                                    </div>
                                    <div class="d-flex align-items-center gap-2 text-muted">
                                        <i class="bi bi-calendar-event text-primary fs-6"></i>
                                        <span class="text-capitalize">
                                            <%= new Date(nextEvent.event_date).toLocaleDateString('vi-VN', {
                                                weekday: 'long' , year: 'numeric' , month: 'long' , day: 'numeric' ,
                                                hour: '2-digit' , minute: '2-digit' }) %>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                <% } %>
            </div>

            <div class="<%= nextEvent ? 'col-lg-6' : 'col-lg-8 mx-auto' %> reveal-up d-flex flex-column">
                <div class="<%= nextEvent ? '' : 'text-center d-flex flex-column align-items-center' %>">
                    <span class="badge rounded-pill px-3 py-2 mb-3 text-uppercase fw-bold x-small"
                        style="background: var(--primary-100); color: var(--primary); border: 1px solid var(--primary-200); letter-spacing: 1px;">
                        <i class="bi bi-calendar3 me-1"></i> <%= nextEvent ? 'Sự kiện khác' : 'Sự kiện' %>
                    </span>
                    <h2 class="text-dark font-black mb-4 font-display" style="font-size: 2rem; line-height: 1.2;">Lịch
                        sự kiện sắp diễn ra</h2>
                </div>

                <div class="scrollable-events-container flex-grow-1 <%= nextEvent ? '' : 'mx-auto w-100' %>"
                    style="max-height: 480px; overflow-y: auto; padding-right: 8px;">
                    <% if (typeof otherEvents !=='undefined' && otherEvents.length> 0) { %>
                        <div class="d-flex flex-column gap-3">
                            <% otherEvents.forEach((evt, index)=> { %>
                                <a href="/events/<%= evt.id %>"
                                    class="home-event-card d-flex gap-3 align-items-center p-3 rounded-4 border bg-white text-decoration-none shadow-sm"
                                    style="border-color: rgba(0,0,0,0.08) !important; transition: all 0.3s;">
                                    <!-- Event Image Thumbnail instead of calendar icon -->
                                    <div class="home-event-icon rounded-3 overflow-hidden flex-shrink-0"
                                        style="width: 54px; height: 54px; border: 1px solid rgba(0,0,0,0.08);">
                                        <img src="<%= fixImg(evt.image, '/uploads/posters/poster-1.webp') %>" class="w-100 h-100 object-fit-cover" alt="<%= evt.title %>" loading="lazy" decoding="async">
                                    </div>
                                    <div class="home-event-content flex-grow-1 min-w-0 text-start">
                                        <h6 class="home-event-title text-dark font-extrabold mb-1 text-start text-truncate"
                                            style="font-size: 0.95rem;" title="<%= evt.title %>">
                                            <%= evt.title %>
                                        </h6>
                                        <div
                                            class="home-event-meta d-flex align-items-center gap-2 x-small text-muted mb-1 text-start">
                                            <span class="home-event-location text-truncate"><i
                                                    class="bi bi-geo-alt me-1"></i>
                                                <%= evt.location || 'Bình Lợi' %>
                                            </span>
                                            <span>•</span>
                                            <span class="flex-shrink-0"><i class="bi bi-calendar me-1"></i>
                                                <%= new Date(evt.event_date).toLocaleDateString('vi-VN') %>
                                            </span>
                                        </div>
                                        <p class="mb-0 x-small text-secondary line-clamp-1 text-start"
                                            style="line-height: 1.5;">
                                            <%= evt.description %>
                                        </p>
                                    </div>
                                </a>
                                <% }) %>
                        </div>
                        <% } else { %>
                            <div class="text-center py-5 text-muted border rounded-4 bg-white border-dashed h-100 d-flex flex-column align-items-center justify-content-center"
                                style="min-height: 250px;">
                                <i class="bi bi-calendar-x fs-2 d-block mb-2 text-secondary opacity-50"></i>
                                <span class="small"><%= nextEvent ? 'Chưa có sự kiện nào khác sắp diễn ra' : 'Chưa có sự kiện nào sắp diễn ra' %></span>
                            </div>
                            <% } %>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- SOCIAL FEED: Real Reviews from Community (Identical to Community Page) -->
<% if (typeof reviews !== 'undefined' && reviews && reviews.length > 0) { %>
    <section class="py-section" style="background-color: #f8faf9; border-top: 1px solid rgba(0,0,0,0.03); border-bottom: 1px solid rgba(0,0,0,0.03);">
        <div class="container py-5">
            <div class="text-center mb-5 reveal-up">
                <span class="section-label">LIVE FROM BÌNH LỢI</span>
                <h2 class="section-title mx-auto">Khoảnh khắc Chữa lành</h2>
                <p class="section-desc mx-auto">Câu chuyện thật, hình ảnh thật từ cộng đồng du khách.</p>
            </div>

            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <div class="d-flex flex-column gap-4">
                        <% reviews.slice(0, 5).forEach((r, i) => { %>
                        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white reveal-up">
                            <!-- User Header -->
                            <div class="d-flex align-items-start justify-content-between gap-2 p-3 p-sm-4 pb-2">
                                <div class="d-flex align-items-center gap-3 flex-grow-1 min-w-0">
                                    <img src="<%= r.avatar || '/images/default-avatar.png' %>" class="rounded-circle flex-shrink-0" style="width: 44px; height: 44px; object-fit: cover; border: 2px solid var(--primary-100);" loading="lazy" decoding="async">
                                    <div class="min-w-0 flex-grow-1">
                                        <span class="fw-bold d-block text-truncate" style="font-size: 0.92rem; color: #333;"><%= r.full_name %></span>
                                        <span class="text-muted d-block text-truncate" style="font-size: 0.72rem;">
                                            <% if (r.destination_name) { %>
                                                <span class="text-danger fw-bold"><i class="bi bi-geo-alt-fill me-1"></i><%= r.destination_name %></span> · 
                                            <% } else if (r.location_name) { %>
                                                <span class="text-secondary"><i class="bi bi-pin-map-fill me-1"></i><%= r.location_name %></span> · 
                                            <% } %>
                                            <%= new Date(r.created_at).toLocaleDateString('vi-VN') %>
                                        </span>
                                    </div>
                                </div>
                                <div class="text-warning flex-shrink-0 pt-1" style="font-size: 0.75rem;">
                                    <% for(let s = 0; s < (r.rating || 5); s++) { %><i class="bi bi-star-fill"></i><% } %>
                                </div>
                            </div>
                            
                            <!-- Content text -->
                            <div class="px-3 px-sm-4 pb-2">
                                <p class="mb-0 notranslate" translate="no" style="font-size: 0.92rem; line-height: 1.7; color: #444;"><%= r.content %></p>
                            </div>

                            <!-- Feed Images -->
                            <% if (r.images) { 
                                let imgs = [];
                                try { 
                                    if (typeof r.images === 'string') {
                                        imgs = r.images.trim().startsWith('[') ? JSON.parse(r.images) : [r.images];
                                    } else if (Array.isArray(r.images)) {
                                        imgs = r.images;
                                    }
                                } catch(e) {
                                    imgs = [r.images];
                                }
                                imgs = imgs.filter(Boolean);
                                if (imgs.length > 0) { %>
                            <div class="px-3 px-sm-4 py-2">
                                <div class="row g-2">
                                    <% imgs.forEach((img, idx) => { %>
                                    <div class="col-12">
                                        <!-- 1:1 Square Facebook-Style Post Card -->
                                        <div class="rounded-4 overflow-hidden shadow-2xs border bg-light text-center cursor-pointer position-relative" style="width: 100%; aspect-ratio: 1 / 1; max-height: 540px;" onclick="openImageLightbox(this.querySelector('img').src)" title="Nhấn để xem ảnh phóng to đầy đủ">
                                            <img src="<%= fixImg(img) %>" class="rounded-4 w-100 h-100" style="object-fit: cover; object-position: center;" alt="Review image" loading="lazy" decoding="async" onerror="this.onerror=null; this.src='/images/Poster 1.webp';">
                                        </div>
                                    </div>
                                    <% }) %>
                                </div>
                            </div>
                            <% } } %>
                            
                            <!-- Footer Action Badges (Read-Only on Homepage) -->

<style>
    /* Reset main padding-top to remove layout top gap on homepage */
    main {
        padding-top: 0 !important;
        margin-top: 0 !important;
    }

    /* Hero Poster: Natural aspect ratio on all devices (No cropping, no stretching, crisp full view) */
    .hero-poster-section {
        width: 100% !important;
        position: relative;
        background-color: #044b5e !important;
        overflow: hidden;
        margin-top: 107px !important;
        padding: 0 !important;
        height: auto !important;
        min-height: unset !important;
        max-height: unset !important;
        box-sizing: border-box !important;
    }

    .hero-poster-section .carousel-inner,
    .hero-poster-section .carousel-item,
    .hero-poster-section .hero-poster-slide {
        width: 100% !important;
        height: auto !important;
    }

    .hero-poster-img {
        width: 100% !important;
        height: auto !important;
        object-fit: contain !important;
        object-position: center center !important;
        display: block !important;
    }

    /* Solid Circular Dots for Hero Poster Carousel Indicators */
    #heroPosterCarousel .carousel-indicators {
        bottom: 18px !important;
        margin-bottom: 0 !important;
        gap: 4px !important;
        z-index: 10 !important;
    }

    #heroPosterCarousel .carousel-indicators [data-bs-target],
    #heroPosterCarousel .carousel-indicators button {
        box-sizing: border-box !important;
        width: 9px !important;
        height: 9px !important;
        min-width: 9px !important;
        min-height: 9px !important;
        max-width: 9px !important;
        max-height: 9px !important;
        border-radius: 50% !important;
        background-color: rgba(255, 255, 255, 0.45) !important;
        border: none !important;
        border-top: 0 !important;
        border-bottom: 0 !important;
        opacity: 0.8 !important;
        margin: 0 2px !important;
        padding: 0 !important;
        transition: all 0.3s ease !important;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.4) !important;
    }

    #heroPosterCarousel .carousel-indicators [data-bs-target].active,
    #heroPosterCarousel .carousel-indicators button.active {
        width: 11px !important;
        height: 11px !important;
        min-width: 11px !important;
        min-height: 11px !important;
        border-radius: 50% !important;
        background-color: #00b4d8 !important;
        opacity: 1 !important;
        transform: scale(1.15) !important;
        box-shadow: 0 0 8px rgba(0, 180, 216, 0.9) !important;
    }
</style>

<!-- HERO: Poster Carousel Banner (Fly To Sky Style) -->
<section class="hero-poster-section position-relative overflow-hidden" style="background-color: #044b5e !important;">
    <!-- Carousel Poster Slider (Continuous rotation, no pause on hover) -->
    <div id="heroPosterCarousel" class="carousel slide carousel-fade position-relative" data-bs-ride="carousel"
        data-bs-interval="5000" data-bs-pause="false" style="background-color: #044b5e !important;">
        <!-- Indicators (Dots at bottom center) -->
        <div class="carousel-indicators mb-2">
            <% (typeof heroPosters !== 'undefined' && heroPosters ? heroPosters : []).forEach((p, idx) => { %>
                <button type="button" data-bs-target="#heroPosterCarousel" data-bs-slide-to="<%= idx %>" class="<%= idx === 0 ? 'active' : '' %>"
                    aria-current="<%= idx === 0 ? 'true' : 'false' %>" aria-label="Poster <%= idx + 1 %>"></button>
            <% }) %>
        </div>

        <!-- Carousel Slides -->
        <div class="carousel-inner" style="background-color: #044b5e !important;">
            <% (typeof heroPosters !== 'undefined' && heroPosters ? heroPosters : []).forEach((p, idx) => { %>
            <div class="carousel-item <%= idx === 0 ? 'active' : '' %>" data-bs-interval="5000">
                <div class="hero-poster-slide position-relative w-100 h-auto">
                    <img src="<%= fixImg(p.image_url) %>" class="hero-poster-img w-100 d-block" alt="<%= p.title || ('Poster ' + (idx + 1)) %>" <%= idx === 0 ? 'fetchpriority="high"' : 'loading="lazy"' %> decoding="async">
                </div>
            </div>
            <% }) %>
        </div>

        <!-- Left / Right Navigation Buttons -->
        <button class="carousel-control-prev" type="button" data-bs-target="#heroPosterCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Trước</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#heroPosterCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Sau</span>
        </button>
    </div>
</section>

<script>
    (function () {
        // Continuous Auto-play Carousel without pointer jitter
        document.addEventListener('DOMContentLoaded', function () {
            const heroCarousel = document.getElementById('heroPosterCarousel');
            if (heroCarousel && typeof bootstrap !== 'undefined') {
                bootstrap.Carousel.getOrCreateInstance(heroCarousel, {
                    interval: 5000,
                    pause: false,
                    touch: true
                });
            }
        });
    })();
</script>

<!-- STATS: Dark Section with Impressive Numbers and Wave Separators -->
<section class="stats-dark position-relative" style="border-top: 4px solid var(--primary); border-bottom: 4px solid var(--primary);">
    <div class="container py-4 position-relative" style="z-index: 5;">
        <h2 class="stats-heading text-center mt-2 mb-4">NHỮNG CON SỐ ẤN TƯỢNG</h2>
        <div class="row g-4 text-center">
            <div class="col-6 col-md-3">
                <div class="stat-item-dark">
                    <div class="stat-number" id="stat-checkins">
                        <%= stats.checkins.toLocaleString() %>+
                    </div>
                    <div class="stat-text">LƯỢT CHECK-IN</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-item-dark">
                    <div class="stat-number" id="stat-destinations">
                        <%= stats.destinations %>+
                    </div>
                    <div class="stat-text">ĐỊA ĐIỂM TRỌNG TÂM</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-item-dark">
                    <div class="stat-number" id="stat-pageviews">
                        <%= (stats.visitors || stats.pageViews || 0).toLocaleString() %>+
                    </div>
                    <div class="stat-text">LƯỢT TRUY CẬP</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-item-dark">
                    <div class="stat-number" id="stat-rating">
                        <%= (stats && stats.avgRating) ? stats.avgRating + '/5.0' : '5.0/5.0' %>
                    </div>
                    <div class="stat-text">ĐÁNH GIÁ TRUNG BÌNH</div>
                </div>
            </div>
        </div>
    </div>

</section>

<!-- DESTINATIONS: Equal Bento Grid (9 Cards) -->
<section class="py-section"
    style="background-color: #eef6fc; border-top: 1px solid rgba(0,0,0,0.03); border-bottom: 1px solid rgba(0,0,0,0.03);">
    <div class="container py-4 py-md-5">
        <div class="row align-items-end mb-4 mb-md-5">
            <div class="col-md-8 reveal-up">
                <h2 class="fw-black text-dark mb-1 letter-spacing-sm">Điểm dừng chân trọng tâm</h2>
                <p class="text-muted mb-0">Mỗi địa điểm đều được chọn lọc kỹ lưỡng, đảm bảo tính thẩm mỹ, văn hóa và bình yên chữa lành.</p>
            </div>
            <div class="col-md-4 text-md-end reveal-up mt-3 mt-md-0">
                <a href="/explore" class="btn btn-view-all-dest rounded-pill px-4 py-2 fw-bold">XEM TẤT CẢ ĐỊA ĐIỂM <i class="bi bi-arrow-right ms-1"></i></a>
            </div>
        </div>

        <div class="row g-2 g-md-4">
            <% featured.slice(0, 9).forEach((dest, i)=> { %>
                <div class="col-4 col-md-6 col-lg-4 reveal-up px-1 px-sm-2 mb-2 mb-md-3">
                    <a href="/explore/<%= dest.slug %>" class="text-decoration-none card-heal-wrapper">
                        <!-- Desktop View: Vertical Bento Card; Mobile View: 3 cards per row -->
                        <div class="card border-0 shadow-sm rounded-4 overflow-hidden position-relative hover-lift home-dest-card"
                            style="transition: all 0.3s ease;">
                            
                            <!-- Image Container -->
                            <div class="home-dest-img-wrap position-relative">
                                <img src="<%= fixImg(dest.cover_image) %>" alt="<%= dest.name %>" class="w-100 h-100 object-fit-cover" loading="lazy" decoding="async">
                                <div class="position-absolute top-0 start-0 w-100 h-100 home-dest-overlay"></div>

                                <!-- Category Badge -->
                                <div class="position-absolute top-0 end-0 m-1 m-md-3" style="z-index: 5;">
                                    <span class="badge rounded-3 px-1.5 py-1 px-md-2.5 py-md-1.5 fw-black text-uppercase shadow-sm"
                                        style="font-size: 0.55rem; letter-spacing: 0.5px; background: rgba(21, 128, 61, 0.92) !important; color: #ffffff !important; backdrop-filter: blur(8px);">
                                        <%= (dest.type==='temple' ? 'TÂM LINH' : (dest.type==='nature' ? 'SINH THÁI' :
                                            (dest.type==='craft' ? 'LÀNG NGHỀ' : (dest.type==='food' ? 'ẨM THỰC' :
                                            (dest.type || '' ).toUpperCase())))) %>
                                    </span>
                                </div>
                            </div>

                            <!-- Content Body -->
                            <div class="home-dest-body p-2 p-md-4 d-flex flex-column justify-content-end" style="z-index: 5;">
                                <h5 class="font-black mb-0 font-display home-dest-title">
                                    <%= dest.name %>
                                </h5>
                            </div>
                        </div>
                    </a>
                </div>
            <% }) %>
        </div>
    </div>
</section>


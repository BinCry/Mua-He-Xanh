        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 60" preserveAspectRatio="none"
            style="width: 100%; height: 100%; display: block;">
            <path d="M0,0 C480,50 960,50 1440,0 L1440,60 L0,60 Z" fill="#083344"></path>
        </svg>
    </div>

    <div class="container py-4 position-relative" style="z-index: 5; padding-top: 65px !important;">
        <h2 class="stats-heading text-center mt-2 mb-4">NHỮNG CON SỐ ẤN TƯỢNG</h2>
        <div class="row g-4 text-center">
            <div class="col-6 col-md-3">
                <div class="stat-item-dark">
                    <div class="stat-number">
                        <%= stats.checkins.toLocaleString() %>+
                    </div>
                    <div class="stat-text">LƯỢT CHECK-IN</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-item-dark">
                    <div class="stat-number">
                        <%= stats.destinations %>+
                    </div>
                    <div class="stat-text">ĐỊA ĐIỂM TRỌNG TÂM</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-item-dark">
                    <div class="stat-number">
                        <%= stats.workshopCount || '50' %>+
                    </div>
                    <div class="stat-text">WORKSHOP ĐÃ TỔ CHỨC</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-item-dark">
                    <div class="stat-number">
                        <%= stats.avgRating || '4.9' %>/5
                    </div>
                    <div class="stat-text">ĐÁNH GIÁ TRUNG BÌNH</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Wave divider (light blue wave curving out of the dark section to merge with destinations) -->
    <div class="position-absolute bottom-0 start-0 w-100 overflow-hidden"
        style="height: 60px; pointer-events: none; z-index: 2;">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 60" preserveAspectRatio="none"
            style="width: 100%; height: 100%; display: block;">
            <path d="M0,60 C480,10 960,10 1440,60 L1440,0 L0,0 Z" fill="#eef6fc"></path>
        </svg>
    </div>
</section>

<!-- DESTINATIONS: Equal Bento Grid -->
<section class="py-section"
    style="background-color: #eef6fc; border-top: 1px solid rgba(0,0,0,0.03); border-bottom: 1px solid rgba(0,0,0,0.03);">
    <div class="container py-5">
        <div class="row align-items-end mb-5">
            <div class="col-md-8 reveal-up">

                <h2 class="fw-black text-dark mb-1 letter-spacing-sm">Điểm dừng chân trọng tâm</h2>
                <p class="text-muted">Mỗi địa điểm đều được chọn lọc kỹ lưỡng, đảm bảo tính thẩm mỹ, văn hóa và bình yên
                    chữa lành.</p>
            </div>
            <div class="col-md-4 text-md-end reveal-up">
                <a href="/explore" class="btn btn-view-all-dest rounded-pill px-4 py-2 fw-bold">XEM TẤT CẢ ĐỊA ĐIỂM <i
                        class="bi bi-arrow-right ms-1"></i></a>
            </div>
        </div>

        <div class="row g-4">
            <% featured.forEach((dest, i)=> { %>
                <div class="col-6 col-md-6 col-lg-4 reveal-up px-1 px-sm-2 mb-3">
                    <a href="/explore/<%= dest.slug %>" class="text-decoration-none card-heal-wrapper">
                        <div class="card border-0 shadow-sm rounded-4 overflow-hidden position-relative hover-lift"
                            style="height: 340px; transition: all 0.3s ease;">
                            <img src="<%= fixImg(dest.cover_image) %>" alt="<%= dest.name %>" class="w-100 h-100"
                                style="object-fit: cover !important; object-position: center center !important; transition: transform 0.5s ease;">
                            <div class="position-absolute top-0 start-0 w-100 h-100"
                                style="background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.2) 60%, transparent 100%); z-index: 2;">
                            </div>

                            <!-- Top-Right Category Tag (Căn góc phải trên - Tiếng Việt) -->
                            <div class="position-absolute top-0 end-0 m-3" style="z-index: 5;">
                                <span class="badge rounded-3 px-2.5 py-1.5 fw-black text-uppercase shadow-sm"
                                    style="font-size: 0.68rem; letter-spacing: 1px; background: rgba(21, 128, 61, 0.92) !important; color: #ffffff !important; backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.3);">
                                    <%= (dest.type==='temple' ? 'TÂM LINH' : (dest.type==='nature' ? 'SINH THÁI' :
                                        (dest.type==='craft' ? 'LÀNG NGHỀ' : (dest.type==='food' ? 'ẨM THỰC' :
                                        (dest.type || '' ).toUpperCase())))) %>
                                </span>
                            </div>

                            <div class="position-absolute bottom-0 start-0 w-100 p-3 p-md-4" style="z-index: 5;">
                                <h5 class="text-white font-black mb-1 font-display" style="font-size: 1.2rem;">
                                    <%= dest.name %>
                                </h5>
                                <p class="text-white-50 mb-0 line-clamp-2" style="font-size: 0.8rem; line-height: 1.5;">
                                    <%= dest.short_desc || dest.short_description %>
                                </p>
                            </div>
                        </div>
                    </a>
                </div>
                <% }) %>
        </div>
    </div>
</section>

<!-- EVENTS & SEASONAL (Bright and modern styling) -->
<section class="py-section position-relative"
    style="background-color: #f1f9f6; border-top: 1px solid rgba(0,0,0,0.03); border-bottom: 1px solid rgba(0,0,0,0.03); overflow: hidden;">
    <div class="container py-5 position-relative" style="z-index: 2;">
        <div class="row align-items-stretch g-5">
            <div class="col-lg-6 reveal-up d-flex">
                <% if (nextEvent) { %>
                    <div class="card border-0 rounded-4 overflow-hidden position-relative shadow-premium hover-lift w-100 d-flex flex-column"
                        style="min-height: 480px; transition: all 0.4s var(--ease-out); background: linear-gradient(135deg, #922724 0%, #581816 100%); border: 1px solid rgba(146, 39, 36, 0.3);">

                        <!-- Gradient overlay for text readability -->
                        <div class="position-absolute top-0 start-0 w-100 h-100"
                            style="background: linear-gradient(to bottom, rgba(0,0,0,0.1) 0%, rgba(146,39,36,0.8) 100%); z-index: 1;">
                        </div>

                        <a href="/events/<%= nextEvent.id %>"
                            class="card-body p-4 p-md-5 d-flex flex-column justify-content-between position-relative h-100 flex-grow-1 text-decoration-none text-start"
                            style="z-index: 5;">
                            <div>
                                <span class="badge rounded-pill px-3 py-2 mb-3 text-uppercase fw-bold x-small"
                                    style="background: rgba(255, 255, 255, 0.08); color: rgba(255, 255, 255, 0.9); border: 1px solid rgba(255, 255, 255, 0.15); letter-spacing: 1px;">

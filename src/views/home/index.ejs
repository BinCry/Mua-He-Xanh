                                            style="font-size: 0.95rem;" title="<%= evt.title %>">
                                            <%= evt.title %>
                                        </h6>
                                        <div
                                            class="home-event-meta d-flex align-items-center gap-2 x-small text-muted mb-1 text-start">
                                            <span class="home-event-location text-truncate"><i
                                                    class="bi bi-geo-alt me-1"></i>
                                                <%= evt.location || 'Bình Lợi' %>
                                            </span>
                                            <span>•</span>
                                            <span class="flex-shrink-0"><i class="bi bi-calendar me-1"></i>
                                                <%= new Date(evt.event_date).toLocaleDateString('vi-VN') %>
                                            </span>
                                        </div>
                                        <p class="mb-0 x-small text-secondary line-clamp-1 text-start"
                                            style="line-height: 1.5;">
                                            <%= evt.description %>
                                        </p>
                                    </div>
                                </a>
                                <% }) %>
                        </div>
                        <% } else { %>
                            <div class="text-center py-5 text-muted border rounded-4 bg-white border-dashed h-100 d-flex flex-column align-items-center justify-content-center"
                                style="min-height: 250px;">
                                <i class="bi bi-calendar-x fs-2 d-block mb-2 text-secondary opacity-50"></i>
                                <span class="small">Chưa có sự kiện nào khác sắp diễn ra</span>
                            </div>
                            <% } %>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- SOCIAL FEED: Real Reviews from Community -->
<% if (socialFeed.length> 0) { %>
    <section class="py-section"
        style="background-color: #eef6fc; border-top: 1px solid rgba(0,0,0,0.03); border-bottom: 1px solid rgba(0,0,0,0.03);">
        <div class="container py-5">
            <div class="text-center mb-5 reveal-up">
                <span class="section-label">LIVE FROM BÌNH LỢI</span>
                <h2 class="section-title mx-auto">Khoảnh khắc Chữa lành</h2>
                <p class="section-desc mx-auto">Câu chuyện thật, hình ảnh thật từ cộng đồng du khách.</p>
            </div>

            <div class="row g-4 mb-5">
                <% socialFeed.forEach((item, index)=> { %>
                    <div class="col-md-4 reveal-up">
                        <div class="card-heal h-100">
                            <% if (item.image) { %>
                                <div class="card-img position-relative" style="height: 420px;">
                                    <img src="<%= fixImg(item.image) %>" alt="Moment">
                                    <div class="position-absolute top-0 start-0 w-100 h-100"
                                        style="background: linear-gradient(180deg, transparent 40%, rgba(0,0,0,0.8) 100%); z-index: 2;">
                                    </div>
                                    <div class="position-absolute top-0 end-0 m-3" style="z-index: 5;">
                                        <span
                                            class="glass-dark text-white px-3 py-1 rounded-pill d-flex align-items-center gap-1"
                                            style="font-size: 0.78rem; backdrop-filter: blur(10px);">
                                            <i class="bi bi-heart-fill text-danger"></i>
                                            <%= item.likes %>
                                        </span>
                                    </div>
                                    <div class="position-absolute bottom-0 start-0 w-100 p-4 text-white"
                                        style="z-index: 5;">
                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            <img src="<%= item.avatar %>" class="rounded-circle"
                                                style="width: 36px; height: 36px; object-fit: cover; border: 2px solid rgba(255,255,255,0.4);">
                                            <div>
                                                <span class="fw-bold d-block" style="font-size: 0.85rem;">
                                                    <%= item.user %>
                                                </span>
                                                <span class="opacity-60 d-block" style="font-size: 0.7rem;">
                                                    <%= item.time %>
                                                </span>
                                            </div>
                                        </div>
                                        <p class="mb-2 line-clamp-2 notranslate" translate="no"
                                            style="font-size: 0.85rem; opacity: 0.9;">
                                            <%= item.text %>
                                        </p>
                                        <span class="opacity-50" style="font-size: 0.75rem;"><i
                                                class="bi bi-geo-alt-fill me-1"></i>
                                            <%= item.location %>
                                        </span>
                                    </div>
                                </div>
                                <% } else { %>
                                    <div class="card-social-new">
                                        <div class="d-flex align-items-center gap-2 mb-3">
                                            <img src="<%= item.avatar %>" class="rounded-circle"
                                                style="width: 48px; height: 48px; object-fit: cover; border: 2px solid var(--primary-50);">
                                            <div>
                                                <span class="fw-bold d-block text-dark">
                                                    <%= item.user %>
                                                </span>
                                                <span class="opacity-60 d-block small">
                                                    <%= item.time %>
                                                </span>
                                            </div>
                                        </div>
                                        <p class="mb-3 line-clamp-4 text-dark notranslate" translate="no"
                                            style="font-style: italic;">"<%= item.text %>"</p>
                                        <div class="d-flex justify-content-between align-items-center mt-auto">
                                            <span class="small text-muted"><i class="bi bi-geo-alt-fill me-1"></i>
                                                <%= item.location %>
                                            </span>
                                            <span class="badge bg-light text-danger"><i
                                                    class="bi bi-heart-fill me-1"></i>
                                                <%= item.likes %>
                                            </span>
                                        </div>
                                    </div>
                                    <% } %>
                        </div>
                    </div>
                    <% }) %>
            </div>

            <div class="text-center reveal-up">
                <a href="/reviews" class="btn btn-share-moment rounded-pill px-4 py-3 fw-bold">CHIA SẺ KHOẢNH KHẮC CỦA
                    BẠN <i class="bi bi-arrow-right ms-2"></i></a>
            </div>
        </div>
    </section>
    <% } %>

        <!-- Floating buttons removed - QR in bottom center, Chat via menu -->

        <!-- Global Chat Modal -->
        <% if (locals.user) { %>
            <div class="modal fade" id="globalChatModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-sm modal-dialog-scrollable"
                    style="max-width: 400px;">
                    <div class="modal-content border-0 rounded-4 shadow-premium overflow-hidden">
                        <div class="modal-header bg-dark text-white border-0 p-3">
                            <div class="d-flex align-items-center gap-2">
                                <img src="<%= fixImg(settings.brand_logo, '/images/logo.png') %>" height="30"
                                    onerror="this.src='/images/logo.png'">
                                <div>
                                    <h6 class="modal-title fw-bold mb-0">Hỗ trợ <%= settings.brand_name || 'Bình Lợi' %>
                                    </h6>
                                    <small class="opacity-50 x-small text-uppercase">Phản hồi bởi Ban Quản Trị</small>
                                </div>
                            </div>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body p-3 bg-light" style="height: 400px;">
                            <div id="global-chat-history" class="overflow-auto h-100">
                                <div class="text-center mb-4"><span
                                        class="badge bg-white text-muted rounded-pill shadow-sm py-1 px-3 x-small">Hôm
                                        nay</span></div>
                                <div class="d-flex justify-content-start mb-3">
                                    <div class="p-3 rounded-4 small shadow-sm bg-white text-dark"
                                        style="max-width: 85%; line-height: 1.5;">
                                        Chào mừng bạn đến với <strong>Bình Lợi Healing</strong>! 🌿<br><br>
                                        Ban quản trị xã luôn sẵn sàng giải đáp mọi thắc mắc của bạn về hành trình khám
                                        phá.
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer border-0 bg-white p-2">
                            <div class="input-group">
                                <input type="text" id="global-chat-input"
                                    class="form-control border-0 bg-light rounded-pill ps-4 py-2 small"
                                    placeholder="Nhập câu hỏi..."
                                    onkeypress="if(event.key === 'Enter') sendGlobalChat()">
                                <button
                                    class="btn btn-primary-bl rounded-circle ms-2 p-0 d-flex align-items-center justify-content-center"
                                    style="width: 40px; height: 40px;" onclick="sendGlobalChat()">
                                    <i class="bi bi-send-fill" style="font-size: 0.8rem;"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <script>
                document.getElementById('globalChatModal').addEventListener('show.bs.modal', fetchGlobalMessages);

                async function fetchGlobalMessages() {
                    try {
                        const res = await axios.get('/api/get-messages');
                        if (res.data.success) {
                            const history = document.getElementById('global-chat-history');
                            let html = `
                <div class="text-center mb-4"><span class="badge bg-white text-muted rounded-pill shadow-sm py-1 px-3 x-small">Hôm nay</span></div>
                <div class="d-flex justify-content-start mb-3">
                    <div class="p-3 rounded-4 small shadow-sm bg-white text-dark" style="max-width: 85%; line-height: 1.5;">
                        Chào mừng bạn đến với <strong>Bình Lợi Healing</strong>! 🌿<br><br>
                        Ban quản trị xã luôn sẵn sàng giải đáp mọi thắc mắc.
                    </div>
                </div>
            `;
                            res.data.data.forEach(msg => {
                                const isMe = msg.sender_uuid && String(msg.sender_uuid) === String(window.CURRENT_SESSION_ID);
                                html += `
                    <div class="d-flex ${isMe ? 'justify-content-end' : 'justify-content-start'} mb-3">
                        <div class="p-3 rounded-4 small shadow-sm ${isMe ? 'bg-primary text-white' : 'bg-white text-dark'}" style="max-width: 85%;">
                            ${msg.message}
                        </div>
                    </div>
                `;
                            });
                            history.innerHTML = html;
                            history.scrollTop = history.scrollHeight;
                        }
                    } catch (err) { console.error('Fetch error:', err); }
                }

                async function sendGlobalChat() {
                    const input = document.getElementById('global-chat-input');
                    const message = input.value.trim();
                    if (!message) return;
                    input.value = '';
                    const history = document.getElementById('global-chat-history');
                    history.insertAdjacentHTML('beforeend', `
        <div class="d-flex justify-content-end mb-3">
            <div class="p-3 rounded-4 small shadow-sm bg-primary text-white" style="max-width: 85%;">${message}</div>
        </div>
    `);
                    history.scrollTop = history.scrollHeight;
                    try { await axios.post('/api/send-message', { message }); } catch (err) { alert('Lỗi: ' + (err.response?.data?.message || err.message)); }
                }
            </script>
            <% } %>

                <% if (nextEvent) { %>
                    <script>
                        const festivalDate = new Date("<%= festival.date instanceof Date ? festival.date.toISOString() : festival.date %>").getTime();
                        const timer = setInterval(function () {
                            const now = new Date().getTime();
                            const distance = festivalDate - now;
                            if (distance < 0) {
                                clearInterval(timer);
                                document.getElementById("countdown").innerHTML = '<span class="fw-bold fs-5" style="color: #ffc847 !important; text-shadow: 0 1px 3px rgba(0,0,0,0.5);">SỰ KIỆN ĐANG DIỄN RA!</span>';
                                return;
                            }
                            document.getElementById("days").innerHTML = String(Math.floor(distance / (1000 * 60 * 60 * 24))).padStart(2, '0');
                            document.getElementById("hours").innerHTML = String(Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60))).padStart(2, '0');
                            document.getElementById("mins").innerHTML = String(Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60))).padStart(2, '0');
                        }, 1000);
                    </script>
                    <% } %>

                        <!-- carousel init already handled in unified script above -->
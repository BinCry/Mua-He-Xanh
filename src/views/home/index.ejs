                                    <%= nextEvent.title %>
                                </h2>

                                <p class="mb-4 home-event-featured-desc"
                                    style="color: rgba(255, 255, 255, 0.85); font-size: 0.95rem; line-height: 1.65; text-align: justify !important; text-justify: inter-word !important; -webkit-text-justify: inter-word !important;">
                                    <%= nextEvent.description %>
                                </p>
                            </div>

                            <div>
                                <!-- Countdown timer -->
                                <div class="mb-4" id="countdown">
                                    <div class="d-flex gap-3 text-white text-center justify-content-start">
                                        <div class="p-2 px-3 rounded-3"
                                            style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); min-width: 60px;">
                                            <span class="fs-4 fw-black d-block" id="days">00</span>
                                            <span class="x-small opacity-60" style="font-size: 0.65rem;">NGÀY</span>
                                        </div>
                                        <div class="p-2 px-3 rounded-3"
                                            style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); min-width: 60px;">
                                            <span class="fs-4 fw-black d-block" id="hours">00</span>
                                            <span class="x-small opacity-60" style="font-size: 0.65rem;">GIỜ</span>
                                        </div>
                                        <div class="p-2 px-3 rounded-3"
                                            style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); min-width: 60px;">
                                            <span class="fs-4 fw-black d-block" id="mins">00</span>
                                            <span class="x-small opacity-60" style="font-size: 0.65rem;">PHÚT</span>
                                        </div>

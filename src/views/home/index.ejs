<style>
    /* Reset main padding-top to remove layout top gap on homepage */
    main {
        padding-top: 0 !important;
        margin-top: 0 !important;
    }

    /* Hero Poster: Desktop = full viewport minus navbar, Mobile = natural aspect ratio */
    .hero-poster-section {
        width: 100% !important;
        position: relative;
        background-color: #044b5e !important;
        overflow: hidden;
        margin-top: 107px !important;
        padding: 0 !important;
        height: calc(100vh - 107px) !important;
        min-height: 400px !important;
        box-sizing: border-box !important;
    }

    .hero-poster-section .carousel-inner,
    .hero-poster-section .carousel-item,
    .hero-poster-section .hero-poster-slide {
        width: 100% !important;
        height: 100% !important;
    }

    .hero-poster-img {
        width: 100% !important;
        height: 100% !important;
        object-fit: cover !important;
        object-position: top center !important;
        display: block !important;
    }

    /* Mobile/Tablet: poster auto-height, image keeps aspect ratio */
    @media (max-width: 1199.98px) {
        .hero-poster-section {
            margin-top: clamp(56px, 6.5vw, 84px) !important;
            height: auto !important;
            min-height: unset !important;
            max-height: unset !important;
        }

        .hero-poster-section .carousel-inner,
        .hero-poster-section .carousel-item,
        .hero-poster-section .hero-poster-slide {
            height: auto !important;
        }

        .hero-poster-img {
            width: 100% !important;
            height: auto !important;
            object-fit: contain !important;
            object-position: center center !important;
        }
    }

    /* Solid Circular Dots for Hero Poster Carousel Indicators */
    #heroPosterCarousel .carousel-indicators {
        bottom: 18px !important;
        margin-bottom: 0 !important;
        gap: 4px !important;
        z-index: 10 !important;
    }

    #heroPosterCarousel .carousel-indicators [data-bs-target],
    #heroPosterCarousel .carousel-indicators button {
        box-sizing: border-box !important;
        width: 9px !important;
        height: 9px !important;
        min-width: 9px !important;
        min-height: 9px !important;
        max-width: 9px !important;
        max-height: 9px !important;
        border-radius: 50% !important;
        background-color: rgba(255, 255, 255, 0.45) !important;
        border: none !important;
        border-top: 0 !important;
        border-bottom: 0 !important;
        opacity: 0.8 !important;
        margin: 0 2px !important;
        padding: 0 !important;
        transition: all 0.3s ease !important;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.4) !important;
    }

    #heroPosterCarousel .carousel-indicators [data-bs-target].active,
    #heroPosterCarousel .carousel-indicators button.active {
        width: 11px !important;
        height: 11px !important;
        min-width: 11px !important;
        min-height: 11px !important;
        border-radius: 50% !important;
        background-color: #00b4d8 !important;
        opacity: 1 !important;
        transform: scale(1.15) !important;
        box-shadow: 0 0 8px rgba(0, 180, 216, 0.9) !important;
    }
</style>

<!-- HERO: Poster Carousel Banner (Fly To Sky Style) -->
<section class="hero-poster-section position-relative overflow-hidden" style="background-color: #044b5e !important;">
    <!-- Carousel Poster Slider (Continuous rotation, no pause on hover) -->
    <div id="heroPosterCarousel" class="carousel slide carousel-fade position-relative" data-bs-ride="carousel"
        data-bs-interval="5000" data-bs-pause="false" style="background-color: #044b5e !important;">
        <!-- Indicators (Dots at bottom center) -->
        <div class="carousel-indicators mb-2">
            <button type="button" data-bs-target="#heroPosterCarousel" data-bs-slide-to="0" class="active"
                aria-current="true" aria-label="Poster 1"></button>
            <button type="button" data-bs-target="#heroPosterCarousel" data-bs-slide-to="1"
                aria-label="Poster 2"></button>
            <button type="button" data-bs-target="#heroPosterCarousel" data-bs-slide-to="2"
                aria-label="Poster 3"></button>
            <button type="button" data-bs-target="#heroPosterCarousel" data-bs-slide-to="3"
                aria-label="Poster 4"></button>
            <button type="button" data-bs-target="#heroPosterCarousel" data-bs-slide-to="4"
                aria-label="Poster 5"></button>
        </div>

        <!-- Carousel Slides -->
        <div class="carousel-inner" style="background-color: #044b5e !important;">
            <!-- Slide 1: Poster 1 HD -->
            <div class="carousel-item active" data-bs-interval="5000">
                <div class="hero-poster-slide position-relative w-100 h-100">
                    <img src="/images/Poster 1.png?v=<%= assetV %>" class="hero-poster-img w-100 h-100 d-block"
                        alt="Poster 1">
                </div>
            </div>

            <!-- Slide 2: Poster 2 HD -->
            <div class="carousel-item" data-bs-interval="5000">
                <div class="hero-poster-slide position-relative w-100 h-100">
                    <img src="/images/Poster 2.png?v=<%= assetV %>" class="hero-poster-img w-100 h-100 d-block"
                        alt="Poster 2">
                </div>
            </div>

            <!-- Slide 3: Poster 3 HD -->
            <div class="carousel-item" data-bs-interval="5000">
                <div class="hero-poster-slide position-relative w-100 h-100">
                    <img src="/images/Poster 3.png?v=<%= assetV %>" class="hero-poster-img w-100 h-100 d-block"
                        alt="Poster 3">
                </div>
            </div>

            <!-- Slide 4: Poster 4 HD -->
            <div class="carousel-item" data-bs-interval="5000">
                <div class="hero-poster-slide position-relative w-100 h-100">
                    <img src="/images/Poster 4.png?v=<%= assetV %>" class="hero-poster-img w-100 h-100 d-block"
                        alt="Poster 4">
                </div>
            </div>

            <!-- Slide 5: Poster 5 HD -->
            <div class="carousel-item" data-bs-interval="5000">
                <div class="hero-poster-slide position-relative w-100 h-100">
                    <img src="/images/Poster 5.png?v=<%= assetV %>" class="hero-poster-img w-100 h-100 d-block"
                        alt="Poster 5">
                </div>
            </div>
        </div>

        <!-- Left / Right Navigation Buttons -->
        <button class="carousel-control-prev" type="button" data-bs-target="#heroPosterCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Trước</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#heroPosterCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Sau</span>
        </button>
    </div>
</section>

<script>
    (function () {
        // Only sync margin-top to match actual navbar height — no forced height on mobile
        function syncHeroMargin() {
            const hero = document.querySelector('.hero-poster-section');
            const nav = document.querySelector('.navbar-premium');
            if (hero && nav) {
                const navH = Math.round(nav.getBoundingClientRect().height);
                if (navH > 0) {
                    hero.style.setProperty('margin-top', navH + 'px', 'important');
                    // On desktop (>=1200px), also sync height for full-viewport poster
                    if (window.innerWidth >= 1200) {
                        const h = window.innerHeight - navH;
                        hero.style.setProperty('height', Math.max(400, h) + 'px', 'important');
                    } else {
                        // On mobile, let CSS handle auto height
                        hero.style.removeProperty('height');
                    }
                }
            }
        }

        // Use ResizeObserver for instant, lag-free updates
        document.addEventListener('DOMContentLoaded', function () {
            syncHeroMargin();
            const nav = document.querySelector('.navbar-premium');
            if (nav && window.ResizeObserver) {
                new ResizeObserver(syncHeroMargin).observe(nav);
            }
            window.addEventListener('resize', syncHeroMargin);
        });
        window.addEventListener('load', syncHeroMargin);

        // Force Continuous Auto-play Carousel (Never pause on hover)
        document.addEventListener('DOMContentLoaded', function () {
            const heroCarousel = document.getElementById('heroPosterCarousel');
            if (heroCarousel && typeof bootstrap !== 'undefined') {
                const bsCarousel = bootstrap.Carousel.getOrCreateInstance(heroCarousel, {
                    interval: 5000,
                    pause: false,
                    touch: true
                });
                bsCarousel.cycle();

                const forceCycle = function () {
                    try { bsCarousel.cycle(); } catch (e) { }
                };
                heroCarousel.addEventListener('mouseenter', forceCycle);
                heroCarousel.addEventListener('mouseleave', forceCycle);
                heroCarousel.addEventListener('pointerenter', forceCycle);
                heroCarousel.addEventListener('touchstart', forceCycle);
            }
        });
    })();
</script>

<!-- CAMPAIGN SECTION: 05 KHÔNG Campaign Info Bar (Separate Section below Hero) -->

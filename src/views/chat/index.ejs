<% const currentUser = locals.user || (typeof user !== 'undefined' ? user : null); %>
<% const currentDest = (typeof dest !== 'undefined' && dest) ? dest : null; %>
<div class="container py-3 py-md-4 mt-4 mt-md-5 px-2 px-md-3">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10 px-1 px-sm-3">
            <div class="glass-panel d-flex flex-column" style="height: calc(100dvh - 110px); max-height: 700px; min-height: 520px; border-radius: 20px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.06); background: #ffffff; border: 1px solid #e4e6eb;">
                <!-- Header -->
                <div class="p-3.5 text-white border-0 d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, #922724 0%, #b83330 100%);">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center bg-white text-danger shadow-sm flex-shrink-0" style="width: 44px; height: 44px; font-size: 1.2rem;">
                            <% if (currentDest && currentDest.cover_image) { %>
                                <img src="<%= fixImg(currentDest.cover_image, '/images/logo.png') %>" class="rounded-circle w-100 h-100 object-fit-cover">
                            <% } else { %>
                                <i class="bi bi-messenger text-danger"></i>
                            <% } %>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-0 text-white" style="color: #ffffff !important; font-size: 1rem;">
                                <%= currentDest ? ('Hỗ trợ Trực tuyến - ' + currentDest.name) : 'Hỗ trợ Trực tuyến - Du Lịch Bình Lợi' %>
                            </h6>
                            <small class="opacity-90 text-white-50 d-flex align-items-center gap-1.5" style="font-size: 11px;">
                                <span class="d-inline-block rounded-circle bg-success" style="width: 7px; height: 7px;"></span>
                                <%= currentDest ? ('Ban Quản Lý ' + currentDest.name + ' • Trực tuyến') : 'Ban Quản Trị • Trực tuyến 24/7' %>
                            </small>
                        </div>
                    </div>
                    <% if (currentUser) { %>
                    <div class="d-flex align-items-center gap-2">
                        <% if (currentUser.avatar) { %>
                            <img src="<%= currentUser.avatar %>" class="rounded-circle border border-white border-2" style="width: 32px; height: 32px; object-fit: cover;" onerror="this.style.display='none'">
                        <% } else { %>
                            <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold" style="width: 32px; height: 32px; background: rgba(255,255,255,0.2); font-size: 0.75rem;">
                                <%= (currentUser.full_name || 'U').split(' ').pop().slice(0,1).toUpperCase() %>
                            </div>
                        <% } %>
                        <small class="text-white fw-semibold d-none d-sm-inline" style="font-size: 0.75rem;"><%= currentUser.full_name %></small>
                    </div>
                    <% } %>
                </div>

                <!-- Messages Body -->
                <div class="flex-grow-1 p-3 px-4 overflow-auto custom-scrollbar" id="chat-messages" style="background: #f0f2f5;">
                    <!-- Dynamically loaded messages -->
                </div>

                <!-- Input Footer (Messenger Style) -->
                <div class="p-2.5 px-3 bg-white border-top position-relative" style="border-color: #e4e6eb !important;">
                    <% if (currentUser) { %>
                    <!-- Floating Quick Emoji & Stickers Popover -->
                    <div id="tourist-emoji-popover" class="position-absolute shadow-lg border rounded-4 bg-white" style="display: none; bottom: 58px; left: 8px; right: 8px; max-width: 380px; z-index: 1050; border-color: #e4e6eb !important;">
                        <div class="p-2 border-bottom d-flex justify-content-between align-items-center bg-light rounded-top-4">
                            <div class="d-flex gap-1">
                                <button type="button" class="btn btn-sm btn-light active rounded-pill px-2.5 py-0.5 fw-bold fs-7 tourist-picker-tab" id="ttab-emoji" onclick="switchTouristPickerTab('emoji')">😊 Biểu cảm</button>
                                <button type="button" class="btn btn-sm btn-light rounded-pill px-2.5 py-0.5 fw-bold fs-7 tourist-picker-tab" id="ttab-travel" onclick="switchTouristPickerTab('travel')">🌿 Du lịch</button>
                                <button type="button" class="btn btn-sm btn-light rounded-pill px-2.5 py-0.5 fw-bold fs-7 tourist-picker-tab" id="ttab-stickers" onclick="switchTouristPickerTab('stickers')">🏷️ Nhãn dán</button>
                            </div>
                            <button type="button" class="btn-close" style="font-size: 0.65rem;" onclick="toggleTouristEmoji(false)"></button>
                        </div>
                        
                        <div class="p-2.5 tourist-pane" id="tpane-emoji" style="max-height: 200px; overflow-y: auto;">
                            <div class="d-flex flex-wrap gap-1.5 fs-3 justify-content-start">
                                <span class="cursor-pointer p-1.5 rounded-2 hover-bg-light" onclick="insertTouristEmoji('😊')">😊</span>
                                <span class="cursor-pointer p-1.5 rounded-2 hover-bg-light" onclick="insertTouristEmoji('🥰')">🥰</span>
                                <span class="cursor-pointer p-1.5 rounded-2 hover-bg-light" onclick="insertTouristEmoji('😂')">😂</span>
                                <span class="cursor-pointer p-1.5 rounded-2 hover-bg-light" onclick="insertTouristEmoji('😍')">😍</span>
                                <span class="cursor-pointer p-1.5 rounded-2 hover-bg-light" onclick="insertTouristEmoji('😎')">😎</span>
                                <span class="cursor-pointer p-1.5 rounded-2 hover-bg-light" onclick="insertTouristEmoji('🥳')">🥳</span>
                                <span class="cursor-pointer p-1.5 rounded-2 hover-bg-light" onclick="insertTouristEmoji('👍')">👍</span>
                                <span class="cursor-pointer p-1.5 rounded-2 hover-bg-light" onclick="insertTouristEmoji('👏')">👏</span>
                                <span class="cursor-pointer p-1.5 rounded-2 hover-bg-light" onclick="insertTouristEmoji('🙏')">🙏</span>
                                <span class="cursor-pointer p-1.5 rounded-2 hover-bg-light" onclick="insertTouristEmoji('❤️')">❤️</span>
                                <span class="cursor-pointer p-1.5 rounded-2 hover-bg-light" onclick="insertTouristEmoji('💖')">💖</span>
                                <span class="cursor-pointer p-1.5 rounded-2 hover-bg-light" onclick="insertTouristEmoji('🔥')">🔥</span>
                                <span class="cursor-pointer p-1.5 rounded-2 hover-bg-light" onclick="insertTouristEmoji('✨')">✨</span>
                                <span class="cursor-pointer p-1.5 rounded-2 hover-bg-light" onclick="insertTouristEmoji('💯')">💯</span>
                            </div>
                        </div>

                        <div class="p-2.5 tourist-pane" id="tpane-travel" style="display: none; max-height: 200px; overflow-y: auto;">
                            <div class="d-flex flex-wrap gap-1.5 fs-3 justify-content-start">
                                <span class="cursor-pointer p-1.5 rounded-2 hover-bg-light" onclick="insertTouristEmoji('🌿')">🌿</span>
                                <span class="cursor-pointer p-1.5 rounded-2 hover-bg-light" onclick="insertTouristEmoji('🌸')">🌸</span>
                                <span class="cursor-pointer p-1.5 rounded-2 hover-bg-light" onclick="insertTouristEmoji('🌾')">🌾</span>
                                <span class="cursor-pointer p-1.5 rounded-2 hover-bg-light" onclick="insertTouristEmoji('🚣')">🚣</span>
                                <span class="cursor-pointer p-1.5 rounded-2 hover-bg-light" onclick="insertTouristEmoji('🚴')">🚴</span>
                                <span class="cursor-pointer p-1.5 rounded-2 hover-bg-light" onclick="insertTouristEmoji('🥭')">🥭</span>
                                <span class="cursor-pointer p-1.5 rounded-2 hover-bg-light" onclick="insertTouristEmoji('🍵')">🍵</span>
                                <span class="cursor-pointer p-1.5 rounded-2 hover-bg-light" onclick="insertTouristEmoji('🏕️')">🏕️</span>
                                <span class="cursor-pointer p-1.5 rounded-2 hover-bg-light" onclick="insertTouristEmoji('🌅')">🌅</span>
                                <span class="cursor-pointer p-1.5 rounded-2 hover-bg-light" onclick="insertTouristEmoji('📸')">📸</span>
                            </div>
                        </div>

                        <div class="p-2 tourist-pane" id="tpane-stickers" style="display: none; max-height: 200px; overflow-y: auto;">
                            <div class="row g-2 text-center">
                                <div class="col-6">
                                    <button type="button" class="btn btn-outline-danger btn-sm w-100 rounded-3 py-1.5 fw-semibold fs-7 text-truncate" onclick="sendCustomMessageTourist('👋 [Xin chào Ban Quản Trị!]')">
                                        👋 Xin chào
                                    </button>
                                </div>
                                <div class="col-6">
                                    <button type="button" class="btn btn-outline-primary btn-sm w-100 rounded-3 py-1.5 fw-semibold fs-7 text-truncate" onclick="sendCustomMessageTourist('🙏 [Cảm ơn Ban Quản Trị đã hỗ trợ!]')">
                                        🙏 Cảm ơn
                                    </button>
                                </div>
                                <div class="col-6">
                                    <button type="button" class="btn btn-outline-warning btn-sm w-100 rounded-3 py-1.5 fw-semibold fs-7 text-truncate" onclick="sendCustomMessageTourist('✨ [Chuyến đi thật tuyệt vời!]')">
                                        ✨ Tuyệt vời
                                    </button>
                                </div>
                                <div class="col-6">
                                    <button type="button" class="btn btn-outline-success btn-sm w-100 rounded-3 py-1.5 fw-semibold fs-7 text-truncate" onclick="sendCustomMessageTourist('💖 [Tôi rất thích Bình Lợi Healing!]')">
                                        💖 Yêu thích
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tourist GIF Picker Popover -->
                    <div id="tourist-gif-popover" class="position-absolute shadow-lg border rounded-4 bg-white" style="display: none; bottom: 58px; left: 8px; right: 8px; max-width: 360px; z-index: 1050; border-color: #e4e6eb !important;">
                        <div class="p-2 border-bottom d-flex justify-content-between align-items-center bg-light rounded-top-4">
                            <span class="fw-bold small text-dark"><i class="bi bi-filetype-gif text-danger me-1"></i>Ảnh Động (GIF)</span>
                            <button type="button" class="btn-close" style="font-size: 0.65rem;" onclick="toggleTouristGif(false)"></button>
                        </div>
                        <div class="p-2 row g-2" style="max-height: 240px; overflow-y: auto;">
                            <div class="col-6">
                                <div class="border rounded-3 overflow-hidden cursor-pointer hover-bg-light shadow-2xs" onclick="sendTouristGif('https://media.giphy.com/media/l0HlBO7eyXzSZkJri/giphy.gif')">
                                    <img src="https://media.giphy.com/media/l0HlBO7eyXzSZkJri/giphy.gif" class="w-100" style="height: 80px; object-fit: cover;" loading="lazy">
                                    <div class="p-1 text-center bg-white"><span class="small fw-semibold text-primary" style="font-size: 0.72rem;">👋 Xin chào!</span></div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="border rounded-3 overflow-hidden cursor-pointer hover-bg-light shadow-2xs" onclick="sendTouristGif('https://media.giphy.com/media/osjgQPWRx3cac/giphy.gif')">
                                    <img src="https://media.giphy.com/media/osjgQPWRx3cac/giphy.gif" class="w-100" style="height: 80px; object-fit: cover;" loading="lazy">
                                    <div class="p-1 text-center bg-white"><span class="small fw-semibold text-success" style="font-size: 0.72rem;">🙏 Cảm ơn!</span></div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="border rounded-3 overflow-hidden cursor-pointer hover-bg-light shadow-2xs" onclick="sendTouristGif('https://media.giphy.com/media/111ebonMs90YLu/giphy.gif')">
                                    <img src="https://media.giphy.com/media/111ebonMs90YLu/giphy.gif" class="w-100" style="height: 80px; object-fit: cover;" loading="lazy">
                                    <div class="p-1 text-center bg-white"><span class="small fw-semibold text-warning" style="font-size: 0.72rem;">👍 Tuyệt vời!</span></div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="border rounded-3 overflow-hidden cursor-pointer hover-bg-light shadow-2xs" onclick="sendTouristGif('https://media.giphy.com/media/26AHONQ79FdWZhAI0/giphy.gif')">
                                    <img src="https://media.giphy.com/media/26AHONQ79FdWZhAI0/giphy.gif" class="w-100" style="height: 80px; object-fit: cover;" loading="lazy">
                                    <div class="p-1 text-center bg-white"><span class="small fw-semibold text-danger" style="font-size: 0.72rem;">❤️ Thả tim!</span></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Hidden file input for images -->
                    <input type="file" id="tourist-image-input" accept="image/*" style="display: none;" onchange="handleTouristImageUpload(event)">

                    <!-- Live Audio Recording Bar Overlay -->
                    <div id="tourist-voice-recording-bar" class="p-2 px-3 bg-white align-items-center gap-3 border-top" style="display: none; border-color: #e4e6eb !important;">
                        <div class="d-flex align-items-center gap-2 text-danger">
                            <span class="spinner-grow spinner-grow-sm text-danger" role="status"></span>
                            <span class="fw-bold" style="font-size: 0.9rem;" id="tourist-recording-timer">00:00</span>
                        </div>
                        <div class="flex-grow-1 text-center">
                            <span class="text-muted small">Đang ghi âm thoại...</span>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-light btn-sm rounded-pill px-3 text-danger fw-bold" onclick="cancelTouristVoiceRecording()">
                                <i class="bi bi-trash3 me-1"></i>Hủy
                            </button>
                            <button type="button" class="btn btn-danger btn-sm rounded-pill px-3 fw-bold" style="background: #922724 !important; border:none;" onclick="stopAndSendTouristVoiceRecording()">
                                <i class="bi bi-send-fill me-1"></i>Gửi
                            </button>
                        </div>
                    </div>

                    <!-- Messenger Main Input Form -->
                    <form id="chat-form" class="d-flex align-items-center gap-1.5 mb-0" onsubmit="sendMessage(event)">
                        <!-- Media Icons (Left) -->
                        <div class="d-flex align-items-center gap-1 flex-shrink-0">
                            <button type="button" class="btn btn-sm btn-light rounded-circle p-0 d-flex align-items-center justify-content-center shadow-none text-decoration-none" style="width: 32px; height: 32px; color: #922724;" onclick="startTouristVoiceRecording()" title="Ghi âm thoại">
                                <i class="bi bi-mic-fill fs-5"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-light rounded-circle p-0 d-flex align-items-center justify-content-center shadow-none text-decoration-none" style="width: 32px; height: 32px; color: #922724;" onclick="triggerTouristImageUpload()" title="Gửi ảnh">
                                <i class="bi bi-image fs-5"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-light rounded-circle p-0 d-flex align-items-center justify-content-center shadow-none text-decoration-none" style="width: 32px; height: 32px; color: #922724;" onclick="toggleTouristGif()" title="Ảnh động GIF">
                                <i class="bi bi-filetype-gif fs-5"></i>
                            </button>
                        </div>
                        
                        <div class="flex-grow-1 position-relative" style="min-width: 0;">
                            <input type="text" class="form-control border-0" style="height: 38px; font-size: 0.9rem; background: #f0f2f5; border-radius: 20px; color: #050505; padding-left: 14px; padding-right: 38px; width: 100%;" placeholder="Nhập tin nhắn..." id="chat-input" autocomplete="off" oninput="toggleTouristSendIcon(this)">
                            <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y p-0 me-2 text-decoration-none d-flex align-items-center justify-content-center" style="width: 26px; height: 26px;" onclick="toggleTouristEmoji()" title="Biểu cảm / Nhãn dán">
                                <i class="bi bi-emoji-smile-fill fs-5 text-warning"></i>
                            </button>
                        </div>

                        <button type="submit" id="tourist-btn-send" class="btn btn-link p-0 d-flex align-items-center justify-content-center flex-shrink-0 text-decoration-none" style="color: #922724; width: 34px; height: 34px;" title="Gửi">
                            <i class="bi bi-hand-thumbs-up-fill fs-4" id="tourist-send-icon"></i>
                        </button>
                    </form>
                    <% } else { %>
                    <div class="text-center py-2">
                        <a href="/auth/login?redirect=<%= encodeURIComponent('/chat' + (currentDest ? ('?destinationId=' + currentDest.id) : '')) %>" class="btn btn-danger rounded-pill px-4 py-2 fw-semibold" style="font-size: 0.85rem; background: #922724 !important; border: none;">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập để gửi tin nhắn hỗ trợ
                        </a>
                    </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Image Lightbox Modal for Tourist Page -->
<div class="modal fade" id="touristImageLightboxModal" tabindex="-1" aria-hidden="true" style="z-index: 1070;">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-dark bg-opacity-95 border-0 rounded-4 overflow-hidden text-center p-2">
            <div class="d-flex justify-content-end p-2">
                <a id="tourist-lightbox-download-btn" href="#" download class="btn btn-sm btn-outline-light rounded-pill me-2"><i class="bi bi-download me-1"></i>Tải ảnh</a>
                <button type="button" class="btn btn-sm btn-light rounded-circle" data-bs-dismiss="modal"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="p-3 d-flex align-items-center justify-content-center" style="min-height: 300px;">
                <img id="tourist-lightbox-img" src="" class="img-fluid rounded-3 shadow-lg" style="max-height: 75vh; object-fit: contain;">
            </div>
        </div>
    </div>
</div>

<!-- Modal Thu Hồi Tin Nhắn (Tourist Page) -->
<div class="modal fade" id="touristRecallModal" tabindex="-1" aria-hidden="true" style="z-index: 1080;">
    <div class="modal-dialog modal-dialog-centered modal-sm" style="max-width: 360px;">
        <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
            <div class="modal-header border-bottom py-2.5 px-3">
                <h6 class="modal-title fw-bold text-dark fs-6"><i class="bi bi-chat-square-dots me-1.5 text-danger"></i>Bạn muốn gỡ tin nhắn này?</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3">
                <!-- Option 1: Unsend for everyone (Sender only) -->
                <div id="tourist-recall-option-all" class="d-flex align-items-start gap-3 p-2.5 rounded-3 border mb-2 cursor-pointer hover-bg-light transition-all" onclick="executeTouristRecall('all')">
                    <div class="rounded-circle bg-danger bg-opacity-10 text-danger d-flex align-items-center justify-content-center p-2 flex-shrink-0" style="width: 38px; height: 38px;">
                        <i class="bi bi-arrow-counterclockwise fs-5"></i>
                    </div>
                    <div>
                        <strong class="d-block text-dark" style="font-size: 0.9rem;">Thu hồi với mọi người</strong>
                        <small class="text-muted d-block" style="font-size: 0.75rem; line-height: 1.3;">Gỡ bỏ nội dung tin nhắn này đối với tất cả mọi người trong đoạn chat.</small>
                    </div>
                </div>

                <!-- Option 2: Remove for you (Everyone) -->
                <div id="tourist-recall-option-self" class="d-flex align-items-start gap-3 p-2.5 rounded-3 border cursor-pointer hover-bg-light transition-all" onclick="executeTouristRecall('self')">
                    <div class="rounded-circle bg-secondary bg-opacity-10 text-secondary d-flex align-items-center justify-content-center p-2 flex-shrink-0" style="width: 38px; height: 38px;">
                        <i class="bi bi-trash3 fs-5"></i>
                    </div>
                    <div>
                        <strong class="d-block text-dark" style="font-size: 0.9rem;">Gỡ ở phía bạn</strong>
                        <small class="text-muted d-block" style="font-size: 0.75rem; line-height: 1.3;">Tin nhắn này sẽ bị xóa khỏi thiết bị của bạn nhưng vẫn hiển thị với người khác.</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .custom-scrollbar::-webkit-scrollbar { width: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(0,0,0,0.15); border-radius: 10px; }
    .group-hover-parent .group-hover-visible {
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.15s ease-in-out;
    }
    .group-hover-parent:hover .group-hover-visible,
    .group-hover-parent:active .group-hover-visible,
    .group-hover-parent:focus-within .group-hover-visible {
        opacity: 1 !important;
        pointer-events: auto;
    }
    .hover-bg-light:hover {
        background-color: #f8f9fa !important;
    }
</style>

<script id="current-user-json-data" type="application/json">
<%- JSON.stringify(currentUser ? { id: currentUser.id, full_name: currentUser.full_name, avatar: currentUser.avatar } : null) %>
</script>

<script>
    const destId = '<%= currentDest ? currentDest.id : "" %>';
    const destName = '<%= currentDest ? currentDest.name.replace(/'/g, "\\'") : "" %>';
    const BRAND_LOGO_URL = "<%= fixImg(settings.brand_logo, '/images/logo.png') %>?v=3";
    let chatInterval = null;
    let currentGlobalMessages = [];
    let lastGlobalChatCount = -1;
    const currentUser = JSON.parse(document.getElementById('current-user-json-data')?.textContent || 'null');

    // Voice recorder state
    let touristMediaRecorder = null;
    let touristAudioChunks = [];
    let touristRecordInterval = null;
    let touristRecordSeconds = 0;

    function toggleTouristSendIcon(input) {
        const icon = document.getElementById('tourist-send-icon');
        if (!icon) return;
        if (input.value.trim().length > 0) {
            icon.className = 'bi bi-send-fill fs-5';
        } else {
            icon.className = 'bi bi-hand-thumbs-up-fill fs-4';
        }
    }

    function toggleTouristEmoji(force) {
        const p = document.getElementById('tourist-emoji-popover');
        if (!p) return;
        toggleTouristGif(false);
        p.style.display = (force !== undefined) ? (force ? 'block' : 'none') : (p.style.display === 'none' ? 'block' : 'none');
    }

    function toggleTouristGif(force) {
        const p = document.getElementById('tourist-gif-popover');
        if (!p) return;
        toggleTouristEmoji(false);
        p.style.display = (force !== undefined) ? (force ? 'block' : 'none') : (p.style.display === 'none' ? 'block' : 'none');
    }

    function switchTouristPickerTab(tab) {
        document.querySelectorAll('.tourist-picker-tab').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.tourist-pane').forEach(p => p.style.display = 'none');
        
        const activeBtn = document.getElementById(`ttab-${tab}`);
        if (activeBtn) activeBtn.classList.add('active');
        
        const activePane = document.getElementById(`tpane-${tab}`);
        if (activePane) activePane.style.display = 'block';
    }

    function insertTouristEmoji(emoji) {
        const input = document.getElementById('chat-input');
        if (!input) return;
        input.value += emoji;
        input.focus();
        toggleTouristSendIcon(input);
        toggleTouristEmoji(false);
    }

    function sendTouristGif(gifUrl) {
        toggleTouristGif(false);
        sendCustomMessageTourist(`[GIF: ${gifUrl}]`);
    }

    function triggerTouristImageUpload() {
        document.getElementById('tourist-image-input').click();
    }

    async function handleTouristImageUpload(e) {
        const file = e.target.files[0];
        if (!file) return;

        const formData = new FormData();
        formData.append('image', file);

        try {
            const res = await axios.post('/api/chat/upload', formData, {
                headers: { 'Content-Type': 'multipart/form-data' }
            });
            if (res.data.success && (res.data.url || res.data.path)) {
                const imgUrl = res.data.url || res.data.path;
                sendCustomMessageTourist(`[HÌNH ẢNH: ${imgUrl}]`);
            } else {
                alert(res.data.message || 'Lỗi tải ảnh');
            }
        } catch (err) {
            alert('Lỗi tải ảnh: ' + (err.response?.data?.message || err.message));
        } finally {
            e.target.value = '';
        }
    }

    async function startTouristVoiceRecording() {
        try {
            const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
            touristAudioChunks = [];
            touristMediaRecorder = new MediaRecorder(stream);
            
            touristMediaRecorder.ondataavailable = (e) => {
                if (e.data.size > 0) touristAudioChunks.push(e.data);
            };

            touristMediaRecorder.start();
            touristRecordSeconds = 0;
            document.getElementById('tourist-recording-timer').innerText = '00:00';
            document.getElementById('chat-form').style.display = 'none';
            document.getElementById('tourist-voice-recording-bar').style.display = 'flex';

            touristRecordInterval = setInterval(() => {
                touristRecordSeconds++;
                const mins = String(Math.floor(touristRecordSeconds / 60)).padStart(2, '0');
                const secs = String(touristRecordSeconds % 60).padStart(2, '0');
                document.getElementById('tourist-recording-timer').innerText = `${mins}:${secs}`;
            }, 1000);
        } catch (err) {
            sendCustomMessageTourist('🎤 [Ghi âm thoại: 0:12]');
        }
    }

    function cancelTouristVoiceRecording() {
        if (touristRecordInterval) clearInterval(touristRecordInterval);
        if (touristMediaRecorder && touristMediaRecorder.state !== 'inactive') {
            touristMediaRecorder.stop();
            touristMediaRecorder.stream.getTracks().forEach(track => track.stop());
        }
        document.getElementById('tourist-voice-recording-bar').style.display = 'none';
        document.getElementById('chat-form').style.display = 'flex';
    }

    async function stopAndSendTouristVoiceRecording() {
        if (!touristMediaRecorder || touristMediaRecorder.state === 'inactive') return;
        if (touristRecordInterval) clearInterval(touristRecordInterval);

        const durationStr = document.getElementById('tourist-recording-timer').innerText;

        touristMediaRecorder.onstop = async () => {
            touristMediaRecorder.stream.getTracks().forEach(track => track.stop());
            const audioBlob = new Blob(touristAudioChunks, { type: 'audio/webm' });
            
            const formData = new FormData();
            formData.append('image', audioBlob, `voice-${Date.now()}.webm`);

            try {
                const res = await axios.post('/api/chat/upload', formData, {
                    headers: { 'Content-Type': 'multipart/form-data' }
                });
                if (res.data.success && (res.data.url || res.data.path)) {
                    const audioUrl = res.data.url || res.data.path;
                    sendCustomMessageTourist(`[AUDIO: ${audioUrl}|${durationStr}]`);
                } else {
                    sendCustomMessageTourist(`🎤 [Ghi âm thoại: ${durationStr}]`);
                }
            } catch(e) {
                sendCustomMessageTourist(`🎤 [Ghi âm thoại: ${durationStr}]`);
            }

            document.getElementById('tourist-voice-recording-bar').style.display = 'none';
            document.getElementById('chat-form').style.display = 'flex';
        };

        touristMediaRecorder.stop();
    }

    function openTouristLightbox(url) {
        document.getElementById('tourist-lightbox-img').src = url;
        document.getElementById('tourist-lightbox-download-btn').href = url;
        const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('touristImageLightboxModal'));
        modal.show();
    }

    function togglePlayTouristVoice(btn, audioUrl) {
        let audio = btn._audioInstance;
        if (!audio) {
            audio = new Audio(audioUrl);
            btn._audioInstance = audio;
            audio.onended = () => {
                btn.innerHTML = '<i class="bi bi-play-fill fs-5"></i>';
            };
        }

        if (audio.paused) {
            audio.play().then(() => {
                btn.innerHTML = '<i class="bi bi-pause-fill fs-5"></i>';
            }).catch(e => {
                btn.innerHTML = '<i class="bi bi-pause-fill fs-5"></i>';
            });
        } else {
            audio.pause();
            btn.innerHTML = '<i class="bi bi-play-fill fs-5"></i>';
        }
    }

    function formatDateDividerText(isoDateStr) {
        if (!isoDateStr) return '';
        const d = new Date(isoDateStr);
        if (isNaN(d.getTime())) return '';
        const now = new Date();
        const isToday = d.toDateString() === now.toDateString();
        const yesterday = new Date(now);
        yesterday.setDate(now.getDate() - 1);
        const isYesterday = d.toDateString() === yesterday.toDateString();

        const timeStr = d.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
        const days = ['CN', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7'];
        const dayName = days[d.getDay()];
        const day = d.getDate();
        const month = d.getMonth() + 1;
        const year = d.getFullYear();

        if (isToday) return `Hôm nay ${timeStr}`;
        if (isYesterday) return `Hôm qua ${timeStr}`;
        if (year === now.getFullYear()) return `${dayName}, ${day} Thg ${month}, ${timeStr}`;
        return `${dayName}, ${day}/${month}/${year}, ${timeStr}`;
    }

    function formatBubbleContentTourist(text) {
        if (!text) return '';

        // 1. Images
        const imgMatch = text.match(/\[(HÌNH ẢNH|IMAGE):\s*([^\]]+)\]/i);
        if (imgMatch) {
            const url = imgMatch[2].trim();
            return `
                <div class="my-1 position-relative overflow-hidden rounded-3 shadow-xs">
                    <img src="${url}" class="img-fluid rounded-3 cursor-pointer" style="max-height: 220px; max-width: 100%; object-fit: cover; display: block;" onclick="openTouristLightbox('${url}')" loading="lazy" onerror="this.outerHTML='<span class=\\'small\\'>📷 Không thể tải ảnh</span>'">
                </div>
            `;
        }

        const directImgMatch = text.match(/^(\/[^\s]+\.(jpg|jpeg|png|webp|gif)|https?:\/\/[^\s]+\.(jpg|jpeg|png|webp|gif))$/i);
        if (directImgMatch) {
            const url = directImgMatch[1].trim();
            return `
                <div class="my-1 position-relative overflow-hidden rounded-3 shadow-xs">
                    <img src="${url}" class="img-fluid rounded-3 cursor-pointer" style="max-height: 220px; max-width: 100%; object-fit: cover; display: block;" onclick="openTouristLightbox('${url}')" loading="lazy">
                </div>
            `;
        }

        // 2. GIFs
        const gifMatch = text.match(/\[GIF:\s*([^\]]+)\]/i);
        if (gifMatch) {
            const url = gifMatch[1].trim();
            return `
                <div class="my-1 position-relative overflow-hidden rounded-3 shadow-xs">
                    <img src="${url}" class="rounded-3 shadow-xs" style="max-height: 180px; max-width: 240px; object-fit: contain; display: block;" loading="lazy">
                </div>
            `;
        }

        // 3. Audio / Voice notes
        const audioMatch = text.match(/\[(AUDIO|VOICE):\s*([^\|\]]+)(?:\|([^\]]+))?\]/i);
        if (audioMatch) {
            const audioUrl = audioMatch[2].trim();
            const duration = audioMatch[3] || '0:15';
            return `
                <div class="d-flex align-items-center gap-2 p-1.5 px-3 rounded-pill my-1" style="background: rgba(0,0,0,0.06); min-width: 180px;">
                    <button type="button" class="btn btn-sm btn-white rounded-circle p-0 d-flex align-items-center justify-content-center shadow-2xs flex-shrink-0" style="width: 30px; height: 30px; color: #922724;" onclick="togglePlayTouristVoice(this, '${audioUrl}')">
                        <i class="bi bi-play-fill fs-5"></i>
                    </button>
                    <div class="flex-grow-1" style="height: 3px; background: rgba(0,0,0,0.15); border-radius: 2px;"></div>
                    <span class="x-small fw-bold opacity-90 text-nowrap" style="font-size: 0.72rem;">${duration}</span>
                </div>
            `;
        }

        if (text.includes('🎤 [Ghi âm thoại')) {
            return `
                <div class="d-flex align-items-center gap-2 p-1.5 px-3 rounded-pill my-1" style="background: rgba(0,0,0,0.06); min-width: 180px;">
                    <button type="button" class="btn btn-sm btn-white rounded-circle p-0 d-flex align-items-center justify-content-center shadow-2xs flex-shrink-0" style="width: 30px; height: 30px; color: #922724;" onclick="togglePlayTouristVoice(this, '/sounds/chat-notification.mp3')">
                        <i class="bi bi-play-fill fs-5"></i>
                    </button>
                    <div class="flex-grow-1" style="height: 3px; background: rgba(0,0,0,0.15); border-radius: 2px;"></div>
                    <span class="x-small fw-bold opacity-90 text-nowrap" style="font-size: 0.72rem;">0:15</span>
                </div>
            `;
        }

        return escapeHtml(text);
    }

    async function loadChatMessages() {
        try {
            const url = destId ? `/api/get-messages?destinationId=${destId}` : '/api/get-messages?scope=global';
            const res = await axios.get(url);
            if (res.data.success) {
                if (res.data.data && res.data.data.length === lastGlobalChatCount) return;
                lastGlobalChatCount = res.data.data.length;
                currentGlobalMessages = res.data.data;
                renderGlobalChat(currentGlobalMessages);
            }
        } catch (e) {
            console.error('Error loading chat messages:', e);
        }
    }

    function renderGlobalChat(messages) {
        const container = document.getElementById('chat-messages');
        if (!container) return;

        let html = `
            <div class="text-center mb-3">
                <span class="badge bg-white text-muted shadow-2xs px-3 py-1.5 rounded-pill border" style="font-size: 11px;">
                    <i class="bi bi-shield-check text-success me-1"></i> Cuộc trò chuyện hỗ trợ trực tuyến bảo mật
                </span>
            </div>
        `;
        
        let lastMsgTime = null;

        if (messages && messages.length > 0) {
            messages.forEach((msg, idx) => {
                const isMe = msg.is_mine || false;
                const isAI = msg.is_ai === 1 || msg.is_ai === true;
                const currentMsgTime = msg.created_at ? new Date(msg.created_at).getTime() : 0;
                const exactTime = msg.created_at ? new Date(msg.created_at).toLocaleTimeString('vi-VN', {hour: '2-digit', minute:'2-digit'}) : '';
                const isLikeEmoji = (msg.message === '👍');
                const isMedia = (msg.message.includes('[HÌNH ẢNH:') || msg.message.includes('[GIF:') || msg.message.includes('[AUDIO:'));
                const isRecalled = msg.is_recalled || msg.message === '[ĐÃ THU HỒI]';

                if (isRecalled) {
                    if (isMe) {
                        html += `
                            <div class="d-flex flex-column mb-1 align-items-end">
                                <div class="px-3 py-2 text-muted fst-italic shadow-2xs" style="border-radius: 18px; border: 1px dashed rgba(0,0,0,0.18); background: rgba(0,0,0,0.03); font-size: 0.85rem;" title="${exactTime}">
                                    <i class="bi bi-arrow-counterclockwise me-1 text-danger"></i>Tin nhắn đã bị thu hồi
                                </div>
                                <div class="x-small text-muted text-end mt-0.5 me-1" style="font-size: 0.68rem; color: #65676b;">${exactTime}</div>
                            </div>
                        `;
                    } else {
                        html += `
                            <div class="d-flex flex-column mb-1 align-items-start">
                                <div class="d-flex gap-2 align-items-end" style="max-width: 78%;">
                                    <img src="${BRAND_LOGO_URL}" class="rounded-circle shadow-2xs flex-shrink-0" style="width: 28px; height: 28px; object-fit: cover;" onerror="this.src='/images/logo.png'">
                                    <div class="px-3 py-2 text-muted fst-italic shadow-2xs" style="border-radius: 18px; border: 1px dashed rgba(0,0,0,0.18); background: rgba(0,0,0,0.03); font-size: 0.85rem;" title="${exactTime}">
                                        <i class="bi bi-arrow-counterclockwise me-1 text-danger"></i>Tin nhắn đã bị thu hồi
                                    </div>
                                </div>
                                <div class="x-small text-muted text-start mt-0.5 ms-5" style="font-size: 0.68rem; color: #65676b;">${exactTime}</div>
                            </div>
                        `;
                    }
                } else if (isMe) {
                    html += `
                        <div class="d-flex flex-column mb-1 align-items-end">
                            <div class="group-hover-parent d-flex align-items-center gap-1.5 justify-content-end" style="max-width: 82%;">
                                <button type="button" class="btn btn-sm btn-light rounded-circle p-0 d-flex align-items-center justify-content-center shadow-none text-muted group-hover-visible flex-shrink-0" style="width: 26px; height: 26px;" onclick="openTouristRecallAction('${msg.id}', true)" title="Tùy chọn tin nhắn">
                                    <i class="bi bi-three-dots"></i>
                                </button>
                                <div class="shadow-2xs text-white text-start" style="font-size: ${isLikeEmoji ? '2.2rem' : '0.93rem'}; line-height: 1.38; padding: ${isLikeEmoji || isMedia ? '2px 4px' : '9px 14px'}; background: ${isLikeEmoji || isMedia ? 'transparent' : 'linear-gradient(135deg, #922724 0%, #b83330 100%)'} !important; border-radius: 18px !important; word-break: break-word; overflow-wrap: anywhere;" title="${exactTime}">
                                    ${formatBubbleContentTourist(msg.message)}
                                </div>
                            </div>
                            <div class="x-small text-muted text-end mt-0.5 me-1" style="font-size: 0.68rem; color: #65676b;">${exactTime}</div>
                        </div>
                    `;
                } else if (isAI) {
                    html += `
                        <div class="d-flex flex-column mb-1 align-items-start">
                            <div class="d-flex gap-2 align-items-end" style="max-width: 78%;">
                                <div class="rounded-circle d-flex align-items-center justify-content-center text-success flex-shrink-0 shadow-2xs bg-success bg-opacity-10 border border-success border-opacity-20" style="width: 28px; height: 28px; font-size: 0.9rem;">
                                    <i class="bi bi-robot"></i>
                                </div>
                                <div class="shadow-2xs text-start" style="font-size: 0.93rem; line-height: 1.38; padding: 9px 14px; border-radius: 18px !important; background: rgba(16,185,129,0.08); border: 1px solid rgba(16,185,129,0.2); color: #065f46; word-break: break-word; overflow-wrap: anywhere;" title="${exactTime}">
                                    <div class="x-small fw-bold text-success mb-0.5" style="font-size: 0.65rem;">🤖 TRỢ LÝ AI</div>
                                    ${formatBubbleContentTourist(msg.message)}
                                </div>
                            </div>
                            <div class="x-small text-muted text-start mt-0.5 ms-5" style="font-size: 0.68rem; color: #65676b;">${exactTime}</div>
                        </div>
                    `;
                } else {
                    const senderLabel = msg.manager_name ? `${msg.manager_name} (Quản lý)` : (msg.destination_name ? `Quản lý ${msg.destination_name}` : 'Ban Quản Trị');
                    const bubbleBg = '#ffffff';
                    const bubbleBorder = '1px solid rgba(0,0,0,0.08)';

                    html += `
                        <div class="d-flex flex-column mb-1 align-items-start">
                            <div class="d-flex gap-2 align-items-end" style="max-width: 82%;">
                                <img src="${BRAND_LOGO_URL}" class="rounded-circle shadow-2xs flex-shrink-0" style="width: 28px; height: 28px; object-fit: cover;" onerror="this.src='/images/logo.png'">
                                <div class="group-hover-parent d-flex align-items-center gap-1.5 justify-content-start flex-grow-1">
                                    <div class="shadow-2xs text-start" style="font-size: ${isLikeEmoji ? '2.2rem' : '0.93rem'}; line-height: 1.38; padding: ${isLikeEmoji || isMedia ? '2px 4px' : '9px 14px'}; border-radius: 18px !important; background: ${isLikeEmoji || isMedia ? 'transparent' : bubbleBg}; border: ${isLikeEmoji || isMedia ? 'none' : bubbleBorder}; color: #050505; word-break: break-word; overflow-wrap: anywhere;" title="${exactTime}">
                                        <div class="x-small fw-bold text-muted mb-0.5" style="font-size: 0.65rem;">${senderLabel}</div>
                                        ${formatBubbleContentTourist(msg.message)}
                                    </div>
                                    <button type="button" class="btn btn-sm btn-light rounded-circle p-0 d-flex align-items-center justify-content-center shadow-none text-muted group-hover-visible flex-shrink-0" style="width: 26px; height: 26px;" onclick="openTouristRecallAction('${msg.id}', false)" title="Tùy chọn tin nhắn">
                                        <i class="bi bi-three-dots"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="x-small text-muted text-start mt-0.5 ms-5" style="font-size: 0.68rem; color: #65676b;">${exactTime}</div>
                        </div>
                    `;
                }
            });
        }
        
        container.innerHTML = html;
        container.scrollTop = container.scrollHeight;
    }

    let activeTouristRecallMessageId = null;

    function openTouristRecallAction(msgId, isMine) {
        activeTouristRecallMessageId = msgId;
        const optAll = document.getElementById('tourist-recall-option-all');
        if (optAll) {
            optAll.style.display = isMine ? 'flex' : 'none';
        }
        const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('touristRecallModal'));
        modal.show();
    }

    async function executeTouristRecall(type) {
        if (!activeTouristRecallMessageId) return;
        const msgId = activeTouristRecallMessageId;
        const modalEl = document.getElementById('touristRecallModal');
        const modal = bootstrap.Modal.getInstance(modalEl);
        if (modal) modal.hide();

        try {
            const res = await axios.post('/api/chat/recall-message', { messageId: msgId, type });
            if (res.data.success) {
                lastGlobalChatCount = -1;
                loadChatMessages();
            } else {
                alert(res.data.message || 'Không thể thực hiện thao tác');
            }
        } catch(e) {
            alert('Lỗi: ' + (e.response?.data?.message || e.message));
        }
    }

    async function sendCustomMessageTourist(msg) {
        if (!msg) return;
        const container = document.getElementById('chat-messages');
        const exactTime = new Date().toLocaleTimeString('vi-VN', {hour: '2-digit', minute:'2-digit'});
        const isLikeEmoji = (msg === '👍');
        const isMedia = (msg.includes('[HÌNH ẢNH:') || msg.includes('[GIF:') || msg.includes('[AUDIO:'));

        const optHtml = `
            <div class="d-flex flex-column mb-1 align-items-end">
                <div class="shadow-2xs text-white text-start" style="max-width: 75%; font-size: ${isLikeEmoji ? '2.2rem' : '0.93rem'}; line-height: 1.38; padding: ${isLikeEmoji || isMedia ? '2px 4px' : '9px 14px'}; background: ${isLikeEmoji || isMedia ? 'transparent' : 'linear-gradient(135deg, #922724 0%, #b83330 100%)'} !important; border-radius: 18px !important; word-break: break-word; overflow-wrap: anywhere;">
                    ${formatBubbleContentTourist(msg)}
                </div>
                <div class="x-small text-muted text-end mt-0.5 me-1" style="font-size: 0.68rem; color: #65676b;">${exactTime}</div>
            </div>
        `;
        container.insertAdjacentHTML('beforeend', optHtml);
        container.scrollTop = container.scrollHeight;

        try {
            const payload = { message: msg };
            if (destId) payload.destinationId = destId;
            const res = await axios.post('/api/send-message', payload);
            if (res.data.success) {
                loadChatMessages();
            } else if (res.data.requireLogin) {
                alert(res.data.message || 'Vui lòng đăng nhập để gửi tin nhắn!');
            }
        } catch (e) {
            console.error('Error sending message:', e);
            const errMsg = e.response?.data?.message || 'Không thể gửi tin nhắn. Vui lòng đăng nhập tài khoản.';
            alert(errMsg);
        }
    }

    async function sendMessage(e) {
        if (e) e.preventDefault();
        const input = document.getElementById('chat-input');
        let msg = input.value.trim();
        if (!msg) msg = '👍';

        input.value = '';
        toggleTouristSendIcon(input);
        sendCustomMessageTourist(msg);
        input.focus();
    }

    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.innerText = text;
        return div.innerHTML;
    }

    document.addEventListener('DOMContentLoaded', () => {
        renderGlobalChat(currentGlobalMessages);
        loadChatMessages();
        chatInterval = setInterval(loadChatMessages, 3500);
    });
</script>

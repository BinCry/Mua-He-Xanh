        .messenger-drawer {
            position: fixed !important;
            bottom: 0 !important;
            left: 0 !important;
            right: 0 !important;
            max-width: 100% !important;
            border-radius: 20px 20px 0 0 !important;
            z-index: 99999 !important;
            box-shadow: 0 -10px 40px rgba(0,0,0,0.2) !important;

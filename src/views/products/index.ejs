<section class="py-4 py-md-5 bg-light min-vh-100">
  <div class="container py-3">
    <header class="text-center mb-4 mb-md-5">
      <h1 class="display-6 fw-bold">Shop hàng hóa</h1>
    </header>
    <form class="card border-0 shadow-sm rounded-4 p-2 mb-5 product-search" action="/shops" method="get">
      <div class="input-group"><input class="form-control border-0 shadow-none" name="q" value="<%= searchQuery %>" maxlength="100" placeholder="Tìm sản phẩm hoặc địa điểm"><button class="btn product-search-button rounded-pill px-4" type="submit">Tìm kiếm</button></div>
    </form>
    <div class="row g-4">
      <% products.forEach(product => { const available = Math.max(0, Number(product.stock_on_hand) - Number(product.reserved_stock)); %>
        <article class="col-12 col-sm-6 col-lg-4 col-xl-3">
          <div class="card h-100 border-0 shadow-sm rounded-4">
            <div class="card-body d-flex flex-column p-4">
              <p class="small text-success fw-bold mb-2"><%= product.destination_name || 'Bình Lợi' %></p>
              <h2 class="h5 fw-bold"><a class="text-decoration-none text-dark" href="/shops/<%= product.id %>"><%= product.title %></a></h2>
              <p class="text-secondary small flex-grow-1"><%= (product.description || '').slice(0, 150) %></p>
              <div class="small text-secondary mb-2"><%= available %> sản phẩm còn có thể đặt</div>
              <div class="d-flex justify-content-between align-items-center gap-2 border-top pt-3"><strong><%= new Intl.NumberFormat('vi-VN').format(product.price_vnd) %>đ</strong><a class="btn btn-outline-success rounded-pill btn-sm" href="/shops/<%= product.id %>">Xem &amp; đặt</a></div>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
    <% if (!products.length) { %><div class="text-center bg-white rounded-4 p-5 shadow-sm"><h2 class="h5 mb-0">Chưa có sản phẩm phù hợp</h2></div><% } %>
  </div>
</section>
<style>
  .product-search-button{background:#a22926;border-color:#a22926;color:#fff;min-height:46px;font-weight:700}
  .product-search-button:hover,.product-search-button:focus{background:#86211f;border-color:#86211f;color:#fff}
  @media(max-width:575.98px){.product-search{margin-bottom:2rem!important}.product-search-button{padding-inline:1rem!important}}
</style>

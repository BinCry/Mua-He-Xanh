<section class="py-4 py-md-5 bg-light min-vh-100">
  <div class="container py-3" style="max-width:760px">
    <a class="btn btn-link px-0 text-success" href="/shops">&larr; Shop hàng hóa</a>
    <% const available = Math.max(0, Number(product.stock_on_hand) - Number(product.reserved_stock)); %>
    <article class="card border-0 shadow-sm rounded-4">
      <div class="card-body p-4 p-md-5">
        <p class="text-success fw-bold"><%= product.destination_name || 'Bình Lợi' %></p>
        <h1 class="h2 fw-bold"><%= product.title %></h1>
        <p class="text-secondary" style="white-space:pre-line"><%= product.description || '' %></p>
        <div class="fs-4 fw-bold mb-2"><%= new Intl.NumberFormat('vi-VN').format(product.price_vnd) %>đ</div>
        <p class="small text-secondary"><%= available %> sản phẩm còn có thể đặt.</p>
        <div id="orderFeedback" class="visually-hidden" role="status" aria-live="polite"></div>
        <div class="d-flex flex-column flex-sm-row gap-2 align-items-sm-end">
          <label class="flex-grow-1">Số lượng<input id="orderQuantity" class="form-control mt-1" type="number" min="1" max="999" value="1" <%= available ? '' : 'disabled' %>></label>
          <button id="orderButton" class="btn btn-success rounded-pill px-4" data-product-id="<%= product.id %>" <%= available ? '' : 'disabled' %>>Đặt hàng</button>
        </div>
      </div>
    </article>
  </div>
</section>
<script>
document.getElementById('orderButton')?.addEventListener('click', async () => {
  const button = document.getElementById('orderButton'); const feedback = document.getElementById('orderFeedback');
  const quantity = Number(document.getElementById('orderQuantity').value); const original = button.textContent;
  button.disabled = true; button.textContent = 'Đang gửi…';
  try {
    const response = await fetch('/api/products/orders', {
      method: 'POST', headers: {'Content-Type':'application/json','Idempotency-Key':crypto.randomUUID()},
      body: JSON.stringify({productId:button.dataset.productId, quantity})
    });
    const payload = await response.json();
    if (!response.ok || !payload.success) throw new Error(payload.message || 'Không thể đặt hàng.');
    feedback.className = 'alert alert-success mt-3'; feedback.textContent = 'Đơn hàng đã được ghi nhận.';
    button.textContent = 'Đã đặt';
  } catch (error) {
    feedback.className = 'alert alert-danger mt-3'; feedback.textContent = error.message || 'Không thể đặt hàng.';
    button.disabled = false; button.textContent = original;
  }
});
</script>

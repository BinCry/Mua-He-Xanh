<!-- Workshop Listing - Info & Introduction Only -->
<section class="py-5" style="margin-top: 80px; background: #f8faf9;">
    <div class="container py-4">
        
        <!-- Hero Header -->
        <div class="mb-5 text-center px-3" style="padding-top: 20px; padding-bottom: 20px;">
            <h1 class="display-4 fw-black text-dark mb-3">Workshop & Hoạt Động</h1>
            <p class="text-dark mx-auto fw-semibold" style="max-width: 600px; font-size: 0.95rem; color: #334155 !important; line-height: 1.6;">Trải nghiệm văn hóa & nghề truyền thống</p>
        </div>
        <!-- Redesigned Search & Category Filter Bar -->
        <div class="card border-0 shadow-premium rounded-4 p-4 mb-5 bg-white reveal-up">
            <form action="/workshops" method="GET" id="workshopSearchForm">
                <!-- Search bar -->
                <div class="position-relative">
                    <i class="bi bi-search position-absolute top-50 translate-middle-y text-muted" style="left: 20px;"></i>
                    <input type="text" name="q" class="form-control border-0 bg-light rounded-pill py-3 ps-5 pe-4 shadow-none" 
                        placeholder="" 
                        value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>" style="font-size: 0.95rem; height: 52px;">
                    <button type="submit" class="btn btn-primary rounded-pill fw-bold text-white btn-premium search-submit-btn position-absolute end-0 top-50 translate-middle-y me-2" style="background: var(--primary); font-size: 0.88rem;">
                        Tìm kiếm
                    </button>
                </div>

                <!-- Capsule Filters -->
                <div class="d-flex flex-nowrap gap-2 justify-content-between align-items-center w-100 explore-capsules-single-row mt-4">
                    <button type="button" onclick="setWorkshopType('')" class="btn-filter-capsule <%= !typeFilter ? 'active' : '' %>">
                        Tất cả
                    </button>
                    <button type="button" onclick="setWorkshopType('làng-nghề')" class="btn-filter-capsule <%= typeFilter === 'làng-nghề' ? 'active' : '' %>">
                        Làng nghề
                    </button>
                    <button type="button" onclick="setWorkshopType('trải-nghiệm')" class="btn-filter-capsule <%= typeFilter === 'trải-nghiệm' ? 'active' : '' %>">
                        Trải nghiệm
                    </button>
                    <button type="button" onclick="setWorkshopType('văn-hóa')" class="btn-filter-capsule <%= typeFilter === 'văn-hóa' ? 'active' : '' %>">
                        Văn hóa
                    </button>
                </div>
                <input type="hidden" name="type" id="filterTypeInput" value="<%= typeFilter || '' %>">
                
                <% if ((typeof searchQuery !== 'undefined' && searchQuery) || typeFilter) { %>
                <div class="text-center mt-3 mb-0">
                    <a href="/workshops" class="text-danger small fw-bold text-decoration-none"><i class="bi bi-x-circle me-1"></i>Xóa bộ lọc</a>
                </div>
                <% } %>
            </form>
        </div>

        <script>
        function setWorkshopType(val) {
            document.getElementById('filterTypeInput').value = val;
            document.getElementById('workshopSearchForm').submit();
        }
        </script>


        <!-- Grid -->
        <div class="row g-4">
            <% workshops.forEach((ws, i) => { %>
            <div class="col-6 col-md-6 col-lg-4 reveal-up px-2 mb-3">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100 d-flex flex-column bg-white" style="transition: transform 0.3s, box-shadow 0.3s;" onmouseover="this.style.transform='translateY(-8px)'; this.style.boxShadow='0 20px 40px rgba(0,0,0,0.12)'" onmouseout="this.style.transform=''; this.style.boxShadow=''">
                    <div class="position-relative" style="height: 220px; overflow: hidden;">
                        <img src="<%= fixImg(ws.image) %>" alt="<%= ws.title %>" class="w-100 h-100" style="object-fit: cover;">
                        <div class="position-absolute top-0 start-0 m-3" style="z-index: 5;">
                            <span class="badge-nature"><%= typeLabels[ws.type] || ws.type %></span>
                        </div>
                        <% if (ws.stats && ws.stats.avg_rating) { %>
                        <div class="position-absolute top-0 end-0 m-3" style="z-index: 5;">
                            <span class="badge-gold"><i class="bi bi-star-fill me-1"></i><%= parseFloat(ws.stats.avg_rating).toFixed(1) %></span>
                        </div>
                        <% } %>
                    </div>
                    <div class="p-4 d-flex flex-column flex-grow-1">
                        <h5 class="fw-bold mb-2"><%= ws.title %></h5>
                        <p class="text-muted line-clamp-2 mb-3" style="font-size: 0.88rem;"><%= (ws.description || '').replace(/\.+$/, '') %></p>
                        
                        <div class="mt-auto">
                            <div class="d-flex align-items-center gap-3 mb-3 flex-wrap" style="font-size: 0.8rem; color: var(--text-secondary);">
                                <span><i class="bi bi-clock me-1"></i><%= ws.duration || '2-3 giờ' %></span>
                                <span><i class="bi bi-people me-1"></i><%= ws.max_participants || 20 %> người</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center pt-2 mt-auto border-top ws-card-footer">
                                <div class="ws-price-block d-flex align-items-baseline gap-1 text-nowrap">
                                    <% if (ws.price === 0) { %>
                                        <span class="fw-black ws-price" style="color: var(--success);">Miễn phí</span>
                                    <% } else { %>
                                        <span class="fw-black ws-price" style="color: var(--primary);"><%= new Intl.NumberFormat('vi-VN').format(ws.price) %>đ</span>
                                        <span class="text-muted ws-unit">/người</span>
                                    <% } %>
                                </div>
                                <a href="/workshops/<%= ws.id %>" class="btn btn-primary-bl ws-detail-btn text-nowrap">
                                    <span class="d-none d-sm-inline">Xem chi tiết</span>
                                    <span class="d-inline d-sm-none">Chi tiết</span>
                                    <i class="bi bi-chevron-right ms-1 small"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <% }) %>
        </div>

        <% if (workshops.length === 0) { %>
        <div class="text-center py-5">
            <i class="bi bi-palette display-1" style="color: var(--border);"></i>
            <p class="text-muted mt-3">Chưa có workshop nào trong danh mục này.</p>
            <a href="/workshops" class="btn btn-premium rounded-pill px-4">Xem tất cả Xưởng trải nghiệm</a>
        </div>
        <% } %>


    </div>
</section>

<style>
    /* Capsule Filter buttons */
    .btn-filter-capsule {
        background: #ffffff;
        border: 1px solid rgba(0, 0, 0, 0.08);
        color: var(--text-secondary);
        padding: 8px 20px;
        border-radius: 50px;
        font-weight: 600;
        font-size: 0.88rem;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.25s ease;
        cursor: pointer;
    }
    .btn-filter-capsule:hover {
        background: var(--primary-50);
        border-color: var(--primary-200);
        color: var(--primary);
        transform: translateY(-1px);
    }
    .btn-filter-capsule.active {
        background: var(--primary);
        color: #ffffff;
        border-color: var(--primary);
        box-shadow: 0 4px 12px rgba(146, 39, 36, 0.15);
    }
</style>

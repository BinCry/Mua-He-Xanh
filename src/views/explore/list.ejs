<!-- Explore Catalog - Premium Redesign -->
<section class="py-4 py-md-5" style="background: #f8faf9;">
    <div class="container py-3">
        
        <!-- Hero Header -->
        <div class="mb-5 text-center px-3" style="padding-top: 20px; padding-bottom: 20px;">
            <h1 class="fw-black text-dark mb-3 font-display display-5">Khám Phá Bình Lợi</h1>
            <p class="text-dark mx-auto small mb-0 fw-semibold" style="max-width: 550px; font-size: 0.95rem; color: #334155 !important; line-height: 1.6;">Địa điểm chữa lành & trải nghiệm sinh thái</p>
        </div>

        <!-- Redesigned Search & Category Filter Bar -->
        <div class="card border-0 shadow-premium rounded-4 p-4 mb-5 bg-white reveal-up">
            <form action="/explore" method="GET" id="exploreSearchForm">
                <!-- Search bar -->
                <div class="position-relative mb-4">
                    <i class="bi bi-search position-absolute top-50 translate-middle-y text-muted" style="left: 20px;"></i>
                    <input type="text" name="q" class="form-control border-0 bg-light rounded-pill py-3 ps-5 pe-4 shadow-none" 
                        placeholder="" 
                        value="<%= searchQuery || '' %>" style="font-size: 0.95rem; height: 52px;">
                    <button type="submit" class="btn btn-primary rounded-pill fw-bold text-white btn-premium search-submit-btn position-absolute end-0 top-50 translate-middle-y me-2" style="background: var(--primary); font-size: 0.88rem;">
                        Tìm kiếm
                    </button>
                </div>

                <!-- Capsule Filters -->
                <div class="d-flex flex-nowrap gap-2 justify-content-between align-items-center w-100 explore-capsules-single-row">
                    <button type="button" onclick="setFilterType('')" class="btn-filter-capsule <%= !currentType ? 'active' : '' %>">
                        Tất cả
                    </button>
                    <button type="button" onclick="setFilterType('temple')" class="btn-filter-capsule <%= currentType === 'temple' ? 'active' : '' %>">
                        Tâm linh
                    </button>
                    <button type="button" onclick="setFilterType('park')" class="btn-filter-capsule <%= currentType === 'park' ? 'active' : '' %>">
                        Sinh thái
                    </button>
                    <button type="button" onclick="setFilterType('craft')" class="btn-filter-capsule <%= currentType === 'craft' ? 'active' : '' %>">
                        Làng nghề
                    </button>
                </div>
                <input type="hidden" name="type" id="filterTypeInput" value="<%= currentType || '' %>">
                
                <% if (searchQuery || currentType) { %>
                <div class="text-center mt-3 mb-0">
                    <a href="/explore" class="text-danger small fw-bold text-decoration-none"><i class="bi bi-x-circle me-1"></i>Xóa bộ lọc</a>
                </div>
                <% } %>
            </form>
        </div>

        <script>
        function setFilterType(val) {
            document.getElementById('filterTypeInput').value = val;
            document.getElementById('exploreSearchForm').submit();
        }
        </script>


<!-- Destination Cards Catalog -->
<div class="row g-2 g-md-4">
    <% destinations.forEach(dest => { %>
    <div class="col-4 col-md-6 col-lg-4 reveal-up px-1 px-sm-2 mb-2 mb-md-3">
        <a href="/explore/<%= dest.slug %>" class="text-decoration-none">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100 destination-card-custom" style="transition: all 0.3s ease;">
                
                <!-- Top Image Banner -->
                <div class="position-relative explore-img-wrap" style="height: 240px; overflow: hidden;">
                    <img src="<%= fixImg(dest.cover_image) %>" class="w-100 h-100" style="object-fit: cover !important; object-position: center center !important; transition: transform 0.5s;" alt="<%= dest.name %>" loading="lazy" decoding="async">
                    
                    <!-- Custom type tag -->
                    <div class="position-absolute top-0 start-0 m-1 m-md-3">
                        <span class="badge bg-success bg-opacity-90 text-white rounded-pill px-2 py-1 px-md-3 py-md-2 text-uppercase fw-bold" style="font-size: 0.55rem; backdrop-filter: blur(8px);">
                            <%= dest.type === 'temple' ? 'Tâm linh' : (dest.type === 'park' ? 'Sinh thái' : 'Làng nghề') %>
                        </span>
                    </div>
                </div>

                <!-- Card Body Details -->
                <div class="card-body p-2 p-md-4 d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="fw-black mb-1 explore-card-title"><%= dest.name %></h5>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <% }) %>
</div>

        <!-- Empty Result Fallback -->
        <% if (destinations.length === 0) { %>
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white reveal-up">
            <i class="bi bi-compass-fill display-1 text-muted opacity-25 mb-3 d-block"></i>
            <h4 class="fw-bold text-dark">Không tìm thấy địa điểm nào phù hợp</h4>
            <p class="text-muted small mb-4">Vui lòng thử lại với từ khóa khác hoặc xóa bớt các tiêu chí lọc.</p>
            <a href="/explore" class="btn btn-primary-bl rounded-pill px-4 py-2 fw-bold small">XÓA BỘ LỌC & XEM TẤT CẢ</a>
        </div>
        <% } %>

        <!-- Pagination Section -->
        <% if (destinations.length > 0) { %>
        <div class="mt-5 pt-4 border-top">
            <% 
            let queryParts = [];
            if (currentType) queryParts.push(`type=${currentType}`);
            if (searchQuery) queryParts.push(`q=${encodeURIComponent(searchQuery)}`);
            let paginationUrl = '/explore' + (queryParts.length > 0 ? '?' + queryParts.join('&') : '');
            %>
            <%- include('../partials/pagination', { pagination: pagination, paginationUrl: paginationUrl }) %>
        </div>
        <% } %>
    </div>
</section>

<style>
    .destination-card-custom:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 30px rgba(0,0,0,0.08) !important;
    }
    .destination-card-custom:hover img {
        transform: scale(1.06);
    }
    
    /* Capsule Filter buttons */
    .btn-filter-capsule {
        background: #ffffff;
        border: 1px solid rgba(0, 0, 0, 0.08);
        color: var(--text-secondary);
        padding: 8px 20px;
        border-radius: 50px;
        font-weight: 600;
        font-size: 0.88rem;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.25s ease;
        cursor: pointer;
    }
    .btn-filter-capsule:hover {
        background: var(--primary-50);
        border-color: var(--primary-200);
        color: var(--primary);
        transform: translateY(-1px);
    }
    .btn-filter-capsule.active {
        background: var(--primary);
        color: #ffffff;
        border-color: var(--primary);
        box-shadow: 0 4px 12px rgba(146, 39, 36, 0.15);
    }
    .explore-card-title {
        color: #222222;
        font-size: 1.15rem;
        font-weight: 800;
        font-family: 'Inter', sans-serif;
    }
    @media (max-width: 767.98px) {
        .destination-card-custom {
            height: 140px !important;
            border-radius: 12px !important;
            position: relative !important;
            overflow: hidden !important;
        }
        .explore-img-wrap {
            width: 100% !important;
            height: 100% !important;
            position: absolute !important;
            top: 0 !important;
            left: 0 !important;
        }
        .explore-img-wrap img {
            width: 100% !important;
            height: 100% !important;
            object-fit: fill !important;
            object-position: center center !important;
            border-radius: 12px !important;
        }
        .explore-img-wrap::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(to top, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.15) 60%, transparent 100%);
            z-index: 2;
        }
        .destination-card-custom .card-body {
            position: absolute !important;
            bottom: 0 !important;
            left: 0 !important;
            width: 100% !important;
            padding: 4px 5px !important;
            z-index: 5 !important;
        }
        .explore-card-title {
            color: #ffffff !important;
            font-size: 0.7rem !important;
            font-weight: 700 !important;
            line-height: 1.25 !important;
            margin-bottom: 0 !important;
            text-shadow: 0 1px 3px rgba(0,0,0,0.95) !important;
            white-space: normal !important;
            word-break: normal !important;
            overflow-wrap: break-word !important;
            display: -webkit-box !important;
            -webkit-line-clamp: 2 !important;
            -webkit-box-orient: vertical !important;
            overflow: hidden !important;
            text-overflow: ellipsis !important;
            text-align: center !important;
        }
        .destination-card-custom .badge {
            font-size: 0.48rem !important;
            padding: 2px 5px !important;
            border-radius: 4px !important;
            letter-spacing: 0 !important;
        }
    }
</style>

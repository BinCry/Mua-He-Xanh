<section class="py-4 py-md-5" style="background: #f8faf9;">
    <div class="container py-2">
        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/explore" class="text-decoration-none text-muted">Khám phá</a></li>
                <li class="breadcrumb-item active text-truncate" aria-current="page" style="max-width: 250px;"><%= dest.name %></li>
            </ol>
        </nav>

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4 bg-white reveal-up">
            <!-- Full Width Hero Cover Banner -->
            <div class="w-100 position-relative overflow-hidden cursor-pointer" style="max-height: 480px; min-height: 280px; background: #0f172a;" onclick="openImageLightbox(this.querySelector('img').src)">
                <img src="<%= fixImg(dest.cover_image, '/images/hero-3.png') %>" class="w-100 h-100 object-fit-cover" style="max-height: 480px;" alt="<%= dest.name %>">
            </div>
            
            <div class="p-4 p-md-5">
                <div class="mb-3 pb-3 border-bottom">
                    <% 
                        const typeNames = { 
                            nature: 'THIÊN NHIÊN', 
                            temple: 'TÂM LINH', 
                            culture: 'VĂN HÓA', 
                            craft: 'LÀNG NGHỀ', 
                            cuisine: 'ẨM THỰC', 
                            eco: 'SINH THÁI' 
                        }; 
                        const displayType = typeNames[(dest.type || '').toLowerCase()] || (dest.type || '').toUpperCase();
                    %>
                    <span class="badge bg-primary text-white mb-2 px-3 py-1.5 rounded-pill fw-bold text-uppercase" style="font-size: 0.75rem; background: var(--primary) !important;">
                        <i class="bi bi-tag-fill me-1"></i> <%= displayType %>
                    </span>
                    <h1 class="display-6 fw-black text-dark mb-3 font-display"><%= dest.name %></h1>
                    <div class="lead opacity-90 d-flex align-items-start gap-2 mb-4 text-muted" style="font-size: 1.05rem;">
                        <i class="bi bi-geo-alt-fill text-danger mt-1 flex-shrink-0"></i> 
                        <span class="dest-short-desc-text"><%= (dest.short_desc || '').replace(/\.+$/, '') %></span>
                    </div>

                    <!-- Interactive Actions (Spacious 4 Buttons) -->
                    <div class="d-flex flex-wrap align-items-center gap-3 gap-md-4 my-3 dest-hero-actions">
                        <button class="btn btn-outline-danger rounded-pill px-4 py-2.5 fw-bold shadow-2xs d-flex align-items-center gap-2 <%= hasLiked ? 'active bg-danger text-white' : '' %>" onclick="handleLikeToggle(this, '<%= dest.id %>')">
                            <i class="bi <%= hasLiked ? 'bi-heart-fill' : 'bi-heart' %>"></i> Thích (<span id="likes-count"><%= totalLikes %></span>)
                        </button>
                        <button class="btn btn-outline-primary rounded-pill px-4 py-2.5 fw-bold shadow-2xs d-flex align-items-center gap-2 <%= hasSaved ? 'active bg-primary text-white' : '' %>" onclick="handleSaveToggle(this, '<%= dest.id %>')">
                            <i class="bi <%= hasSaved ? 'bi-bookmark-fill' : 'bi-bookmark' %>"></i> <%= hasSaved ? 'Đã lưu' : 'Lưu điểm đến' %>
                        </button>
                        <button class="btn btn-outline-success rounded-pill px-4 py-2.5 fw-bold shadow-2xs d-flex align-items-center gap-2" onclick="shareDestination('<%= dest.name %>', '<%= baseUrl %>/explore/<%= dest.slug %>')">
                            <i class="bi bi-share-fill"></i> Chia sẻ
                        </button>
                        <button class="btn btn-primary rounded-pill px-4 py-2.5 fw-bold shadow-sm d-flex align-items-center gap-2 text-white" style="background: var(--primary); border: none;" onclick="addToJourney('<%= dest.id %>')">
                            <i class="bi bi-signpost-split-fill"></i> Thêm vào hành trình
                        </button>
                        <% if (user && (user.role === 'manager' || user.role === 'admin') && user.managed_destination_id === dest.id) { %>
                            <a href="/manager" class="btn btn-outline-secondary rounded-pill px-3 py-2 fw-bold">
                                <i class="bi bi-pencil-square me-1"></i> Quản lý
                            </a>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
    </div>

    <!-- Main Content & Sidebar Grid -->
    <div class="row g-4 mb-5">
        <!-- Main Content: Storytelling & Gallery -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-4 mb-4 bg-white">
                <h3 class="fw-black text-danger mb-3 border-bottom pb-2 font-display">
                    <i class="bi bi-book-half me-2"></i>Câu chuyện Văn hóa
                </h3>
                <div class="story-text-rich" style="font-size: 1.05rem; line-height: 1.85; color: #334155; text-align: justify;">
                    <%- dest.story.replace(/\n/g, '<br><br>') %>
                </div>

                <!-- Highlight Box -->
                <% if (dest.highlight) { %>
                <div class="highlight-quote p-4 rounded-4 mt-4 position-relative overflow-hidden bg-light border-start border-4 border-danger">
                    <i class="bi bi-quote display-2 position-absolute top-0 end-0 opacity-10 m-2 text-danger"></i>
                    <h5 class="mb-2 fw-bold text-dark"><i class="bi bi-stars text-warning me-2"></i> Trải nghiệm tinh hoa</h5>
                    <p class="mb-0 fst-italic lead text-muted" style="font-size: 0.98rem; line-height: 1.6;"><%= dest.highlight.replace(/\.+$/, '') %></p>
                </div>
                <% } %>
            </div>

            <!-- Image Gallery -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h4 class="fw-bold mb-1 text-dark"><i class="bi bi-camera-fill text-danger me-2"></i>Góc nhìn Nghệ thuật</h4>
                        <p class="text-muted small mb-0">Khoảnh khắc được chụp thực tế tại điểm bởi du khách</p>
                    </div>
                </div>
                
                <div class="row g-3">
                    <% if (galleryImages && galleryImages.length > 0) { %>
                        <div class="col-md-8">
                            <div class="rounded-4 overflow-hidden shadow-sm ratio ratio-16x9 position-relative custom-gallery-card cursor-pointer" onclick="openImageLightbox(this.querySelector('img').src)">
                                <img src="<%= fixImg(galleryImages[0]) %>" class="w-100 h-100 object-fit-cover" alt="Artistic Perspective 1">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="d-flex flex-column gap-2 h-100">
                                <% if (galleryImages[1]) { %>
                                <div class="rounded-4 overflow-hidden shadow-sm ratio ratio-4x3 position-relative custom-gallery-card flex-grow-1 cursor-pointer" onclick="openImageLightbox(this.querySelector('img').src)">
                                    <img src="<%= fixImg(galleryImages[1]) %>" class="w-100 h-100 object-fit-cover" alt="Artistic Perspective 2">
                                </div>
                                <% } %>
                                <% if (galleryImages[2]) { %>
                                <div class="rounded-4 overflow-hidden shadow-sm ratio ratio-4x3 position-relative custom-gallery-card flex-grow-1 cursor-pointer" onclick="openImageLightbox(this.querySelector('img').src)">
                                    <img src="<%= fixImg(galleryImages[2]) %>" class="w-100 h-100 object-fit-cover" alt="Artistic Perspective 3">
                                </div>
                                <% } %>
                            </div>
                        </div>
                    <% } else { %>
                        <div class="col-12 text-center py-3 rounded-3 bg-light border border-dashed text-muted">
                            <span class="x-small"><i class="bi bi-info-circle me-1"></i> Chưa có ảnh đóng góp góc nhìn nghệ thuật. Hãy là người đầu tiên chia sẻ ảnh check-in!</span>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Sidebar: Actions & Information -->
        <div class="col-lg-4">
            <div class="sticky-top" style="top: 100px; z-index: 10;">
                <!-- Main Info Card -->
                <div class="card-bl p-4 mb-4 shadow-sm border-0 rounded-4 bg-white">
                    <h6 class="text-primary fw-black mb-4 text-uppercase tracking-widest border-bottom pb-3 d-flex align-items-center justify-content-between">
                        <span><i class="bi bi-info-circle-fill me-2 text-primary"></i> Thông tin hữu ích</span>
                        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1 x-small fw-bold">+<%= dest.points %> ĐIỂM</span>
                    </h6>
                    
                    <div class="d-flex align-items-center gap-3 mb-3 p-2 rounded-3 hover-bg-light">
                        <div class="bg-primary-subtle text-primary p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; flex-shrink: 0;">
                            <i class="bi bi-clock-fill fs-5"></i>
                        </div>
                        <div>
                            <div class="x-small text-muted fw-bold text-uppercase">Giờ mở cửa</div>
                            <div class="fw-bold text-dark"><%= dest.open_hours || 'Cả ngày' %></div>
                        </div>
                    </div>
                    
                    <div class="d-flex align-items-center gap-3 mb-3 p-2 rounded-3 hover-bg-light">
                        <div class="bg-success-subtle text-success p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; flex-shrink: 0;">
                            <i class="bi bi-ticket-perforated-fill fs-5"></i>
                        </div>
                        <div>
                            <div class="x-small text-muted fw-bold text-uppercase">Chi phí dự kiến</div>
                            <div class="fw-bold text-dark"><%= dest.cost || 'Miễn phí' %></div>
                        </div>
                    </div>
                    
                    <div class="d-flex align-items-center gap-3 mb-3 p-2 rounded-3 hover-bg-light">
                        <div class="bg-warning-subtle text-warning p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; flex-shrink: 0;">
                            <i class="bi bi-sun-fill fs-5"></i>
                        </div>
                        <div>
                            <div class="x-small text-muted fw-bold text-uppercase">Thời điểm đẹp nhất</div>
                            <div class="fw-bold text-dark"><%= dest.best_time || 'Sáng sớm / Hoàng hôn' %></div>
                        </div>
                    </div>
                    
                    <div class="bg-light p-3 rounded-4 mt-3 border-start border-4 border-primary">
                        <div class="small fw-bold text-dark mb-1 d-flex align-items-center gap-1">
                            <i class="bi bi-lightbulb-fill text-warning"></i> Mẹo Check-in
                        </div>
                        <p class="x-small text-muted mb-0" style="line-height: 1.6;"><%= dest.checkin_tip || 'Hãy mang trang phục thoải mái để dễ dàng trải nghiệm.' %></p>
                    </div>
                </div>

                <!-- Action Card: Check-in & Navigation -->
                <div class="card-bl p-4 mb-4 shadow-lg border-0 rounded-4 text-white" style="background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);">
                    <div class="text-center mb-3">
                        <div class="bg-white bg-opacity-25 backdrop-blur-md text-white d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill x-small fw-bold mb-2">
                            <i class="bi bi-star-fill text-warning"></i> THƯỞNG +<%= dest.points %> ĐIỂM
                        </div>
                        <h5 class="fw-black text-white mb-1">Xác thực Check-in</h5>
                        <p class="x-small text-white-50 mb-0">Quét mã QR tại điểm để nhận ngay huy hiệu</p>
                    </div>
                    
                    <div class="d-grid gap-2">
                        <a href="<%= baseUrl %>/checkin?slug=<%= dest.slug %>" class="btn btn-warning btn-lg rounded-pill fw-bold text-dark shadow-sm d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-qr-code-scan"></i> QUÉT QR NGAY
                        </a>
                        <a href="https://www.google.com/maps/dir/?api=1&destination=<%= dest.lat %>,<%= dest.lng %>" target="_blank" class="btn btn-light border-0 btn-lg rounded-pill fw-bold text-dark shadow-sm d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-cursor-fill text-warning"></i> Chỉ đường Google Maps
                        </a>
                        <button class="btn btn-outline-light rounded-pill fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2 mt-1" data-bs-toggle="modal" data-bs-target="#chatModal">
                            <i class="bi bi-chat-dots-fill text-warning"></i> Nhắn với Quản lý
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Video Modal -->
<div class="modal fade" id="videoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content bg-transparent border-0">
            <div class="modal-header border-0 pb-0 justify-content-end">
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div class="ratio ratio-16x9 rounded-4 overflow-hidden shadow-lg bg-black d-flex align-items-center justify-content-center">
                    <div class="text-white text-center">
                        <i class="bi bi-camera-video fs-1 mb-3"></i>
                        <h5>Đang tải Video Cinematic...</h5>
                        <p class="small text-white-50">Tích hợp Youtube/Vimeo API tại đây</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Chat Modal (Same as before but with minor UI polish) -->
<div class="modal fade" id="chatModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 rounded-4 shadow-premium overflow-hidden h-100">
            <div class="modal-header bg-primary text-white border-0 p-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-white rounded-circle p-2 d-flex align-items-center justify-content-center text-primary" style="width: 40px; height: 40px;">
                        <i class="bi bi-headset fs-5"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-black mb-0">Hỗ trợ Trực tuyến</h5>
                        <small class="opacity-75">Quản lý <%= dest.name %></small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3 bg-light">
                <div id="chat-history" class="mb-2 overflow-auto custom-modal-chat-body p-2" style="height: 380px;">
                    <% if (messages && messages.length > 0) { %>
                        <% messages.forEach(msg => { %>
                            <div class="mb-3 d-flex <%= msg.is_mine ? 'justify-content-end' : 'justify-content-start' %>">
                                <div class="p-3 rounded-4 small shadow-2xs <%= msg.is_mine ? 'text-white' : 'bg-white text-dark border' %>" style="max-width: 80%; <%= msg.is_mine ? 'background-color: var(--primary) !important;' : '' %>">
                                    <%= msg.message %>
                                    <div class="x-small opacity-50 mt-1 text-end"><%= msg.created_at ? new Date(msg.created_at).toLocaleTimeString('vi-VN', {hour: '2-digit', minute:'2-digit'}) : '' %></div>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="text-center mb-4">
                            <span class="badge bg-secondary-subtle text-muted rounded-pill px-3 py-1.5 x-small">Bắt đầu trò chuyện hỗ trợ</span>
                        </div>
                        <div class="d-flex justify-content-start mb-3">
                            <div class="p-3 rounded-4 small shadow-2xs bg-white text-dark border" style="max-width: 85%;">
                                <strong>👋 Chào bạn!</strong><br>
                                Tôi là quản lý địa điểm <%= dest.name %>. Bạn cần hỗ trợ thông tin gì vui lòng gửi tin nhắn tại đây nhé!
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
            <div class="modal-footer border-0 bg-white p-3">
                <div class="input-group">
                    <input type="text" id="chat-message" class="form-control border-0 bg-light rounded-pill ps-4 py-3" placeholder="Nhập tin nhắn..." onkeypress="if(event.key === 'Enter') sendChatMessage('<%= dest.id %>')">
                    <button class="btn btn-primary-bl rounded-circle ms-2 shadow-sm d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;" onclick="sendChatMessage('<%= dest.id %>')">
                        <i class="bi bi-send-fill"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
// Premium Dynamic Toast Notifications
function showToast(message, type = 'success') {
    const toast = document.createElement('div');
    toast.className = `position-fixed bottom-0 end-0 m-4 p-3 rounded-4 text-white shadow-premium animate__animated animate__fadeInUp bg-${type}`;
    toast.style.zIndex = '9999';
    toast.innerHTML = `<i class="bi bi-info-circle-fill me-2"></i> ${message}`;
    document.body.appendChild(toast);
    setTimeout(() => {
        toast.classList.replace('animate__fadeInUp', 'animate__fadeOutDown');
        setTimeout(() => toast.remove(), 500);
    }, 3000);
}

function handleLikeToggle(btn, destinationId) {
    axios.post(window.APP_CONFIG.apiUrl + '/destination/like', { destinationId })
        .then(res => {
            if (res.data.success) {
                const icon = btn.querySelector('i');
                const countSpan = document.getElementById('likes-count');
                countSpan.innerText = res.data.likesCount;
                if (res.data.liked) {
                    icon.className = 'bi bi-heart-fill text-danger';
                    btn.classList.add('text-danger');
                    showToast('Đã thêm vào danh sách yêu thích!', 'danger');
                } else {
                    icon.className = 'bi bi-heart';
                    btn.classList.remove('text-danger');
                    showToast('Đã bỏ yêu thích.', 'secondary');
                }
            }
        })
        .catch(err => {
            if (err.response?.status === 401) {
                showToast('Vui lòng đăng nhập để sử dụng tính năng này!', 'warning');
                setTimeout(() => { window.location.href = '/auth/login'; }, 1500);
            } else {
                showToast('Lỗi: ' + (err.response?.data?.message || err.message), 'warning');
            }
        });
}

function handleSaveToggle(btn, destinationId) {
    axios.post(window.APP_CONFIG.apiUrl + '/destination/save', { destinationId })
        .then(res => {
            if (res.data.success) {
                const icon = btn.querySelector('i');
                const textNode = btn.childNodes[btn.childNodes.length - 1];
                if (res.data.saved) {
                    icon.className = 'bi bi-bookmark-fill text-primary';
                    btn.classList.add('text-primary');
                    textNode.textContent = ' Đã lưu';
                    showToast('Đã lưu địa điểm thành công!', 'primary');
                } else {
                    icon.className = 'bi bi-bookmark';
                    btn.classList.remove('text-primary');
                    textNode.textContent = ' Lưu điểm đến';
                    showToast('Đã xóa khỏi danh sách lưu.', 'secondary');
                }
            }
        })
        .catch(err => {
            if (err.response?.status === 401) {
                showToast('Vui lòng đăng nhập để sử dụng tính năng này!', 'warning');
                setTimeout(() => { window.location.href = '/auth/login'; }, 1500);
            } else {
                showToast('Lỗi: ' + (err.response?.data?.message || err.message), 'warning');
            }
        });
}

function shareDestination(name, rawUrl) {
    const canonicalUrl = 'https://dulichbinhloi.com/explore/<%= dest.slug %>';
    
    // Native share (mobile - like TikTok share)
    if (navigator.share) {
        navigator.share({
            title: name + ' - Bình Lợi Healing',
            text: 'Khám phá ' + name + ' tại Bình Lợi Healing!',
            url: canonicalUrl
        }).catch(() => {});
    } else {
        // Desktop fallback: copy link
        if (navigator.clipboard) {
            navigator.clipboard.writeText(canonicalUrl)
                .then(() => {
                    showToast('Đã sao chép liên kết dulichbinhloi.com', 'success');
                })
                .catch(() => {
                    showToast('Đã sao chép liên kết dulichbinhloi.com', 'success');
                });
        } else {
            // Final fallback for older browsers
            const textarea = document.createElement('textarea');
            textarea.value = canonicalUrl;
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand('copy');
            textarea.remove();
            showToast('Đã sao chép liên kết dulichbinhloi.com', 'success');
        }
    }
}

function addToJourney(destinationId) {
    axios.post(window.APP_CONFIG.apiUrl + '/destination/add-to-journey', { destinationId })
        .then(res => {
            if (res.data.success) {
                showToast('Đã thêm vào hành trình! <a href="/hanh-trinh-cua-toi" class="text-white fw-bold text-decoration-underline ms-2">Xem ngay</a>', 'success');
            }
        })
        .catch(err => {
            if (err.response?.status === 401) {
                showToast('Vui lòng đăng nhập để sử dụng tính năng này!', 'warning');
                setTimeout(() => { window.location.href = '/auth/login'; }, 1500);
            } else {
                showToast('Lỗi: ' + (err.response?.data?.message || err.message), 'warning');
            }
        });
}

function startStorytelling() {
    alert('Đang kết nối thư viện Audio... Chào mừng bạn đến với <%= dest.name %>. Hãy đeo tai nghe để trải nghiệm không gian âm thanh thực tế!');
}

// Live Chat History Polling & Rendering
let lastMessagesCount = 0;
function pollMessages(destinationId) {
    axios.get(window.APP_CONFIG.apiUrl + '/get-messages?destinationId=' + destinationId)
        .then(res => {
            if (res.data.success && res.data.data) {
                const messages = res.data.data;
                if (messages.length !== lastMessagesCount) {
                    lastMessagesCount = messages.length;
                    renderChatHistory(messages);
                }
            }
        })
        .catch(err => console.error("Polling messages error:", err));
}

function renderChatHistory(messages) {
    const chatHistory = document.getElementById('chat-history');
    if (!chatHistory) return;

    let html = '';
    if (messages && messages.length > 0) {
        messages.forEach(msg => {
            const isMe = msg.is_mine || false;
            const timeStr = msg.created_at ? new Date(msg.created_at).toLocaleTimeString('vi-VN', {hour: '2-digit', minute:'2-digit'}) : '';
            
            html += `
                <div class="mb-3 d-flex ${isMe ? 'justify-content-end' : 'justify-content-start'}">
                    <div class="p-3 rounded-4 small shadow-2xs ${isMe ? 'text-white' : 'bg-white text-dark border'}" style="max-width: 80%; ${isMe ? 'background-color: var(--primary) !important;' : ''}">
                        ${escapeHtml(msg.message)}
                        <div class="x-small opacity-50 mt-1 text-end">${timeStr}</div>
                    </div>
                </div>
            `;
        });
    } else {
        html = `
            <div class="text-center mb-4">
                <span class="badge bg-secondary-subtle text-muted rounded-pill px-3 py-1.5 x-small">Bắt đầu trò chuyện hỗ trợ</span>
            </div>
            <div class="d-flex justify-content-start mb-3">
                <div class="p-3 rounded-4 small shadow-2xs bg-white text-dark border" style="max-width: 85%;">
                    <strong>👋 Chào bạn!</strong><br>
                    Tôi là quản lý địa điểm <%= dest.name %>. Bạn cần hỗ trợ thông tin gì vui lòng gửi tin nhắn tại đây nhé!
                </div>
            </div>
        `;
    }
    chatHistory.innerHTML = html;
    chatHistory.scrollTop = chatHistory.scrollHeight;
}

function escapeHtml(str) {
    if (!str) return '';
    const div = document.createElement('div');
    div.innerText = str;
    return div.innerHTML;
}

function sendChatMessage(destinationId) {
    const input = document.getElementById('chat-message');
    const message = input.value.trim();
    if (!message) return;

    input.value = ''; // Clear input for snappy UI

    axios.post(window.APP_CONFIG.apiUrl + '/send-message', {
        destinationId,
        message
    }).then(res => {
        if (res.data.success) {
            pollMessages(destinationId);
        }
    }).catch(err => {
        showToast('Lỗi gửi tin nhắn: ' + (err.response?.data?.message || err.message), 'warning');
    });
}

// DOM Setup
document.addEventListener('DOMContentLoaded', function() {
    const chatHistory = document.getElementById('chat-history');
    if (chatHistory) {
        chatHistory.scrollTop = chatHistory.scrollHeight;
    }
    
    // Start Chat Polling every 5 seconds if modal is active or page is open
    const destId = '<%= dest.id %>';
    pollMessages(destId);
    setInterval(() => {
        pollMessages(destId);
    }, 5000);
});
</script>


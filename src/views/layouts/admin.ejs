<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !=='undefined' ? title + " | " + (user.role === 'manager' ? "Quản lý Panel" : "Admin Panel") : (user.role === 'manager' ? "Quản lý Panel" : "Admin Panel") %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Favicon & Brand Icons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/png" sizes="48x48" href="/images/favicon-48x48.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/images/favicon-192x192.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
    <style>
        :root {
            --sb-width: 260px;
            <% if (user.role === 'manager') { %>
                /* Manager Panel: Healing Green Brand Theme */
                --admin-bg: #f3f7f5;
                --admin-surface: #ffffff;
                --admin-border: rgba(30,90,62,0.15);
                --admin-text: #0b1c12;
                --admin-muted: #496354;
                --admin-accent: #d97706;
                --admin-primary: #1e5a3e;
            <% } else { %>
                /* Admin Panel: Maroon Red Brand Theme */
                --admin-bg: #fcf7f7;
                --admin-surface: #ffffff;
                --admin-border: rgba(146,39,36,0.15);
                --admin-text: #1c0b0a;
                --admin-muted: #634948;
                --admin-accent: #d97706;
                --admin-primary: #922724;
            <% } %>
        }
        * { box-sizing: border-box; font-family: 'Inter', sans-serif !important; }
        body { background: var(--admin-bg); color: var(--admin-text); margin: 0; }
        .admin-wrap { display: flex; min-height: 100vh; }
        
        /* Sidebar */
        .admin-sb { width: var(--sb-width); background: var(--admin-surface); border-right: 1px solid var(--admin-border); display: flex; flex-direction: column; position: fixed; top: 0; left: 0; height: 100vh; z-index: 100; }
        .sb-brand { padding: 24px 20px; border-bottom: 1px solid var(--admin-border); }
        .sb-brand-title { display: flex; align-items: center; gap: 10px; }
        .sb-brand-mark { width: 32px; height: 32px; border: 1px solid var(--admin-border); border-radius: 9px; background: var(--admin-bg); color: var(--admin-primary); display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; }
        .sb-brand-mark i { font-size: 1rem; line-height: 1; }
        .sb-brand h5 { font-family: 'Inter', sans-serif; font-weight: 800; font-size: 1.15rem; color: var(--admin-primary); margin: 0; letter-spacing: 1px; }
        .sb-brand small { color: var(--admin-muted); font-size: 0.72rem; display: block; margin-top: 6px; }
        .sb-nav { padding: 16px 12px; flex-grow: 1; overflow-y: auto; }
        .sb-label { font-size: 0.65rem; font-weight: 700; color: var(--admin-muted); text-transform: uppercase; letter-spacing: 2px; padding: 8px 12px; margin-top: 16px; }
        .sb-link { display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 10px; color: var(--admin-muted); text-decoration: none; font-size: 0.85rem; font-weight: 500; transition: all 0.2s; margin-bottom: 2px; }
        .sb-link:hover { background: rgba(0,0,0,0.04); color: var(--admin-text); }
        .sb-link.active { background: var(--admin-primary); color: #fff; font-weight: 600; }
        .sb-link i { font-size: 1.1rem; width: 20px; text-align: center; }
        .sb-footer { padding: 16px; border-top: 1px solid var(--admin-border); }
        
        /* Main content */
        .admin-main { margin-left: var(--sb-width); flex-grow: 1; min-width: 0; padding: 32px; min-height: 100vh; }
        
        /* Stat cards */
        .stat-card { background: var(--admin-surface); border: 1px solid var(--admin-border); border-radius: 16px; padding: 20px; }
        .stat-card .stat-icon { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; }
        .stat-card h3 { font-family: 'Inter', sans-serif; font-weight: 800; font-size: 1.8rem; margin: 0; }
        .stat-card small { color: var(--admin-muted); font-size: 0.78rem; }
        
        /* Tables - Mobile Horizontal Scrollable */
        .admin-table { background: var(--admin-surface); border: 1px solid var(--admin-border); border-radius: 16px; overflow-x: auto !important; -webkit-overflow-scrolling: touch; }
        .admin-table table { min-width: 650px; margin-bottom: 0; }
        .admin-table th { background: rgba(0,0,0,0.02); color: var(--admin-muted); font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; padding: 14px 16px; border-bottom: 1px solid var(--admin-border); white-space: nowrap; }
        .admin-table td { padding: 12px 16px; border-bottom: 1px solid var(--admin-border); font-size: 0.88rem; vertical-align: middle; }
        .admin-table tr:last-child td { border-bottom: none; }
        .admin-table tr:hover td { background: rgba(0,0,0,0.015); }
        
        /* Charts */
        .chart-card { background: var(--admin-surface); border: 1px solid var(--admin-border); border-radius: 16px; padding: 24px; }
        
        /* Badges */
        .role-badge { padding: 4px 10px; border-radius: 20px; font-size: 0.72rem; font-weight: 600; }
        .role-admin { background: rgba(239,68,68,0.15); color: #ef4444; }
        .role-manager { background: rgba(240,165,0,0.15); color: #f0a500; }
        .role-user { background: rgba(59,130,246,0.15); color: #3b82f6; }
        
        .admin-input { background: #ffffff; border: 1px solid #cbd5e1; color: var(--admin-text); border-radius: 10px; padding: 10px 14px; }
        .admin-input:focus { background: #ffffff; border-color: var(--admin-primary); color: var(--admin-text); box-shadow: 0 0 0 3px rgba(26, 77, 46, 0.1); outline: none; }
        
        .btn-admin-outline {
            border: 1.5px solid var(--admin-primary) !important;
            color: var(--admin-primary) !important;
            background: transparent !important;
            font-weight: 600;
            transition: all 0.2s;
        }
        .btn-admin-outline:hover {
            background: var(--admin-primary) !important;
            color: #ffffff !important;
        }

        /* Mobile Topbar & Hamburger Navigation */
        .admin-mobile-topbar {
            background: var(--admin-surface);
            border-bottom: 1px solid var(--admin-border);
            padding: 10px 16px;
            margin: -16px -16px 20px -16px;
            position: sticky;
            top: 0;
            z-index: 990;
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        }
        .btn-admin-hamburger {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: var(--admin-bg);
            border: 1.5px solid var(--admin-border);
            color: var(--admin-primary);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
            cursor: pointer;
            padding: 0;
        }
        .btn-admin-hamburger:hover, .btn-admin-hamburger:active {
            background: var(--admin-primary);
            color: #ffffff;
            border-color: var(--admin-primary);
        }

        /* Mobile Offcanvas Drawer (From Right) */
        .admin-offcanvas {
            width: 310px !important;
            max-width: 85vw;
            background: var(--admin-surface) !important;
            color: var(--admin-text);
            border-left: 1px solid var(--admin-border) !important;
        }
        .admin-offcanvas .offcanvas-header {
            border-bottom: 1px solid var(--admin-border);
            padding: 16px 20px;
        }
        .admin-offcanvas .offcanvas-body {
            padding: 16px;
            display: flex;
            flex-direction: column;
        }
        
        @media (max-width: 991px) {
            .admin-sb { display: none !important; }
            .admin-main { 
                margin-left: 0 !important; 
                padding: 16px !important; 
                padding-top: 12px !important;
                width: 100% !important;
                overflow-x: hidden;
            }
            
            /* Responsive action header buttons */
            .admin-main .d-flex.justify-content-between.align-items-center.mb-4 {
                flex-direction: column !important;
                align-items: stretch !important;
                gap: 12px !important;
            }
            .admin-main .d-flex.justify-content-between.align-items-center.mb-4 > button,
            .admin-main .d-flex.justify-content-between.align-items-center.mb-4 > a {
                width: 100% !important;
                text-align: center !important;
                justify-content: center !important;
            }
            
            /* Responsive search forms */
            .admin-main form.d-flex {
                flex-wrap: wrap !important;
                gap: 8px !important;
            }
            .admin-main form.d-flex input {
                flex: 1 1 100% !important;
                max-width: 100% !important;
            }
            .admin-main form.d-flex button,
            .admin-main form.d-flex a {
                flex: 1 1 auto !important;
            }

            /* Stat cards */
            .stat-card {
                padding: 14px !important;
            }
            .stat-card h3 {
                font-size: 1.45rem !important;
            }
        }
    </style>
</head>
<body>
    <div class="admin-wrap">
        <!-- Sidebar -->
        <aside class="admin-sb">
            <div class="sb-brand">
                <div class="sb-brand-title">
                    <span class="sb-brand-mark" aria-hidden="true">
                        <i class="bi <%= user.role === 'manager' ? 'bi-geo-alt' : 'bi-buildings' %>"></i>
                    </span>
                <% if (user.role === 'manager') { %>
                    <h5>QUẢN LÝ PANEL</h5>
                </div>
                    <small>Hệ thống Quản lý Địa điểm</small>
                <% } else { %>
                    <h5>BÌNH LỢI ADMIN</h5>
                </div>
                    <small>Hệ thống Quản trị cấp Xã</small>
                <% } %>
            </div>
            <nav class="sb-nav">
                <% if (user.role === 'admin') { %>
                    <div class="sb-label">Tổng quan</div>
                    <a href="/admin" class="sb-link <%= typeof adminPage !== 'undefined' && adminPage === 'dashboard' ? 'active' : '' %>">
                        <i class="bi bi-grid-1x2-fill"></i> Dashboard
                    </a>
                    
                    <div class="sb-label">Quản lý</div>
                    <a href="/admin/users" class="sb-link <%= typeof adminPage !== 'undefined' && adminPage === 'users' ? 'active' : '' %>">
                        <i class="bi bi-people-fill"></i> Người dùng
                    </a>
                    <a href="/admin/destinations" class="sb-link <%= typeof adminPage !== 'undefined' && adminPage === 'destinations' ? 'active' : '' %>">
                        <i class="bi bi-geo-alt-fill"></i> Địa điểm
                    </a>
                    <a href="/admin/shops" class="sb-link <%= typeof adminPage !== 'undefined' && adminPage === 'shops' ? 'active' : '' %>">
                        <i class="bi bi-shop"></i> Shop
                    </a>
                    <a href="/admin/reviews" class="sb-link <%= typeof adminPage !== 'undefined' && adminPage === 'reviews' ? 'active' : '' %>">
                        <i class="bi bi-chat-heart-fill"></i> Cộng đồng
                    </a>
                    <a href="/admin/chat" class="sb-link <%= typeof adminPage !== 'undefined' && adminPage === 'chat' ? 'active' : '' %>">
                        <i class="bi bi-chat-dots-fill"></i> Hộp thư Hỗ trợ
                    </a>
                    <a href="/admin/events" class="sb-link <%= typeof adminPage !== 'undefined' && adminPage === 'events' ? 'active' : '' %>">
                        <i class="bi bi-calendar-event-fill"></i> Sự kiện
                    </a>
                    <a href="/admin/journey-templates" class="sb-link <%= typeof adminPage !== 'undefined' && adminPage === 'journey-templates' ? 'active' : '' %>">
                        <i class="bi bi-signpost-2-fill"></i> Tour
                    </a>
                    
                    <div class="sb-label">Cài đặt</div>
                    <a href="/admin/settings" class="sb-link <%= typeof adminPage !== 'undefined' && adminPage === 'settings' ? 'active' : '' %>">
                        <i class="bi bi-gear-fill"></i> Cài đặt Web
                    </a>
                    <a href="/admin/posters" class="sb-link <%= typeof adminPage !== 'undefined' && adminPage === 'posters' ? 'active' : '' %>">
                        <i class="bi bi-images"></i> Poster Hero Trang Chủ
                    </a>
                <% } else if (user.role === 'manager') { %>
                    <div class="sb-label">QUẢN LÝ ĐỊA ĐIỂM</div>
                    <a href="/manager" class="sb-link <%= typeof managerPage !== 'undefined' && managerPage === 'dashboard' ? 'active' : '' %>">
                        <i class="bi bi-grid-1x2-fill"></i> Bảng điều khiển
                    </a>
                    <a href="/manager/chat" class="sb-link <%= typeof managerPage !== 'undefined' && managerPage === 'chat' ? 'active' : '' %>">
                        <i class="bi bi-chat-dots-fill"></i> Hộp thư Hỗ trợ
                    </a>
                    <a href="/manager/destination" class="sb-link <%= typeof managerPage !== 'undefined' && managerPage === 'destination' ? 'active' : '' %>">
                        <i class="bi bi-geo-alt-fill"></i> Quản lý Địa điểm
                    </a>
                <% } %>
            </nav>
            <div class="sb-footer">
                <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                    <span class="small fw-bold text-muted">Ngôn ngữ / Lang</span>
                    <div class="lang-switch-group d-inline-flex align-items-center bg-white border rounded-pill p-1 shadow-sm notranslate" translate="no" style="border-color: rgba(0,0,0,0.15) !important;">
                        <button type="button" class="btn btn-sm rounded-pill lang-btn-vn border-0 text-center notranslate" translate="no" onclick="event.preventDefault(); event.stopPropagation(); setAppLanguage('vi')" style="font-size: 0.72rem; width: 34px; padding: 2px 0; letter-spacing: 0.5px;">VN</button>
                        <button type="button" class="btn btn-sm rounded-pill lang-btn-en border-0 text-center notranslate" translate="no" onclick="event.preventDefault(); event.stopPropagation(); setAppLanguage('en')" style="font-size: 0.72rem; width: 34px; padding: 2px 0; letter-spacing: 0.5px;">EN</button>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2 mb-3">
                    <img src="<%= fixImg(settings.brand_logo || user.avatar, '/brand-logo.png') %>" class="rounded-circle shadow-2xs flex-shrink-0" style="width: 36px; height: 36px; object-fit: cover;" onerror="this.src='/brand-logo.png'">
                    <div class="min-w-0">
                        <div class="fw-bold text-truncate notranslate" translate="no" style="font-size: 0.82rem;"><%= user.full_name %></div>
                        <div class="text-truncate" style="font-size: 0.7rem; color: var(--admin-muted);"><%= user.email %></div>
                    </div>
                </div>
                <a href="/auth/logout" class="btn btn-outline-danger w-100 rounded-pill btn-sm fw-bold">
                    <i class="bi bi-box-arrow-right me-1"></i>Đăng xuất
                </a>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="admin-main">
            <!-- Mobile Admin Top Bar with Brand, Language Toggle, and Hamburger Button on the Right -->
            <div class="d-lg-none d-flex justify-content-between align-items-center admin-mobile-topbar">
                <div class="d-flex align-items-center gap-2 min-w-0">
                    <span class="sb-brand-mark" style="width: 34px; height: 34px;">
                        <i class="bi <%= user.role === 'manager' ? 'bi-geo-alt' : 'bi-buildings' %>"></i>
                    </span>
                    <div class="min-w-0">
                        <span class="fw-black text-truncate d-block" style="color: var(--admin-primary); font-size: 0.95rem; letter-spacing: 0.3px;">
                            <%= user.role === 'manager' ? 'QUẢN LÝ PANEL' : 'BÌNH LỢI ADMIN' %>
                        </span>
                    </div>
                </div>
                
                <div class="d-flex align-items-center gap-2">
                    <div class="lang-switch-group d-inline-flex align-items-center bg-white border rounded-pill p-0.5 shadow-sm notranslate" translate="no" style="border-color: rgba(0,0,0,0.15) !important;">
                        <button type="button" class="btn btn-sm rounded-pill lang-btn-vn border-0 text-center notranslate" translate="no" onclick="event.preventDefault(); event.stopPropagation(); setAppLanguage('vi')" style="font-size: 0.7rem; width: 30px; padding: 2px 0; letter-spacing: 0.5px;">VN</button>
                        <button type="button" class="btn btn-sm rounded-pill lang-btn-en border-0 text-center notranslate" translate="no" onclick="event.preventDefault(); event.stopPropagation(); setAppLanguage('en')" style="font-size: 0.7rem; width: 30px; padding: 2px 0; letter-spacing: 0.5px;">EN</button>
                    </div>
                    
                    <!-- Nút 3 gạch mở menu bên phải trên điện thoại -->
                    <button type="button" class="btn-admin-hamburger" data-bs-toggle="offcanvas" data-bs-target="#adminMobileOffcanvas" aria-controls="adminMobileOffcanvas" title="Mở danh mục quản trị">
                        <i class="bi bi-list fs-3"></i>
                    </button>
                </div>
            </div>

            <%- body %>
        </main>
    </div>

    <!-- Mobile Admin Offcanvas Drawer (Trượt ra từ bên phải) -->
    <div class="offcanvas offcanvas-end admin-offcanvas" tabindex="-1" id="adminMobileOffcanvas" aria-labelledby="adminMobileOffcanvasLabel">
        <div class="offcanvas-header d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <span class="sb-brand-mark" aria-hidden="true" style="width: 32px; height: 32px;">
                    <i class="bi <%= user.role === 'manager' ? 'bi-geo-alt' : 'bi-buildings' %>"></i>
                </span>
                <div>
                    <h6 class="mb-0 fw-bold" id="adminMobileOffcanvasLabel" style="color: var(--admin-primary); letter-spacing: 0.5px;">
                        <%= user.role === 'manager' ? 'QUẢN LÝ PANEL' : 'BÌNH LỢI ADMIN' %>
                    </h6>
                    <small class="text-muted" style="font-size: 0.68rem;"><%= user.role === 'manager' ? 'Quản lý Địa điểm' : 'Hệ thống Quản trị cấp Xã' %></small>
                </div>
            </div>
            <button type="button" class="btn-close shadow-none" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>

        <div class="offcanvas-body">
            <!-- User Info Card -->
            <div class="d-flex align-items-center gap-2.5 p-2.5 rounded-3 mb-3 bg-light border" style="border-color: var(--admin-border) !important;">
                <img src="<%= fixImg(settings.brand_logo || user.avatar, '/brand-logo.png') %>" class="rounded-circle shadow-2xs flex-shrink-0" style="width: 40px; height: 40px; object-fit: cover;" onerror="this.src='/brand-logo.png'">
                <div class="min-w-0 flex-grow-1">
                    <div class="fw-bold text-truncate notranslate" translate="no" style="font-size: 0.85rem;"><%= user.full_name %></div>
                    <div class="text-truncate" style="font-size: 0.72rem; color: var(--admin-muted);"><%= user.email %></div>
                </div>
                <span class="role-badge role-<%= user.role %> text-uppercase fw-bold" style="font-size: 0.62rem;"><%= user.role %></span>
            </div>

            <!-- Navigation Links -->
            <nav class="flex-grow-1 overflow-y-auto custom-scrollbar pe-1">
                <% if (user.role === 'admin') { %>
                    <div class="sb-label mt-0">Tổng quan</div>
                    <a href="/admin" class="sb-link <%= typeof adminPage !== 'undefined' && adminPage === 'dashboard' ? 'active' : '' %>">
                        <i class="bi bi-grid-1x2-fill"></i> Dashboard
                    </a>
                    
                    <div class="sb-label">Quản lý</div>
                    <a href="/admin/users" class="sb-link <%= typeof adminPage !== 'undefined' && adminPage === 'users' ? 'active' : '' %>">
                        <i class="bi bi-people-fill"></i> Người dùng
                    </a>
                    <a href="/admin/destinations" class="sb-link <%= typeof adminPage !== 'undefined' && adminPage === 'destinations' ? 'active' : '' %>">
                        <i class="bi bi-geo-alt-fill"></i> Địa điểm
                    </a>
                    <a href="/admin/shops" class="sb-link <%= typeof adminPage !== 'undefined' && adminPage === 'shops' ? 'active' : '' %>">
                        <i class="bi bi-shop"></i> Shop
                    </a>
                    <a href="/admin/reviews" class="sb-link <%= typeof adminPage !== 'undefined' && adminPage === 'reviews' ? 'active' : '' %>">
                        <i class="bi bi-chat-heart-fill"></i> Cộng đồng
                    </a>
                    <a href="/admin/chat" class="sb-link <%= typeof adminPage !== 'undefined' && adminPage === 'chat' ? 'active' : '' %>">
                        <i class="bi bi-chat-dots-fill"></i> Hộp thư Hỗ trợ
                    </a>
                    <a href="/admin/events" class="sb-link <%= typeof adminPage !== 'undefined' && adminPage === 'events' ? 'active' : '' %>">
                        <i class="bi bi-calendar-event-fill"></i> Sự kiện
                    </a>
                    <a href="/admin/journey-templates" class="sb-link <%= typeof adminPage !== 'undefined' && adminPage === 'journey-templates' ? 'active' : '' %>">
                        <i class="bi bi-signpost-2-fill"></i> Tour
                    </a>
                    
                    <div class="sb-label">Cài đặt</div>
                    <a href="/admin/settings" class="sb-link <%= typeof adminPage !== 'undefined' && adminPage === 'settings' ? 'active' : '' %>">
                        <i class="bi bi-gear-fill"></i> Cài đặt Web
                    </a>
                    <a href="/admin/posters" class="sb-link <%= typeof adminPage !== 'undefined' && adminPage === 'posters' ? 'active' : '' %>">
                        <i class="bi bi-images"></i> Poster Hero Trang Chủ
                    </a>
                <% } else if (user.role === 'manager') { %>
                    <div class="sb-label mt-0">QUẢN LÝ ĐỊA ĐIỂM</div>
                    <a href="/manager" class="sb-link <%= typeof managerPage !== 'undefined' && managerPage === 'dashboard' ? 'active' : '' %>">
                        <i class="bi bi-grid-1x2-fill"></i> Bảng điều khiển
                    </a>
                    <a href="/manager/chat" class="sb-link <%= typeof managerPage !== 'undefined' && managerPage === 'chat' ? 'active' : '' %>">
                        <i class="bi bi-chat-dots-fill"></i> Hộp thư Hỗ trợ
                    </a>
                    <a href="/manager/destination" class="sb-link <%= typeof managerPage !== 'undefined' && managerPage === 'destination' ? 'active' : '' %>">
                        <i class="bi bi-geo-alt-fill"></i> Quản lý Địa điểm
                    </a>
                    <a href="/manager/workshops" class="sb-link <%= typeof managerPage !== 'undefined' && managerPage === 'workshops' ? 'active' : '' %>">
                        <i class="bi bi-shop"></i> Quản lý Shop
                    </a>
                <% } %>
            </nav>

            <!-- Offcanvas Footer: Quick Links & Logout -->
            <div class="pt-3 border-top mt-2">
                <a href="/" class="btn btn-light w-100 rounded-pill btn-sm fw-bold mb-2 border text-muted d-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-house-door"></i>Về Trang chủ
                </a>
                <a href="/auth/logout" class="btn btn-outline-danger w-100 rounded-pill btn-sm fw-bold d-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-box-arrow-right"></i>Đăng xuất
                </a>
            </div>
        </div>
    </div>

    <!-- Hidden Google Translate container for auto-translation fallback -->
    <div id="google_translate_element" style="display:none !important;"></div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.js"></script>
    <script src="/js/i18n-switcher.js"></script>
    <script type="text/javascript" src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
    
    <script>
    window.showAdminToast = function(message, type = 'success') {
        let container = document.getElementById('adminToastContainer');
        if (!container) {
            container = document.createElement('div');
            container.id = 'adminToastContainer';
            container.style.cssText = 'position: fixed; top: 24px; right: 24px; z-index: 99999; display: flex; flex-direction: column; gap: 10px; max-width: 380px; width: calc(100% - 48px); pointer-events: none;';
            document.body.appendChild(container);
        }
        
        const isErr = type === 'error';
        const toast = document.createElement('div');
        toast.className = 'admin-toast';
        toast.style.cssText = `
            pointer-events: auto;
            background: ${isErr ? 'linear-gradient(135deg, #ef4444, #dc2626)' : 'linear-gradient(135deg, #10b981, #059669)'};
            color: #ffffff;
            padding: 14px 20px;
            border-radius: 16px;
            box-shadow: 0 12px 32px rgba(0,0,0,0.22);
            backdrop-filter: blur(12px);
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 0.92rem;
            font-weight: 600;
            transform: translateY(-20px) scale(0.95);
            opacity: 0;
            transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
        `;
        
        const icon = isErr ? '<i class="bi bi-exclamation-triangle-fill fs-5"></i>' : '<i class="bi bi-check-circle-fill fs-5"></i>';
        toast.innerHTML = `<div class="d-flex align-items-center">${icon}</div><div class="flex-grow-1">${message}</div><button type="button" class="btn-close btn-close-white ms-auto" style="font-size: 0.75rem; cursor: pointer;"></button>`;
        
        const closeBtn = toast.querySelector('.btn-close');
        closeBtn.onclick = () => {
            toast.style.opacity = '0';
            toast.style.transform = 'translateY(-20px) scale(0.95)';
            setTimeout(() => toast.remove(), 350);
        };

        container.appendChild(toast);
        
        requestAnimationFrame(() => {
            toast.style.opacity = '1';
            toast.style.transform = 'translateY(0) scale(1)';
        });

        setTimeout(() => {
            if (toast.parentNode) {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(-20px) scale(0.95)';
                setTimeout(() => toast.remove(), 350);
            }
        }, 3200);
    };

    // Global Modern Popup Confirmation Modal Function
    let adminConfirmCallback = null;
    window.showAdminConfirm = function(message, title = 'Xác nhận xóa', onConfirm = null) {
        if (typeof title === 'function') {
            onConfirm = title;
            title = 'Xác nhận xóa';
        }
        document.getElementById('adminConfirmTitle').innerText = title || 'Xác nhận xóa';
        document.getElementById('adminConfirmMessage').innerText = message || 'Bạn có chắc chắn muốn thực hiện thao tác này?';
        adminConfirmCallback = onConfirm;
        
        const modalEl = document.getElementById('adminConfirmModal');
        const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
        modal.show();
    };

    document.addEventListener('DOMContentLoaded', function() {
        const btnConfirm = document.getElementById('btnAdminConfirmSubmit');
        if (btnConfirm) {
            btnConfirm.addEventListener('click', function() {
                const modalEl = document.getElementById('adminConfirmModal');
                const modal = bootstrap.Modal.getInstance(modalEl);
                if (modal) modal.hide();
                if (typeof adminConfirmCallback === 'function') {
                    const cb = adminConfirmCallback;
                    adminConfirmCallback = null;
                    cb();
                }
            });
        }
    });

    // Override browser window.alert in Admin layout for modern toast notifications
    window.alert = function(msg) {
        if (!msg) return;
        const msgStr = String(msg);
        const isError = msgStr.toLowerCase().includes('lỗi') || msgStr.toLowerCase().includes('thất bại') || msgStr.toLowerCase().includes('error');
        window.showAdminToast(msgStr, isError ? 'error' : 'success');
    };
    </script>

    <!-- Global Modern Confirm Modal Popup -->
    <div class="modal fade" id="adminConfirmModal" tabindex="-1" aria-hidden="true" style="z-index: 100000;">
        <div class="modal-dialog modal-dialog-centered modal-sm" style="max-width: 400px;">
            <div class="modal-content border-0 rounded-4 shadow-premium overflow-hidden">
                <div class="modal-body p-4 text-center">
                    <div class="mb-3 d-inline-flex align-items-center justify-content-center rounded-circle bg-danger bg-opacity-10 text-danger" style="width: 60px; height: 60px;">
                        <i class="bi bi-exclamation-triangle-fill fs-2"></i>
                    </div>
                    <h5 id="adminConfirmTitle" class="fw-bold mb-2 text-dark">Xác nhận thao tác</h5>
                    <p id="adminConfirmMessage" class="text-muted small mb-4 px-2" style="line-height: 1.5;">Bạn có chắc chắn muốn thực hiện thao tác này?</p>
                    <div class="d-flex gap-2 justify-content-center">
                        <button type="button" class="btn btn-light rounded-pill px-4 fw-bold flex-grow-1" data-bs-dismiss="modal">Hủy</button>
                        <button type="button" id="btnAdminConfirmSubmit" class="btn btn-danger rounded-pill px-4 fw-bold flex-grow-1">Xác nhận</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- typeof scripts !=='undefined' ? scripts : '' %>
</body>
</html>

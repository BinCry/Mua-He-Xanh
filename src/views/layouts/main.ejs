    <!-- Real-time Engagement & Tab-Session Visit Tracker -->
    <script>
    (function() {
        if (window.location.pathname.startsWith('/admin') || window.location.pathname.startsWith('/manager')) return;

        const now = Date.now();
        const THIRTY_MINS = 30 * 60 * 1000;
        let tabSession = sessionStorage.getItem('bl_tab_session_id');
        let lastActive = parseInt(sessionStorage.getItem('bl_tab_last_active') || '0', 10);
        let isNewTabSession = false;

        if (!tabSession || (now - lastActive > THIRTY_MINS)) {
            tabSession = 'tab_' + Math.random().toString(36).substring(2, 12) + '_' + now;
            sessionStorage.setItem('bl_tab_session_id', tabSession);
            sessionStorage.setItem('bl_session_start_ts', now.toString());
            isNewTabSession = true;
        }
        sessionStorage.setItem('bl_tab_last_active', now.toString());
        document.cookie = "tab_session_id=" + tabSession + "; path=/; SameSite=Lax";

        if (isNewTabSession) {
            const startPayload = JSON.stringify({ tabSession: tabSession, path: window.location.pathname });
            if (navigator.sendBeacon) {
                navigator.sendBeacon('/api/analytics/session-start', new Blob([startPayload], { type: 'application/json' }));
            } else {
                fetch('/api/analytics/session-start', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: startPayload,
                    keepalive: true
                }).catch(function() {});
            }
        }

        let sessionStartTime = parseInt(sessionStorage.getItem('bl_session_start_ts') || now.toString(), 10);

        function sendHeartbeat(isFinal) {
            sessionStorage.setItem('bl_tab_last_active', Date.now().toString());
            const totalDurationSec = Math.max(1, Math.round((Date.now() - sessionStartTime) / 1000));
            const payload = JSON.stringify({
                path: window.location.pathname,
                sessionId: tabSession,
                seconds: totalDurationSec,
                isFinal: !!isFinal
            });
            if (navigator.sendBeacon) {
                navigator.sendBeacon('/api/analytics/heartbeat', new Blob([payload], { type: 'application/json' }));
            } else {
                fetch('/api/analytics/heartbeat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: payload,
                    keepalive: true
                }).catch(function() {});
            }
        }

        setInterval(function() { sendHeartbeat(false); }, 20000);

        window.addEventListener('visibilitychange', function() {
            if (document.visibilityState === 'hidden') sendHeartbeat(true);
        });
        window.addEventListener('beforeunload', function() { sendHeartbeat(true); });
    })();
    </script>

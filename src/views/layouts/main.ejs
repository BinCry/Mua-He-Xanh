                                <img src="https://media.giphy.com/media/osjgQPWRx3cac/giphy.gif" class="w-100" style="height: 65px; object-fit: cover;" loading="lazy">
                                <div class="p-1 text-center bg-white"><span class="small fw-semibold text-success" style="font-size: 0.68rem;">🙏 Cảm ơn!</span></div>

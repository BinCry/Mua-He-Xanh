    <!-- Scripts (all deferred to avoid render-blocking) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer></script>

    <script>
        // Smooth Reveal Animation without layout jump or mid-frame flickering
        document.addEventListener('DOMContentLoaded', () => {
            const items = document.querySelectorAll('.reveal-up');
            if ('IntersectionObserver' in window) {
                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('active');
                            observer.unobserve(entry.target);
                        }
                    });
                }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

                items.forEach(item => observer.observe(item));
            } else {
                items.forEach(item => item.classList.add('active'));
            }
        });

        // Navbar Scroll Effect (Fixed top without detached spacing)
        // Navbar always white - shadow only on scroll
        const nav = document.querySelector('.navbar-premium');
        let isNavTicking = false;
        window.addEventListener('scroll', () => {
            if (!isNavTicking) {
                window.requestAnimationFrame(() => {
                    if (window.scrollY > 50) {
                        nav.classList.add('scrolled', 'shadow-premium');
                    } else {
                        nav.classList.remove('scrolled', 'shadow-premium');
                    }
                    isNavTicking = false;
                });
                isNavTicking = true;
            }
        }, { passive: true });


    </script>
    <script src="/js/app.js?v=<%= assetV %>"></script>



    <!-- Floating Buttons Alignment -->
    <style>
        /* Mobile QR Floating Button */
        .mobile-qr-fab {
            width: 56px;
            height: 56px;
            background: linear-gradient(135deg, var(--primary) 0%, #15803d 100%);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .mobile-qr-fab:hover {
            transform: scale(1.1);
            box-shadow: 0 6px 20px rgba(15, 118, 110, 0.4) !important;
        }

        /* Uniform size and styles for desktop floating action buttons */
        .fab-qr, 
        #floatingChatFabContainer button {
            width: 60px !important;
            height: 60px !important;
            border-radius: 50% !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            border: 3px solid white !important;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15) !important;
            transition: all 0.4s ease !important;
            padding: 0 !important;
        }

        /* Hover animations */
        .fab-qr:hover, 
        #floatingChatFabContainer button:hover {
            transform: scale(1.1) !important;
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.25) !important;
        }

        /* Desktop position alignment (centers them horizontally since they all have width 60px) */
        .fab-qr {
            position: fixed !important;
            bottom: 32px !important;
            right: 32px !important;
            z-index: 1040;
            background: var(--grad-nature) !important;
            color: white !important;
            font-size: 1.5rem !important;
            text-decoration: none !important;
        }
        #floatingChatFabContainer {
            position: fixed !important;
            bottom: 112px !important;
            right: 32px !important;
            z-index: 1040;
        }
        #floatingChatFabContainer button {
            background-color: var(--primary) !important;
            color: white !important;
            font-size: 1.5rem !important;
        }

        /* Mobile alignment & responsive adjustments */
        @media (max-width: 991.98px) {
            .footer-main { 
                padding-bottom: calc(90px + env(safe-area-inset-bottom, 0px)) !important; 
            }
            body.is-pwa main {
                padding-bottom: calc(90px + env(safe-area-inset-bottom, 0px)) !important; 
            }
            .fab-qr { display: none !important; }
            /* Hide floating chat on mobile - use sidebar link instead */
            #floatingChatFabContainer { display: none !important; }
            #floatingChatWidget { display: none !important; }
            
            /* Responsive offcanvas sidebar for small phones */
            #mobileMenu {
                max-width: 85% !important;
            }
        }

        /* Optimize branding on smaller screens (SE sizes) */
        @media (max-width: 375px) {
            .navbar-brand img {
                height: 34px !important;
            }
            .navbar-brand span:first-child {
                font-size: 1.1rem !important;
            }
            .navbar-brand span:last-child {
                font-size: 0.95rem !important;
            }
        }

        @media (max-width: 575.98px) {
            #floatingChatWidget {
                right: 10px !important;
                left: 10px !important;
                bottom: 80px !important;
                width: auto !important;
                height: 450px !important;
            }
        }

        /* PWA Install Banner & iOS Instructions CSS */
        .pwa-install-banner {
            position: fixed;
            bottom: calc(90px + env(safe-area-inset-bottom, 0px));
            left: 20px;
            right: 20px;
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
            z-index: 1060;
            border: 1px solid rgba(226, 232, 240, 0.8);
            max-width: 500px;
            margin: 0 auto;
        }

        .pwa-ios-instructions {
            position: fixed;
            bottom: calc(90px + env(safe-area-inset-bottom, 0px));
            left: 20px;
            right: 20px;
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
            z-index: 1060;
            border: 1px solid rgba(226, 232, 240, 0.8);
            max-width: 450px;
            margin: 0 auto;
        }

        /* Standalone PWA UI overrides (keeps hamburger button visible) */
        @media (display-mode: standalone) {
            .footer-main {
                display: none !important;
            }
            main {
                padding-bottom: calc(90px + env(safe-area-inset-bottom, 0px)) !important;
            }
        }

        /* JS-detected PWA UI overrides (keeps hamburger button visible) */
        body.is-pwa .footer-main {
            display: none !important;
        }
    </style>


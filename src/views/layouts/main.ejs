    <script>
        let currentZoomScale = 1;
        let panX = 0;
        let panY = 0;
        let isDragging = false;
        let startX = 0;
        let startY = 0;
        let currentGallery = [];
        let currentGalleryIndex = 0;

        function openImageLightbox(imgSrc, galleryList = null, startIndex = 0) {
            if (!imgSrc) return;
            const target = document.getElementById('lightboxTargetImg');
            const modalEl = document.getElementById('imageLightboxModal');
            if (!target || !modalEl) return;

            if (Array.isArray(galleryList) && galleryList.length > 0) {
                currentGallery = galleryList;
                currentGalleryIndex = Math.max(0, Math.min(galleryList.length - 1, startIndex || 0));
                target.src = currentGallery[currentGalleryIndex];
            } else {
                currentGallery = [imgSrc];
                currentGalleryIndex = 0;
                target.src = imgSrc;
            }

            updateLightboxGalleryUI();
            resetLightboxZoom();
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        }

        function updateLightboxGalleryUI() {
            const counter = document.getElementById('lightboxGalleryCounter');
            const prevBtn = document.getElementById('lightboxPrevBtn');
            const nextBtn = document.getElementById('lightboxNextBtn');

            if (currentGallery.length > 1) {
                if (counter) {
                    counter.textContent = `${currentGalleryIndex + 1} / ${currentGallery.length}`;
                    counter.classList.remove('d-none');
                }
                if (prevBtn) prevBtn.classList.remove('d-none');
                if (nextBtn) nextBtn.classList.remove('d-none');
            } else {
                if (counter) counter.classList.add('d-none');
                if (prevBtn) prevBtn.classList.add('d-none');
                if (nextBtn) nextBtn.classList.add('d-none');
            }
        }

        function prevLightboxImage() {
            if (currentGallery.length <= 1) return;
            currentGalleryIndex = (currentGalleryIndex - 1 + currentGallery.length) % currentGallery.length;
            const target = document.getElementById('lightboxTargetImg');
            if (target) {
                target.src = currentGallery[currentGalleryIndex];
                resetLightboxZoom();
                updateLightboxGalleryUI();
            }
        }

        function nextLightboxImage() {
            if (currentGallery.length <= 1) return;
            currentGalleryIndex = (currentGalleryIndex + 1) % currentGallery.length;
            const target = document.getElementById('lightboxTargetImg');
            if (target) {
                target.src = currentGallery[currentGalleryIndex];
                resetLightboxZoom();
                updateLightboxGalleryUI();
            }
        }

        function zoomLightboxImage(delta) {
            currentZoomScale = Math.max(0.6, Math.min(5, currentZoomScale + delta));
            if (currentZoomScale <= 1) {
                panX = 0;
                panY = 0;
            }
            updateLightboxTransform();
        }

        function resetLightboxZoom() {
            currentZoomScale = 1;
            panX = 0;
            panY = 0;
            updateLightboxTransform();
        }

        function toggleLightboxZoom() {
            if (currentZoomScale > 1) {
                resetLightboxZoom();
            } else {
                currentZoomScale = 2.5;
                updateLightboxTransform();
            }
        }

        function updateLightboxTransform() {
            const target = document.getElementById('lightboxTargetImg');
            if (target) {
                target.style.transform = `translate(${panX}px, ${panY}px) scale(${currentZoomScale})`;
            }
        }

        window.addEventListener('keydown', (e) => {
            const modalEl = document.getElementById('imageLightboxModal');
            if (modalEl && modalEl.classList.contains('show')) {
                if (e.key === 'ArrowLeft') {
                    prevLightboxImage();
                } else if (e.key === 'ArrowRight') {
                    nextLightboxImage();
                }
            }
        });

        document.addEventListener('DOMContentLoaded', () => {
            const stage = document.getElementById('lightboxStage');
            if (!stage) return;

            stage.addEventListener('wheel', (e) => {
                e.preventDefault();
                const delta = e.deltaY < 0 ? 0.3 : -0.3;
                zoomLightboxImage(delta);
            }, { passive: false });

            // Mouse Drag Panning when Zoomed
            stage.addEventListener('mousedown', (e) => {
                if (currentZoomScale > 1) {
                    isDragging = true;
                    startX = e.clientX - panX;
                    startY = e.clientY - panY;
                    stage.style.cursor = 'grabbing';
                }
            });

            window.addEventListener('mousemove', (e) => {
                if (isDragging && currentZoomScale > 1) {
                    panX = e.clientX - startX;
                    panY = e.clientY - startY;
                    updateLightboxTransform();
                }
            });

            window.addEventListener('mouseup', () => {
                isDragging = false;
                if (stage) stage.style.cursor = 'grab';
            });

            // Touch Panning for Mobile Devices
            stage.addEventListener('touchstart', (e) => {
                if (e.touches.length === 1 && currentZoomScale > 1) {
                    isDragging = true;
                    startX = e.touches[0].clientX - panX;
                    startY = e.touches[0].clientY - panY;
                }
            }, { passive: true });

            stage.addEventListener('touchmove', (e) => {
                if (isDragging && e.touches.length === 1 && currentZoomScale > 1) {
                    panX = e.touches[0].clientX - startX;
                    panY = e.touches[0].clientY - startY;
                    updateLightboxTransform();
                }
            }, { passive: true });

            stage.addEventListener('touchend', () => {
                isDragging = false;
            });
        });
    </script>

    <!-- Global Modern Confirm & Alert Modal Popups for Main App -->
    <script>
    let mainConfirmCallback = null;
    window.showAppConfirm = function(message, title = 'Xác nhận', onConfirm = null) {
        if (typeof title === 'function') {
            onConfirm = title;
            title = 'Xác nhận';
        }
        const titleEl = document.getElementById('appConfirmTitle');
        const msgEl = document.getElementById('appConfirmMessage');
        if (titleEl) titleEl.innerText = title || 'Xác nhận';
        if (msgEl) msgEl.innerText = message || 'Bạn có chắc chắn muốn thực hiện thao tác này?';
        mainConfirmCallback = onConfirm;
        
        const modalEl = document.getElementById('appConfirmModal');
        if (modalEl) {
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        }
    };

    let mainAlertCallback = null;
    window.showAppAlert = function(message, title = 'Thông báo', onOk = null) {
        if (typeof title === 'function') {
            onOk = title;
            title = 'Thông báo';
        }
        const titleEl = document.getElementById('appAlertTitle');
        const msgEl = document.getElementById('appAlertMessage');
        if (titleEl) titleEl.innerText = title || 'Thông báo';
        if (msgEl) msgEl.innerText = message || '';
        mainAlertCallback = onOk;
        
        const modalEl = document.getElementById('appAlertModal');
        if (modalEl) {
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        }
    };

    document.addEventListener('DOMContentLoaded', function() {
        const btnConfirm = document.getElementById('btnAppConfirmSubmit');
        if (btnConfirm) {
            btnConfirm.addEventListener('click', function() {
                const modalEl = document.getElementById('appConfirmModal');
                if (modalEl) {
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();
                }
                if (typeof mainConfirmCallback === 'function') {
                    const cb = mainConfirmCallback;
                    mainConfirmCallback = null;
                    cb();
                }
            });
        }

        const btnAlertOk = document.getElementById('btnAppAlertOk');
        if (btnAlertOk) {
            btnAlertOk.addEventListener('click', function() {
                const modalEl = document.getElementById('appAlertModal');
                if (modalEl) {
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();
                }
                if (typeof mainAlertCallback === 'function') {
                    const cb = mainAlertCallback;
                    mainAlertCallback = null;
                    cb();
                }
            });
        }
    });

    // Automatically route all standard alert() calls to the modern popup modal
    window.alert = function(msg) {
        if (!msg) return;
        window.showAppAlert(String(msg), 'Thông báo');
    };
    </script>


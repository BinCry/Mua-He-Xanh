            <!-- Standard Bottom Input Bar -->
            <div class="p-2 px-2.5 border-top bg-white d-flex align-items-center gap-1" id="floating-standard-input-bar" style="height: 56px; border-color: #e4e6eb !important;">
                <!-- Media Action Icons (Left) -->
                <div class="d-flex align-items-center gap-0.5 flex-shrink-0">
                    <button type="button" class="btn btn-sm btn-light rounded-circle p-0 d-flex align-items-center justify-content-center shadow-none text-decoration-none" style="width: 28px; height: 28px; color: #922724;" onclick="startFloatingVoiceRecording()" title="Ghi âm thoại">
                        <i class="bi bi-mic-fill fs-6"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-light rounded-circle p-0 d-flex align-items-center justify-content-center shadow-none text-decoration-none" style="width: 28px; height: 28px; color: #922724;" onclick="triggerFloatingImageUpload()" title="Gửi ảnh">
                        <i class="bi bi-image fs-6"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-light rounded-circle p-0 d-flex align-items-center justify-content-center shadow-none text-decoration-none" style="width: 28px; height: 28px; color: #922724;" onclick="toggleFloatingGif()" title="Ảnh động GIF">
                        <i class="bi bi-filetype-gif fs-6"></i>
                    </button>
                </div>

                <!-- Text Input Pill -->
                <div class="flex-grow-1 position-relative" style="min-width: 0;">
                    <input type="text" class="form-control border-0" style="font-size: 0.86rem; height: 36px; background: #f0f2f5; border-radius: 18px; color: #050505; padding-left: 12px; padding-right: 32px; width: 100%;" placeholder="Nhập tin nhắn..." id="floatingChatInput" autocomplete="off" onkeypress="if(event.key === 'Enter'){ event.preventDefault(); sendFloatingLiveMessage(); }" oninput="toggleFloatingSendIcon(this)">
                    <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y p-0 me-1.5 text-decoration-none d-flex align-items-center justify-content-center" style="width: 24px; height: 24px;" onclick="toggleFloatingEmoji()" title="Biểu cảm / Nhãn dán">
                        <i class="bi bi-emoji-smile-fill fs-6 text-warning"></i>
                    </button>
                </div>

                <!-- Right Button (Thumbs-Up / Send) -->
                <div class="flex-shrink-0">
                    <button type="button" id="floating-btn-send" class="btn btn-link p-0 d-flex align-items-center justify-content-center flex-shrink-0 text-decoration-none" style="color: #922724; width: 32px; height: 32px;" onclick="sendFloatingLiveMessage()" title="Gửi">
                        <i class="bi bi-hand-thumbs-up-fill fs-5" id="floating-send-icon"></i>
                    </button>

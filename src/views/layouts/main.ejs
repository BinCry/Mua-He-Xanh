    <meta property="og:title" content="<%= (typeof title !== 'undefined' && title && title !== appName) ? (title + ' | ' + appName) : (typeof title !== 'undefined' && title ? title : appName) %>">
    <meta property="og:description" content="<%= typeof description !== 'undefined' && description ? description : (settings.site_description || 'Hành trình khám phá và chữa lành tại làng quê Bình Lợi') %>">
    <meta property="og:image" content="<%= baseUrl %>/images/brand-logo.png">
    <meta property="og:image:secure_url" content="<%= baseUrl %>/images/brand-logo.png">
    <meta property="og:image:width" content="512">
    <meta property="og:image:height" content="512">
    <meta property="og:image:type" content="image/png">
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= (typeof title !== 'undefined' && title && title !== appName) ? (title + ' | ' + appName) : (typeof title !== 'undefined' && title ? title : appName) %>">
    <meta name="twitter:description" content="<%= typeof description !== 'undefined' && description ? description : (settings.site_description || 'Hành trình khám phá và chữa lành tại làng quê Bình Lợi') %>">
    <meta name="twitter:image" content="<%= baseUrl %>/images/brand-logo.png">

    <!-- Structured Data (JSON-LD) for Google Search Engine Knowledge & Logo Discovery -->

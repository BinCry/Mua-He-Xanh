        <!-- Hidden file input for image uploads -->
        <input type="file" id="floating-chat-image-input" accept="image/*" style="display: none;" onchange="handleFloatingImageUpload(event)">

        <!-- Body & Message Stream -->
        <div class="d-flex flex-column" style="height: calc(100% - 64px);">
            <div class="flex-grow-1 p-3 overflow-auto custom-scrollbar" id="floatingChatMessages" style="background: #ffffff;">
                <div class="text-center mb-3">

    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="description" content="<%= typeof description !== 'undefined' && description ? description : (settings.site_description || 'Khám phá du lịch Bình Lợi - Điểm đến sinh thái chữa lành, trải nghiệm văn hóa và ẩm thực đậm chất Nam Bộ giữa lòng TP.HCM.') %>">

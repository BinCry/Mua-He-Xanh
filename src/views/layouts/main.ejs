                <div class="d-flex justify-content-end p-2">
                    <a id="floating-lightbox-download-btn" href="#" download class="btn btn-sm btn-outline-light rounded-pill me-2"><i class="bi bi-download me-1"></i>Tải ảnh</a>
                    <button type="button" class="btn btn-sm btn-light rounded-circle" data-bs-dismiss="modal"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="p-3 d-flex align-items-center justify-content-center" style="min-height: 300px;">
                    <img id="floating-lightbox-img" src="" class="img-fluid rounded-3 shadow-lg" style="max-height: 75vh; object-fit: contain;">
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Thu Hồi Tin Nhắn (Floating Chat) -->
    <div class="modal fade" id="floatingRecallModal" tabindex="-1" aria-hidden="true" style="z-index: 1080;">
        <div class="modal-dialog modal-dialog-centered modal-sm" style="max-width: 360px;">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <div class="modal-header border-bottom py-2.5 px-3">
                    <h6 class="modal-title fw-bold text-dark fs-6"><i class="bi bi-chat-square-dots me-1.5 text-danger"></i>Bạn muốn gỡ tin nhắn này?</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-3">
                    <!-- Option 1: Unsend for everyone (Sender only) -->
                    <div id="floating-recall-option-all" class="d-flex align-items-start gap-3 p-2.5 rounded-3 border mb-2 cursor-pointer hover-bg-light transition-all" onclick="executeFloatingRecall('all')">
                        <div class="rounded-circle bg-danger bg-opacity-10 text-danger d-flex align-items-center justify-content-center p-2 flex-shrink-0" style="width: 38px; height: 38px;">
                            <i class="bi bi-arrow-counterclockwise fs-5"></i>
                        </div>
                        <div>
                            <strong class="d-block text-dark" style="font-size: 0.9rem;">Thu hồi với mọi người</strong>
                            <small class="text-muted d-block" style="font-size: 0.75rem; line-height: 1.3;">Gỡ bỏ nội dung tin nhắn này đối với tất cả mọi người trong đoạn chat.</small>
                        </div>
                    </div>

                    <!-- Option 2: Remove for you (Everyone) -->
                    <div id="floating-recall-option-self" class="d-flex align-items-start gap-3 p-2.5 rounded-3 border cursor-pointer hover-bg-light transition-all" onclick="executeFloatingRecall('self')">
                        <div class="rounded-circle bg-secondary bg-opacity-10 text-secondary d-flex align-items-center justify-content-center p-2 flex-shrink-0" style="width: 38px; height: 38px;">
                            <i class="bi bi-trash3 fs-5"></i>
                        </div>
                        <div>
                            <strong class="d-block text-dark" style="font-size: 0.9rem;">Gỡ ở phía bạn</strong>
                            <small class="text-muted d-block" style="font-size: 0.75rem; line-height: 1.3;">Tin nhắn này sẽ bị xóa khỏi thiết bị của bạn nhưng vẫn hiển thị với người khác.</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        let floatingChatInterval = null;
        let lastFloatingMsgCount = -1;
        let floatingMediaRecorder = null;
        let floatingAudioChunks = [];
        let floatingRecordInterval = null;
        let floatingRecordSeconds = 0;

        function toggleFloatingChat() {
            const widget = document.getElementById('floatingChatWidget');
            widget.classList.toggle('d-none');
            
            if (!widget.classList.contains('d-none')) {
                loadFloatingChatMessages();
                setTimeout(() => {
                    const container = document.getElementById('floatingChatMessages');
                    if (container) container.scrollTop = container.scrollHeight;
                }, 150);
                floatingChatInterval = setInterval(loadFloatingChatMessages, 3500);
            } else {
                if (floatingChatInterval) {
                    clearInterval(floatingChatInterval);
                    floatingChatInterval = null;
                }
                toggleFloatingEmoji(false);
                toggleFloatingGif(false);
            }
        }

        document.addEventListener('visibilitychange', () => {
            if (document.hidden && floatingChatInterval) {
                clearInterval(floatingChatInterval);
                floatingChatInterval = null;
            } else if (!document.hidden && !document.getElementById('floatingChatWidget').classList.contains('d-none')) {
                floatingChatInterval = setInterval(loadFloatingChatMessages, 3500);
            }
        });

        function toggleFloatingSendIcon(input) {
            const icon = document.getElementById('floating-send-icon');
            if (!icon) return;
            if (input.value.trim().length > 0) {
                icon.className = 'bi bi-send-fill fs-5';
            } else {
                icon.className = 'bi bi-hand-thumbs-up-fill fs-4';
            }
        }

        function toggleFloatingEmoji(force) {
            const d = document.getElementById('floating-messenger-drawer');
            if (!d) return;
            const willHide = (force !== undefined) ? !force : (d.style.display !== 'none');
            d.style.display = willHide ? 'none' : 'block';
            if (!willHide) switchFloatingNavTab('all-emoji');
        }

        function toggleFloatingGif() {
            const d = document.getElementById('floating-messenger-drawer');
            if (!d) return;
            d.style.display = 'block';
            switchFloatingNavTab('gifs');
        }

        function switchFloatingNavTab(tab) {
            document.querySelectorAll('.fnav-tab').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.fnav-pane').forEach(p => p.style.display = 'none');
            
            const activeBtn = document.getElementById(`fntab-${tab}`);
            if (activeBtn) activeBtn.classList.add('active');
            
            const activePane = document.getElementById(`fnpane-${tab}`);
            if (activePane) activePane.style.display = 'block';
        }

        function filterFloatingPicker(query) {
            query = (query || '').toLowerCase().trim();
            const emojiItems = document.querySelectorAll('#fnpane-all-emoji .f-emoji-item');
            const groups = document.querySelectorAll('#fnpane-all-emoji .f-emoji-group');
            
            if (!query) {
                emojiItems.forEach(el => el.style.display = 'inline-flex');
                groups.forEach(g => g.style.display = 'block');
                return;
            }

            switchFloatingNavTab('all-emoji');
            emojiItems.forEach(el => {
                const char = el.innerText.trim();
                el.style.display = char.includes(query) ? 'inline-flex' : 'none';
            });
            groups.forEach(g => {
                let has = false;
                g.querySelectorAll('.f-emoji-item').forEach(e => {
                    if (e.style.display !== 'none') has = true;
                });
                g.style.display = has ? 'block' : 'none';
            });
        }

        function insertFloatingEmoji(emoji) {
            const input = document.getElementById('floatingChatInput');
            if (!input) return;
            input.value += emoji;
            input.focus();
            toggleFloatingSendIcon(input);
        }

        function sendFloatingGif(gifUrl) {
            toggleFloatingEmoji(false);
            sendFloatingCustomMessage(`[GIF: ${gifUrl}]`);
        }

        function triggerFloatingImageUpload() {
            document.getElementById('floating-chat-image-input').click();
        }

        async function handleFloatingImageUpload(e) {
            const file = e.target.files[0];
            if (!file) return;

            const formData = new FormData();
            formData.append('image', file);

            try {
                const res = await axios.post('/api/chat/upload', formData, {
                    headers: { 'Content-Type': 'multipart/form-data' }
                });
                if (res.data.success && (res.data.url || res.data.path)) {
                    const imgUrl = res.data.url || res.data.path;
                    sendFloatingCustomMessage(`[HÌNH ẢNH: ${imgUrl}]`);
                } else {
                    alert(res.data.message || 'Lỗi tải ảnh');
                }
            } catch (err) {
                alert('Lỗi tải ảnh: ' + (err.response?.data?.message || err.message));
            } finally {
                e.target.value = '';
            }
        }

        async function startFloatingVoiceRecording() {
            try {
                const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                floatingAudioChunks = [];
                floatingMediaRecorder = new MediaRecorder(stream);
                
                floatingMediaRecorder.ondataavailable = (e) => {
                    if (e.data.size > 0) floatingAudioChunks.push(e.data);
                };

                floatingMediaRecorder.start();
                floatingRecordSeconds = 0;
                document.getElementById('floating-recording-timer').innerText = '00:00';
                document.getElementById('floating-standard-input-bar').style.display = 'none';
                document.getElementById('floating-voice-recording-bar').style.display = 'flex';

                floatingRecordInterval = setInterval(() => {
                    floatingRecordSeconds++;
                    const mins = String(Math.floor(floatingRecordSeconds / 60)).padStart(2, '0');
                    const secs = String(floatingRecordSeconds % 60).padStart(2, '0');
                    document.getElementById('floating-recording-timer').innerText = `${mins}:${secs}`;
                }, 1000);
            } catch (err) {
                sendFloatingCustomMessage('🎤 [Ghi âm thoại: 0:12]');
            }
        }

        function cancelFloatingVoiceRecording() {
            if (floatingRecordInterval) clearInterval(floatingRecordInterval);
            if (floatingMediaRecorder && floatingMediaRecorder.state !== 'inactive') {
                floatingMediaRecorder.stop();
                floatingMediaRecorder.stream.getTracks().forEach(track => track.stop());
            }
            document.getElementById('floating-voice-recording-bar').style.display = 'none';
            document.getElementById('floating-standard-input-bar').style.display = 'flex';
        }

        async function stopAndSendFloatingVoiceRecording() {
            if (!floatingMediaRecorder || floatingMediaRecorder.state === 'inactive') return;
            if (floatingRecordInterval) clearInterval(floatingRecordInterval);

            const durationStr = document.getElementById('floating-recording-timer').innerText;

            floatingMediaRecorder.onstop = async () => {
                floatingMediaRecorder.stream.getTracks().forEach(track => track.stop());
                const audioBlob = new Blob(floatingAudioChunks, { type: 'audio/webm' });
                
                const formData = new FormData();
                formData.append('image', audioBlob, `voice-${Date.now()}.webm`);

                try {
                    const res = await axios.post('/api/chat/upload', formData, {
                        headers: { 'Content-Type': 'multipart/form-data' }
                    });
                    if (res.data.success && (res.data.url || res.data.path)) {
                        const audioUrl = res.data.url || res.data.path;
                        sendFloatingCustomMessage(`[AUDIO: ${audioUrl}|${durationStr}]`);
                    } else {
                        sendFloatingCustomMessage(`🎤 [Ghi âm thoại: ${durationStr}]`);
                    }
                } catch(e) {
                    sendFloatingCustomMessage(`🎤 [Ghi âm thoại: ${durationStr}]`);
                }

                document.getElementById('floating-voice-recording-bar').style.display = 'none';
                document.getElementById('floating-standard-input-bar').style.display = 'flex';
            };

            floatingMediaRecorder.stop();
        }

        function openFloatingChatLightbox(url) {
            document.getElementById('floating-lightbox-img').src = url;
            document.getElementById('floating-lightbox-download-btn').href = url;
            const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('floatingChatLightboxModal'));
            modal.show();
        }

        function togglePlayFloatingVoice(btn, audioUrl) {
            let audio = btn._audioInstance;
            if (!audio) {
                audio = new Audio(audioUrl);
                btn._audioInstance = audio;
                audio.onended = () => {
                    btn.innerHTML = '<i class="bi bi-play-fill fs-5"></i>';
                };
            }

            if (audio.paused) {
                audio.play().then(() => {
                    btn.innerHTML = '<i class="bi bi-pause-fill fs-5"></i>';
                }).catch(e => {
                    btn.innerHTML = '<i class="bi bi-pause-fill fs-5"></i>';
                });
            } else {
                audio.pause();
                btn.innerHTML = '<i class="bi bi-play-fill fs-5"></i>';
            }
        }

        function formatFloatingDividerTime(isoDateStr) {
            if (!isoDateStr) return '';
            const d = new Date(isoDateStr);
            if (isNaN(d.getTime())) return '';
            const now = new Date();
            const isToday = d.toDateString() === now.toDateString();
            const yesterday = new Date(now);
            yesterday.setDate(now.getDate() - 1);
            const isYesterday = d.toDateString() === yesterday.toDateString();

            const timeStr = d.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
            const days = ['CN', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7'];
            const dayName = days[d.getDay()];
            const day = d.getDate();
            const month = d.getMonth() + 1;
            const year = d.getFullYear();

            if (isToday) return `Hôm nay ${timeStr}`;
            if (isYesterday) return `Hôm qua ${timeStr}`;
            if (year === now.getFullYear()) return `${dayName}, ${day} Thg ${month}, ${timeStr}`;
            return `${dayName}, ${day}/${month}/${year}, ${timeStr}`;
        }

        function formatBubbleContentFloating(text) {
            if (!text) return '';
            
            // 1. Images: [HÌNH ẢNH: url] or [IMAGE: url] or plain /uploads/...
            const imgTagMatch = text.match(/\[(HÌNH ẢNH|IMAGE):\s*([^\]]+)\]/i);
            if (imgTagMatch) {
                const url = imgTagMatch[2].trim();
                return `
                    <div class="my-1 position-relative overflow-hidden rounded-3 shadow-xs">
                        <img src="${url}" class="img-fluid rounded-3 cursor-pointer" style="max-height: 180px; max-width: 100%; object-fit: cover; display: block;" onclick="openFloatingChatLightbox('${url}')" loading="lazy" onerror="this.outerHTML='<span class=\\'small\\'>📷 Không thể tải ảnh</span>'">
                    </div>
                `;
            }

            const directImgMatch = text.match(/^(\/[^\s]+\.(jpg|jpeg|png|webp|gif)|https?:\/\/[^\s]+\.(jpg|jpeg|png|webp|gif))$/i);
            if (directImgMatch) {
                const url = directImgMatch[1].trim();
                return `
                    <div class="my-1 position-relative overflow-hidden rounded-3 shadow-xs">
                        <img src="${url}" class="img-fluid rounded-3 cursor-pointer" style="max-height: 180px; max-width: 100%; object-fit: cover; display: block;" onclick="openFloatingChatLightbox('${url}')" loading="lazy">
                    </div>
                `;
            }

            // 2. GIFs [GIF: url]
            const gifMatch = text.match(/\[GIF:\s*([^\]]+)\]/i);
            if (gifMatch) {
                const url = gifMatch[1].trim();
                return `
                    <div class="my-1 position-relative overflow-hidden rounded-3 shadow-xs">
                        <img src="${url}" class="rounded-3 shadow-xs" style="max-height: 150px; max-width: 200px; object-fit: contain; display: block;" loading="lazy">
                    </div>
                `;
            }

            // 3. Voice notes [AUDIO: url|dur]
            const audioMatch = text.match(/\[(AUDIO|VOICE):\s*([^\|\]]+)(?:\|([^\]]+))?\]/i);
            if (audioMatch) {
                const audioUrl = audioMatch[2].trim();
                const duration = audioMatch[3] || '0:15';
                return `
                    <div class="d-flex align-items-center gap-2 p-1.5 px-2.5 rounded-pill my-1" style="background: rgba(0,0,0,0.06); min-width: 160px;">
                        <button type="button" class="btn btn-sm btn-white rounded-circle p-0 d-flex align-items-center justify-content-center shadow-2xs flex-shrink-0" style="width: 28px; height: 28px; color: #922724;" onclick="togglePlayFloatingVoice(this, '${audioUrl}')">
                            <i class="bi bi-play-fill fs-5"></i>
                        </button>
                        <div class="flex-grow-1" style="height: 3px; background: rgba(0,0,0,0.15); border-radius: 2px;"></div>
                        <span class="x-small fw-bold opacity-90 text-nowrap" style="font-size: 0.7rem;">${duration}</span>
                    </div>
                `;
            }

            if (text.includes('🎤 [Ghi âm thoại')) {
                return `
                    <div class="d-flex align-items-center gap-2 p-1.5 px-2.5 rounded-pill my-1" style="background: rgba(0,0,0,0.06); min-width: 160px;">
                        <button type="button" class="btn btn-sm btn-white rounded-circle p-0 d-flex align-items-center justify-content-center shadow-2xs flex-shrink-0" style="width: 28px; height: 28px; color: #922724;" onclick="togglePlayFloatingVoice(this, '/sounds/chat-notification.mp3')">
                            <i class="bi bi-play-fill fs-5"></i>
                        </button>
                        <div class="flex-grow-1" style="height: 3px; background: rgba(0,0,0,0.15); border-radius: 2px;"></div>
                        <span class="x-small fw-bold opacity-90 text-nowrap" style="font-size: 0.7rem;">0:15</span>
                    </div>
                `;
            }

            const div = document.createElement('div');
            div.innerText = text;
            return div.innerHTML;
        }

        async function loadFloatingChatMessages() {
            try {
                const res = await axios.get('/api/get-messages');
                if (res.data.success) {
                    const messages = res.data.data;
                    if (messages.length === lastFloatingMsgCount) return;
                    lastFloatingMsgCount = messages.length;

                    const container = document.getElementById('floatingChatMessages');
                    let html = `
                        <div class="text-center mb-3">
                            <span class="badge bg-light text-muted px-2.5 py-1 rounded-pill small border" style="font-size: 0.7rem;">
                                <i class="bi bi-shield-check text-success me-1"></i>Hỗ trợ trực tuyến bảo mật
                            </span>
                        </div>
                    `;
                    
                    let lastMsgTime = null;

                    messages.forEach((msg, idx) => {
                        const isMe = msg.is_mine || false;
                        const isAI = msg.is_ai === 1 || msg.is_ai === true;
                        const currentMsgTime = msg.created_at ? new Date(msg.created_at).getTime() : 0;
                        const exactTime = msg.created_at ? new Date(msg.created_at).toLocaleTimeString('vi-VN', {hour: '2-digit', minute:'2-digit'}) : '';
                        const isLikeEmoji = (msg.message === '👍');
                        const isMedia = (msg.message.includes('[HÌNH ẢNH:') || msg.message.includes('[GIF:') || msg.message.includes('[AUDIO:'));
                        const isRecalled = msg.is_recalled || msg.message === '[ĐÃ THU HỒI]';

                        if (isRecalled) {
                            if (isMe) {
                                html += `
                                    <div class="message-sent mb-1.5 d-flex flex-column align-items-end">
                                        <div class="px-2.5 py-1.5 text-muted fst-italic shadow-2xs" style="border-radius: 14px; border: 1px dashed rgba(0,0,0,0.18); background: rgba(0,0,0,0.03); font-size: 0.8rem;" title="${exactTime}">
                                            <i class="bi bi-arrow-counterclockwise me-1 text-danger"></i>Tin nhắn đã bị thu hồi
                                        </div>
                                        <div class="x-small text-muted text-end mt-0.5 me-1" style="font-size: 0.65rem; color: #65676b;">${exactTime}</div>
                                    </div>
                                `;
                            } else {
                                html += `
                                    <div class="message-received mb-1.5 d-flex flex-column align-items-start">
                                        <div class="d-flex gap-1.5 align-items-end" style="max-width: 82%;">
                                            <img src="<%= fixImg(settings.brand_logo, '/images/logo.png') %>?v=3" class="rounded-circle flex-shrink-0" style="width: 24px; height: 24px; object-fit: cover;" onerror="this.src='/images/logo.png'">
                                            <div class="px-2.5 py-1.5 text-muted fst-italic shadow-2xs" style="border-radius: 14px; border: 1px dashed rgba(0,0,0,0.18); background: rgba(0,0,0,0.03); font-size: 0.8rem;" title="${exactTime}">
                                                <i class="bi bi-arrow-counterclockwise me-1 text-danger"></i>Tin nhắn đã bị thu hồi
                                            </div>
                                        </div>
                                        <div class="x-small text-muted text-start mt-0.5 ms-4" style="font-size: 0.65rem; color: #65676b;">${exactTime}</div>
                                    </div>
                                `;
                            }
                        } else if (isMe) {
                            html += `
                                <div class="message-sent mb-1.5 d-flex flex-column align-items-end">
                                    <div class="group-hover-parent d-flex align-items-center gap-1 justify-content-end" style="max-width: 85%;">
                                        <button type="button" class="btn btn-sm btn-light rounded-circle p-0 d-flex align-items-center justify-content-center shadow-none text-muted group-hover-visible flex-shrink-0" style="width: 22px; height: 22px; font-size: 0.75rem;" onclick="openFloatingRecallAction('${msg.id}', true)" title="Tùy chọn tin nhắn">
                                            <i class="bi bi-three-dots"></i>
                                        </button>
                                        <div class="shadow-2xs text-white text-start" style="font-size: ${isLikeEmoji ? '2rem' : '0.88rem'}; line-height: 1.35; padding: ${isLikeEmoji || isMedia ? '2px 4px' : '8px 12px'}; background: ${isLikeEmoji || isMedia ? 'transparent' : 'linear-gradient(135deg, #922724 0%, #b83330 100%)'} !important; border-radius: 16px 16px 4px 16px !important; word-break: break-word; overflow-wrap: anywhere;" title="${exactTime}">
                                            ${formatBubbleContentFloating(msg.message)}
                                        </div>
                                    </div>
                                    <div class="x-small text-muted text-end mt-0.5 me-1" style="font-size: 0.65rem; color: #65676b;">${exactTime}</div>
                                </div>
                            `;
                        } else if (isAI) {
                            html += `
                                <div class="message-received mb-1.5 d-flex flex-column align-items-start">
                                    <div class="d-flex gap-1.5 align-items-end" style="max-width: 82%;">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center text-success flex-shrink-0 bg-success bg-opacity-10 border border-success border-opacity-20" style="width: 24px; height: 24px; font-size: 0.8rem;">
                                            <i class="bi bi-robot"></i>
                                        </div>
                                        <div class="shadow-2xs text-start" style="font-size: 0.88rem; line-height: 1.35; padding: 8px 12px; border-radius: 16px 16px 16px 4px !important; background: rgba(16,185,129,0.08); border: 1px solid rgba(16,185,129,0.2); color: #065f46; word-break: break-word; overflow-wrap: anywhere;" title="${exactTime}">
                                            <div class="x-small fw-bold text-success mb-0.5" style="font-size: 0.6rem;">🤖 TRỢ LÝ AI</div>
                                            ${formatBubbleContentFloating(msg.message)}
                                        </div>
                                    </div>
                                    <div class="x-small text-muted text-start mt-0.5 ms-4" style="font-size: 0.65rem; color: #65676b;">${exactTime}</div>
                                </div>
                            `;
                        } else {
                            const senderName = msg.manager_name || (msg.destination_name ? `Quản lý ${msg.destination_name}` : 'Ban Quản Trị');
                            html += `
                                <div class="message-received mb-1.5 d-flex flex-column align-items-start">
                                    <div class="d-flex gap-1.5 align-items-end" style="max-width: 85%;">
                                        <img src="<%= fixImg(settings.brand_logo, '/images/logo.png') %>?v=3" class="rounded-circle flex-shrink-0" style="width: 24px; height: 24px; object-fit: cover;" onerror="this.src='/images/logo.png'">
                                        <div class="group-hover-parent d-flex align-items-center gap-1 justify-content-start flex-grow-1">
                                            <div class="shadow-2xs text-start" style="font-size: ${isLikeEmoji ? '2rem' : '0.88rem'}; line-height: 1.35; padding: ${isLikeEmoji || isMedia ? '2px 4px' : '8px 12px'}; border-radius: 16px 16px 16px 4px !important; background: ${isLikeEmoji || isMedia ? 'transparent' : '#f0f2f5'}; color: #050505; word-break: break-word; overflow-wrap: anywhere;" title="${exactTime}">
                                                <div class="x-small fw-bold text-muted mb-0.5" style="font-size: 0.6rem;">${senderName}</div>
                                                ${formatBubbleContentFloating(msg.message)}
                                            </div>
                                            <button type="button" class="btn btn-sm btn-light rounded-circle p-0 d-flex align-items-center justify-content-center shadow-none text-muted group-hover-visible flex-shrink-0" style="width: 22px; height: 22px; font-size: 0.75rem;" onclick="openFloatingRecallAction('${msg.id}', false)" title="Tùy chọn tin nhắn">
                                                <i class="bi bi-three-dots"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="x-small text-muted text-start mt-0.5 ms-4" style="font-size: 0.65rem; color: #65676b;">${exactTime}</div>
                                </div>
                            `;
                        }
                    });
                    
                    container.innerHTML = html;
                    container.scrollTop = container.scrollHeight;
                }
            } catch (e) {
                console.error('Error loading chat messages:', e);
            }
        }

        let activeFloatingRecallMessageId = null;

        function openFloatingRecallAction(msgId, isMine) {
            activeFloatingRecallMessageId = msgId;
            const optAll = document.getElementById('floating-recall-option-all');
            if (optAll) {
                optAll.style.display = isMine ? 'flex' : 'none';
            }
            const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('floatingRecallModal'));
            modal.show();
        }

        async function executeFloatingRecall(type) {
            if (!activeFloatingRecallMessageId) return;
            const msgId = activeFloatingRecallMessageId;
            const modalEl = document.getElementById('floatingRecallModal');
            const modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) modal.hide();

            try {
                const res = await axios.post('/api/chat/recall-message', { messageId: msgId, type });
                if (res.data.success) {
                    lastFloatingMsgCount = -1;
                    loadFloatingChatMessages();
                } else {
                    alert(res.data.message || 'Không thể thực hiện thao tác');
                }
            } catch(e) {
                alert('Lỗi: ' + (e.response?.data?.message || e.message));
            }
        }

        async function sendFloatingCustomMessage(msg) {
            if (!msg) return;
            const container = document.getElementById('floatingChatMessages');
            const exactTime = new Date().toLocaleTimeString('vi-VN', {hour: '2-digit', minute:'2-digit'});
            const isLikeEmoji = (msg === '👍');
            const isMedia = (msg.includes('[HÌNH ẢNH:') || msg.includes('[GIF:') || msg.includes('[AUDIO:'));

            const optHtml = `
                <div class="message-sent mb-1.5 d-flex flex-column align-items-end">
                    <div class="shadow-2xs text-white text-start" style="max-width: 78%; font-size: ${isLikeEmoji ? '2rem' : '0.88rem'}; line-height: 1.35; padding: ${isLikeEmoji || isMedia ? '2px 4px' : '8px 12px'}; background: ${isLikeEmoji || isMedia ? 'transparent' : 'linear-gradient(135deg, #922724 0%, #b83330 100%)'} !important; border-radius: 16px 16px 4px 16px !important; word-break: break-word; overflow-wrap: anywhere;">
                        ${formatBubbleContentFloating(msg)}
                    </div>
                    <div class="x-small text-muted text-end mt-0.5 me-1" style="font-size: 0.65rem; color: #65676b;">${exactTime}</div>
                </div>
            `;
            container.insertAdjacentHTML('beforeend', optHtml);
            container.scrollTop = container.scrollHeight;

            try {
                const res = await axios.post('/api/send-message', { message: msg });
                if (res.data.success) {
                    loadFloatingChatMessages();
                }
            } catch (e) {
                console.error('Error sending message:', e);
            }
        }

        function sendFloatingLiveMessage() {
            const input = document.getElementById('floatingChatInput');
            let msg = input.value.trim();
            if (!msg) msg = '👍';

            input.value = '';
            toggleFloatingSendIcon(input);
            sendFloatingCustomMessage(msg);
            input.focus();
        }
    </script>

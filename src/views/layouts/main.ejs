    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "<%= settings.site_name || 'Bình Lợi' %>",
      "alternateName": "Bình Lợi",
      "url": "<%= baseUrl %>",
      "description": "<%= settings.site_description || 'Nền tảng Du lịch Chữa lành Xã Bình Lợi' %>",
      "publisher": {
        "@type": "Organization",
        "name": "<%= settings.brand_name || 'Bình Lợi' %>",
        "url": "<%= baseUrl %>",
        "logo": {
          "@type": "ImageObject",
          "url": "<%= baseUrl %>/images/brand-logo.png",
          "width": 512,
          "height": 512
        }
      }
    }
    </script>

    <script>
        window.APP_CONFIG = {
            baseUrl: '<%= baseUrl %>',
            apiUrl: '<%= baseUrl %>/api',

            </div>

            <!-- Voice Recording Live Bar (When recording) -->
            <div id="floating-voice-recording-bar" class="p-2 px-3 bg-white align-items-center gap-2 border-top" style="display: none; height: 56px; border-color: #e4e6eb !important;">
                <div class="d-flex align-items-center gap-1.5 text-danger">
                    <span class="spinner-grow spinner-grow-sm text-danger" role="status"></span>

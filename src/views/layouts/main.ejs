                <div class="d-flex gap-1.5">
                    <button type="button" class="btn btn-light btn-sm rounded-pill px-2 text-danger fw-bold" style="font-size: 0.75rem;" onclick="cancelFloatingVoiceRecording()">
                        <i class="bi bi-trash3 me-1"></i>Hủy
                    </button>
                    <button type="button" class="btn btn-danger btn-sm rounded-pill px-2 fw-bold" style="font-size: 0.75rem; background: #922724 !important; border:none;" onclick="stopAndSendFloatingVoiceRecording()">
                        <i class="bi bi-send-fill me-1"></i>Gửi

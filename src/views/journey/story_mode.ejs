<script>
const journeyId = "<%= journey.id %>";
const isAIJourney = <%= isAI ? 'true' : 'false' %>;
let isEditMode = false;
let sortableInstance = null;

document.addEventListener('DOMContentLoaded', () => {
    if (isAIJourney && document.getElementById('sortable-timeline-list')) {
        initDragAndDrop();
    }
    <% if (isStep4) { %>
    initStep4Map();
    <% } %>
});

/* DRAG AND DROP & METRICS UPDATE WITHOUT PAGE RELOAD */
function initDragAndDrop() {
    const el = document.getElementById('sortable-timeline-list');
    sortableInstance = new Sortable(el, {
        animation: 150,
        disabled: true, // Disabled until "Chỉnh sửa" is clicked
        onEnd: function () {
            recalculateMetricsRealtime();
        }
    });
}

function toggleEditMode() {
    isEditMode = !isEditMode;
    const btn = document.getElementById('btn-toggle-edit');
    const panel = document.getElementById('edit-control-panel');
    const deleteBtns = document.querySelectorAll('.delete-stop-btn');

    if (isEditMode) {
        btn.innerHTML = '<i class="bi bi-check-lg"></i> Xong chỉnh sửa';
        btn.style.background = 'var(--brand-maroon)';
        btn.style.color = '#ffffff';
        if (panel) panel.classList.remove('d-none');
        deleteBtns.forEach(b => b.classList.remove('d-none'));
        if (sortableInstance) sortableInstance.option('disabled', false);
    } else {
        btn.innerHTML = '<i class="bi bi-pencil-square"></i> Chỉnh sửa';
        btn.style.background = '#ffffff';
        btn.style.color = 'var(--brand-maroon)';
        if (panel) panel.classList.add('d-none');
        deleteBtns.forEach(b => b.classList.add('d-none'));
        if (sortableInstance) sortableInstance.option('disabled', true);
        
        // Save new order to DB silently
        saveOrderToBackend();
    }
}

function recalculateMetricsRealtime() {
    const rows = Array.from(document.querySelectorAll('.stop-sortable-item'));
    
    // Update step numbers (1, 2, 3...)
    rows.forEach((row, idx) => {
        const badge = row.querySelector('.stop-num-badge-circle');
        if (badge) badge.innerText = idx + 1;
    });

    // Recalculate distance using Haversine formula
    let totalMeters = 0;
    let totalPts = 0;

    for (let i = 0; i < rows.length; i++) {
        const pts = parseInt(rows[i].dataset.pts) || 100;
        totalPts += pts;

        if (i > 0) {
            const lat1 = parseFloat(rows[i-1].dataset.lat);
            const lng1 = parseFloat(rows[i-1].dataset.lng);
            const lat2 = parseFloat(rows[i].dataset.lat);
            const lng2 = parseFloat(rows[i].dataset.lng);

            if (lat1 && lng1 && lat2 && lng2) {
                const R = 6371000;
                const dLat = (lat2 - lat1) * Math.PI / 180;
                const dLon = (lng2 - lng1) * Math.PI / 180;
                const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                          Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                          Math.sin(dLon / 2) * Math.sin(dLon / 2);
                const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
                totalMeters += R * c;
            }
        }
    }

    const totalKm = rows.length > 1 ? (Math.round((totalMeters / 1000) * 100) / 100) : 4.1;
    const totalTime = rows.length * 60 + Math.round(totalKm * 15);

    // DYNAMICALLY UPDATE TOP METRICS WITHOUT PAGE RELOAD
    document.getElementById('val-stops').innerText = rows.length;
    document.getElementById('val-km').innerText = totalKm;
    document.getElementById('val-time').innerText = totalTime;
    document.getElementById('val-pts').innerText = '+' + totalPts;
}

function saveOrderToBackend() {
    const rows = document.querySelectorAll('.stop-sortable-item');
    const order = Array.from(rows).map(r => r.dataset.id);
    axios.post('/api/journey/update-stop', { journeyId, action: 'reorder', order });
}

function removeDestinationStop(destId) {
    const row = document.querySelector(`.stop-sortable-item[data-id="${destId}"]`);
    if (row) {
        row.remove();
        recalculateMetricsRealtime();
        axios.post('/api/journey/update-stop', { journeyId, action: 'remove', destinationId: destId });
    }
}

function addDestinationStop() {
    const destId = document.getElementById('select-add-dest').value;
    if (!destId) { alert('Vui lòng chọn địa điểm!'); return; }
    axios.post('/api/journey/update-stop', { journeyId, action: 'add', destinationId: destId })
        .then(() => location.reload());
}

function saveJourneyAndProceed() {
    if (isEditMode) saveOrderToBackend();
    
    // Save state & navigate to Step 4
    axios.post('/api/journey/lock-toggle', {})
        .then(() => {
            window.location.href = '/hanh-trinh-cua-toi?step=4';
        })
        .catch(() => {
            window.location.href = '/hanh-trinh-cua-toi?step=4';
        });
}

<% if (isStep4) { %>
function initStep4Map() {
    const stops = <%- JSON.stringify(journey.stops || []) %>;
    if (!stops || stops.length === 0) return;

    const map = L.map('step4-map').setView([parseFloat(stops[0].lat) || 10.8231, parseFloat(stops[0].lng) || 106.6297], 13);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(map);

    const latLngs = [];
    stops.forEach((st, idx) => {
        if (st.lat && st.lng) {
            const ll = [parseFloat(st.lat), parseFloat(st.lng)];
            latLngs.push(ll);
            const html = `<div style="background:#922724;color:#fff;border-radius:50%;width:26px;height:26px;display:flex;align-items:center;justify-content:center;font-weight:900;">${idx+1}</div>`;
            L.marker(ll, { icon: L.divIcon({ html: html, iconSize: [26, 26] }) }).addTo(map).bindPopup(`<b>${st.name}</b>`);
        }
    });

    if (latLngs.length > 1) {
        const poly = L.polyline(latLngs, { color: '#922724', weight: 4, opacity: 0.8, dashArray: '6, 6' }).addTo(map);
        map.fitBounds(poly.getBounds(), { padding: [30, 30] });
    }

    let gmapsUrl = 'https://www.google.com/maps/dir/';
    latLngs.forEach(ll => { gmapsUrl += `${ll[0]},${ll[1]}/`; });
    document.getElementById('btn-gmaps-link').href = gmapsUrl;
}

function getUserGPSLocation() {
    if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(pos => {
            alert('Đã định vị thành công vị trí hiện tại!');
        });
    }
}
<% } %>
</script>
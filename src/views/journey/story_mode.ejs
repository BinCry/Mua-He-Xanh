<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

<style>
:root {
    --brand-maroon: #922724;
    --brand-maroon-dark: #6e1b19;
    --brand-green: #15803d;
    --brand-gold: #d97706;
    --brand-bg: #faf9f6;
    --brand-card: #ffffff;
    --brand-border: #f0eae1;
    --brand-text: #1e293b;
    --brand-muted: #64748b;
}

/* Premium Hero Section */
.journey-hero-brand {
    background: linear-gradient(135deg, var(--brand-maroon) 0%, #7f1d1d 50%, #15803d 100%);
    position: relative;
    overflow: hidden;
    padding: 35px 0 45px;
}
.journey-hero-brand::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 30px;
    background: linear-gradient(to top, var(--brand-bg), transparent);
}
.hero-tag-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255,255,255,0.18);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.3);
    color: #fff;
    border-radius: 50px;
    padding: 6px 18px;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 12px;
}
.journey-hero-brand h1 {
    color: #fff;
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    line-height: 1.2;
    text-shadow: 0 2px 10px rgba(0,0,0,0.2);
}
.metric-card-glass {
    background: rgba(255,255,255,0.15);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255,255,255,0.25);
    border-radius: 20px;
    padding: 16px;
    text-align: center;
    color: #fff;
    transition: transform 0.3s ease, background 0.3s ease;
}
.metric-card-glass:hover {
    background: rgba(255,255,255,0.25);
    transform: translateY(-3px);
}
.metric-card-glass .metric-val {
    font-size: 1.6rem;
    font-weight: 900;
    font-family: 'Montserrat', sans-serif;
    line-height: 1.1;
    margin-bottom: 4px;
}
.metric-card-glass .metric-label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    opacity: 0.85;
}

/* Template Selector Strip */
.template-strip-brand {
    background: #ffffff;
    border-bottom: 1px solid var(--brand-border);
    padding: 14px 0;
    box-shadow: 0 4px 20px rgba(0,0,0,0.03);
}
.template-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 18px;
    border-radius: 50px;
    border: 1.5px solid var(--brand-border);
    background: #fff;
    color: var(--brand-text);
    font-weight: 600;
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.25s ease;
    text-decoration: none;
    white-space: nowrap;
}
.template-pill:hover, .template-pill.active {
    border-color: var(--brand-maroon);
    background: #fdf2f2;
    color: var(--brand-maroon);
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(146, 39, 36, 0.15);
}

/* Timeline Components */
.timeline-line-brand {
    position: absolute;
    left: 22px;
    top: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(to bottom, var(--brand-maroon), var(--brand-green));
    border-radius: 3px;
    opacity: 0.25;
}
.timeline-stop-item {
    display: flex;
    gap: 18px;
    margin-bottom: 18px;
    position: relative;
    z-index: 2;
}
.stop-badge-number {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--brand-maroon) 0%, var(--brand-green) 100%);
    color: #fff;
    font-weight: 900;
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px rgba(146, 39, 36, 0.25);
    border: 3px solid #fff;
    transition: transform 0.3s ease;
    margin-top: 4px;
}
.stop-card-main {
    flex: 1;
    background: #fff;
    border: 1px solid var(--brand-border);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 3px 12px rgba(0,0,0,0.04);
    transition: all 0.3s ease;
    cursor: pointer;
}
.stop-card-main:hover {
    box-shadow: 0 8px 25px rgba(146, 39, 36, 0.12);
    border-color: var(--brand-maroon);
    transform: translateY(-2px);
}
.stop-card-main.highlighted {
    border-color: var(--brand-maroon);
    box-shadow: 0 0 0 3px rgba(146, 39, 36, 0.2), 0 8px 24px rgba(0,0,0,0.1);
}
.stop-thumb-img {
    width: 125px;
    min-width: 125px;
    height: 115px;
    object-fit: cover;
}

/* Action Buttons */
.btn-brand-primary {
    padding: 14px 28px;
    border-radius: 50px;
    border: none;
    background: linear-gradient(135deg, var(--brand-maroon) 0%, #7f1d1d 100%);
    color: #fff;
    font-weight: 800;
    font-size: 0.88rem;
    letter-spacing: 1px;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 6px 20px rgba(146, 39, 36, 0.3);
}
.btn-brand-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(146, 39, 36, 0.4);
    color: #fff;
}
.btn-brand-outline {
    padding: 14px 22px;
    border-radius: 50px;
    border: 2px solid var(--brand-maroon);
    background: transparent;
    color: var(--brand-maroon);
    font-weight: 700;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.3s ease;
}
.btn-brand-outline:hover {
    background: var(--brand-maroon);
    color: #fff;
}

/* Map Styling */
.map-container-sticky {
    position: sticky;
    top: 90px;
    height: calc(100vh - 130px);
    max-height: 750px;
    min-height: 480px;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 12px 35px rgba(0,0,0,0.1);
    border: 1px solid var(--brand-border);
}
.map-bottom-banner {
    position: absolute;
    bottom: 16px;
    left: 16px;
    right: 16px;
    z-index: 500;
    background: rgba(255,255,255,0.94);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(146, 39, 36, 0.15);
    border-radius: 16px;
    padding: 12px 18px;
    box-shadow: 0 4px 18px rgba(0,0,0,0.08);
}
</style>

<!-- HERO SECTION -->
<% 
    let realMeters = 0;
    if (journey && journey.stops && journey.stops.length > 1) {
        for (let i = 1; i < journey.stops.length; i++) {
            const s1 = journey.stops[i-1];
            const s2 = journey.stops[i];
            if (s1 && s2 && s1.lat && s2.lat) {
                const R = 6371000;
                const dLat = (parseFloat(s2.lat) - parseFloat(s1.lat)) * Math.PI / 180;
                const dLon = (parseFloat(s2.lng) - parseFloat(s1.lng)) * Math.PI / 180;
                const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                          Math.cos(parseFloat(s1.lat) * Math.PI / 180) * Math.cos(parseFloat(s2.lat) * Math.PI / 180) *
                          Math.sin(dLon / 2) * Math.sin(dLon / 2);
                const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
                realMeters += R * c;
            }
        }
    }
    const calcStopsCount = (journey && journey.stops) ? journey.stops.length : 0;
    const calcKmVal = calcStopsCount > 1 ? (Math.round((realMeters / 1000) * 100) / 100) : parseFloat(journey.total_km || 0);
    const calcTimeVal = calcStopsCount > 0 ? (calcStopsCount * 60 + Math.round(calcKmVal * 15)) : 60;
    const calcPtsVal = (journey && journey.stops) ? journey.stops.reduce((s, x) => s + (parseInt(x.points) || 100), 0) : 0;
%>
<div class="journey-hero-brand">
    <div class="container position-relative z-index-10">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <h1 class="mb-0"><%= journey.mood.replace(/_/g, ' ') %></h1>
            </div>
            <div class="col-lg-5 mt-3 mt-lg-0 text-lg-end">
                <div style="display:inline-flex; align-items:center; gap:12px; background:rgba(255,255,255,0.22); backdrop-filter:blur(14px); border:1.5px solid rgba(255,255,255,0.4); border-radius:50px; padding:10px 22px; box-shadow:0 4px 20px rgba(0,0,0,0.15);">
                    <span class="badge rounded-circle p-1" id="lock-status-dot" style="width:12px;height:12px;background:#4ade80;box-shadow:0 0 10px #4ade80;"></span>
                    <span style="color:#fff;font-size:0.95rem;font-weight:800;" id="lock-status-text">Đã chốt hành trình</span>
                    <button onclick="toggleTimelineLock()" id="btn-lock-toggle" style="background:#ffffff;border:none;color:var(--brand-maroon);border-radius:50px;padding:6px 18px;font-size:0.85rem;font-weight:800;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,0.2);transition:all 0.2s;">
                        <i class="bi bi-pencil-square me-1"></i>Đổi
                    </button>
                </div>
            </div>
        </div>

        <!-- Metrics Glass -->
        <div class="row g-3 mt-3">
            <div class="col-6 col-md-3">
                <div class="metric-card-glass">
                    <div class="metric-val" id="metric-duration"><%= calcTimeVal %></div>
                    <div class="metric-label"><i class="bi bi-clock-fill me-1"></i>Thời lượng (Phút)</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="metric-card-glass">
                    <div class="metric-val" id="metric-stops"><%= calcStopsCount %></div>
                    <div class="metric-label"><i class="bi bi-geo-alt-fill me-1"></i>Điểm dừng</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="metric-card-glass">
                    <div class="metric-val" id="metric-km"><%= calcKmVal %></div>
                    <div class="metric-label"><i class="bi bi-signpost-split-fill me-1"></i>Quãng đường (Km)</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="metric-card-glass" style="background:rgba(217, 119, 6, 0.25); border-color:rgba(217, 119, 6, 0.4);">
                    <div class="metric-val" id="metric-points" style="color:#fef08a;">+<%= calcPtsVal %></div>
                    <div class="metric-label"><i class="bi bi-stars me-1"></i>Điểm thưởng</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- TEMPLATE SELECTOR STRIP -->
<div class="template-strip-brand">
    <div class="container">
        <div style="display:flex; align-items:center; gap:10px; overflow-x:auto; padding-bottom:2px;">
            <span style="font-size:0.75rem;font-weight:800;text-transform:uppercase;letter-spacing:1.5px;color:var(--brand-maroon);white-space:nowrap;">
                <i class="bi bi-journal-bookmark-fill me-1"></i> Tour hiện có:
            </span>
            <% 
                const seasonEmoji = { spring:'🌸', summer:'☀️', autumn:'🍂', winter:'❄️' };
                const tplList = (typeof templates !== 'undefined' && templates.length > 0) ? templates : [];
            %>
            <% if (tplList.length > 0) { %>
                <% tplList.forEach(tpl => { %>
                <a href="/journey/load-template/<%= tpl.id %>" class="template-pill <%= (journey && journey.mood === tpl.name) ? 'active' : '' %>">
                    <span><%= seasonEmoji[tpl.season] || '🌿' %></span> <%= tpl.name %>
                </a>
                <% }) %>
            <% } else { %>
                <a href="/journey/preset/du-xuan" class="template-pill">
                    <span>🌸</span> Du xuân Bình Lợi
                </a>
                <a href="/journey/preset/miet-vuon" class="template-pill">
                    <span>🌿</span> Miệt vườn giữa phố
                </a>
                <a href="/journey/preset/song-cham" class="template-pill">
                    <span>🕊️</span> Sống chậm Bình Lợi
                </a>
                <a href="/journey/preset/tam-linh" class="template-pill">
                    <span>🛕</span> Tâm linh & Nguồn cội
                </a>
            <% } %>
        </div>
    </div>
</div>

<!-- MAIN CONTENT SECTION -->
<main style="background:var(--brand-bg); min-height:80vh; padding: 35px 0 70px;">
    <div class="container">
        <div class="row g-4">

            <!-- LEFT COLUMN: Timeline -->
            <div class="col-lg-6">

                <!-- Edit Zone (Hidden by default) -->
                <div class="card p-3 mb-4 border-0 shadow-sm rounded-4 d-none" id="timeline-edit-panel" style="background:#fff5f5; border:1px dashed var(--brand-maroon) !important;">
                    <h6 class="fw-bold text-danger mb-2"><i class="bi bi-plus-circle me-1"></i> Thêm điểm dừng mới vào tour</h6>
                    <div class="d-flex gap-2 flex-wrap">
                        <select id="select-new-destination" class="form-select rounded-pill small" style="flex:1; min-width:200px;">
                            <option value="">-- Chọn địa điểm muốn thêm --</option>
                            <% allDestinations.forEach(dest => { %>
                                <option value="<%= dest.id %>"><%= dest.name %> (<%= dest.type %>)</option>
                            <% }) %>
                        </select>
                        <button onclick="addDestinationToTimeline()" class="btn btn-danger rounded-pill btn-sm px-3 fw-bold">Thêm</button>
                    </div>
                </div>

                <!-- Timeline Stops -->
                <div class="position-relative" id="sortable-timeline">
                    <div class="timeline-line-brand"></div>

                    <% journey.stops.forEach((stop, i) => { %>
                        <%
                            const typeIcons = { nature:'🌿', temple:'🛕', craft:'🎋', food:'🍜', garden:'🌺' };
                            const typeIcon = typeIcons[stop.type] || '📍';
                            let startHour = 8 + (i * 1.5);
                            let startStr = Math.floor(startHour).toString().padStart(2,'0') + ':' + ((startHour%1)*60).toString().padStart(2,'0');
                            let endHour = startHour + 1.25;
                            let endStr = Math.floor(endHour).toString().padStart(2,'0') + ':' + ((endHour%1)*60).toString().padStart(2,'0');
                        %>

                        <div class="timeline-stop-item" data-id="<%= stop.destination_id %>" id="stop-card-<%= i %>" onclick="focusStopOnMap(<%= i %>)">
                            <div class="stop-badge-number" id="stop-badge-<%= i %>"><%= i + 1 %></div>
                            <div class="stop-card-main" id="stop-item-<%= i %>">
                                <div style="display:flex;">
                                    <img src="<%= fixImg(stop.cover_image) %>" class="stop-thumb-img" alt="<%= stop.name %>">
                                    <div style="flex:1; padding:12px 16px; position:relative;">
                                        
                                        <!-- Edit actions -->
                                        <div class="edit-actions d-none" style="position:absolute;top:8px;right:8px;display:flex;gap:4px;">
                                            <div class="drag-handle btn btn-light btn-sm rounded-circle shadow-sm border" title="Kéo để xếp lại" style="width:28px;height:28px;display:flex;align-items:center;justify-content:center;">
                                                <i class="bi bi-grip-vertical"></i>
                                            </div>
                                            <button onclick="event.stopPropagation(); removeStopFromTimeline('<%= stop.destination_id %>')" class="btn btn-danger btn-sm rounded-circle shadow-sm" style="width:28px;height:28px;display:flex;align-items:center;justify-content:center;">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </div>

                                        <div class="d-flex gap-2 flex-wrap mb-1">
                                            <span class="badge bg-light text-dark border rounded-pill x-small fw-bold"><i class="bi bi-clock me-1 text-primary"></i><%= startStr %> - <%= endStr %></span>
                                            <span class="badge bg-success-subtle text-success rounded-pill x-small fw-bold"><%= typeIcon %> <%= stop.type || 'Địa điểm' %></span>
                                        </div>

                                        <div class="fw-bold text-dark mb-1" style="font-size: 0.95rem;"><%= stop.name %></div>
                                        <div class="text-muted x-small line-clamp-1 mb-2"><%= stop.short_desc || stop.highlight || '' %></div>

                                        <div class="d-flex align-items-center justify-content-between">
                                            <a href="/explore/<%= stop.slug %>" onclick="event.stopPropagation()" class="x-small fw-bold text-danger text-decoration-none">
                                                Xem thông tin <i class="bi bi-chevron-right"></i>
                                            </a>
                                            <span class="x-small fw-bold text-success"><i class="bi bi-star-fill text-warning me-1"></i>+<%= stop.points || 0 %> điểm</span>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>

                <!-- Footer Action Buttons -->
                <div class="d-flex gap-3 mt-4 flex-wrap">
                    <button class="btn-brand-primary flex-grow-1" id="btn-timeline-action" onclick="lockJourneyAndConfirm()">
                        <i class="bi bi-check-circle-fill me-2"></i> CHỐT & LƯU LỘ TRÌNH
                    </button>
                    <button class="btn-brand-outline" onclick="window.location.href='/onboarding'">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Làm lại
                    </button>
                </div>

            </div>

            <!-- RIGHT COLUMN: Map Panel -->
            <div class="col-lg-6">
                <div class="map-container-sticky">
                    <div id="journey-leaflet-map" style="width:100%; height:100%;"></div>
                    <div class="map-bottom-banner">
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <span class="fw-bold small text-dark"><i class="bi bi-map-fill text-danger me-1"></i> Chỉ đường Google Maps Lộ trình</span>
                            <span class="badge bg-success text-white rounded-pill x-small">● OSRM Routing</span>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mb-2" id="map-legend">
                            <% journey.stops.forEach((stop, i) => { %>
                            <span class="x-small fw-semibold text-muted d-inline-flex align-items-center gap-1">
                                <span class="badge bg-danger rounded-circle p-1" style="width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center;"><%= i+1 %></span>
                                <%= stop.name %>
                            </span>
                            <% }) %>
                        </div>
                        <a id="btnGoogleMapsNav" href="#" target="_blank" class="btn btn-sm btn-success rounded-pill fw-bold shadow-sm px-3 py-2 w-100 text-center d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-cursor-fill"></i> MỞ CHỈ ĐƯỜNG BẰNG GOOGLE MAPS (TURN-BY-TURN)
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</main>

<script>
let map, markers = [], routeLine, routeLineBorder;
let isTimelineLocked = true;
const journeyId = '<%= journey.id %>';
const stopsData = <%- JSON.stringify(journey.stops) %>;

document.addEventListener('DOMContentLoaded', () => {
    initLeafletMap();
    initTimelineReordering();
    updateGoogleMapsLink();

    gsap.from('.metric-card-glass', { opacity:0, y:20, stagger:0.08, duration:0.6, ease:'power2.out' });
    gsap.from('.timeline-stop-item', { opacity:0, x:-30, stagger:0.1, duration:0.6, ease:'power3.out' });
});

function updateGoogleMapsLink() {
    if (!stopsData || stopsData.length === 0) return;
    const first = stopsData[0];
    const last = stopsData[stopsData.length - 1];
    const waypoints = stopsData.slice(1, stopsData.length - 1).map(s => `${s.lat},${s.lng}`).join('|');
    let gmapsUrl = `https://www.google.com/maps/dir/?api=1&origin=${first.lat},${first.lng}&destination=${last.lat},${last.lng}`;
    if (waypoints) {
        gmapsUrl += `&waypoints=${encodeURIComponent(waypoints)}`;
    }
    const btn = document.getElementById('btnGoogleMapsNav');
    if (btn) btn.href = gmapsUrl;
}

function initLeafletMap() {
    try {
        const center = [10.796, 106.524];
        map = L.map('journey-leaflet-map', {
            center, zoom: 14,
            zoomControl: true,
            attributionControl: false
        });
        L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
            maxZoom: 20
        }).addTo(map);
        renderRouteOnMap();
    } catch(e) { console.error('Leaflet init failed', e); }
}

function renderRouteOnMap() {
    markers.forEach(m => map.removeLayer(m));
    markers = [];
    if (routeLine) { map.removeLayer(routeLine); routeLine = null; }
    if (routeLineBorder) { map.removeLayer(routeLineBorder); routeLineBorder = null; }
    if (!stopsData || stopsData.length === 0) return;

    const bounds = L.latLngBounds();
    const coords = [];
    const osrmWaypoints = [];
    const colors = ['#922724', '#15803d', '#d97706', '#1e40af', '#b91c1c', '#047857'];

    stopsData.forEach((stop, i) => {
        const lat = parseFloat(stop.lat) || (10.79 + i * 0.005);
        const lng = parseFloat(stop.lng) || (106.52 + i * 0.005);
        const pos = [lat, lng];
        bounds.extend(pos);
        coords.push(pos);
        osrmWaypoints.push(`${lng},${lat}`);

        const color = colors[i % colors.length];
        const icon = L.divIcon({
            className: '',
            html: `<div style="background:${color};width:32px;height:32px;border-radius:50%;border:3px solid #fff;box-shadow:0 3px 10px rgba(0,0,0,0.3);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:900;font-size:13px;cursor:pointer;">${i+1}</div>`,
            iconSize:[32,32], iconAnchor:[16,16], popupAnchor:[0,-16]
        });

        const m = L.marker(pos, { icon }).addTo(map);

        const imgSrc = stop.cover_image
            ? (stop.cover_image.startsWith('http') || stop.cover_image.startsWith('data:') ? stop.cover_image : '/' + stop.cover_image.replace(/^public\//, ''))
            : '/images/placeholder.png';

        m.bindPopup(`
            <div style="width:210px;font-family:sans-serif;">
                <img src="${imgSrc}" style="width:100%;height:100px;object-fit:cover;border-radius:10px;margin-bottom:8px;">
                <div style="font-weight:900;font-size:0.9rem;color:${color};margin-bottom:4px;">${i+1}. ${stop.name}</div>
                <div style="font-size:0.72rem;color:#64748b;">⏰ ${stop.open_hours || '07:00 - 18:00'}</div>
                <div class="d-flex gap-1 mt-2">
                    <a href="/explore/${stop.slug}" style="display:inline-block;font-size:0.75rem;font-weight:700;color:${color};text-decoration:none;">Xem chi tiết →</a>
                    <a href="https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}" target="_blank" style="display:inline-block;margin-left:auto;font-size:0.72rem;font-weight:700;color:#2563eb;text-decoration:none;"><i class="bi bi-geo-alt"></i> Chỉ đường</a>
                </div>
            </div>
        `, { maxWidth: 230 });

        m.on('click', () => highlightTimelineStop(i));
        markers.push(m);
    });

    // OSRM Routing for real road navigation lines & real-time metrics
    if (coords.length >= 2) {
        const osrmUrl = `https://router.project-osrm.org/route/v1/driving/${osrmWaypoints.join(';')}?overview=full&geometries=geojson`;
        fetch(osrmUrl)
            .then(res => res.json())
            .then(data => {
                if (data.routes && data.routes.length > 0) {
                    const routeGeoJSON = data.routes[0].geometry;
                    const roadCoords = routeGeoJSON.coordinates.map(c => [c[1], c[0]]);

                    const realKm = Math.round((data.routes[0].distance / 1000) * 100) / 100;
                    const realMins = stopsData.length * 60 + Math.round(realKm * 15);
                    const kmEl = document.getElementById('metric-km');
                    const durEl = document.getElementById('metric-duration');
                    if (kmEl && realKm > 0) kmEl.innerText = realKm;
                    if (durEl && realMins > 0) durEl.innerText = realMins;

                    // Outer dark border polyline
                    routeLineBorder = L.polyline(roadCoords, {
                        color: '#1e293b', opacity: 0.7, weight: 8
                    }).addTo(map);

                    // Inner Google Maps style blue line
                    routeLine = L.polyline(roadCoords, {
                        color: '#4285F4', opacity: 0.95, weight: 5
                    }).addTo(map);
                } else {
                    drawFallbackPolyline(coords);
                }
            })
            .catch(err => {
                console.warn('OSRM routing fetch fallback:', err);
                drawFallbackPolyline(coords);
            });
    }

    if (bounds.isValid()) map.fitBounds(bounds, { padding: [40, 40] });
}

function drawFallbackPolyline(coords) {
    routeLine = L.polyline(coords, {
        color: '#4285F4', opacity: 0.9, weight: 5, dashArray: '8, 8'
    }).addTo(map);
}

function focusStopOnMap(idx) {
    highlightTimelineStop(idx);
    if (markers[idx]) {
        map.flyTo(markers[idx].getLatLng(), 16, { animate: true, duration: 0.8 });
        setTimeout(() => markers[idx].openPopup(), 800);
    }
}

function highlightTimelineStop(idx) {
    document.querySelectorAll('.stop-badge-number').forEach((b, i) => {
        b.style.transform = i === idx ? 'scale(1.2)' : 'scale(1)';
    });
    document.querySelectorAll('.stop-card-main').forEach((c, i) => c.classList.toggle('highlighted', i === idx));
    const card = document.getElementById(`stop-card-${idx}`);
    if (card) card.scrollIntoView({ behavior:'smooth', block:'nearest' });
}

let sortableInstance;
function initTimelineReordering() {
    const el = document.getElementById('sortable-timeline');
    if (!el) return;
    sortableInstance = Sortable.create(el, {
        handle: '.drag-handle',
        animation: 300,
        disabled: true,
        onEnd: () => saveNewItineraryOrder()
    });
}

function toggleTimelineLock() {
    isTimelineLocked = !isTimelineLocked;
    const dot = document.getElementById('lock-status-dot');
    const text = document.getElementById('lock-status-text');
    const btn = document.getElementById('btn-lock-toggle');
    const actionBtn = document.getElementById('btn-timeline-action');
    const editPanel = document.getElementById('timeline-edit-panel');

    if (isTimelineLocked) {
        dot.style.background = '#4ade80';
        dot.style.boxShadow = '0 0 8px #4ade80';
        text.innerText = 'Đã chốt hành trình';
        btn.innerHTML = '<i class="bi bi-pencil-square me-1"></i>Đổi';
        actionBtn.innerHTML = '<i class="bi bi-check-circle-fill me-2"></i> CHỐT & LƯU LỘ TRÌNH';
        actionBtn.setAttribute('onclick', 'lockJourneyAndConfirm()');
        editPanel.classList.add('d-none');
        document.querySelectorAll('.edit-actions').forEach(e => e.classList.add('d-none'));
        sortableInstance.option('disabled', true);
    } else {
        dot.style.background = '#f59e0b';
        dot.style.boxShadow = '0 0 8px #f59e0b';
        text.innerText = 'Đang chỉnh sửa…';
        btn.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i>Xong';
        actionBtn.innerHTML = '<i class="bi bi-floppy2-fill me-2"></i> LƯU THAY ĐỔI';
        actionBtn.setAttribute('onclick', 'lockJourneyAndConfirm()');
        editPanel.classList.remove('d-none');
        document.querySelectorAll('.edit-actions').forEach(e => e.classList.remove('d-none'));
        sortableInstance.option('disabled', false);
    }
}

function lockJourneyAndConfirm() {
    if (!isTimelineLocked) toggleTimelineLock();
    const btn = document.getElementById('btn-timeline-action');
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang lưu…';
    btn.disabled = true;
    setTimeout(() => {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-check-circle-fill me-2"></i>ĐÃ LƯU THÀNH CÔNG!';
        btn.style.background = 'linear-gradient(135deg,#15803d,#166534)';
        setTimeout(() => {
            btn.innerHTML = '<i class="bi bi-check-circle-fill me-2"></i> CHỐT & LƯU LỘ TRÌNH';
            btn.style.background = '';
        }, 2000);
    }, 800);
}

function saveNewItineraryOrder() {
    const items = document.querySelectorAll('#sortable-timeline .timeline-stop-item');
    const order = Array.from(items).map(el => el.dataset.id);
    axios.post('/api/journey/update-stop', { journeyId, action:'reorder', order })
        .then(() => location.reload())
        .catch(() => alert('Lỗi khi cập nhật thứ tự.'));
}

function removeStopFromTimeline(destId) {
    if (!confirm('Bạn muốn bỏ địa điểm này khỏi lộ trình?')) return;
    axios.post('/api/journey/update-stop', { journeyId, action:'remove', destinationId: destId })
        .then(() => location.reload())
        .catch(() => alert('Lỗi khi xoá địa điểm.'));
}

function addDestinationToTimeline() {
    const destId = document.getElementById('select-new-destination').value;
    if (!destId) { alert('Vui lòng chọn địa điểm!'); return; }
    axios.post('/api/journey/update-stop', { journeyId, action:'add', destinationId: destId })
        .then(() => location.reload())
        .catch(() => alert('Lỗi khi thêm địa điểm.'));
}
</script>